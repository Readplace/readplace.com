{
  "name": "@packages/account-liveness",
  "version": "1.0.0",
  "description": "One consistent read of the users table that answers whether an account is still live: its row exists, still names this user id, and carries no deletedAt",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "scripts": {
    "compile": "rm -rf dist && tsc",
    "lint": "concurrently --kill-others-on-fail \"tsc --project tsconfig.lint.json\" \"biome lint src\" \"knip\"",
    "test": "jest --testMatch='**/dist/**/*.test.js'",
    "test-with-coverage": "c8 pnpm test && node enforce-coverage.config.js",
    "check": "nx run @packages/account-liveness:check",
    "check-infra": "echo 'No infrastructure — shared library'"
  },
  "dependencies": {
    "@packages/domain": "workspace:*",
    "@packages/provider-contracts": "workspace:*",
    "@packages/storage-client": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "c8": "11.0.0",
    "concurrently": "10.0.0",
    "jest": "30.4.2",
    "typescript": "6.0.3"
  }
}
