{
  "name": "@packages/infra-components",
  "version": "1.0.0",
  "description": "Shared EventBridge infrastructure and runtime utilities for Readplace",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./infra": {
      "types": "./dist/infra/index.d.ts",
      "default": "./dist/infra/index.js"
    },
    "./infra/build-handler-images": {
      "types": "./dist/infra/build-handler-images.d.ts",
      "default": "./dist/infra/build-handler-images.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "infra": ["./dist/infra/index.d.ts"],
      "infra/build-handler-images": ["./dist/infra/build-handler-images.d.ts"],
      "runtime": ["./dist/runtime/index.d.ts"]
    }
  },
  "private": true,
  "scripts": {
    "compile": "rm -rf dist && tsc",
    "lint": "concurrently --kill-others-on-fail \"tsc --project tsconfig.lint.json\" \"biome lint src\" \"knip\"",
    "test": "jest --testMatch='**/dist/**/*.test.js'",
    "check": "nx run @packages/infra-components:check",
    "check-infra": "echo 'No infrastructure — shared library'"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "3.1057.0",
    "@aws-sdk/client-sqs": "3.1057.0",
    "@packages/article-state-types": "workspace:*",
    "@packages/logger": "workspace:*",
    "@packages/media-contracts": "workspace:*",
    "@packages/provider-contracts": "workspace:*",
    "esbuild": "catalog:",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@packages/test-fixtures": "workspace:*",
    "@pulumi/aws": "7.32.0",
    "@pulumi/pulumi": "3.277.0",
    "@types/aws-lambda": "8.10.161",
    "@types/jest": "30.0.0",
    "concurrently": "10.0.7",
    "jest": "30.5.2",
    "typescript": "6.0.3"
  }
}
