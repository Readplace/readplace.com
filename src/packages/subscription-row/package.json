{
  "name": "@packages/subscription-row",
  "version": "1.0.0",
  "description": "The DynamoDB row schema for subscriptions and its mapping to a SubscriptionRecord — one definition shared by the read half (hutch) and the write half (subscription service)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "scripts": {
    "compile": "rm -rf dist && tsc",
    "lint": "concurrently --kill-others-on-fail \"tsc --project tsconfig.lint.json\" \"biome lint src\" \"knip\"",
    "test": "jest --testMatch='**/dist/**/*.test.js'",
    "test-with-coverage": "c8 pnpm test && node enforce-coverage.config.js",
    "check": "pnpm lint",
    "check-infra": "echo 'No infrastructure — shared library'"
  },
  "dependencies": {
    "@packages/domain": "workspace:*",
    "@packages/hutch-storage-client": "workspace:*",
    "@packages/provider-contracts": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "c8": "11.0.0",
    "concurrently": "10.0.0",
    "jest": "30.4.2",
    "typescript": "6.0.3"
  }
}
