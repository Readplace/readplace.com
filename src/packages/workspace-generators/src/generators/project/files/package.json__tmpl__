{
  "name": "<%= name %>",
  "version": "1.0.0",
  "description": <%- JSON.stringify(description) %>,
  "main": "src/runtime/<%= name %>.ts",
  "private": true,
  "scripts": {
    "compile": "rm -rf dist && tsc",
    "test": "jest --testMatch='**/dist/**/*.test.js' --testTimeout=10000",
    "test-with-coverage": "c8 pnpm test && node enforce-coverage.config.js",
    "lint": "tsc --project tsconfig.lint.json && concurrently --kill-others-on-fail \"biome lint src\" \"knip\"",
    "check-infra": "echo 'No infrastructure — nothing to preview'",
    "check": "nx run <%= name %>:check"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.19.19",
    "c8": "11.0.0",
    "concurrently": "10.0.0",
    "jest": "30.4.2",
    "typescript": "6.0.3"
  }
}
