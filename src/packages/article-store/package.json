{
  "name": "@packages/article-store",
  "version": "1.0.0",
  "description": "DynamoDB-backed storage adapter for the Article aggregate; consumed by save-link and hutch.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "scripts": {
    "compile": "rm -rf dist && tsc",
    "lint": "concurrently --kill-others-on-fail \"tsc --project tsconfig.lint.json\" \"biome lint src\" \"knip\"",
    "test": "jest --testMatch='**/dist/**/*.test.js' --testTimeout=10000",
    "test-with-coverage": "c8 pnpm test && node enforce-coverage.config.js",
    "check": "nx run @packages/article-store:check",
    "check-infra": "echo 'No infrastructure \u2014 shared library'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1057.0",
    "@packages/article-resource-unique-id": "workspace:*",
    "@packages/article-state-types": "workspace:*",
    "@packages/domain": "workspace:*",
    "@packages/hutch-logger": "workspace:*",
    "@packages/hutch-storage-client": "workspace:*",
    "@packages/provider-contracts": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "c8": "11.0.0",
    "concurrently": "10.0.0",
    "jest": "30.4.2",
    "typescript": "6.0.3"
  }
}
