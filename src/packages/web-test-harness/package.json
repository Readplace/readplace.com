{
  "name": "@packages/web-test-harness",
  "version": "1.0.0",
  "description": "Application-agnostic Express test-server harness and fixture bundle types for Readplace",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "private": true,
  "scripts": {
    "compile": "rm -rf dist && tsc",
    "lint": "concurrently --kill-others-on-fail \"tsc --project tsconfig.lint.json\" \"biome lint src\" \"knip\"",
    "test": "jest --testMatch='**/dist/**/*.test.js' --testTimeout=10000",
    "test-with-coverage": "c8 pnpm test && node enforce-coverage.config.js",
    "check": "nx run @packages/web-test-harness:check",
    "check-infra": "echo 'No infrastructure — shared library'"
  },
  "dependencies": {
    "@packages/article-parser": "workspace:*",
    "@packages/crawl-article": "workspace:*",
    "@packages/domain": "workspace:*",
    "@packages/extract-links-from-page": "workspace:*",
    "@packages/hutch-logger": "workspace:*",
    "@packages/provider-contracts": "workspace:*",
    "linkedom": "0.18.12",
    "supertest": "7.2.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.0",
    "c8": "11.0.0",
    "concurrently": "10.0.0",
    "express": "5.2.1",
    "jest": "30.4.2",
    "typescript": "6.0.3"
  }
}
