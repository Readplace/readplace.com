# The browser environment CI consumes. Read by .github/actions/pinned-browsers
# and by browser-image.yml, which is the only thing that builds the image.
#
# To move a browser: edit a version here, dispatch browser-image.yml, and land
# the digest it prints as its own commit. Nothing else changes a browser.
#
# First promotion only: make ghcr.io/readplace/ci-browsers public (repo Packages
# -> package settings -> Change visibility). GHCR creates a package private, and
# every consumer pulls it anonymously — fork-PR web-tests gets no secrets, and
# rebuild.sh runs on the OrbStack host, which holds no GITHUB_TOKEN. Only
# browser-image.yml ever logs in.

# Build inputs. PLAYWRIGHT_BASE_IMAGE must be a manifest INDEX digest and must
# match the @playwright/test version the workspace is pinned to.
PLAYWRIGHT_BASE_IMAGE=mcr.microsoft.com/playwright:v1.60.0-noble@sha256:9bd26ad900bb5e0f4dee75839e957a89ae89c2b7ab1e76050e559790e946b948
CHROME_FOR_TESTING_VERSION=152.0.7977.82
FIREFOX_VERSION=153.0.3
GECKODRIVER_VERSION=0.37.0

# The built image, added by the promotion commit once browser-image.yml has
# validated the candidate. Consumers fail loudly while it is absent.
CI_BROWSER_IMAGE=ghcr.io/readplace/ci-browsers@sha256:1c99ad3124c1588f3cf0ab142edec552c0bbd3e93298470919feaf979b5e712d
