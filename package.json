{
  "name": "readplace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Readplace monorepo — read-it-later app",
  "scripts": {
    "test": "nx run-many --target=test --all",
    "compile": "nx run-many --target=compile --all",
    "lint": "editorconfig-checker && nx run-many --target=lint --all",
    "dev": "nx run hutch:dev",
    "permalink": "pnpm --filter hutch permalink",
    "check": ". ./.envrc && editorconfig-checker && nx run-many --target=check --all",
    "perf": ". ./.envrc && nx run-many --target=perf --all --parallel=1",
    "check-infra": ". ./.envrc && nx run-many --target=compile --all && nx run-many --target=check-infra --all",
    "deploy-infra": "nx run-many --target=deploy-infra --all",
    "generate-package": "nx run @packages/workspace-generators:compile && nx generate @packages/workspace-generators:package",
    "generate-project": "nx run @packages/workspace-generators:compile && nx generate @packages/workspace-generators:project",
    "clean-disk": "rm -rf projects/browser-extensions/chrome-extension/.cache .nx node_modules projects/save-link/.lib projects/hutch/.lib",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.19",
    "editorconfig-checker": "6.1.1",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "knip": "6.14.2",
    "minimatch": "11.0.1",
    "nx": "22.7.12",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "sanitize-html>htmlparser2": "10.1.0",
      "@babel/helper-compilation-targets>browserslist": "^4.28.7",
      "@grpc/proto-loader>protobufjs": "^7.6.1",
      "@pulumi/pulumi>@grpc/grpc-js": "^1.14.5",
      "@devicefarmer/adbkit>node-forge": "^1.4.1",
      "ajv@8>fast-uri": "^3.1.7",
      "cheerio>undici": "^7.30.1",
      "flat-cache>flatted": "^3.4.2",
      "knip>smol-toml": "^1.7.1",
      "livereload>ws": "^8.21.0",
      "minimatch@3>brace-expansion": "^1.1.20",
      "minimatch@9>brace-expansion": "^2.1.6",
      "minimatch@10>brace-expansion": "^5.0.11",
      "nx>axios": "^1.20.0",
      "nx>brace-expansion": "^5.0.11",
      "nx>follow-redirects": "^1.16.2",
      "nx>smol-toml": "^1.7.1",
      "selenium-webdriver>tmp": "^0.2.7"
    },
    "supportedArchitectures": {
      "os": ["current", "linux"],
      "cpu": ["current", "x64"],
      "libc": ["current", "glibc"]
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "nx",
      "protobufjs",
      "spawn-sync",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "node-html-markdown@2.0.0": "patches/node-html-markdown@2.0.0.patch"
    }
  }
}
