{
  "name": "firefox-extension",
  "targets": {
    "deploy-infra": {
      "command": "PULUMI_CONFIG_PASSPHRASE='' pulumi up --stack \"${PULUMI_STACK:?PULUMI_STACK is not set}\" $([ \"$CI\" = true ] && echo --skip-preview --yes)",
      "options": { "cwd": "{projectRoot}" }
    },
    "compile": {
      "outputs": ["{projectRoot}/dist", "{projectRoot}/dist-extension-compiled", "{projectRoot}/dist-extension-files"]
    },
    "compile-dev": {
      "dependsOn": ["^compile"]
    },
    "test:e2e": {
      "dependsOn": ["compile", "hutch:compile"]
    },
    "post-deploy": {
      "command": "bash scripts/post-deploy.sh",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["compile"]
    },
    "check": {
      "command": "pnpm lint && pnpm test-with-coverage",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["compile", "^compile", "hutch:compile"],
      "inputs": [
        "default",
        "^production",
        { "projects": ["hutch"], "input": "production" },
        { "dependentTasksOutputFiles": "**/dist/**/!(.tsbuildinfo)", "transitive": true },
        { "env": "CLAUDE_CODE_REMOTE" },
        { "runtime": "/opt/firefox/firefox --version 2>/dev/null; true" }
      ]
    }
  }
}
