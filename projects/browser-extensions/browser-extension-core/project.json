{
  "name": "browser-extension-core",
  "targets": {
    "check": {
      "command": "true",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["lint", "test-with-coverage"]
    },
    "lint": {
      "dependsOn": ["compile"]
    },
    "test-with-coverage": {
      "dependsOn": ["compile"]
    }
  }
}
