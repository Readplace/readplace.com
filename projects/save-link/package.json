{
  "name": "save-link",
  "version": "1.0.0",
  "description": "Event handlers for link saving and summary generation",
  "main": "src/infra/index.ts",
  "private": true,
  "scripts": {
    "compile": "rm -rf dist && tsc && node scripts/copy-static-assets.js",
    "test": "jest --testMatch='**/dist/**/*.test.js' --testTimeout=10000",
    "test-with-coverage": "c8 node scripts/run-tests-with-coverage.js && node enforce-coverage.config.js",
    "lint": "tsc --project tsconfig.lint.json && concurrently --kill-others-on-fail \"biome lint src\" \"knip\"",
    "check-infra": "pnpm compute-image-tags && PULUMI_CONFIG_PASSPHRASE='' pulumi preview --stack \"${PULUMI_STACK:?PULUMI_STACK is not set}\"",
    "check": "nx run save-link:check",
    "build-image": "node tools/build-image.mjs",
    "compute-image-tags": "node tools/build-image.mjs --tag-only",
    "deploy-infra": "nx run save-link:build-image && PULUMI_CONFIG_PASSPHRASE='' pulumi up --stack \"${PULUMI_STACK:?PULUMI_STACK is not set}\" $([ \"$CI\" = true ] && echo --yes) $([ \"$CI\" = true ] && [ \"$PULUMI_STACK\" = staging ] && echo --skip-preview)",
    "post-deploy": "nx run @packages/crawl-article:health-egress-proxy"
  },
  "dependencies": {
    "@11ty/posthtml-urls": "1.0.3",
    "@aws-sdk/client-cloudwatch-logs": "3.1057.0",
    "@aws-sdk/client-lambda": "3.1057.0",
    "@aws-sdk/client-s3": "3.1057.0",
    "@aws-sdk/client-sqs": "3.1057.0",
    "@packages/ai-message": "workspace:*",
    "@packages/article-parser": "workspace:*",
    "@packages/article-resource-unique-id": "workspace:*",
    "@packages/article-state-types": "workspace:*",
    "@packages/article-store": "workspace:*",
    "@packages/crawl-article": "workspace:*",
    "@packages/dead-letter-routing": "workspace:*",
    "@packages/domain": "workspace:*",
    "@packages/finalize-article": "workspace:*",
    "@packages/hutch-infra-components": "workspace:*",
    "@packages/hutch-logger": "workspace:*",
    "@packages/hutch-storage-client": "workspace:*",
    "@packages/onboarding-signals": "workspace:*",
    "@packages/provider-contracts": "workspace:*",
    "@packages/refresh-article-content": "workspace:*",
    "@packages/require-env": "workspace:*",
    "@packages/retriable": "workspace:*",
    "@packages/save-article": "workspace:*",
    "@packages/site-rules": "workspace:*",
    "@packages/test-fixtures": "workspace:*",
    "@smithy/node-http-handler": "4.7.5",
    "@types/parse-srcset": "1.0.0",
    "diff": "9.0.0",
    "linkedom": "0.18.12",
    "openai": "6.39.1",
    "parse-srcset": "1.0.2",
    "posthtml": "0.16.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@packages/test-phase-runner": "workspace:*",
    "@pulumi/aws": "7.32.0",
    "@pulumi/pulumi": "3.244.0",
    "@types/aws-lambda": "8.10.161",
    "@types/jest": "30.0.0",
    "c8": "11.0.0",
    "concurrently": "10.0.0",
    "esbuild": "catalog:",
    "jest": "30.4.2",
    "typescript": "6.0.3"
  }
}
