# Copy to `fastlane/.env` (gitignored) and fill in. fastlane auto-loads it.
# NEVER commit the real .env or the .p8 key.

# --- App Store Connect API key (the only auth; no Apple ID / app-specific password) ---
# Key ID of the .p8 (App Store Connect → Users and Access → Integrations → App Store Connect API).
ASC_KEY_ID=
# Issuer ID (UUID) shown above the keys list on the same page.
ASC_ISSUER_ID=
# Path to the .p8 private key. Put the file under fastlane/secrets/ (gitignored).
ASC_KEY_PATH=./fastlane/secrets/AuthKey.p8

# --- Apple Developer team ---
# 10-character Team ID (developer.apple.com → Membership details).
TEAM_ID=

# --- fastlane match (encrypted cert/profile storage) ---
# Private git repo URL that match reads/writes (must already exist; can be empty).
MATCH_GIT_URL=
# Passphrase match uses to encrypt the repo contents. Choose a strong one and keep it safe.
MATCH_PASSWORD=
