{
  "name": "ios-readplace-poc",
  "projectType": "application",
  "targets": {
    "compile": {
      "command": "bash scripts/generate-project.sh",
      "options": { "cwd": "{projectRoot}" },
      "inputs": [
        "{projectRoot}/App/**/*",
        "{projectRoot}/Shared/**/*",
        "{projectRoot}/ShareExtension/**/*",
        "{projectRoot}/project.yml"
      ],
      "cache": false,
      "dependsOn": []
    }
  }
}
