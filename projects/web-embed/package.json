{
  "name": "web-embed",
  "version": "1.0.0",
  "description": "Standalone embed kit pages (/embed, /embed/preview) \u2014 save-button snippets for publishers",
  "main": "src/infra/index.ts",
  "private": true,
  "scripts": {
    "compile": "rm -rf dist && tsc && node scripts/copy-static-assets.js",
    "test": "jest --testMatch='**/dist/**/*.test.js' --testTimeout=10000",
    "test-with-coverage": "c8 node scripts/run-tests-with-coverage.js && node enforce-coverage.config.js",
    "test:e2e": "pnpm compile && E2E_PORT=3700 playwright test --config playwright.config.local-dev.ts",
    "lint": "tsc --project tsconfig.lint.json && concurrently --kill-others-on-fail \"biome lint src\" \"knip\" \"editorconfig-checker\"",
    "check-infra": "PULUMI_CONFIG_PASSPHRASE='' pulumi preview --stack \"${PULUMI_STACK:?PULUMI_STACK is not set}\"",
    "check": "nx run web-embed:check"
  },
  "dependencies": {
    "@packages/domain": "workspace:*",
    "@packages/hutch-logger": "workspace:*",
    "@packages/hutch-storage-client": "workspace:*",
    "@packages/require-env": "workspace:*",
    "@packages/web-session": "workspace:*",
    "@packages/web-shell": "workspace:*",
    "express": "5.2.1",
    "helmet": "8.2.0",
    "serverless-http": "4.0.0"
  },
  "devDependencies": {
    "@packages/e2e-harness": "workspace:*",
    "@packages/hutch-infra-components": "workspace:*",
    "@packages/test-fixtures": "workspace:*",
    "@packages/test-phase-runner": "workspace:*",
    "@playwright/test": "1.60.0",
    "@pulumi/aws": "7.32.0",
    "@pulumi/pulumi": "3.244.0",
    "@types/aws-lambda": "8.10.161",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.19",
    "@types/supertest": "7.2.0",
    "c8": "11.0.0",
    "concurrently": "10.0.0",
    "editorconfig-checker": "6.1.1",
    "jest": "30.4.2",
    "jsdom": "26.1.0",
    "supertest": "7.2.2",
    "typescript": "6.0.3"
  }
}
