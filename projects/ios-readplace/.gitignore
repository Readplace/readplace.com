# Xcode user state / build artifacts
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.xcscmblueprint
.DS_Store

# The .xcodeproj is generated from project.yml by XcodeGen, so it is not
# committed (it churns on every `compile`/`make generate` and CI-injected
# signing leaks into the diff). Regenerate it any time with `make generate`.
Readplace.xcodeproj/

# --- Secrets (NEVER commit) ---
fastlane/.env
fastlane/secrets/
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# --- Bundler / fastlane generated ---
vendor/
.bundle/
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/README.md
