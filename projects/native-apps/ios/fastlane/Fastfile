require "digest"

default_platform(:ios)

PROJECT     = "Readplace.xcodeproj"
SCHEME      = "Readplace"
APP_ID      = "com.readplace"
EXT_ID      = "com.readplace.ShareExtension"
OUTPUT_NAME = "Readplace.ipa"

# fastlane runs with its working directory set to the fastlane/ folder, so raw
# file paths must be anchored to the project root, not the current directory.
# Walk up to the committed XcodeGen spec — the .xcodeproj cannot be the anchor
# because it is generated, not committed, so it does not exist on a fresh CI
# checkout (the beta lane itself generates it mid-run).
SPEC = "project.yml"
PROJECT_ROOT = begin
  dir = Dir.pwd
  dir = File.dirname(dir) until File.exist?(File.join(dir, SPEC)) || dir == File.dirname(dir)
  UI.user_error!("Could not find #{SPEC} in any directory above #{Dir.pwd}") unless File.exist?(File.join(dir, SPEC))
  dir
end
PROJECT_PATH = File.join(PROJECT_ROOT, PROJECT)
OUTPUT_DIR   = File.join(PROJECT_ROOT, "build", "output")

# Targets that ship in the App Store build and therefore need distribution
# signing. The test target is intentionally excluded.
SIGNED_TARGETS = [
  { target: "Readplace",   bundle_id: APP_ID },
  { target: "ShareExtension", bundle_id: EXT_ID },
].freeze

# Resolve the .p8 path from .env against the project root (env value is written
# relative to it), and fail early with a clear message if it is missing.
def asc_key_filepath
  raw = ENV.fetch("ASC_KEY_PATH")
  path = raw.start_with?("/") ? raw : File.expand_path(raw, PROJECT_ROOT)
  UI.user_error!("ASC_KEY_PATH points to a missing file: #{path}") unless File.file?(path)
  path
end

# Creating the App Review detail requires the four reviewer-contact attributes
# (contactFirstName/LastName/Email/Phone, phone in +<country> format) — with
# only notes.txt, App Store Connect rejects the create. The contact (and the
# optional demo account) is PII/credentials, so it comes from env (CI
# environment secrets), never from files in git. When the env is absent the
# hash is nil and review info comes from fastlane/metadata alone — which only
# works once the review detail already exists in ASC.
# When App Store Connect refuses a submit with "not in valid state", the error
# names no resource — these states are the difference between diagnosing from
# the run log and guessing.
def log_submission_diagnostics(version:, submission:)
  state = version.app_version_state || version.app_store_state
  UI.message("version #{version.id}: state=#{state}, string=#{version.version_string}")
  attached = version.build
  if attached
    UI.message("attached build #{attached.version}: processing_state=#{attached.processing_state}, expired=#{attached.expired}")
  else
    UI.message("attached build: none")
  end
  UI.message("review submission #{submission.id}: state=#{submission.state}")
  submission.items.to_a.each do |item|
    UI.message("  item #{item.id}: state=#{item.state}")
  end
end

def review_information_from_env
  contact_keys = %w[ASC_REVIEW_FIRST_NAME ASC_REVIEW_LAST_NAME ASC_REVIEW_EMAIL ASC_REVIEW_PHONE]
  return nil unless contact_keys.all? { |k| ENV[k].to_s.strip != "" }

  {
    first_name: ENV.fetch("ASC_REVIEW_FIRST_NAME"),
    last_name: ENV.fetch("ASC_REVIEW_LAST_NAME"),
    email_address: ENV.fetch("ASC_REVIEW_EMAIL"),
    phone_number: ENV.fetch("ASC_REVIEW_PHONE"),
    demo_user: ENV["ASC_REVIEW_DEMO_USER"],
    demo_password: ENV["ASC_REVIEW_DEMO_PASSWORD"],
    notes: File.read(File.join(PROJECT_ROOT, "fastlane", "metadata", "review_information", "notes.txt")),
  }.compact
end

# The TestFlight publish workflow stamps CFBundleShortVersionString as
# <major.minor>.<build>; an App Store version record must carry the identical
# string or App Store Connect refuses to attach that build to it.
def version_string_for(build)
  build = build.to_s
  UI.user_error!("Pass the TestFlight build number, e.g. `build:68` — got: #{build.inspect}") unless build.match?(/\A\d+\z/)

  spec = File.read(File.join(PROJECT_ROOT, SPEC))
  base = spec[/MARKETING_VERSION:\s*"(\d+\.\d+)(?:\.\d+)?"/, 1]
  UI.user_error!("Could not read MARKETING_VERSION from #{SPEC}") unless base
  "#{base}.#{build}"
end

# App Store Connect only surfaces an uploaded screenshot to its own read API once
# its media pipeline has processed it, and deliver reads that window as "the
# upload went missing" and re-uploads every file without removing the copies
# already in flight — 1.0.67 went live with all four screenshots doubled (run
# 28878621545). deliver cannot notice the result either: its check asks whether
# each local file is present remotely, which a duplicated set satisfies. So the
# listing is read back below and reconciled against the committed files instead.
SCREENSHOT_SETTLE_TIMEOUT = 900
SCREENSHOT_POLL_INTERVAL = 15
SCREENSHOT_REPAIR_PASSES = 3

# locale => { file name => MD5 }, the digest App Store Connect reports back as
# sourceFileChecksum.
def committed_screenshots
  root = File.join(PROJECT_ROOT, "fastlane", "screenshots")
  locales = Dir.children(root).select { |entry| File.directory?(File.join(root, entry)) }
  locales.sort.to_h do |locale|
    names = Dir.children(File.join(root, locale)).grep(/\.png\z/).sort
    [locale, names.to_h { |name| [name, Digest::MD5.hexdigest(File.binread(File.join(root, locale, name)))] }]
  end
end

def verify_screenshots!(repair:)
  expected = committed_screenshots
  UI.user_error!("No screenshots under fastlane/screenshots to verify the listing against") if expected.empty?

  app = Spaceship::ConnectAPI::App.find(APP_ID)
  UI.user_error!("No App Store Connect app record for #{APP_ID}") unless app
  version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
  UI.user_error!("No editable App Store version to verify screenshots on — pass build:<n> so the lane creates one") unless version

  localizations = version.get_app_store_version_localizations
  expected.each do |locale, files|
    localization = localizations.find { |l| l.locale == locale }
    UI.user_error!("Version #{version.version_string} has no #{locale} localization") unless localization
    verify_locale_screenshots!(localization: localization, locale: locale, files: files, repair: repair)
  end
  UI.success("Screenshot verify PASS — #{version.version_string} matches fastlane/screenshots")
end

def verify_locale_screenshots!(localization:, locale:, files:, repair:)
  display_type = Spaceship::ConnectAPI::AppScreenshotSet::DisplayType::APP_IPHONE_67
  deadline = Time.now + SCREENSHOT_SETTLE_TIMEOUT
  repairs = 0
  removed = 0

  loop do
    sets = localization.get_app_screenshot_sets(includes: "appScreenshots")
    types = sets.map(&:screenshot_display_type).sort
    UI.user_error!("#{locale}: expected one #{display_type} screenshot set, found #{types.inspect}") unless types == [display_type]

    shots = (sets.first.app_screenshots || []).to_a
    rejected = shots.select(&:error?)
    UI.user_error!("#{locale}: App Store Connect rejected #{rejected.map(&:file_name).inspect} — #{rejected.flat_map(&:error_messages).inspect}") if rejected.any?

    pending = shots.reject(&:complete?)
    duplicates = shots.select(&:complete?).group_by(&:file_name).values.flat_map { |group| group.drop(1) }

    # Judge the set only once nothing is still in flight, so a screenshot the API
    # has not caught up with yet is never mistaken for a missing one — the exact
    # misread that produced the duplicates.
    if duplicates.any? && pending.empty?
      UI.user_error!("#{locale}: the listing carries duplicates #{duplicates.map(&:file_name).tally.inspect} — re-run Publish iOS App Store metadata with screenshots:true") unless repair
      UI.user_error!("#{locale}: duplicates returned after #{repairs} repair passes — inspect the listing in App Store Connect") if repairs >= SCREENSHOT_REPAIR_PASSES

      # Everything dropped here shares its file name, and so its content, with a
      # copy that stays: the set can only lose duplicates, never a screenshot.
      duplicates.each do |shot|
        UI.important("#{locale}: removing duplicate #{shot.file_name} (#{shot.id})")
        shot.delete!
      end
      repairs += 1
      removed += duplicates.size
      sleep(SCREENSHOT_POLL_INTERVAL)
      next
    end

    if pending.any?
      UI.user_error!("#{locale}: #{pending.map(&:file_name).inspect} never finished processing — check the PNGs are opaque RGB (see TESTFLIGHT.md)") if Time.now >= deadline
      UI.message("#{locale}: waiting for #{pending.size} screenshot(s) to finish processing")
      sleep(SCREENSHOT_POLL_INTERVAL)
      next
    end

    listed = shots.to_h { |shot| [shot.file_name, shot.source_file_checksum] }
    UI.user_error!("#{locale}: the listing shows #{listed.keys.sort.inspect}, want #{files.keys.inspect}") unless listed.keys.sort == files.keys
    altered = files.reject { |name, checksum| listed[name] == checksum }.keys
    UI.user_error!("#{locale}: #{altered.inspect} do not match the committed files") if altered.any?

    # deliver reorders the set by natural file name as its last upload step, so
    # order drifting is cosmetic next to the duplication this exists to catch.
    order = shots.map(&:file_name)
    UI.important("#{locale}: listing order is #{order.inspect}, committed order is #{files.keys.inspect}") unless order == files.keys

    UI.success("#{locale}: #{order.size} screenshots match fastlane/screenshots/#{locale}#{removed.positive? ? " (#{removed} duplicate(s) removed)" : ''}")
    return
  end
end

platform :ios do
  desc "Build an App Store-signed .ipa and upload it to TestFlight (INTERNAL testers only)."
  desc "Re-runnable end to end. Requires the one-time portal/repo setup in TESTFLIGHT.md."
  lane :beta do
    team_id = ENV.fetch("TEAM_ID")

    # On CI, create a temporary keychain for match to import the distribution
    # certificate into (the runner has no unlocked login keychain). No-op locally.
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: asc_key_filepath,
      duration: 1200,
      in_house: false,
    )

    # Regenerate the project from the XcodeGen spec (the source of truth) so a
    # stale committed .xcodeproj can never drive signing or the build. The script
    # also downshifts the project format so the installed Xcode can open it.
    sh("bash", File.join(PROJECT_ROOT, "scripts", "generate-project.sh"))

    # iOS Distribution certificate + an App Store profile for BOTH bundle ids,
    # stored encrypted in the match git repo. Both App IDs must already exist in
    # the Developer portal with the App Groups capability enabled and the group
    # assigned, or the generated profiles will not carry the app-group
    # entitlement (see TESTFLIGHT.md).
    # CI fetches the already-seeded cert/profiles (readonly) and authenticates to
    # the match repo over HTTPS via MATCH_GIT_BASIC_AUTHORIZATION; a local first
    # run may create them, using your own git/SSH credentials.
    match(
      type: "appstore",
      app_identifier: SIGNED_TARGETS.map { |t| t[:bundle_id] },
      api_key: api_key,
      readonly: ENV["CI"] == "true",
    )

    profiles = SIGNED_TARGETS.map { |t|
      [t[:bundle_id], ENV.fetch("sigh_#{t[:bundle_id]}_appstore_profile-name")]
    }.to_h

    # Point each target at its match profile with MANUAL signing. Done from the
    # CLI because the Signing & Capabilities GUI is unavailable on this machine.
    SIGNED_TARGETS.each do |t|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: PROJECT_PATH,
        team_id: team_id,
        targets: [t[:target]],
        code_sign_identity: "Apple Distribution",
        profile_name: profiles.fetch(t[:bundle_id]),
        build_configurations: ["Release"],
      )
    end

    # CI passes the build counter as both the build number and the marketing patch
    # (CFBundleVersion must increase per upload; CFBundleShortVersionString tracks it
    # as <major.minor>.<build>). Locally neither is set and the project.yml defaults are used.
    build_number = ENV["APP_BUILD_NUMBER"]
    marketing    = ENV["APP_MARKETING_VERSION"]

    # A TestFlight upload can't be cleanly unpublished, so a malformed version from
    # CI must abort HERE — before build_app/upload_to_testflight — rather than be
    # baked into CFBundleVersion/CFBundleShortVersionString and shipped. nil means
    # "not set" (local make ipa) and correctly falls through to the project.yml
    # defaults; only a present-but-malformed value is a hard error.
    if build_number && !build_number.match?(/\A\d+\z/)
      UI.user_error!("APP_BUILD_NUMBER must be a plain integer (CFBundleVersion), got: #{build_number.inspect}")
    end
    if marketing && !marketing.match?(/\A\d+(\.\d+){0,2}\z/)
      UI.user_error!("APP_MARKETING_VERSION must be 1-3 dot-separated integers (CFBundleShortVersionString), got: #{marketing.inspect}")
    end

    version_args = [
      build_number && "CURRENT_PROJECT_VERSION=#{build_number}",
      marketing    && "MARKETING_VERSION=#{marketing}",
    ].compact.join(" ")

    build_app(
      project: PROJECT_PATH,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      output_directory: OUTPUT_DIR,
      output_name: OUTPUT_NAME,
      export_method: "app-store",
      skip_profile_detection: true,
      xcargs: version_args.empty? ? nil : version_args,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: profiles,
      },
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      distribute_external: false,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Set the TestFlight What to Test note on a build that is ALREADY uploaded. The text comes"
  desc "from fastlane/metadata/en-US/release_notes.txt, the same file the App Store listing reads,"
  desc "so TestFlight and the store listing cannot drift apart. Uploads no binary and submits"
  desc "nothing. Re-runnable. Usage: `bundle exec fastlane whats_new build:104`."
  lane :whats_new do |options|
    build = options[:build].to_s
    version_string = version_string_for(build)

    notes_path = File.join(PROJECT_ROOT, "fastlane", "metadata", "en-US", "release_notes.txt")
    notes = File.read(notes_path).strip
    UI.user_error!("#{notes_path} is empty — there is no What to Test text to set") if notes.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: asc_key_filepath,
      duration: 1200,
      in_house: false,
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      distribute_only: true,
      app_platform: "ios",
      app_version: version_string,
      build_number: build,
      changelog: notes,
      skip_submission: true,
    )

    UI.success("Set What to Test on #{version_string} (build #{build}) from #{notes_path}")
  end

  desc "Read-only preflight: verify API-key auth and the one-time portal prerequisites"
  desc "(both bundle ids registered with App Groups, and the App Store Connect app record)."
  lane :preflight do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: asc_key_filepath,
    )
    Spaceship::ConnectAPI::App.all(limit: 1)
    UI.success("API key authenticates")

    all = Spaceship::ConnectAPI::BundleId.all
    SIGNED_TARGETS.each do |t|
      b = all.find { |x| x.identifier == t[:bundle_id] }
      next UI.error("Bundle ID #{t[:bundle_id]} is NOT registered") if b.nil?

      UI.success("Bundle ID #{t[:bundle_id]} registered")
      caps = (b.get_capabilities rescue [])
      if caps.any? { |c| (c.capability_type rescue nil) == "APP_GROUPS" }
        UI.success("  App Groups capability ON")
      else
        UI.error("  App Groups capability OFF — the share extension needs it")
      end
    end

    app = (Spaceship::ConnectAPI::App.find(APP_ID) rescue nil)
    if app
      UI.success("App Store Connect app record exists: #{app.name}")
    else
      UI.error("No App Store Connect app record for #{APP_ID} (My Apps → +)")
    end
  end

  desc "Upload the App Store listing metadata (fastlane/metadata) to App Store Connect as a"
  desc "DRAFT. Never submits for review and never uploads a binary: the build comes from the"
  desc "beta lane, and submitting is the resubmit lane's job, dispatched by a human. Pass"
  desc "`screenshots:true` to also push fastlane/screenshots, which is then read back and"
  desc "verified against the committed files. Pass `build:<n>` to create the matching version"
  desc "record when nothing sits in 'Prepare for Submission' — screenshots on a released"
  desc "version cannot be edited, so fixing them needs a new version. Uses the same"
  desc "fastlane/.env API key the beta lane does."
  lane :release do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: asc_key_filepath,
      duration: 1200,
      in_house: false,
    )

    params = {
      api_key: api_key,
      app_identifier: APP_ID,
      # The binary is uploaded by the beta lane; this lane only manages the listing.
      skip_binary_upload: true,
      # Screenshots are opt-in so a metadata-only push doesn't require them to exist yet.
      skip_screenshots: options[:screenshots] != true,
      overwrite_screenshots: options[:screenshots] == true,
      # Never auto-submit or run precheck: submitting for review is the resubmit
      # lane's job, and only ever on a human's explicit dispatch.
      submit_for_review: false,
      run_precheck_before_submit: false,
      # Non-interactive: skip the HTML preview confirmation prompt.
      force: true,
      precheck_include_in_app_purchases: false,
      # cwd is fastlane/, so anchor the trees to the project root explicitly.
      metadata_path: File.join(PROJECT_ROOT, "fastlane", "metadata"),
      screenshots_path: File.join(PROJECT_ROOT, "fastlane", "screenshots"),
      app_review_information: review_information_from_env,
    }

    # Given a build, deliver creates the <major.minor>.<build> version record (or
    # renames the open draft to it) before touching the listing, so the lane no
    # longer depends on someone opening one by hand in App Store Connect first.
    build = options[:build].to_s.strip
    params[:app_version] = version_string_for(build) unless build.empty?

    upload_to_app_store(**params)

    verify_screenshots!(repair: true) if options[:screenshots] == true
  end

  desc "Submit (or resubmit after a rejection) a TestFlight build for App Store review:"
  desc "set the version record's string to <major.minor>.<build>, attach the build, push"
  desc "the listing metadata (including the review notes), and submit. Reuses the"
  desc "rejection's still-open review submission — a rejection leaves it in"
  desc "UNRESOLVED_ISSUES, and App Store Connect refuses a second open submission per"
  desc "platform. Usage: `bundle exec fastlane resubmit build:67`. Submitting stays a"
  desc "deliberate human act: this lane runs only from the manually-dispatched resubmit"
  desc "workflow or a developer's shell, never from the on-push CI pipeline."
  lane :resubmit do |options|
    build = options[:build].to_s
    version_string = version_string_for(build)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: asc_key_filepath,
      duration: 1200,
      in_house: false,
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      app_version: version_string,
      skip_binary_upload: true,
      skip_screenshots: true,
      # deliver's own submit path refuses while the rejected submission is still
      # open (UNRESOLVED_ISSUES counts as in progress), so submission happens
      # below by reusing that record.
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: File.join(PROJECT_ROOT, "fastlane", "metadata"),
      app_review_information: review_information_from_env,
    )

    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("No App Store Connect app record for #{APP_ID}") unless app
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable App Store version to submit — create one in App Store Connect first") unless version

    # A new version record inherits the released version's screenshots and this
    # lane never pushes screenshots, so a listing that is already wrong would
    # sail back into review unnoticed — 1.0.67 was approved carrying every
    # screenshot twice. Submitting is the last point where that can be caught.
    # Repairing is the release lane's job, hence read-only here.
    verify_screenshots!(repair: false)

    # deliver honours build_number only inside its own submit path, which this
    # lane bypasses — run 29975411270's diagnostics showed the rejected build
    # still attached after four "successful" metadata pushes. Attach explicitly.
    candidate = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: version_string,
      build_number: build,
      processing_states: "VALID",
    ).first
    UI.user_error!("No processed TestFlight build #{build} (#{version_string}) in App Store Connect") unless candidate
    Spaceship::ConnectAPI.patch_app_store_version_with_build(app_store_version_id: version.id, build_id: candidate.id)
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)

    platform = Spaceship::ConnectAPI::Platform::IOS
    submission = app.get_in_progress_review_submission(platform: platform, includes: "items")
    if submission && submission.state != Spaceship::ConnectAPI::ReviewSubmission::ReviewSubmissionState::UNRESOLVED_ISSUES
      UI.user_error!("A review submission is already #{submission.state} — resolve it in App Store Connect first")
    end

    if submission && submission.items.to_a.any? { |item| item.state == "REJECTED" }
      # A rejected item stays REJECTED even once its version is fixed and a new
      # build attached (run 29975701128: version PREPARE_FOR_SUBMISSION, build
      # VALID, submit still refused), and this fastlane version has no API to
      # shed a single item — so the submission is replaced wholesale.
      UI.message("Cancelling review submission #{submission.id} — its item is REJECTED")
      submission.cancel_submission
      submission = nil
      # Cancellation drains asynchronously and ASC refuses a new submission
      # until it completes; UNRESOLVED_ISSUES may linger briefly pre-flip.
      waited = 0
      until app.get_review_submissions(filter: { state: "CANCELING,UNRESOLVED_ISSUES", platform: platform }).to_a.empty?
        UI.user_error!("Cancelled review submission is still draining after 5 minutes — re-run once it settles") if waited >= 300
        sleep(10)
        waited += 10
      end
    end

    submission ||= app.get_ready_review_submission(platform: platform, includes: "items")
    submission ||= app.create_review_submission(platform: platform)
    if submission.items.to_a.empty?
      submission.add_app_store_version_to_review_items(app_store_version_id: version.id)
    end
    log_submission_diagnostics(version: version, submission: submission)

    # ASC wires a freshly attached build into the version asynchronously, and a
    # submit inside that window is refused with "Version is not ready to be
    # submitted yet, please try again later" — so take the error at its word.
    attempts = 0
    begin
      submission.submit_for_review
    rescue Spaceship::UnexpectedResponse => e
      raise unless e.to_s.include?("not ready to be submitted")
      attempts += 1
      raise if attempts >= 5
      UI.message("Version not ready to submit yet (attempt #{attempts}/5) — waiting 60s")
      sleep(60)
      version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
      log_submission_diagnostics(version: version, submission: submission)
      retry
    end
    UI.success("Submitted #{version_string} (build #{build}) for App Review")
  end
end
