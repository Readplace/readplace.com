{
  "name": "android",
  "projectType": "application",
  "targets": {
    "compile": {
      "command": "make apk",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "compile-dev": {
      "command": "make apk-staging",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "check": {
      "command": "make test",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": []
    }
  }
}
