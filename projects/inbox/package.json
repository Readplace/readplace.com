{
  "name": "inbox",
  "version": "1.0.0",
  "description": "Newsletter inbox deployable: /inbox pages plus the email receive/extract/preview pipeline, behind hutch's API Gateway.",
  "main": "src/infra/index.ts",
  "private": true,
  "scripts": {
    "check": "nx run inbox:check",
    "check-infra": "PULUMI_CONFIG_PASSPHRASE='' pulumi preview --stack \"${PULUMI_STACK:?PULUMI_STACK is not set}\"",
    "compile": "rm -rf dist && tsc && node scripts/build-client-bundles.js && node scripts/copy-static-assets.js",
    "dev": "node scripts/build-client-bundles.js && tsx watch src/runtime/server.main.ts",
    "lint": "concurrently --kill-others-on-fail \"tsc --project tsconfig.lint.json\" \"biome lint src\" \"knip\" \"editorconfig-checker\"",
    "start": "node dist/runtime/server.main.js",
    "test": "jest --testMatch='**/dist/**/*.test.js' --testTimeout=10000",
    "test-with-coverage": "c8 node scripts/run-tests-with-coverage.js && node enforce-coverage.config.js",
    "test:e2e": "pnpm compile && E2E_PORT=3120 playwright test --config playwright.config.local-dev.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1057.0",
    "@aws-sdk/client-sqs": "3.1057.0",
    "@packages/ai-message": "workspace:*",
    "@packages/article-parser": "workspace:*",
    "@packages/article-resource-unique-id": "workspace:*",
    "@packages/article-store": "workspace:*",
    "@packages/crawl-article": "workspace:*",
    "@packages/dead-letter-routing": "workspace:*",
    "@packages/domain": "workspace:*",
    "@packages/finalize-article": "workspace:*",
    "@packages/hutch-infra-components": "workspace:*",
    "@packages/hutch-logger": "workspace:*",
    "@packages/hutch-storage-client": "workspace:*",
    "@packages/inbox-store": "workspace:*",
    "@packages/provider-contracts": "workspace:*",
    "@packages/require-env": "workspace:*",
    "@packages/subscription-access": "workspace:*",
    "@packages/web-session": "workspace:*",
    "@packages/find-available-port": "workspace:*",
    "@packages/web-shell": "workspace:*",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.2.0",
    "linkedom": "0.18.12",
    "openai": "6.39.1",
    "serverless-http": "4.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@packages/e2e-harness": "workspace:*",
    "@packages/test-fixtures": "workspace:*",
    "@packages/test-phase-runner": "workspace:*",
    "@packages/web-test-harness": "workspace:*",
    "@playwright/test": "1.60.0",
    "@pulumi/aws": "7.32.0",
    "@pulumi/pulumi": "3.244.0",
    "@types/aws-lambda": "8.10.161",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.19",
    "@types/supertest": "7.2.0",
    "c8": "11.0.0",
    "concurrently": "10.0.0",
    "editorconfig-checker": "6.1.1",
    "esbuild": "catalog:",
    "htmx.org": "2.0.8",
    "jest": "30.4.2",
    "jsdom": "26.1.0",
    "supertest": "7.2.2",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
