{
  "name": "subscriptions",
  "version": "1.0.0",
  "description": "Subscription service — Stripe handlers, write providers, and the per-user subscription HTML fragments hutch embeds",
  "main": "src/runtime/lambda.main.ts",
  "private": true,
  "scripts": {
    "compile": "rm -rf dist && tsc",
    "test": "jest --testMatch='**/dist/**/*.test.js' --testTimeout=10000",
    "test-with-coverage": "c8 pnpm test && node enforce-coverage.config.js",
    "lint": "tsc --project tsconfig.lint.json && concurrently --kill-others-on-fail \"biome lint src\" \"knip\"",
    "check": "nx run subscriptions:check"
  },
  "dependencies": {
    "@packages/hutch-logger": "workspace:*",
    "@packages/require-env": "workspace:*",
    "compression": "1.8.1",
    "express": "5.2.1",
    "helmet": "8.2.0",
    "serverless-http": "4.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.161",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.19",
    "@types/supertest": "7.2.0",
    "c8": "11.0.0",
    "concurrently": "10.0.0",
    "jest": "30.4.2",
    "supertest": "7.2.2",
    "typescript": "6.0.3"
  }
}
