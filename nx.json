{
  "$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/nx-schema.json",
  "tui": {
    "enabled": false
  },
  "plugins": [
    {
      "plugin": "nx/plugins/package-json"
    }
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/*.config.base.*",
      "{workspaceRoot}/jest.setup.base.js",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.envrc",
      "{workspaceRoot}/projects/hutch/Pulumi.prod.yaml",
      "{workspaceRoot}/projects/save-link/Pulumi.prod.yaml"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/jest.config.js"
    ]
  },
  "targetDefaults": {
    "test": {
      "inputs": [
        "default",
        "^production",
        {
          "env": "CLAUDE_CODE_REMOTE"
        }
      ],
      "cache": true
    },
    "test-with-coverage": {
      "inputs": [
        "default",
        "^production",
        {
          "env": "CLAUDE_CODE_REMOTE"
        }
      ],
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "cache": true
    },
    "compile": {
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^compile"
      ],
      "cache": true
    },
    "lint": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "check": {
      "inputs": [
        "default",
        "^production",
        {
          "env": "CLAUDE_CODE_REMOTE"
        }
      ],
      "dependsOn": [
        "compile",
        "^compile"
      ],
      "cache": true
    },
    "check-infra": {
      "inputs": [
        "production",
        "^production"
      ],
      "dependsOn": [
        "^compile"
      ],
      "cache": false
    },
    "deploy-infra": {
      "inputs": [
        "production",
        "^production"
      ],
      "dependsOn": [
        "^compile"
      ],
      "cache": false
    }
  },
  "defaultBase": "main",
  "analytics": false
}
