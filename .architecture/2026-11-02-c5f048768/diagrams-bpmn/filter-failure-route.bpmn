<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_filter_failure_route" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_filter_failure_route" name="filter-failure-route" isExecutable="false">
    <bpmn:startEvent id="n_T" name="EmailLinksTriagedEvent">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_Q" name="filter-email-links queue">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_H" name="filter-email-links Lambda">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_F" name="FileArticleIntoReadlistCommand, per kept link">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_D" name="EmailLinksFilteredEvent">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_R" name="Fail the record so the queue retries">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_M" name="Publish the failed fact, then fail the record">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_X" name="EmailLinksFilterFailedEvent">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_N" name="filter-email-links-dlq">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_A" name="filter-email-links-dlq-alarm">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_S" name="save-link-failures-dlq">
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_C" name="Shared failures consumer: crawl and submit routes only">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_T" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Q" targetRef="n_H" />
    <bpmn:sequenceFlow id="f_2" name="decided" sourceRef="n_H" targetRef="n_F" />
    <bpmn:sequenceFlow id="f_3" name="decided" sourceRef="n_H" targetRef="n_D" />
    <bpmn:sequenceFlow id="f_4" name="failed, receive 1" sourceRef="n_H" targetRef="n_R" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_R" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_6" name="failed, receive 2" sourceRef="n_H" targetRef="n_M" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_M" targetRef="n_X" />
    <bpmn:sequenceFlow id="f_8" name="out of receives" sourceRef="n_Q" targetRef="n_N" />
    <bpmn:sequenceFlow id="f_9" name="rule cannot deliver" sourceRef="n_T" targetRef="n_N" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_N" targetRef="n_A" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_S" targetRef="n_C" />
  </bpmn:process>
