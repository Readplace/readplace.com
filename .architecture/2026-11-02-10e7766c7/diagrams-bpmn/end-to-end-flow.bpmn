        <dc:Bounds x="829.5" y="562.25" width="194.25" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="525.88" y="96" />
        <di:waypoint x="525.88" y="126" />
