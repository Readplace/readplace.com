<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:serviceTask id="n_EXT" name="extract-email-links Lambda pre-saves every link to All">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SLC" name="SubmitLinkCommand per link to All">
      <bpmn:incoming>f_0</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="n_TRI" name="EmailLinksTriagedEvent per routed readlist">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_FQ" name="filter-email-links queue 360 s visibility, 2 receives">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_FIL" name="filter-email-links Lambda judges through DecideReadlistFit">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_DEF" name="readlist definitions user-articles table"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_DS" name="DeepSeek engine from READLIST_FIT_ENGINE">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_FAC" name="FileArticleIntoReadlistCommand per keep, or per link with no purpose">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_FILQ" name="file-article-into-readlist queue 300 s visibility, 5 receives">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_FILL" name="file-article-into-readlist Lambda">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_OUT" name="EmailLinksFilteredEvent fit, purposeVersion, engine, model">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_RQ" name="inbox-record-email-links-filtered queue">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_REC" name="inbox-record-email-links-filtered Lambda">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ROW" name="readlist#slug row decision, fit, purposeVersion, engine, model"></bpmn:dataStoreReference>
    <bpmn:task id="n_PAGE" name="Email page non-keep counts as didn't fit"></bpmn:task>
    <bpmn:sendTask id="n_GONE" name="SubmitLinkCommand from the filter removed">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_EXT" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_EXT" targetRef="n_TRI" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_TRI" targetRef="n_FQ" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_FQ" targetRef="n_FIL" />
    <bpmn:sequenceFlow id="f_5" name="one call per email and readlist" sourceRef="n_FIL" targetRef="n_DS" />
    <bpmn:sequenceFlow id="f_6" name="published first" sourceRef="n_FIL" targetRef="n_FAC" />
    <bpmn:sequenceFlow id="f_7" name="published last" sourceRef="n_FIL" targetRef="n_OUT" />
    <bpmn:sequenceFlow id="f_8" name="no longer published" sourceRef="n_FIL" targetRef="n_GONE" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_FAC" targetRef="n_FILQ" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_FILQ" targetRef="n_FILL" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_OUT" targetRef="n_RQ" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_RQ" targetRef="n_REC" />
    <bpmn:association id="f_4" sourceRef="n_FIL" targetRef="n_DEF" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_REC" targetRef="n_ROW" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_ROW" targetRef="n_PAGE" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_end_to_end_flow">
    <bpmndi:BPMNPlane id="Plane_end_to_end_flow" bpmnElement="Process_end_to_end_flow">
      <bpmndi:BPMNShape id="n_EXT_di" bpmnElement="n_EXT">
        <dc:Bounds x="428.63" y="28" width="194.5" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SLC_di" bpmnElement="n_SLC">
        <dc:Bounds x="348.96" y="156" width="182.75" height="68" />
