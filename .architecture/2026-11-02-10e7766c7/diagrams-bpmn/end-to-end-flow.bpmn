      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_RQ_di" bpmnElement="n_RQ">
        <dc:Bounds x="595.49" y="710.5" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_REC_di" bpmnElement="n_REC">
        <dc:Bounds x="536.75" y="854" width="203" height="52" />
