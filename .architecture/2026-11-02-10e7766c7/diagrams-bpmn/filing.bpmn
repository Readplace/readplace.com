<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_filing" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_filing" name="filing" isExecutable="false">
    <bpmn:sendTask id="n_FAC" name="FileArticleIntoReadlistCommand now published by the filter">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="file-article-into-readlist queue 300 s visibility, 5 receives">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_L" name="file-article-into-readlist Lambda">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_FIND" name="link's article in All? follows the alias to the canonical">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_WAIT" name="ArticleNotYetSavedError info line, record fails, redelivery">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_FILE" name="fileArticleIntoReadlist">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ART" name="user-articles readlist membership"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_EV" name="ArticleFiledIntoReadlistEvent no subscriber yet">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_DLQ" name="file-article-into-readlist DLQ alert email">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_FAC" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Q" targetRef="n_L" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_L" targetRef="n_FIND" />
    <bpmn:sequenceFlow id="f_3" name="not saved" sourceRef="n_FIND" targetRef="n_WAIT" />
    <bpmn:sequenceFlow id="f_4" name="redelivered" sourceRef="n_WAIT" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_5" name="saved" sourceRef="n_FIND" targetRef="n_FILE" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_FILE" targetRef="n_EV" />
    <bpmn:sequenceFlow id="f_8" name="after 5 receives" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:association id="f_6" sourceRef="n_FILE" targetRef="n_ART" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_filing">
    <bpmndi:BPMNPlane id="Plane_filing" bpmnElement="Process_filing">
      <bpmndi:BPMNShape id="n_FAC_di" bpmnElement="n_FAC">
