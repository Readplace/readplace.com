    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_CALL" targetRef="n_L1" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_CALL" targetRef="n_V" />
    <bpmn:sequenceFlow id="f_9" name="keep" sourceRef="n_V" targetRef="n_FK" />
    <bpmn:sequenceFlow id="f_10" name="drop" sourceRef="n_V" targetRef="n_NOFILE" />
    <bpmn:sequenceFlow id="f_11" name="unsure" sourceRef="n_V" targetRef="n_NOFILE" />
    <bpmn:sequenceFlow id="f_12" name="unsure" sourceRef="n_V" targetRef="n_L2" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_NOP" targetRef="n_FNP" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_FK" targetRef="n_EV" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_FNP" targetRef="n_EV" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_NOFILE" targetRef="n_EV" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_MISS" targetRef="n_EV" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_EMPTY" targetRef="n_EV" />
  </bpmn:process>
