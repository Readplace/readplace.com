<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_filter_branches" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_filter_branches" name="filter-branches" isExecutable="false">
    <bpmn:serviceTask id="n_IN" name="Parsed EmailLinksTriagedEvent the All readlist is asserted out">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_D1" name="readlist defined?">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_D2" name="purpose stored?">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_D3" name="any links?">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_CALL" name="decideReadlistFit purpose fields and version, examples empty, candidates by ordinal, subject and sender">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_V" name="verdict per link">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_MISS" name="readlist-missing label All, files nothing">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_NOP" name="no-purpose">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_EMPTY" name="filtered, fit empty purposeVersion set">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_FNP" name="FileArticleIntoReadlistCommand kind no-purpose, email source">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_FK" name="FileArticleIntoReadlistCommand verdict keep, reason, purposeVersion, email source">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_NOFILE" name="No filing recorded in fit">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_L1" name="readlist-fit-decided line one per call">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_L2" name="readlist-fit-unsure line one per unsure link">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_EV" name="EmailLinksFilteredEvent">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_IN" targetRef="n_D1" />
    <bpmn:sequenceFlow id="f_1" name="no" sourceRef="n_D1" targetRef="n_MISS" />
    <bpmn:sequenceFlow id="f_2" name="yes" sourceRef="n_D1" targetRef="n_D2" />
    <bpmn:sequenceFlow id="f_3" name="no" sourceRef="n_D2" targetRef="n_NOP" />
