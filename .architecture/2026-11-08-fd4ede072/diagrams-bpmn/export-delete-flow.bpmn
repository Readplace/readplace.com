<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_export_delete_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_export_delete_flow" name="export-delete-flow" isExecutable="false">
    <bpmn:serviceTask id="n_ExportRoute" name="POST /export/start">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_DeleteRoute" name="POST account delete"></bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_MarkDeleted" name="users row: deletedAt set"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_ExportCmd" name="ExportUserDataCommand userId, requestedAt (email removed)">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_DeleteCmd" name="DeleteAccountCommand userId">
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_Bus" name="[&quot;EventBridge bus detail-type rules">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_JobsQ" name="[&quot;user-data-jobs-q batch 1, 12 receives">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_JobsDlq" name="[&quot;user-data-jobs-dlq">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_Lambda" name="user-data-jobs Lambda dispatch by detail type">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ExportHandler" name="export handler gate 1, build, upload, gate 2, send, mark">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_DeleteHandler" name="delete-account handler idempotent, unchanged">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Users" name="users table exportDeliveredRequestedAt"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Bucket" name="export bucket exports/userId/"></bpmn:dataStoreReference>
    <bpmn:task id="n_Resend" name="Resend: export link to the live row's address">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="n_Exported" name="UserDataExported">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_Skipped" name="UserDataExportSkipped account-gone, account-deleting, already-delivered">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_ExportRoute" targetRef="n_ExportCmd" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_ExportCmd" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_DeleteCmd" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Bus" targetRef="n_JobsQ" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_JobsQ" targetRef="n_Lambda" />
    <bpmn:sequenceFlow id="f_7" name="after 12 receives" sourceRef="n_JobsQ" targetRef="n_JobsDlq" />
    <bpmn:sequenceFlow id="f_8" name="redrive, any order" sourceRef="n_JobsDlq" targetRef="n_JobsQ" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_Lambda" targetRef="n_ExportHandler" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Lambda" targetRef="n_DeleteHandler" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_ExportHandler" targetRef="n_Resend" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_ExportHandler" targetRef="n_Exported" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_ExportHandler" targetRef="n_Skipped" />
    <bpmn:association id="f_1" sourceRef="n_DeleteRoute" targetRef="n_MarkDeleted" associationDirection="One" />
    <bpmn:association id="f_2" sourceRef="n_MarkDeleted" targetRef="n_DeleteCmd" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_ExportHandler" targetRef="n_Users" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_ExportHandler" targetRef="n_Bucket" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_DeleteHandler" targetRef="n_Users" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_DeleteHandler" targetRef="n_Bucket" associationDirection="One" />
  </bpmn:process>
