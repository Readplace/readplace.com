<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_export_gates" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_export_gates" name="export-gates" isExecutable="false">
    <bpmn:sendTask id="n_Cmd" name="ExportUserDataCommand"></bpmn:sendTask>
    <bpmn:dataStoreReference id="n_Read1" name="findExportRecipient index query + consistent GetItem"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_Gate1" name="gate 1: decide delivery">
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_Build" name="read articles, readlists, engagement; upload JSON">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Read2" name="findExportRecipient again"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_Gate2" name="gate 2: decide delivery">
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_Send" name="sendEmail to the decided address">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Mark" name="markExportDelivered conditional on same user and an older marker"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_Exported" name="UserDataExported">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="n_Refused" name="reason">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_Purge" name="deleteUserExports(userId)"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_Skipped" name="UserDataExportSkipped">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_2" name="deliver" sourceRef="n_Gate1" targetRef="n_Build" />
    <bpmn:sequenceFlow id="f_5" name="deliver" sourceRef="n_Gate2" targetRef="n_Send" />
    <bpmn:sequenceFlow id="f_8" name="refused" sourceRef="n_Gate1" targetRef="n_Refused" />
    <bpmn:sequenceFlow id="f_9" name="refused" sourceRef="n_Gate2" targetRef="n_Refused" />
    <bpmn:sequenceFlow id="f_12" name="already-delivered" sourceRef="n_Refused" targetRef="n_Skipped" />
    <bpmn:association id="f_0" sourceRef="n_Cmd" targetRef="n_Read1" associationDirection="One" />
    <bpmn:association id="f_1" sourceRef="n_Read1" targetRef="n_Gate1" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_Build" targetRef="n_Read2" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_Read2" targetRef="n_Gate2" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_Send" targetRef="n_Mark" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_Mark" targetRef="n_Exported" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_Refused" targetRef="n_Purge" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_Purge" targetRef="n_Skipped" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_export_gates">
    <bpmndi:BPMNPlane id="Plane_export_gates" bpmnElement="Process_export_gates">
      <bpmndi:BPMNShape id="n_Cmd_di" bpmnElement="n_Cmd">
        <dc:Bounds x="120.41" y="28" width="188" height="48" />
