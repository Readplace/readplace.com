        <dc:Bounds x="223.28" y="1003.5" width="177.54" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Skipped_di" bpmnElement="n_Skipped">
        <dc:Bounds x="263.67" y="1140.5" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_2_di" bpmnElement="f_2">
        <di:waypoint x="214.41" y="370.5" />
        <di:waypoint x="214.41" y="446.5" />
