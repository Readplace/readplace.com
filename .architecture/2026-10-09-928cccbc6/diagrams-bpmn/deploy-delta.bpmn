      <bpmndi:BPMNShape id="n_DTABLE_di" bpmnElement="n_DTABLE">
        <dc:Bounds x="391.97" y="455.5" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_RETAIN_di" bpmnElement="n_RETAIN">
        <dc:Bounds x="552.29" y="458.75" width="190" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="grp_0_di" bpmnElement="grp_0">
        <dc:Bounds x="16" y="142.75" width="464.5" height="108" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="grp_1_di" bpmnElement="grp_1">
        <dc:Bounds x="204.63" y="142" width="882.63" height="438" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="551.63" y="96" />
        <di:waypoint x="551.63" y="125.38" />
        <di:waypoint x="135" y="125.38" />
