<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_deploy_delta" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_deploy_delta" name="deploy-delta" isExecutable="false">
    <bpmn:serviceTask id="n_DEPLOY" name="CI deploy of the hutch stack staging, then prod">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_UFN" name="user-data-jobs-handler environment loses DYNAMODB_DIGEST_QUEUE_TABLE, new code">
      <bpmn:incoming>f_0</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_UPOL" name="user-data-jobs DynamoDB role policy loses the digest-queue table ARN">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_DRULE" name="EventBridge rule and target reader-view-loading-succeeded">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_DQP" name="queue policy and DLQ policy reader-view-loading-succeeded">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_DESM" name="event source mapping reader-ready-fanout">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_DFN" name="Lambda reader-ready-fanout-handler role, basic execution, 3 inline policies, log subscription filter">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_DQ" name="reader-ready-fanout-q and reader-ready-fanout-dlq">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="n_DALARM" name="DLQ alarm, SNS topic and email subscription">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="n_DTABLE" name="DynamoDB hutch-digest-queue-staging and -prod no deletion protection, no PITR">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:dataStoreReference id="n_RETAIN" name="log group /aws/lambda/reader-ready-fanout-handler retained: leaves state, stays in AWS"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="updates apply first" sourceRef="n_DEPLOY" targetRef="n_UFN" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_DEPLOY" targetRef="n_UPOL" />
    <bpmn:sequenceFlow id="f_2" name="delivery" sourceRef="n_DEPLOY" targetRef="n_DRULE" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_DRULE" targetRef="n_DQP" />
    <bpmn:sequenceFlow id="f_4" name="worker" sourceRef="n_DEPLOY" targetRef="n_DESM" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_DESM" targetRef="n_DFN" />
    <bpmn:sequenceFlow id="f_6" name="queues and alerting" sourceRef="n_DEPLOY" targetRef="n_DQ" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_DQ" targetRef="n_DALARM" />
    <bpmn:sequenceFlow id="f_8" name="the table goes after everything that names it" sourceRef="n_DFN" targetRef="n_DTABLE" />
    <bpmn:sequenceFlow id="f_9" name="no longer names it" sourceRef="n_UPOL" targetRef="n_DTABLE" />
    <bpmn:association id="f_10" sourceRef="n_DFN" targetRef="n_RETAIN" associationDirection="One" />
    <bpmn:group id="grp_0" />
    <bpmn:group id="grp_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_deploy_delta">
    <bpmndi:BPMNPlane id="Plane_deploy_delta" bpmnElement="Process_deploy_delta">
      <bpmndi:BPMNShape id="n_DEPLOY_di" bpmnElement="n_DEPLOY">
        <dc:Bounds x="467.01" y="28" width="169.25" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_UFN_di" bpmnElement="n_UFN">
