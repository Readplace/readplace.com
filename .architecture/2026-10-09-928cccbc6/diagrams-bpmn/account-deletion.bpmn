<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_account_deletion" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_account_deletion" name="account-deletion" isExecutable="false">
    <bpmn:startEvent id="n_UI" name="POST /account/delete typed confirmation">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_WEB" name="web Lambda stamp deletedAt, destroy sessions, revoke OAuth tokens">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_DAC" name="DeleteAccountCommand">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_UDJQ" name="user-data-jobs-q visibility 900 s">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_UDJDLQ" name="user-data-jobs-dlq alarm and SNS email">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_UDJ" name="user-data-jobs Lambda no digest-queue grant or environment variable">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_EARLY" name="billing, per-user schedules, inbox, Gmail and readlist address claims">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ARTS" name="purge single-saver content, then delete the user's saved-article rows">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_UIDX" name="user-articles url-index other savers per URL"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_STARTER" name="withdraw the HN starter assignment">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RRS" name="delete the reader-ready slot row">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_RRN" name="hutch-reader-ready-notifications"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_REST" name="onboarding, exports, reset and verification tokens, pending signups">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CREDS" name="revoke IdP and OAuth tokens, destroy sessions, close the account, delete the subscription row">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_DONE" name="completion logged no event published">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="n_GONE" name="delete the user's digest-queue rows Query and DeleteItem on hutch-digest-queue">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_UI" targetRef="n_WEB" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_WEB" targetRef="n_DAC" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_DAC" targetRef="n_UDJQ" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_UDJQ" targetRef="n_UDJ" />
    <bpmn:sequenceFlow id="f_4" name="12 receives" sourceRef="n_UDJQ" targetRef="n_UDJDLQ" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_UDJ" targetRef="n_EARLY" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_EARLY" targetRef="n_ARTS" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_ARTS" targetRef="n_STARTER" />
    <bpmn:sequenceFlow id="f_9" name="removed step" sourceRef="n_ARTS" targetRef="n_GONE" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_STARTER" targetRef="n_RRS" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_RRS" targetRef="n_REST" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_REST" targetRef="n_CREDS" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_CREDS" targetRef="n_DONE" />
    <bpmn:association id="f_7" sourceRef="n_ARTS" targetRef="n_UIDX" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_RRS" targetRef="n_RRN" associationDirection="One" />
  </bpmn:process>
