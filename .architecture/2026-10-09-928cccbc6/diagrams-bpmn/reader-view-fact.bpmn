<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_reader_view_fact" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_reader_view_fact" name="reader-view-fact" isExecutable="false">
    <bpmn:sendTask id="n_GSC" name="GenerateSummaryCommand">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_GSQ" name="generate-summary queue">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_GS" name="save-link generate-summary Lambda markSummaryReady or markSummarySkipped">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ART" name="articles table summary axis"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_GATE" name="did this write move the reader view into succeeded?">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="n_SG" name="SummaryGeneratedEvent ready summaries only">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_SGC" name="existing save-link consumer unchanged">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_RVLS" name="ReaderViewLoadingSucceeded url, succeededAt, hasSummary">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_BUS" name="hutch event bus no rule matches the detail-type">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_DROP" name="accepted, delivered nowhere">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="n_QUIET" name="no reader-view fact re-summarise of a succeeded article">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_RULE" name="reader-view-loading-succeeded-rule target, queue policy, DLQ policy">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_FQ" name="reader-ready-fanout-q visibility 120 s"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_FDLQ" name="reader-ready-fanout-dlq alarm and SNS email">

      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_FL" name="reader-ready-fanout Lambda 512 MB, 60 s, batch 1">
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_DQT" name="hutch-digest-queue table userId and url, 30-day TTL">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:dataStoreReference id="n_UIDX" name="user-articles url-index stays: savers are still counted through it"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_GSC" targetRef="n_GSQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_GSQ" targetRef="n_GS" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_GS" targetRef="n_SG" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_SG" targetRef="n_SGC" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_GS" targetRef="n_GATE" />
    <bpmn:sequenceFlow id="f_6" name="yes" sourceRef="n_GATE" targetRef="n_RVLS" />
    <bpmn:sequenceFlow id="f_7" name="no" sourceRef="n_GATE" targetRef="n_QUIET" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_RVLS" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_BUS" targetRef="n_DROP" />
    <bpmn:sequenceFlow id="f_10" name="was" sourceRef="n_BUS" targetRef="n_RULE" />
    <bpmn:sequenceFlow id="f_15" name="PutItem per saver with viewedAt, when hasSummary" sourceRef="n_FL" targetRef="n_DQT" />
    <bpmn:association id="f_2" sourceRef="n_GS" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_RULE" targetRef="n_FQ" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_FQ" targetRef="n_FL" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_FQ" targetRef="n_FDLQ" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_FL" targetRef="n_UIDX" associationDirection="One" />
    <bpmn:group id="grp_0" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_reader_view_fact">
    <bpmndi:BPMNPlane id="Plane_reader_view_fact" bpmnElement="Process_reader_view_fact">
      <bpmndi:BPMNShape id="n_GSC_di" bpmnElement="n_GSC">
