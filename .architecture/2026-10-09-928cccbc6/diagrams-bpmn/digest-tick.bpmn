<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_digest_tick" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_digest_tick" name="digest-tick" isExecutable="false">
    <bpmn:serviceTask id="n_SCHED" name="EventBridge Scheduler hutch-digest-flush rate 6 hours">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_DSQ" name="digest-scan-q visibility 120 s">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DSDLQ" name="digest-scan-dlq alarm and SNS email">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_DS" name="digest-scan Lambda 512 MB, 60 s, batch 1">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_PREP" name="1. prepare the starter snapshot a failure is logged and the tick continues">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_BUCKET" name="content bucket starter rollout and daily HN snapshot"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_HN" name="Hacker News API top 30 stories">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_NEWSTORY" name="story with no article row and no crawl?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_STUB" name="articles table stub, crawl and summary pending"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_SALC" name="SaveAnonymousLinkCommand">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_PIPE" name="existing save-link crawl, selection and summary chain">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_RVLS" name="ReaderViewLoadingSucceeded no consumer">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_REPORT" name="2. starter report a failure is logged and the tick continues">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_RLOG" name="JSON report lines CloudWatch Logs"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_ENUM" name="3. list recipients trialing, active, pending_cancellation">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_SIDX" name="subscription-providers status-index, KEYS_ONLY"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_SUDC" name="SendUserDigestCommand one per user, direct SQS">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_SUDQ" name="send-user-digest-q">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_TICK" name="dispatched user digests users and failed counts logged">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="trigger message" sourceRef="n_SCHED" targetRef="n_DSQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_DSQ" targetRef="n_DS" />
    <bpmn:sequenceFlow id="f_2" name="3 receives" sourceRef="n_DSQ" targetRef="n_DSDLQ" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_DS" targetRef="n_PREP" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_PREP" targetRef="n_HN" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_PREP" targetRef="n_NEWSTORY" />
    <bpmn:sequenceFlow id="f_8" name="yes" sourceRef="n_NEWSTORY" targetRef="n_SALC" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_SALC" targetRef="n_PIPE" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_PIPE" targetRef="n_RVLS" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_DS" targetRef="n_REPORT" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_DS" targetRef="n_ENUM" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_ENUM" targetRef="n_SUDC" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_SUDC" targetRef="n_SUDQ" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_ENUM" targetRef="n_TICK" />
    <bpmn:association id="f_4" sourceRef="n_PREP" targetRef="n_BUCKET" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_NEWSTORY" targetRef="n_STUB" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_REPORT" targetRef="n_RLOG" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_ENUM" targetRef="n_SIDX" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_digest_tick">
