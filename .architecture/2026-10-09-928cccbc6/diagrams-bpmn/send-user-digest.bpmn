<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_send_user_digest" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_send_user_digest" name="send-user-digest" isExecutable="false">
    <bpmn:sendTask id="n_SUDC" name="SendUserDigestCommand">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_SUDQ" name="send-user-digest-q visibility 120 s">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_SUDDLQ" name="send-user-digest-dlq alarm and SNS email">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_SUD" name="send-user-digest Lambda 512 MB, 60 s, batch 1">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_OWN" name="does this message already hold a digest claim?">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="n_ENROLL" name="enrol in the HN starter pack a failure is logged">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="n_PAYDUE" name="pay digest due?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="n_STARTER" name="HN starter email path">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_STOP" name="done for this tick">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="n_GATES" name="verified email, subscribed, trial or paid tier?">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_SKIP" name="skipped and logged">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="n_CADENCE" name="7 days less 30 min since the last digest of either kind?">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_HELD" name="held: cadence">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_PAYSEL" name="pay digest selection up to 10 unread saves, reader available, summary ready">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_REGSEL" name="regular digest selection up to 10 unread saves 30 days old or more, never emailed">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_UAIDX" name="user-articles userId-savedAt-index"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_PAYCLAIM" name="claim the once-per-trial pay digest">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_REGCLAIM" name="claim the per-user slot 5.5 h cooldown">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_SUBS" name="subscription-providers row"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_RRN" name="hutch-reader-ready-notifications row"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_WARN" name="claim held elsewhere warning logged">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:incoming>f_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_MAIL" name="send the digest email through Resend">
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_FIN" name="stamp emailSentAt on every listed save">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_UAROWS" name="user-articles rows"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_RRES" name="ReaderReadyEmailSentEvent no consumer">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SUDC" targetRef="n_SUDQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_SUDQ" targetRef="n_SUD" />
    <bpmn:sequenceFlow id="f_2" name="3 receives" sourceRef="n_SUDQ" targetRef="n_SUDDLQ" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SUD" targetRef="n_OWN" />
    <bpmn:sequenceFlow id="f_4" name="yes, a redelivery" sourceRef="n_OWN" targetRef="n_FIN" />
    <bpmn:sequenceFlow id="f_5" name="no" sourceRef="n_OWN" targetRef="n_ENROLL" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_ENROLL" targetRef="n_PAYDUE" />
    <bpmn:sequenceFlow id="f_7" name="no" sourceRef="n_PAYDUE" targetRef="n_STARTER" />
    <bpmn:sequenceFlow id="f_8" name="starter handled the user" sourceRef="n_STARTER" targetRef="n_STOP" />
    <bpmn:sequenceFlow id="f_9" name="nothing to send" sourceRef="n_STARTER" targetRef="n_GATES" />
    <bpmn:sequenceFlow id="f_10" name="yes" sourceRef="n_PAYDUE" targetRef="n_GATES" />
    <bpmn:sequenceFlow id="f_11" name="no" sourceRef="n_GATES" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_12" name="pay due" sourceRef="n_GATES" targetRef="n_PAYSEL" />
    <bpmn:sequenceFlow id="f_13" name="regular" sourceRef="n_GATES" targetRef="n_CADENCE" />
    <bpmn:sequenceFlow id="f_14" name="no" sourceRef="n_CADENCE" targetRef="n_HELD" />
    <bpmn:sequenceFlow id="f_15" name="yes" sourceRef="n_CADENCE" targetRef="n_REGSEL" />
    <bpmn:sequenceFlow id="f_18" name="nothing ready" sourceRef="n_PAYSEL" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_19" name="nothing ready" sourceRef="n_REGSEL" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_PAYSEL" targetRef="n_PAYCLAIM" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_REGSEL" targetRef="n_REGCLAIM" />
    <bpmn:sequenceFlow id="f_24" name="already claimed" sourceRef="n_PAYCLAIM" targetRef="n_WARN" />
    <bpmn:sequenceFlow id="f_25" name="slot held" sourceRef="n_REGCLAIM" targetRef="n_WARN" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_PAYCLAIM" targetRef="n_MAIL" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_REGCLAIM" targetRef="n_MAIL" />
    <bpmn:sequenceFlow id="f_28" name="" sourceRef="n_MAIL" targetRef="n_FIN" />
    <bpmn:sequenceFlow id="f_30" name="" sourceRef="n_FIN" targetRef="n_RRES" />
    <bpmn:association id="f_16" sourceRef="n_PAYSEL" targetRef="n_UAIDX" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_REGSEL" targetRef="n_UAIDX" associationDirection="One" />
    <bpmn:association id="f_22" sourceRef="n_PAYCLAIM" targetRef="n_SUBS" associationDirection="One" />
    <bpmn:association id="f_23" sourceRef="n_REGCLAIM" targetRef="n_RRN" associationDirection="One" />
    <bpmn:association id="f_29" sourceRef="n_FIN" targetRef="n_UAROWS" associationDirection="One" />
  </bpmn:process>
