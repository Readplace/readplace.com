        <dc:Bounds x="229.13" y="646" width="201.5" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_consumer_di" bpmnElement="n_consumer">
        <dc:Bounds x="466.63" y="646" width="201.5" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_noopA_di" bpmnElement="n_noopA">
        <dc:Bounds x="245.05" y="782.25" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_noopB_di" bpmnElement="n_noopB">
        <dc:Bounds x="620.13" y="782.25" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_onboarding_di" bpmnElement="n_onboarding">
        <dc:Bounds x="361.54" y="772" width="190" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_noopC_di" bpmnElement="n_noopC">
        <dc:Bounds x="322.25" y="922.5" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_send_di" bpmnElement="n_send">
        <dc:Bounds x="443.04" y="932.5" width="176.75" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_readerInbox_di" bpmnElement="n_readerInbox">
        <dc:Bounds x="358.54" y="1052.5" width="180.18" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="448.63" y="68" />
        <di:waypoint x="448.63" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_1_di" bpmnElement="f_1">
        <di:waypoint x="448.63" y="210" />
        <di:waypoint x="448.63" y="248" />
        <di:waypoint x="106.75" y="248" />
        <di:waypoint x="106.75" y="286" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_2_di" bpmnElement="f_2">
        <di:waypoint x="448.63" y="210" />
