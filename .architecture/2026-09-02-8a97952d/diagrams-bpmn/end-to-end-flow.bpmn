<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:startEvent id="n_emailReceived" name="EmailReceivedEvent source: hutch.inbox">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_extract" name="extract-email-links handler inbox Lambda">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_submit" name="SubmitLinkCommand">
      <bpmn:incoming>f_1</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_held" name="SendTrialFeedbackEmailCommand kind: automation_saves_held">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_notice" name="SendFirstInboxEmailNoticeCommand source: hutch.inbox">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_crawlPreview" name="CrawlEmailLinkPreview">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:task id="n_rule" name="EventBridge rule send-first-inbox-email-notice-command-rule">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_queue" name="send-first-inbox-email-notice-q">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_dlq" name="send-first-inbox-email-notice-dlq SNS alarm + email">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_consumer" name="send-first-inbox-email-notice handler hutch Lambda">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_noopA" name="noop — the held notice speaks instead">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="n_noopB" name="noop — marker left unclaimed">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_onboarding" name="hutch-onboarding firstInboxEmailNoticeSentAt, set-once"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_noopC" name="noop — another delivery sent it"></bpmn:endEvent>
    <bpmn:serviceTask id="n_send" name="InboxFirstArrivalEmail rendered → Resend"></bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_readerInbox" name="Reader's email + bcc readplace+first_inbox_email"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_emailReceived" targetRef="n_extract" />
    <bpmn:sequenceFlow id="f_1" name="per saveable link, writeAccess = full" sourceRef="n_extract" targetRef="n_submit" />
    <bpmn:sequenceFlow id="f_2" name="per saveable link, writeAccess = read-only, once per email" sourceRef="n_extract" targetRef="n_held" />
    <bpmn:sequenceFlow id="f_3" name="first saveable link, writeAccess = full, once per email" sourceRef="n_extract" targetRef="n_notice" />
    <bpmn:sequenceFlow id="f_4" name="per link" sourceRef="n_extract" targetRef="n_crawlPreview" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_notice" targetRef="n_rule" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_rule" targetRef="n_queue" />
    <bpmn:sequenceFlow id="f_7" name="redrive after maxReceiveCount" sourceRef="n_queue" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_queue" targetRef="n_consumer" />
    <bpmn:sequenceFlow id="f_9" name="resolveWriteAccess != full" sourceRef="n_consumer" targetRef="n_noopA" />
    <bpmn:sequenceFlow id="f_10" name="no email on file" sourceRef="n_consumer" targetRef="n_noopB" />
    <bpmn:association id="f_11" sourceRef="n_consumer" targetRef="n_onboarding" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_onboarding" targetRef="n_noopC" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_onboarding" targetRef="n_send" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_send" targetRef="n_readerInbox" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_end_to_end_flow">
    <bpmndi:BPMNPlane id="Plane_end_to_end_flow" bpmnElement="Process_end_to_end_flow">
      <bpmndi:BPMNShape id="n_emailReceived_di" bpmnElement="n_emailReceived">
        <dc:Bounds x="428.63" y="28" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_extract_di" bpmnElement="n_extract">
        <dc:Bounds x="347.13" y="158" width="203" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_submit_di" bpmnElement="n_submit">
