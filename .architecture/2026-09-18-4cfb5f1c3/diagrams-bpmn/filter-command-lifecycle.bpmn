    <bpmn:sequenceFlow id="f_27" name="disconnect" sourceRef="n_Q" targetRef="n_DH" />
    <bpmn:sequenceFlow id="f_28" name="" sourceRef="n_DH" targetRef="n_DE" />
    <bpmn:sequenceFlow id="f_29" name="Google unavailable or exception" sourceRef="n_DH" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_30" name="connection absent" sourceRef="n_DH" targetRef="n_DS" />
    <bpmn:sequenceFlow id="f_31" name="three receives exhausted" sourceRef="n_Q" targetRef="n_L" />
    <bpmn:association id="f_10" sourceRef="n_D" targetRef="n_W" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_S" targetRef="n_D" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_V" targetRef="n_D" associationDirection="One" />
    <bpmn:association id="f_25" sourceRef="n_CH" targetRef="n_D" associationDirection="One" />
  </bpmn:process>
