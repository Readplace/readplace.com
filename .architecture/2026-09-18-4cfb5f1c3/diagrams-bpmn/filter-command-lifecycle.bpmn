<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_filter_command_lifecycle" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_filter_command_lifecycle" name="filter-command-lifecycle" isExecutable="false">
    <bpmn:startEvent id="n_A" name="GmailForwardingConfirmedEvent">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_B" name="EventBridge rules">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="rewrite-gmail-filter SQS">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:outgoing>f_31</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_G" name="Mark matching gateway confirmed">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_C" name="RewriteGmailFilterCommand">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_P" name="Add or remove sender mapping; retry confirmed live filter">
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_R" name="Reconnect callback after prior revocation">
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_N" name="RewriteGmailFilterCommand, reason reconnected">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_RF" name="Restore revocation only for that gateway and connectedAt; next OAuth retries">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_W" name="Validate command and derive all selected senders">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_D" name="Connection, sender and inbox-address stores"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Gm" name="Gmail Filters API: reconcile one gateway filter and remove legacy owned filters">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_S" name="Record or clear filter count and sender count">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_E" name="GmailFilterRewrittenEvent">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_V" name="Mark connection revoked">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_F" name="GmailFilterRewriteFailedEvent">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="n_CF" name="GmailForwardingConfirmFailedEvent">
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_CH" name="Record error for matching unconfirmed gateway; otherwise log and skip">
      <bpmn:incoming>f_24</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_DC" name="DisconnectGmailCommand">
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_DH" name="Delete mappings; reconcile empty filter; revoke grant; delete credentials, connection and discovery; disable gateway">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
      <bpmn:outgoing>f_29</bpmn:outgoing>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_DE" name="GmailDisconnectedEvent">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_DS" name="Clear discovery and log no connection">
      <bpmn:incoming>f_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="n_L" name="Rewrite-filter DLQ and alarm">
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_A" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_1" name="forwarding confirmed" sourceRef="n_Q" targetRef="n_G" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_G" targetRef="n_C" />
