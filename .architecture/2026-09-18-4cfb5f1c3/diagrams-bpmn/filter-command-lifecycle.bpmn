    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_B" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_9" name="rewrite command" sourceRef="n_Q" targetRef="n_W" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_W" targetRef="n_Gm" />
    <bpmn:sequenceFlow id="f_12" name="complete reconciliation" sourceRef="n_Gm" targetRef="n_S" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_S" targetRef="n_E" />
    <bpmn:sequenceFlow id="f_15" name="reauth-required" sourceRef="n_Gm" targetRef="n_V" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_V" targetRef="n_F" />
    <bpmn:sequenceFlow id="f_18" name="not connected, not confirmed or already revoked" sourceRef="n_W" targetRef="n_F" />
    <bpmn:sequenceFlow id="f_19" name="rejected or query too long" sourceRef="n_Gm" targetRef="n_F" />
    <bpmn:sequenceFlow id="f_20" name="unavailable or exception" sourceRef="n_Gm" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_21" name="publish failure" sourceRef="n_E" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_22" name="publish failure" sourceRef="n_F" targetRef="n_Q" />
