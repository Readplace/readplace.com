<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_reconnect_and_discovery" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_reconnect_and_discovery" name="reconnect-and-discovery" isExecutable="false">
    <bpmn:sendTask id="n_U" name="Reader submits Reconnect Gmail">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_O" name="Google OAuth consent and callback">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_Z" name="Redirect with existing OAuth error">
      <bpmn:incoming>f_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_J" name="Save credentials, create gateway, record mailbox">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_K" name="Save credentials and record mailbox">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_C" name="Clear revocation and advance connectedAt">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_D" name="Connection, credentials and discovery state"></bpmn:dataStoreReference>
    <bpmn:task id="n_GD" name="Clear discovery gate, rotate generation, release claim; retain checkpoint and cache">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_RC" name="Publish RewriteGmailFilterCommand, reason reconnected">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_RF" name="Restore prior revocation only for same gateway and connectedAt, then fail callback">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_R" name="303 Gmail page with connected notice">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_V" name="Render sender picker">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_FC" name="Render existing forwarding confirmation step">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_S" name="StartGmailSenderDiscoveryCommand">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_B" name="EventBridge rule">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:incoming>f_34</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="gmail-discovery SQS">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:incoming>f_41</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_42</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_W" name="Discovery Lambda routes start, page or progress">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:outgoing>f_36</bpmn:outgoing>
      <bpmn:outgoing>f_39</bpmn:outgoing>
      <bpmn:outgoing>f_41</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_P" name="Discovery checkpoint and sender cache"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_E" name="GmailSenderDiscoveryProgressedEvent">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="n_N" name="DiscoverGmailSendersPageCommand, delayed direct SQS">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_X" name="Conditionally revoke captured gateway and connectedAt">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:outgoing>f_29</bpmn:outgoing>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_I" name="Discovery IAM: UpdateItem on connections table only">
      <bpmn:outgoing>f_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_Y" name="Fail current discovery generation with reconnect requirement">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:outgoing>f_33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_SK" name="Leave state untouched; retry after page lease">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:outgoing>f_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_F" name="GmailSenderDiscoveryProgressedEvent without next page">
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:incoming>f_38</bpmn:incoming>
      <bpmn:incoming>f_40</bpmn:incoming>
      <bpmn:incoming>f_44</bpmn:incoming>
      <bpmn:outgoing>f_34</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_H" name="Page renders current discovery and connection state"></bpmn:endEvent>
    <bpmn:businessRuleTask id="n_M" name="Fail discovery with reconnect requirement only">
      <bpmn:incoming>f_36</bpmn:incoming>
      <bpmn:outgoing>f_38</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_RJ" name="Fail current discovery generation without reconnect requirement">
      <bpmn:incoming>f_39</bpmn:incoming>
      <bpmn:outgoing>f_40</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="n_L" name="Discovery DLQ and alarm">
      <bpmn:incoming>f_42</bpmn:incoming>
      <bpmn:outgoing>f_43</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_T" name="DLQ handler fails only the current generation">
      <bpmn:incoming>f_43</bpmn:incoming>
      <bpmn:outgoing>f_44</bpmn:outgoing>
    </bpmn:serviceTask>
