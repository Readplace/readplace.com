<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_save_asks_for_passes" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_save_asks_for_passes" name="save-asks-for-passes" isExecutable="false">
    <bpmn:startEvent id="n_TAP" name="Reader taps save">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_AUTO" name="Automatic save">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_SAVE" name="Save the link">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ROW" name="Default-list user-article row"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_NONE" name="No related pass requested">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_GATE" name="requestMissingRelatedPasses manual saves only">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_REQ" name="Row saved and not yet stamped?">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_BOTH" name="Both passes settled?">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_NEXT" name="Next read settled?">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_CREATED" name="Row created by this save?">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_PAST" name="ComputeRelatedPastReadsCommand">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="n_QEC" name="QueueEntryCreatedEvent">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="n_PASSES" name="ComputeRelatedPassesCommand">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="n_MARK" name="markRelatedPassesRequested stamps relatedPassesRequestedAt">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_STOP" name="Nothing published">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_TAP" targetRef="n_SAVE" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_AUTO" targetRef="n_SAVE" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_AUTO" targetRef="n_NONE" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_TAP" targetRef="n_GATE" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_GATE" targetRef="n_REQ" />
    <bpmn:sequenceFlow id="f_6" name="no" sourceRef="n_REQ" targetRef="n_STOP" />
    <bpmn:sequenceFlow id="f_7" name="yes" sourceRef="n_REQ" targetRef="n_BOTH" />
    <bpmn:sequenceFlow id="f_8" name="yes" sourceRef="n_BOTH" targetRef="n_STOP" />
    <bpmn:sequenceFlow id="f_9" name="no" sourceRef="n_BOTH" targetRef="n_NEXT" />
    <bpmn:sequenceFlow id="f_10" name="yes" sourceRef="n_NEXT" targetRef="n_PAST" />
    <bpmn:sequenceFlow id="f_11" name="no" sourceRef="n_NEXT" targetRef="n_CREATED" />
    <bpmn:sequenceFlow id="f_12" name="yes" sourceRef="n_CREATED" targetRef="n_QEC" />
    <bpmn:sequenceFlow id="f_13" name="no" sourceRef="n_CREATED" targetRef="n_PASSES" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_PAST" targetRef="n_MARK" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_QEC" targetRef="n_MARK" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_PASSES" targetRef="n_MARK" />
    <bpmn:association id="f_2" sourceRef="n_SAVE" targetRef="n_ROW" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_MARK" targetRef="n_ROW" associationDirection="One" />
  </bpmn:process>
