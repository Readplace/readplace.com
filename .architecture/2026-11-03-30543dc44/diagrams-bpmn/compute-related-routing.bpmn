<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_compute_related_routing" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_compute_related_routing" name="compute-related-routing" isExecutable="false">
    <bpmn:startEvent id="n_QEC" name="QueueEntryCreatedEvent">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:sendTask id="n_PASSES" name="ComputeRelatedPassesCommand">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_PAST" name="ComputeRelatedPastReadsCommand">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:startEvent id="n_CCC" name="CanonicalContentChangedEvent">
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_Q" name="compute-related-articles queue batch size 1">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DLQ" name="compute-related-articles DLQ">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_ROUTER" name="compute-related-passes router">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_NR" name="Next read pass">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PR" name="Past reads pass">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RE" name="Recompute a skipped Next read">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ROW" name="Default-list user-article row relatedStatus, pastReadsComputedAt"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_QEC" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_PASSES" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_PAST" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_CCC" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Q" targetRef="n_ROUTER" />
    <bpmn:sequenceFlow id="f_5" name="out of receives" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_6" name="QueueEntryCreated, ComputeRelatedPasses" sourceRef="n_ROUTER" targetRef="n_NR" />
    <bpmn:sequenceFlow id="f_7" name="QueueEntryCreated, ComputeRelatedPasses, ComputeRelatedPastReads" sourceRef="n_ROUTER" targetRef="n_PR" />
    <bpmn:sequenceFlow id="f_8" name="CanonicalContentChanged" sourceRef="n_ROUTER" targetRef="n_RE" />
    <bpmn:association id="f_9" sourceRef="n_NR" targetRef="n_ROW" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_PR" targetRef="n_ROW" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_RE" targetRef="n_ROW" associationDirection="One" />
  </bpmn:process>
