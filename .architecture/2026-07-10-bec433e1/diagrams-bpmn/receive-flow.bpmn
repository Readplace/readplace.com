<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_receive_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_receive_flow" name="receive-flow" isExecutable="false">
    <bpmn:sendTask id="n_mail" name="Forwarded newsletter arrives at in-token@mail-domain">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_rule" name="SES catch-all receipt rule (hutch InboxMail) S3 action + SNS notify">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_raw" name="raw-email bucket inbound/sesMessageId — immutable, forever"></bpmn:dataStoreReference>
    <bpmn:intermediateCatchEvent id="n_topic" name="inbox-mail SNS topic TWO SQS subscriptions during overlap">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_hq" name="receive-email SQS (hutch, current)">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_hdlq" name="receive-email DLQ + alarm → SNS email">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_hl" name="receive-email Lambda (hutch, current) receive-email-handler.ts">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_iq" name="inbox-receive-email SQS">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_idlq" name="inbox-receive-email DLQ + alarm → SNS email">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_il" name="inbox-receive-email Lambda same handler code, re-homed">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_resolve" name="resolve each recipient findByAddress (GetItem)">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_addr" name="hutch-inbox-addresses"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_gate" name="deliverable? known + not disabled">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_audit" name="hutch-inbox-emails audit row, __unrouted__ partition (unknown / disabled / rejected / unparsed)"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_fault" name="oversize or unparseable with a real enabled recipient?">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_body" name="shared content bucket sanitized body + inline images (user-scoped key, written BEFORE row)"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_row" name="hutch-inbox-emails putEmail conditional — duplicate = no-op"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_ere" name="EmailReceivedEvent published even on duplicate row ×2 during overlap (one per stack)">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_mail" targetRef="n_rule" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_rule" targetRef="n_topic" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_topic" targetRef="n_hq" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_hq" targetRef="n_hl" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_topic" targetRef="n_iq" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_iq" targetRef="n_il" />
    <bpmn:sequenceFlow id="f_7" name="maxReceiveCount" sourceRef="n_hq" targetRef="n_hdlq" />
    <bpmn:sequenceFlow id="f_8" name="maxReceiveCount" sourceRef="n_iq" targetRef="n_idlq" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_hl" targetRef="n_resolve" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_il" targetRef="n_resolve" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_resolve" targetRef="n_gate" />
    <bpmn:sequenceFlow id="f_14" name="yes" sourceRef="n_gate" targetRef="n_fault" />
    <bpmn:association id="f_1" sourceRef="n_rule" targetRef="n_raw" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_resolve" targetRef="n_addr" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_gate" targetRef="n_audit" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_fault" targetRef="n_audit" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_fault" targetRef="n_body" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_body" targetRef="n_row" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_row" targetRef="n_ere" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_receive_flow">
