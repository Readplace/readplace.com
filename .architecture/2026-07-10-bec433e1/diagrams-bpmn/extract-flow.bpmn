<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_extract_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_extract_flow" name="extract-flow" isExecutable="false">
    <bpmn:startEvent id="n_ere" name="EmailReceivedEvent userId, receivedAtMessageId, recipientAddress (published twice during overlap)">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="n_hrule" name="email-received-rule (hutch, current) source hutch.inbox / EmailReceived">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="n_hq" name="extract-email-links SQS (hutch, current)">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_hdlq" name="extract-email-links DLQ + alarm">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_hl" name="extract-email-links Lambda (hutch, current)">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_irule" name="inbox-extract-email-links-rule same pattern, explicit distinct name">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_iq" name="inbox-extract-email-links SQS">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_idlq" name="inbox-extract-email-links DLQ + alarm">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_il" name="inbox-extract-email-links Lambda same handler code, re-homed">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_getEmail" name="hutch-inbox-emails getEmail skip unless status = received"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_raw" name="raw-email bucket readRawEmail re-derive body from immutable .eml"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_derive" name="parseEmail + deriveSanitizedBody + extractUrls + capEmailLinks (soft cap 200)">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_putLink" name="hutch-inbox-email-links putLink one pending row per url conditional — replay = no-op"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_meta" name="hutch-inbox-email-links putLinksMeta LAST — extraction-finished barrier, truncated flag"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_celp" name="CrawlEmailLinkPreview one per link, per execution">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_halert" name="extract-email-links-truncated-alert queue + send-rate alarm → SNS email (hutch, current)">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_ialert" name="inbox-extract-email-links-truncated-alert queue + send-rate alarm → SNS email">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_ere" targetRef="n_hrule" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_hrule" targetRef="n_hq" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_hq" targetRef="n_hl" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_ere" targetRef="n_irule" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_irule" targetRef="n_iq" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_iq" targetRef="n_il" />
    <bpmn:sequenceFlow id="f_6" name="maxReceiveCount" sourceRef="n_hq" targetRef="n_hdlq" />
    <bpmn:sequenceFlow id="f_7" name="maxReceiveCount" sourceRef="n_iq" targetRef="n_idlq" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_hl" targetRef="n_derive" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_il" targetRef="n_derive" />
    <bpmn:sequenceFlow id="f_17" name="if truncated" sourceRef="n_hl" targetRef="n_halert" />
    <bpmn:sequenceFlow id="f_18" name="if truncated" sourceRef="n_il" targetRef="n_ialert" />
    <bpmn:association id="f_8" sourceRef="n_hl" targetRef="n_getEmail" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_il" targetRef="n_getEmail" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_hl" targetRef="n_raw" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_il" targetRef="n_raw" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_derive" targetRef="n_putLink" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_putLink" targetRef="n_celp" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_derive" targetRef="n_meta" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_extract_flow">
