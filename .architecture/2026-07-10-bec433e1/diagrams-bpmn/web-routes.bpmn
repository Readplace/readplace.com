<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_web_routes" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_web_routes" name="web-routes" isExecutable="false">
    <bpmn:sendTask id="n_req" name="GET /inbox — reader opens the received list">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_gw" name="hutch API Gateway (owned by hutch)">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_routes" name="route keys GET /inbox + ANY /inbox/proxy attached by the inbox stack — more-specific beats $default">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_webL" name="inbox-web Lambda express app, requireAuth on /inbox">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ssr" name="hutch SSR Lambda on $default /inbox router still mounted — shadowed, removed in follow-up cleanup">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_sessions" name="sessions table GetItem each request; UpdateItem on markSessionEmailVerified"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_users" name="users table Query userId-index"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_subs" name="subscription-providers GetItem trial / access display"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_tables" name="hutch-inbox-addresses / -emails / -email-links lists, detail, link cards + polling"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_content" name="shared content bucket sanitized email body for the iframe"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_banner" name="changelog banner fragment same-origin /blog route, fail-open">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_req" targetRef="n_gw" />
    <bpmn:sequenceFlow id="f_1" name="route precedence" sourceRef="n_gw" targetRef="n_routes" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_routes" targetRef="n_webL" />
    <bpmn:sequenceFlow id="f_3" name="$default — every other path" sourceRef="n_gw" targetRef="n_ssr" />
    <bpmn:sequenceFlow id="f_9" name="cached, decorative" sourceRef="n_webL" targetRef="n_banner" />
    <bpmn:association id="f_4" sourceRef="n_webL" targetRef="n_sessions" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_webL" targetRef="n_users" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_webL" targetRef="n_subs" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_webL" targetRef="n_tables" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_webL" targetRef="n_content" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_web_routes">
    <bpmndi:BPMNPlane id="Plane_web_routes" bpmnElement="Process_web_routes">
      <bpmndi:BPMNShape id="n_req_di" bpmnElement="n_req">
