<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ownership_and_seams" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_ownership_and_seams" name="ownership-and-seams" isExecutable="false">
    <bpmn:serviceTask id="n_inboxMail" name="InboxMail component SES domain identity + DKIM + MX catch-all receipt rule set (active)">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_rawBucket" name="raw-email bucket immutable .eml, kept forever"></bpmn:dataStoreReference>
    <bpmn:intermediateCatchEvent id="n_snsTopic" name="inbox-mail SNS notification topic">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:dataStoreReference id="n_tables" name="hutch-inbox-addresses hutch-inbox-emails hutch-inbox-email-links"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_contentBucket" name="shared article-content bucket sanitized bodies + lead images"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_gateway" name="API Gateway hutch SSR Lambda on $default">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_oldConsumers" name="ORIGINAL consumers still live: receive-email, extract-email-links, crawl-email-link-preview (removed in follow-up cleanup)">
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_exports" name="stack outputs: apiGatewayId, apiGatewayExecutionArn, apiUrl, inboxNotificationTopicArn">
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_stackRef" name="StackReference to hutch (4 deploy-time outputs)">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_cfg" name="own Pulumi config: table + bucket names, contentMediaCdnDomain">
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_webL" name="inbox-web Lambda GET /inbox + ANY /inbox/proxy routes">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_recvL" name="inbox-receive-email Lambda + SQS + DLQ">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_extractL" name="inbox-extract-email-links Lambda + SQS + DLQ + truncation alert">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_crawlL" name="inbox-crawl-email-link-preview Lambda + SQS + DLQ">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_bus" name="platform event bus (shared, via platformStack reference)">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_inboxMail" targetRef="n_snsTopic" />
    <bpmn:sequenceFlow id="f_2" name="inboxNotificationTopicArn" sourceRef="n_exports" targetRef="n_stackRef" />
    <bpmn:sequenceFlow id="f_3" name="apiGatewayId / execArn / apiUrl" sourceRef="n_exports" targetRef="n_stackRef" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_stackRef" targetRef="n_webL" />
    <bpmn:sequenceFlow id="f_5" name="SNS TopicSubscription" sourceRef="n_stackRef" targetRef="n_recvL" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_cfg" targetRef="n_recvL" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_cfg" targetRef="n_extractL" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_cfg" targetRef="n_crawlL" />
    <bpmn:sequenceFlow id="f_9" name="routes attached by precedence" sourceRef="n_webL" targetRef="n_gateway" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_oldConsumers" targetRef="n_bus" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_recvL" targetRef="n_bus" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_extractL" targetRef="n_bus" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_crawlL" targetRef="n_bus" />
    <bpmn:association id="f_0" sourceRef="n_inboxMail" targetRef="n_rawBucket" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_oldConsumers" targetRef="n_tables" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_recvL" targetRef="n_tables" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_extractL" targetRef="n_tables" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_crawlL" targetRef="n_tables" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_webL" targetRef="n_tables" associationDirection="One" />
    <bpmn:association id="f_19" sourceRef="n_recvL" targetRef="n_contentBucket" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_crawlL" targetRef="n_contentBucket" associationDirection="One" />
    <bpmn:group id="grp_0" />
    <bpmn:group id="grp_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ownership_and_seams">
