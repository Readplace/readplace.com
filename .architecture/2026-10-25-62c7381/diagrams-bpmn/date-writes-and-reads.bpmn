<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_date_writes_and_reads" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_date_writes_and_reads" name="date-writes-and-reads" isExecutable="false">
    <bpmn:intermediateThrowEvent id="n_Save" name="TierContentExtractedEvent (save, capture)">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_Selection" name="content selection resolves the canonical publish date">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:startEvent id="n_Recrawl" name="RecrawlContentExtractedEvent (admin recrawl)">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_Refresh" name="RefreshContentExtractedEvent (refresh flow above)">
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:dataStoreReference id="n_Row" name="articles table publishedOn"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_Email" name="SaveEmailIssueCommand receivedAtMessageId">
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_EmailLambda" name="save-email-issue Lambda publishedOn = UTC day of receipt">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_Port" name="display port webmail rows get no date">
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_Header" name="reader header Published · Saved">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_Siren" name="Siren article properties">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_Mcp" name="MCP article tools">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_Markdown" name="Markdown frontmatter published">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Save" targetRef="n_Selection" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Recrawl" targetRef="n_Selection" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Refresh" targetRef="n_Selection" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Email" targetRef="n_EmailLambda" />
    <bpmn:sequenceFlow id="f_7" name="tier-0 manifest" sourceRef="n_EmailLambda" targetRef="n_Save" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_Port" targetRef="n_Header" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Port" targetRef="n_Siren" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_Port" targetRef="n_Mcp" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Port" targetRef="n_Markdown" />
    <bpmn:association id="f_3" sourceRef="n_Selection" targetRef="n_Row" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_Selection" targetRef="n_Row" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_EmailLambda" targetRef="n_Row" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_Row" targetRef="n_Port" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_date_writes_and_reads">
    <bpmndi:BPMNPlane id="Plane_date_writes_and_reads" bpmnElement="Process_date_writes_and_reads">
      <bpmndi:BPMNShape id="n_Save_di" bpmnElement="n_Save">
