<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_refresh_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_refresh_flow" name="refresh-flow" isExecutable="false">
    <bpmn:businessRuleTask id="n_View" name="Public /view page or re-save of a crawled URL">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateThrowEvent id="n_StaleEvent" name="StaleCheckRequestedEvent">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_StaleQueue" name="stale-check SQS">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_StaleCheck" name="stale-check Lambda 24h freshness gate">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_StaleDlq" name="stale-check DLQ">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_Row" name="articles table title, siteName, excerpt, imageUrl, publishedOn, etag, lastModified, bodyHash"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Crawl" name="crawl + finalize (in process) Readability publishedTime → publishedOn calendar date">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_UFT" name="UpdateFetchTimestampCommand">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_UFTQueue" name="update-fetch-timestamp SQS">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_UFTLambda" name="update-fetch-timestamp Lambda no metadata write">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_Unsupported" name="SimpleCrawlUnsupportedEvent refresh: true">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_Comprehensive" name="comprehensive crawl (no publish date)">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_RCEPdf" name="RefreshContentExtractedEvent">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_Stage" name="stage HTML under refresh-html/ in the pending-HTML bucket">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_RACmd" name="RefreshArticleContentCommand metadata.publishedOn (optional)">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_RAQueue" name="refresh-article-content SQS">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_RADlq" name="refresh-article-content DLQ">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_RALambda" name="refresh-article-content Lambda reads staged HTML">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Manifest" name="tier-1 source manifest metadata.publishedOn"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_RCE" name="RefreshContentExtractedEvent">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_RCEQueue" name="refresh-content-extracted SQS">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Select" name="refresh-content-extracted Lambda content selection over every candidate">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Resolve" name="resolve canonical publish date winner's, else first candidate's">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Transition" name="refreshContent transition metadata.publishedOn = resolved, or cleared">
      <bpmn:incoming>f_25</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_View" targetRef="n_StaleEvent" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_StaleEvent" targetRef="n_StaleQueue" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_StaleQueue" targetRef="n_StaleCheck" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_StaleQueue" targetRef="n_StaleDlq" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_StaleCheck" targetRef="n_Crawl" />
    <bpmn:sequenceFlow id="f_6" name="304 or byte-identical body" sourceRef="n_Crawl" targetRef="n_UFT" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_UFT" targetRef="n_UFTQueue" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_UFTQueue" targetRef="n_UFTLambda" />
    <bpmn:sequenceFlow id="f_10" name="unsupported (PDF)" sourceRef="n_Crawl" targetRef="n_Unsupported" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_Unsupported" targetRef="n_Comprehensive" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Comprehensive" targetRef="n_RCEPdf" />
    <bpmn:sequenceFlow id="f_13" name="changed HTML" sourceRef="n_Crawl" targetRef="n_Stage" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_Stage" targetRef="n_RACmd" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_RACmd" targetRef="n_RAQueue" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_RAQueue" targetRef="n_RADlq" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_RAQueue" targetRef="n_RALambda" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_RALambda" targetRef="n_RCE" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_RCE" targetRef="n_RCEQueue" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_RCEPdf" targetRef="n_RCEQueue" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_RCEQueue" targetRef="n_Select" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_Select" targetRef="n_Resolve" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_Resolve" targetRef="n_Transition" />
    <bpmn:association id="f_4" sourceRef="n_StaleCheck" targetRef="n_Row" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_UFTLambda" targetRef="n_Row" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_RALambda" targetRef="n_Manifest" associationDirection="One" />
    <bpmn:association id="f_23" sourceRef="n_Manifest" targetRef="n_Select" associationDirection="One" />
    <bpmn:association id="f_26" sourceRef="n_Transition" targetRef="n_Row" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_refresh_flow">
