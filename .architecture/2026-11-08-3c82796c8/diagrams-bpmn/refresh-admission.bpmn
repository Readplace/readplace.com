<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_refresh_admission" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_refresh_admission" name="refresh-admission" isExecutable="false">
    <bpmn:sendTask id="n_RAC" name="RefreshArticleContentCommand url, saveAttemptId, contentFetchedAt">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_RA" name="refresh-article-content Lambda">
      <bpmn:incoming>f_0</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ROW" name="articles row, consistent read purgedAt, contentFetchedAt, savedAt, crawlStatus"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_G0" name="row exists?">
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_G1" name="purgedAt set?">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_G2" name="crawlStatus unsupported?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_G3" name="row contentFetchedAt set?">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_G4" name="row contentFetchedAt &gt;= message's?">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_G5" name="savedAt &gt; message's contentFetchedAt?">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_SKIP" name="RefreshArticleContentSkippedEvent purged / unsupported / superseded / staged-html-expired">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_ID" name="source original matches canonical identity? (assert)">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_ALIAS" name="articles table canonical alias row"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_PH" name="pending-html bucket html + evaluation html"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_H" name="both representations present?">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_CB" name="content bucket tier-1 source"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_RCE" name="RefreshContentExtractedEvent">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_FAIL" name="record failed, SQS retry">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_DLQ" name="[&quot;refresh-article-content-dlq">
      <bpmn:incoming>f_22</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_RAC" targetRef="n_RA" />
    <bpmn:sequenceFlow id="f_3" name="no" sourceRef="n_G0" targetRef="n_ID" />
    <bpmn:sequenceFlow id="f_4" name="yes" sourceRef="n_G0" targetRef="n_G1" />
    <bpmn:sequenceFlow id="f_5" name="yes: purged" sourceRef="n_G1" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_6" name="no" sourceRef="n_G1" targetRef="n_G2" />
    <bpmn:sequenceFlow id="f_7" name="yes: unsupported" sourceRef="n_G2" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_8" name="no" sourceRef="n_G2" targetRef="n_G3" />
    <bpmn:sequenceFlow id="f_9" name="yes" sourceRef="n_G3" targetRef="n_G4" />
    <bpmn:sequenceFlow id="f_10" name="yes: superseded" sourceRef="n_G4" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_11" name="no" sourceRef="n_G4" targetRef="n_ID" />
    <bpmn:sequenceFlow id="f_12" name="no" sourceRef="n_G3" targetRef="n_G5" />
    <bpmn:sequenceFlow id="f_13" name="yes: superseded" sourceRef="n_G5" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_14" name="no" sourceRef="n_G5" targetRef="n_ID" />
    <bpmn:sequenceFlow id="f_16" name="mismatch" sourceRef="n_ID" targetRef="n_FAIL" />
    <bpmn:sequenceFlow id="f_17" name="match" sourceRef="n_ID" targetRef="n_H" />
    <bpmn:sequenceFlow id="f_19" name="NoSuchKey: staged-html-expired" sourceRef="n_H" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_22" name="after 3 receives" sourceRef="n_FAIL" targetRef="n_DLQ" />
    <bpmn:association id="f_1" sourceRef="n_RA" targetRef="n_ROW" associationDirection="One" />
    <bpmn:association id="f_2" sourceRef="n_ROW" targetRef="n_G0" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_ID" targetRef="n_ALIAS" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_H" targetRef="n_PH" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_H" targetRef="n_CB" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_CB" targetRef="n_RCE" associationDirection="One" />
  </bpmn:process>
