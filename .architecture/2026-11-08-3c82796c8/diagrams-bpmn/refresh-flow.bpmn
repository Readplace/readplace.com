<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_refresh_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_refresh_flow" name="refresh-flow" isExecutable="false">
    <bpmn:serviceTask id="n_VIEW" name="/view page (hutch web Lambda)">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_SCR" name="StaleCheckRequestedEvent">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_SCQ" name="[&quot;stale-check-requested queue">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SCDLQ" name="[&quot;stale-check-requested-dlq 3 receives, alarm emails">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SC" name="stale-check-requested Lambda">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_SCP" name="freshness + crawl status conditional GET">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_ART" name="articles table"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_PH" name="pending-html bucket refresh-html/ prefix, 1-day expiry"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_SAL" name="SaveAnonymousLinkCommand">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_UFT" name="UpdateFetchTimestampCommand">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="n_SCU" name="SimpleCrawlUnsupportedEvent refresh=true">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_COMP" name="comprehensive crawl chain">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_RAC" name="RefreshArticleContentCommand">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_RACQ" name="[&quot;refresh-article-content queue">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RACDLQ" name="[&quot;refresh-article-content-dlq 3 receives, alarm emails">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RA" name="refresh-article-content Lambda">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_GATE" name="admission gate purged / unsupported / superseded">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_READ" name="staged HTML present?">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_SKIP" name="RefreshArticleContentSkippedEvent no subscribers">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_CB" name="content bucket tier sources + canonical"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_RCE" name="RefreshContentExtractedEvent">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_RCEQ" name="[&quot;refresh-content-extracted queue">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RCEDLQ" name="[&quot;refresh-content-extracted-dlq 3 receives, alarm emails, keep-row">
      <bpmn:incoming>f_26</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RC" name="refresh-content-extracted Lambda">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_REF" name="refresh refusal purged / unsupported / row-newer">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
      <bpmn:outgoing>f_29</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_LOG" name="log [RefreshContentExtracted] refused">
      <bpmn:incoming>f_28</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_SEL" name="content selection DeepSeek judge when needed">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:outgoing>f_31</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_AGG" name="refreshContent transition">
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:outgoing>f_34</bpmn:outgoing>
      <bpmn:outgoing>f_35</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_CCC" name="CanonicalContentChangedEvent">
      <bpmn:incoming>f_34</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sendTask id="n_GS" name="GenerateSummaryCommand generate-summary queue">
      <bpmn:incoming>f_35</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_VIEW" targetRef="n_SCR" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_SCR" targetRef="n_SCQ" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_SCQ" targetRef="n_SC" />
    <bpmn:sequenceFlow id="f_3" name="after 3 receives" sourceRef="n_SCQ" targetRef="n_SCDLQ" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_SC" targetRef="n_SCP" />
    <bpmn:sequenceFlow id="f_6" name="row missing" sourceRef="n_SCP" targetRef="n_SAL" />
    <bpmn:sequenceFlow id="f_7" name="304 / backoff" sourceRef="n_SCP" targetRef="n_UFT" />
    <bpmn:sequenceFlow id="f_8" name="non-HTML, deferrable" sourceRef="n_SCP" targetRef="n_SCU" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_SCU" targetRef="n_COMP" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_COMP" targetRef="n_RCE" />
    <bpmn:sequenceFlow id="f_12" name="new body" sourceRef="n_SCP" targetRef="n_RAC" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_RAC" targetRef="n_RACQ" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_RACQ" targetRef="n_RA" />
    <bpmn:sequenceFlow id="f_15" name="after 3 receives" sourceRef="n_RACQ" targetRef="n_RACDLQ" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_RA" targetRef="n_GATE" />
    <bpmn:sequenceFlow id="f_18" name="skip" sourceRef="n_GATE" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_19" name="admit" sourceRef="n_GATE" targetRef="n_READ" />
    <bpmn:sequenceFlow id="f_21" name="NoSuchKey: staged-html-expired" sourceRef="n_READ" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_23" name="present" sourceRef="n_READ" targetRef="n_RCE" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_RCE" targetRef="n_RCEQ" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_RCEQ" targetRef="n_RC" />
    <bpmn:sequenceFlow id="f_26" name="after 3 receives" sourceRef="n_RCEQ" targetRef="n_RCEDLQ" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_RC" targetRef="n_REF" />
    <bpmn:sequenceFlow id="f_28" name="refused" sourceRef="n_REF" targetRef="n_LOG" />
    <bpmn:sequenceFlow id="f_29" name="admitted" sourceRef="n_REF" targetRef="n_SEL" />
    <bpmn:sequenceFlow id="f_31" name="winner" sourceRef="n_SEL" targetRef="n_AGG" />
    <bpmn:sequenceFlow id="f_34" name="canonical changed" sourceRef="n_AGG" targetRef="n_CCC" />
    <bpmn:sequenceFlow id="f_35" name="summary pending" sourceRef="n_AGG" targetRef="n_GS" />
    <bpmn:association id="f_5" sourceRef="n_SCP" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_SCP" targetRef="n_PH" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_GATE" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_READ" targetRef="n_PH" associationDirection="One" />
    <bpmn:association id="f_22" sourceRef="n_READ" targetRef="n_CB" associationDirection="One" />
    <bpmn:association id="f_30" sourceRef="n_SEL" targetRef="n_CB" associationDirection="One" />
    <bpmn:association id="f_32" sourceRef="n_AGG" targetRef="n_CB" associationDirection="One" />
    <bpmn:association id="f_33" sourceRef="n_AGG" targetRef="n_ART" associationDirection="One" />
  </bpmn:process>
