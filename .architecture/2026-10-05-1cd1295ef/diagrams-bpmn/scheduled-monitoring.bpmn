<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_scheduled_monitoring" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_scheduled_monitoring" name="scheduled-monitoring" isExecutable="false">
    <bpmn:serviceTask id="n_SCH" name="EventBridge Scheduler: rate 6 hours, targets the queue">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_C" name="Check Gmail newsletters Command">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="Gmail newsletter monitor SQS">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_W" name="Monitoring Lambda: route by detail-type">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ENUM" name="Query one connected-account page">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CON" name="Gmail connections: connected-account index"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_AC" name="Gmail newsletter accounts checked Event">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_BUS" name="EventBridge rules and union queue policy">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_FAN" name="Dispatch one monitor per user and the next account check">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_MC" name="Monitor Gmail newsletters Command">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_PAGE" name="Process one mailbox page with generation fence">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_MON" name="Hutch Gmail monitoring table: checkpoint and notice-dispatch replay"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_PR" name="Gmail newsletter monitoring progressed Event: next page and waiting senders">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_CONT" name="Dispatch the continuation, and ONE notice command when the page lists any waiting sender, not one per sender">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_NC" name="Send Gmail newsletter notice Command: reader only, no sender">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_NQ" name="Gmail newsletter notice SQS">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="n_NB" name="EventBridge notice rule">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_DLQ" name="Monitoring DLQ and operator alarm">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SCH" targetRef="n_C" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_C" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Q" targetRef="n_W" />
    <bpmn:sequenceFlow id="f_3" name="check command" sourceRef="n_W" targetRef="n_ENUM" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_ENUM" targetRef="n_AC" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_AC" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_BUS" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_8" name="accounts checked reaction" sourceRef="n_W" targetRef="n_FAN" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_FAN" targetRef="n_C" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_FAN" targetRef="n_MC" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_MC" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_12" name="monitor command" sourceRef="n_W" targetRef="n_PAGE" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_PAGE" targetRef="n_PR" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_PR" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_17" name="progress reaction" sourceRef="n_W" targetRef="n_CONT" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_CONT" targetRef="n_MC" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_CONT" targetRef="n_NC" />
    <bpmn:sequenceFlow id="f_20" name="direct SQS" sourceRef="n_NC" targetRef="n_NQ" />
    <bpmn:sequenceFlow id="f_21" name="also subscribed" sourceRef="n_NC" targetRef="n_NB" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_NB" targetRef="n_NQ" />
    <bpmn:sequenceFlow id="f_23" name="receives exhausted" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:association id="f_4" sourceRef="n_CON" targetRef="n_ENUM" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_MON" targetRef="n_PAGE" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_PAGE" targetRef="n_MON" associationDirection="One" />
  </bpmn:process>
