<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_batch_claim_and_retry" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_batch_claim_and_retry" name="batch-claim-and-retry" isExecutable="false">
    <bpmn:task id="n_FRESH" name="New grouped email rendered: senders, payload, key">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_CL" name="Conditional claim on the NOTICE_BATCH row">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_FOUND" name="Batch row found in sending">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_WIN" name="Within 23h55m of firstAttemptAt?">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_STOP" name="Fail without sending, claim retained for review">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_ROW" name="Monitoring table: NOTICE_BATCH row per reader"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_ACQ" name="Set sending, store senders, payload and firstAttemptAt, 2-minute lease">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_KEEP" name="Renew the lease, keep the stored senders, payload, key and firstAttemptAt">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_REFUSED" name="Claim refused">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_SEND" name="Send the stored payload with the stored idempotency key">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_FAILR" name="Fail record, lease expires">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_MARK" name="Mark every listed notice sent">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_PUB" name="Gmail newsletter notice processed Event: sent, per listed sender">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_FIN" name="Finish: idle, lastSentAt now, drop payload and lease">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="n_Q" name="Gmail newsletter notice SQS: 180 s visibility, 12 receives">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DLQ" name="Notice DLQ and operator alarm, delivery evidence needs review">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_LEG" name="Notice row still sending from a per-sender claim">
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_LWIN" name="Within 23h55m of that row's first attempt?">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_LCL" name="Claim that notice row's lease">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_LSEND" name="Resend the original single-sender payload and key">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_LMARK" name="Mark that notice sent">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:outgoing>f_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_LPUB" name="Gmail newsletter notice processed Event: sent, that sender">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_FRESH" targetRef="n_CL" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_FOUND" targetRef="n_WIN" />
    <bpmn:sequenceFlow id="f_2" name="no" sourceRef="n_WIN" targetRef="n_STOP" />
    <bpmn:sequenceFlow id="f_3" name="yes" sourceRef="n_WIN" targetRef="n_CL" />
    <bpmn:sequenceFlow id="f_5" name="no row, or idle with lastSentAt at least 3 days old" sourceRef="n_CL" targetRef="n_ACQ" />
    <bpmn:sequenceFlow id="f_6" name="sending with an expired lease" sourceRef="n_CL" targetRef="n_KEEP" />
    <bpmn:sequenceFlow id="f_7" name="lease live, or idle under 3 days" sourceRef="n_CL" targetRef="n_REFUSED" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_ACQ" targetRef="n_SEND" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_KEEP" targetRef="n_SEND" />
    <bpmn:sequenceFlow id="f_12" name="provider error or ambiguous response" sourceRef="n_SEND" targetRef="n_FAILR" />
    <bpmn:sequenceFlow id="f_13" name="accepted" sourceRef="n_SEND" targetRef="n_MARK" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_MARK" targetRef="n_PUB" />
    <bpmn:sequenceFlow id="f_15" name="publish fails" sourceRef="n_PUB" targetRef="n_FAILR" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_PUB" targetRef="n_FIN" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_REFUSED" targetRef="n_FAILR" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_STOP" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_FAILR" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_21" name="redelivery" sourceRef="n_Q" targetRef="n_FOUND" />
    <bpmn:sequenceFlow id="f_22" name="receives exhausted" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_LEG" targetRef="n_LWIN" />
    <bpmn:sequenceFlow id="f_24" name="no" sourceRef="n_LWIN" targetRef="n_STOP" />
    <bpmn:sequenceFlow id="f_25" name="yes" sourceRef="n_LWIN" targetRef="n_LCL" />
    <bpmn:sequenceFlow id="f_26" name="lease held elsewhere" sourceRef="n_LCL" targetRef="n_FAILR" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_LCL" targetRef="n_LSEND" />
    <bpmn:sequenceFlow id="f_28" name="" sourceRef="n_LSEND" targetRef="n_LMARK" />
    <bpmn:sequenceFlow id="f_29" name="" sourceRef="n_LMARK" targetRef="n_LPUB" />
    <bpmn:association id="f_4" sourceRef="n_ROW" targetRef="n_CL" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_ACQ" targetRef="n_ROW" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_KEEP" targetRef="n_ROW" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_FIN" targetRef="n_ROW" associationDirection="One" />
  </bpmn:process>
