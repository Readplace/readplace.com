<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_landing_and_cleanup" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_landing_and_cleanup" name="landing-and-cleanup" isExecutable="false">
    <bpmn:exclusiveGateway id="n_EMAIL" name="Notice email lists how many newsletters?">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_ONE" name="Choose readlists: that sender selected, arrival hint">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_MANY" name="Per-newsletter links each select their sender with the arrival hint; Choose readlists opens the page with no sender">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_AUTH" name="Gmail page auth: login returns to the same URL">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PAGE" name="Gmail page: merge current-mailbox observed and discovered candidates">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_MON" name="Monitoring observations for the current mailbox"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_DISC" name="Gmail discovery and saved sender mappings"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_HINT" name="Brand border on picker and Save, first click dismisses">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CH" name="Notified sender unmapped and custom readlists exist?">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PEND" name="Save disabled: sender-bound pending choice">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_CONF" name="GET Confirm readlists: All-only is explicit">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_POST" name="POST senders add: authenticate, mailbox ownership, validate every readlist">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_MAP" name="Resolve readlist addresses and save sender mapping">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_FC" name="Rewrite Gmail filter Command">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_FQ" name="rewrite-gmail-filter SQS">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_FW" name="Existing filter Lambda: reconcile Gmail rules">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_FE" name="Gmail filter rewritten or rewrite failed Event">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_FD" name="Existing filter DLQ and alarm">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sendTask id="n_SUG" name="Submit newsletter sender Command">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_SQ" name="Existing newsletter suggestion queue">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_SW" name="Existing suggestion worker: ETag-conditional pending catalog suggestion">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_SE" name="Newsletter sender submitted Event">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sendTask id="n_IC" name="Start Gmail history import Command">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_IMP" name="Existing paginated import, ingest and outcomes chain">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_IE" name="Gmail history import completed or failed Event">
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_RESP" name="303 mapping saved, filter and optional import status">
      <bpmn:incoming>f_27</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_DEL" name="Delete account Command">
      <bpmn:outgoing>f_28</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_UQ" name="Existing user-data-jobs SQS">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:outgoing>f_29</bpmn:outgoing>
      <bpmn:outgoing>f_33</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_U" name="Existing account erasure worker">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_ERASE" name="Query and delete the whole monitoring partition, now including the NOTICE_BATCH row">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:outgoing>f_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_DE" name="Continue existing erasure, close account, log completion">
      <bpmn:incoming>f_32</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_UD" name="Existing user-data-jobs DLQ and alarm">
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="one" sourceRef="n_EMAIL" targetRef="n_ONE" />
    <bpmn:sequenceFlow id="f_1" name="several" sourceRef="n_EMAIL" targetRef="n_MANY" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_ONE" targetRef="n_AUTH" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_MANY" targetRef="n_AUTH" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_AUTH" targetRef="n_PAGE" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_PAGE" targetRef="n_HINT" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_PAGE" targetRef="n_CH" />
    <bpmn:sequenceFlow id="f_9" name="yes" sourceRef="n_CH" targetRef="n_PEND" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_PEND" targetRef="n_CONF" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_CONF" targetRef="n_PAGE" />
    <bpmn:sequenceFlow id="f_12" name="saved destinations, confirmed, ordinary entry or only All" sourceRef="n_CH" targetRef="n_POST" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_POST" targetRef="n_MAP" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_MAP" targetRef="n_FC" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_FC" targetRef="n_FQ" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_FQ" targetRef="n_FW" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_FW" targetRef="n_FE" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_FQ" targetRef="n_FD" />
    <bpmn:sequenceFlow id="f_20" name="catalog match not exact or unavailable" sourceRef="n_POST" targetRef="n_SUG" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_SUG" targetRef="n_SQ" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_SQ" targetRef="n_SW" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_SW" targetRef="n_SE" />
    <bpmn:sequenceFlow id="f_24" name="explicit import option" sourceRef="n_POST" targetRef="n_IC" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_IC" targetRef="n_IMP" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_IMP" targetRef="n_IE" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_POST" targetRef="n_RESP" />
    <bpmn:sequenceFlow id="f_28" name="" sourceRef="n_DEL" targetRef="n_UQ" />
    <bpmn:sequenceFlow id="f_29" name="" sourceRef="n_UQ" targetRef="n_U" />
    <bpmn:sequenceFlow id="f_30" name="" sourceRef="n_U" targetRef="n_ERASE" />
    <bpmn:sequenceFlow id="f_32" name="" sourceRef="n_ERASE" targetRef="n_DE" />
    <bpmn:sequenceFlow id="f_33" name="" sourceRef="n_UQ" targetRef="n_UD" />
    <bpmn:association id="f_5" sourceRef="n_MON" targetRef="n_PAGE" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_DISC" targetRef="n_PAGE" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_MAP" targetRef="n_DISC" associationDirection="One" />
    <bpmn:association id="f_31" sourceRef="n_ERASE" targetRef="n_MON" associationDirection="One" />
  </bpmn:process>
