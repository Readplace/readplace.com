<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_grouped_notice_delivery" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_grouped_notice_delivery" name="grouped-notice-delivery" isExecutable="false">
    <bpmn:sendTask id="n_C" name="Send Gmail newsletter notice Command: reader only">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="Gmail newsletter notice SQS, batch size 1">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_34</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_W" name="Notice Lambda: list every notice row for the reader and read the NOTICE_BATCH row">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_MON" name="Monitoring table: notice rows and per-reader NOTICE_BATCH row"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_B" name="Batch row state?">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_RETRY" name="Retry the stored grouped email, see batch claim and retry">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_HOLD1" name="Hold: log only, publish nothing, rows stay pending">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_P" name="Any pending notice?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_QUIET" name="Finish silently">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_RL" name="Reader owns a readlist besides All?">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_UA" name="User-articles table: readlist definitions, All has no row"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_HOLD2" name="Hold: log only, publish nothing, rows stay pending">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CAT" name="Catalog available?">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CATS" name="Newsletter catalog"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_FAIL" name="Fail record, SQS retries">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_ELIG" name="Recheck each pending notice: same connection, gateway, account and mailbox, still unmapped, still approved, account email on file">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CONN" name="Gmail connections, sender mappings, account email"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_CANCEL" name="Cancel the notice row">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_SUP" name="Gmail newsletter notice processed Event: suppressed, per sender">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_32</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_RENDER" name="Render ONE email listing every eligible newsletter, sorted by name, each with its own choice link, from Readplace">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_CLAIM" name="Claim the NOTICE_BATCH row with the senders, payload and key, see batch claim and retry">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_SEND" name="Resend adapter: one email to the account address">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_MARK" name="Mark every listed notice sent, pending to sent now allowed">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_SENT" name="Gmail newsletter notice processed Event: sent, one per listed sender">
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:outgoing>f_33</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_FIN" name="Finish batch: idle, lastSentAt now">
      <bpmn:incoming>f_27</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_LEG" name="Rows still sending from per-sender claims: resend each with its original payload">
      <bpmn:incoming>f_29</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_NEXT" name="Next six-hour check lists the pending rows again and dispatches another command">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:incoming>f_31</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_BUS" name="EventBridge: no downstream subscriber">
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_DLQ" name="Notice DLQ and operator alarm">
      <bpmn:incoming>f_34</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_C" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Q" targetRef="n_W" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_W" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_4" name="sending" sourceRef="n_B" targetRef="n_RETRY" />
    <bpmn:sequenceFlow id="f_5" name="idle, last notice email under 3 days ago" sourceRef="n_B" targetRef="n_HOLD1" />
    <bpmn:sequenceFlow id="f_6" name="absent, or idle for 3 days or more" sourceRef="n_B" targetRef="n_P" />
    <bpmn:sequenceFlow id="f_7" name="no" sourceRef="n_P" targetRef="n_QUIET" />
    <bpmn:sequenceFlow id="f_8" name="yes" sourceRef="n_P" targetRef="n_RL" />
    <bpmn:sequenceFlow id="f_10" name="no, only All" sourceRef="n_RL" targetRef="n_HOLD2" />
    <bpmn:sequenceFlow id="f_11" name="yes" sourceRef="n_RL" targetRef="n_CAT" />
    <bpmn:sequenceFlow id="f_13" name="unavailable" sourceRef="n_CAT" targetRef="n_FAIL" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_FAIL" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_15" name="available" sourceRef="n_CAT" targetRef="n_ELIG" />
    <bpmn:sequenceFlow id="f_17" name="ineligible" sourceRef="n_ELIG" targetRef="n_CANCEL" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_CANCEL" targetRef="n_SUP" />
    <bpmn:sequenceFlow id="f_20" name="none eligible" sourceRef="n_ELIG" targetRef="n_QUIET" />
    <bpmn:sequenceFlow id="f_21" name="eligible" sourceRef="n_ELIG" targetRef="n_RENDER" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_RENDER" targetRef="n_CLAIM" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_CLAIM" targetRef="n_SEND" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_SEND" targetRef="n_MARK" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_MARK" targetRef="n_SENT" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_SENT" targetRef="n_FIN" />
    <bpmn:sequenceFlow id="f_29" name="after the grouped pass, even when held" sourceRef="n_W" targetRef="n_LEG" />
    <bpmn:sequenceFlow id="f_30" name="" sourceRef="n_HOLD1" targetRef="n_NEXT" />
    <bpmn:sequenceFlow id="f_31" name="" sourceRef="n_HOLD2" targetRef="n_NEXT" />
    <bpmn:sequenceFlow id="f_32" name="" sourceRef="n_SUP" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_33" name="" sourceRef="n_SENT" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_34" name="receives exhausted" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:association id="f_2" sourceRef="n_MON" targetRef="n_W" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_UA" targetRef="n_RL" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_CATS" targetRef="n_CAT" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_CONN" targetRef="n_ELIG" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_CANCEL" targetRef="n_MON" associationDirection="One" />
    <bpmn:association id="f_25" sourceRef="n_MARK" targetRef="n_MON" associationDirection="One" />
    <bpmn:association id="f_28" sourceRef="n_FIN" targetRef="n_MON" associationDirection="One" />
  </bpmn:process>
