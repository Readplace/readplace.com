<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_mailbox_observations" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_mailbox_observations" name="mailbox-observations" isExecutable="false">
    <bpmn:sendTask id="n_CMD" name="Monitor Gmail newsletters Command">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_GATE" name="Check active matching connection and metadata scope">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CON" name="Gmail connections and credentials"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_STATE" name="Claim durable checkpoint page">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_DONE" name="Gmail newsletter monitoring progressed Event">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_MON" name="Monitoring checkpoint, observations and notice rows"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_PROFILE" name="Capture Gmail history cursor before baseline">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SEED" name="Page same-mailbox discovered senders on every check">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_BASE" name="Record recent 5000 metadata messages silently">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_DISC" name="Interactive Gmail discovery, separate cursor"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_API" name="Gmail metadata API">
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ARR" name="Page messageAdded arrivals after captured cursor">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SYNC" name="Paginated metadata resync, preserve notice history">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_SKIP" name="Exclude message">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_OBS" name="Keep sender and effective approval">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CAT" name="Approved newsletter catalog"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_REC" name="Page all observed senders; compare effective recognition">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_NOTICE" name="Persist pending notice row, keyed by user and actual sender">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:incoming>f_27</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_SEND" name="Gmail sender mappings"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_NP" name="Notices pages: list pending and still-sending senders, store them as dispatch replay">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:outgoing>f_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_CMD" targetRef="n_GATE" />
    <bpmn:sequenceFlow id="f_2" name="eligible" sourceRef="n_GATE" targetRef="n_STATE" />
    <bpmn:sequenceFlow id="f_3" name="inactive or stale command" sourceRef="n_GATE" targetRef="n_DONE" />
    <bpmn:sequenceFlow id="f_5" name="new mailbox" sourceRef="n_STATE" targetRef="n_PROFILE" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_PROFILE" targetRef="n_SEED" />
    <bpmn:sequenceFlow id="f_7" name="initialization" sourceRef="n_SEED" targetRef="n_BASE" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_API" targetRef="n_PROFILE" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_API" targetRef="n_BASE" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_BASE" targetRef="n_ARR" />
    <bpmn:sequenceFlow id="f_13" name="existing mailbox" sourceRef="n_STATE" targetRef="n_SEED" />
    <bpmn:sequenceFlow id="f_14" name="subsequent check" sourceRef="n_SEED" targetRef="n_ARR" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_API" targetRef="n_ARR" />
    <bpmn:sequenceFlow id="f_16" name="expired history cursor" sourceRef="n_ARR" targetRef="n_SYNC" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_SYNC" targetRef="n_ARR" />
    <bpmn:sequenceFlow id="f_18" name="spam, trash, draft, outbound-only" sourceRef="n_ARR" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_19" name="incoming sender" sourceRef="n_ARR" targetRef="n_OBS" />
    <bpmn:sequenceFlow id="f_22" name="arrivals complete" sourceRef="n_ARR" targetRef="n_REC" />
    <bpmn:sequenceFlow id="f_25" name="unapproved to approved, unmapped" sourceRef="n_REC" targetRef="n_NOTICE" />
    <bpmn:sequenceFlow id="f_26" name="new approved unmapped arrival" sourceRef="n_OBS" targetRef="n_NOTICE" />
    <bpmn:sequenceFlow id="f_27" name="observed sender became approved" sourceRef="n_SEED" targetRef="n_NOTICE" />
    <bpmn:sequenceFlow id="f_30" name="reconcile complete" sourceRef="n_REC" targetRef="n_NP" />
    <bpmn:sequenceFlow id="f_32" name="" sourceRef="n_NP" targetRef="n_DONE" />
    <bpmn:association id="f_1" sourceRef="n_CON" targetRef="n_GATE" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_MON" targetRef="n_STATE" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_DISC" targetRef="n_SEED" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_SEED" targetRef="n_MON" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_CAT" targetRef="n_OBS" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_OBS" targetRef="n_MON" associationDirection="One" />
    <bpmn:association id="f_23" sourceRef="n_CAT" targetRef="n_REC" associationDirection="One" />
    <bpmn:association id="f_24" sourceRef="n_MON" targetRef="n_REC" associationDirection="One" />
    <bpmn:association id="f_28" sourceRef="n_SEND" targetRef="n_NOTICE" associationDirection="One" />
    <bpmn:association id="f_29" sourceRef="n_NOTICE" targetRef="n_MON" associationDirection="One" />
    <bpmn:association id="f_31" sourceRef="n_MON" targetRef="n_NP" associationDirection="One" />
  </bpmn:process>
