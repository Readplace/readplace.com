<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_production_health" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_production_health" name="production-health" isExecutable="false">
    <bpmn:serviceTask id="n_SCHEDULE" name="Existing daily workflow or manual dispatch">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_LOCK" name="Single concurrency group; never cancel a running check">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_ORD" name="Ordinary sources: forced recrawl and reader assertion">
      <bpmn:incoming>f_1</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_LOGIN" name="Log in with the dedicated verified account">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_RED" name="Fail the run">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_SAVES" name="Sequential form saves: Wayback exact, Wayback calendar, direct original, archive.today">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_ATTEMPT" name="Require the attempt in the accepted save's response header">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_LOGS" name="Poll the selector log for this attempt's comparison with a fresh live candidate or live no-body">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_JUDGE" name="Require a completed judge response and the fresh wrapper id and body hash in the audit">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_BYTES" name="Read the stored evaluation body and verify its hash">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_WB" name="Wayback entry: fresh body readable with the expected text?">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_CARD" name="Require one original card at the top; same card across archive, calendar and direct saves">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_AT" name="archive.today entry: fresh article confirmed, or not confirmed with the real winner named">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_READER" name="Assert reader content and original link">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_REPORT" name="JSON artifact and run summary: attempt, capture, hashes, winner"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SCHEDULE" targetRef="n_LOCK" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_LOCK" targetRef="n_ORD" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_LOCK" targetRef="n_LOGIN" />
    <bpmn:sequenceFlow id="f_3" name="missing credentials or failed login" sourceRef="n_LOGIN" targetRef="n_RED" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_LOGIN" targetRef="n_SAVES" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_SAVES" targetRef="n_ATTEMPT" />
    <bpmn:sequenceFlow id="f_6" name="header missing" sourceRef="n_ATTEMPT" targetRef="n_RED" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_ATTEMPT" targetRef="n_LOGS" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_LOGS" targetRef="n_JUDGE" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_JUDGE" targetRef="n_BYTES" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_BYTES" targetRef="n_WB" />
    <bpmn:sequenceFlow id="f_11" name="no" sourceRef="n_WB" targetRef="n_RED" />
    <bpmn:sequenceFlow id="f_12" name="yes" sourceRef="n_WB" targetRef="n_CARD" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_BYTES" targetRef="n_AT" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_AT" targetRef="n_CARD" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_SAVES" targetRef="n_CARD" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_CARD" targetRef="n_READER" />
    <bpmn:association id="f_17" sourceRef="n_READER" targetRef="n_REPORT" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_RED" targetRef="n_REPORT" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_production_health">
