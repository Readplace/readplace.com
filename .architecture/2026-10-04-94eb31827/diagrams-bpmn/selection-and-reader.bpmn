<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_selection_and_reader" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_selection_and_reader" name="selection-and-reader" isExecutable="false">
    <bpmn:startEvent id="n_EVT" name="Tier extracted / recrawl extracted / refresh extracted / reselect after removal">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_Q" name="Existing selector queues and DLQs">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_LOAD" name="Load article, selection snapshot, named candidates, tier pointers and current canonical">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3" name="Immutable candidate manifests and bodies"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_DB" name="Article pointer, selection revision, pinned source and revoked candidate ids"></bpmn:dataStoreReference>
    <bpmn:task id="n_VERIFY" name="Keep candidates whose original, body hash, kind, revocation and wrapper source verify">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_AI" name="AI compares live, wrapper, extension and prior canonical bodies">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_VERDICT" name="Readability for every candidate plus winner / tie / none">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_RETRY" name="Fail the record; queue retries">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_FALLBACK" name="Deterministic tie rules over readable 2xx candidates">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_CHOOSE" name="Choose candidate; live beats an archive canonical on a tie; extension rules kept">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_KEEP" name="Retain the verified readable canonical">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_FAIL" name="Mark crawl failed under the snapshot condition">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_POINT" name="Check stored locations match the chosen bytes; materialize a legacy direct canonical only">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CAS" name="One conditional update: pointer, provenance, transition, summary reset; revision advanced">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_FACT" name="LinkSaved / AnonymousLinkSaved / CanonicalContentChanged / CrawlArticleCompleted">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_SUMMARY" name="Existing summary command, queue, generator and DLQ">
      <bpmn:incoming>f_19</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_READY" name="Summary written only against the selection and canonical hash it read"></bpmn:dataStoreReference>
    <bpmn:task id="n_VERSION" name="Append version reference to the immutable body under candidate and revision">
      <bpmn:incoming>f_21</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_LOG" name="Comparison log: attempt, candidates, body hashes, prompt hash, response status, winner">
      <bpmn:incoming>f_22</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_READ" name="Reader follows the committed pointer; withholds revoked, mismatched or unverified wrapper content">
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="n_UI" name="Article reader and original destination link">
      <bpmn:incoming>f_25</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_EVT" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Q" targetRef="n_LOAD" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_LOAD" targetRef="n_VERIFY" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_VERIFY" targetRef="n_AI" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_AI" targetRef="n_VERDICT" />
    <bpmn:sequenceFlow id="f_7" name="invalid response or provider error" sourceRef="n_VERDICT" targetRef="n_RETRY" />
    <bpmn:sequenceFlow id="f_8" name="provider rejected the request, HTTP 400" sourceRef="n_VERDICT" targetRef="n_FALLBACK" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_FALLBACK" targetRef="n_CHOOSE" />
    <bpmn:sequenceFlow id="f_10" name="winner or tie" sourceRef="n_VERDICT" targetRef="n_CHOOSE" />
    <bpmn:sequenceFlow id="f_11" name="none, verified prior exists" sourceRef="n_VERDICT" targetRef="n_KEEP" />
    <bpmn:sequenceFlow id="f_12" name="none, no prior, live not deferred" sourceRef="n_VERDICT" targetRef="n_FAIL" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_CHOOSE" targetRef="n_POINT" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_KEEP" targetRef="n_POINT" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_POINT" targetRef="n_CAS" />
    <bpmn:sequenceFlow id="f_17" name="condition failed" sourceRef="n_CAS" targetRef="n_RETRY" />
    <bpmn:sequenceFlow id="f_18" name="committed" sourceRef="n_CAS" targetRef="n_FACT" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_FACT" targetRef="n_SUMMARY" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_CAS" targetRef="n_VERSION" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_CAS" targetRef="n_LOG" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_READ" targetRef="n_UI" />
    <bpmn:association id="f_2" sourceRef="n_LOAD" targetRef="n_S3" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_LOAD" targetRef="n_DB" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_CAS" targetRef="n_DB" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_SUMMARY" targetRef="n_READY" associationDirection="One" />
    <bpmn:association id="f_23" sourceRef="n_DB" targetRef="n_READ" associationDirection="One" />
    <bpmn:association id="f_24" sourceRef="n_READY" targetRef="n_READ" associationDirection="One" />
  </bpmn:process>
