<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_maintenance" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_maintenance" name="maintenance" isExecutable="false">
    <bpmn:startEvent id="n_ADMIN" name="Admin recrawl with a fresh attempt">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="n_REC" name="RecrawlLinkInitiatedEvent">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_RQ" name="Existing recrawl queue and DLQ">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="n_REPAIR" name="Prepare identity; repair a wrapper-keyed original on the same row">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_FETCH" name="Live crawl plus pinned capture, as a save attempt">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_RECOUT" name="RecrawlContentExtractedEvent with candidate refs">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_SELECT" name="Shared verified selection and conditional commit">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_STALE" name="Existing freshness check">
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_ORIGINAL" name="Prepare identity; conditional fetch of the original">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_BACKOFF" name="Bump fetch timestamp; try next window">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_STAGE" name="Reader and evaluation bodies staged under a fresh attempt key"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_RCMD" name="RefreshArticleContentCommand with response URL, original and attempt">
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_FQ" name="Existing refresh queue and DLQ">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="n_PROOF" name="Require the fetched original to match current identity; write live candidate">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_FOUT" name="RefreshContentExtractedEvent with candidate refs">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="n_DELETE" name="RemoveMyContentCommand">
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_DQ" name="Existing removal queue and DLQ">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="n_OWN" name="Resolve authored version copy, tier slot, candidate manifests and image manifests">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_REVOKE" name="Add candidate ids to the revoked set; advance selection revision">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_ERASE" name="Delete bodies and images, then manifests; check each delete; prune versions">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_NEED" name="Canonical revoked or its legacy source gone?">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_DONE" name="Canonical pointer kept; legacy canonical copy deleted behind a committed candidate">
      <bpmn:incoming>f_19</bpmn:incoming>
    </bpmn:task>
    <bpmn:businessRuleTask id="n_REMAIN" name="Candidates or savers remain?">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateThrowEvent id="n_RESELECT" name="ReselectAfterRemovalEvent">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_PURGE" name="Purge storage prefixes, then tombstone and advance revision">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_ACCOUNT" name="Account deletion">
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_REVIVE" name="Later save revives the row in place; revoked set and revision kept">
      <bpmn:incoming>f_26</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_ADMIN" targetRef="n_REC" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_REC" targetRef="n_RQ" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_RQ" targetRef="n_REPAIR" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_REPAIR" targetRef="n_FETCH" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_FETCH" targetRef="n_RECOUT" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_RECOUT" targetRef="n_SELECT" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_STALE" targetRef="n_ORIGINAL" />
    <bpmn:sequenceFlow id="f_7" name="original not recoverable" sourceRef="n_ORIGINAL" targetRef="n_BACKOFF" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_RCMD" targetRef="n_FQ" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_FQ" targetRef="n_PROOF" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_PROOF" targetRef="n_FOUT" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_FOUT" targetRef="n_SELECT" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_DELETE" targetRef="n_DQ" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_DQ" targetRef="n_OWN" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_OWN" targetRef="n_REVOKE" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_REVOKE" targetRef="n_ERASE" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_ERASE" targetRef="n_NEED" />
    <bpmn:sequenceFlow id="f_19" name="no" sourceRef="n_NEED" targetRef="n_DONE" />
    <bpmn:sequenceFlow id="f_20" name="yes" sourceRef="n_NEED" targetRef="n_REMAIN" />
    <bpmn:sequenceFlow id="f_21" name="candidates with provenance" sourceRef="n_REMAIN" targetRef="n_RESELECT" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_RESELECT" targetRef="n_SELECT" />
    <bpmn:sequenceFlow id="f_23" name="savers only" sourceRef="n_REMAIN" targetRef="n_REC" />
    <bpmn:sequenceFlow id="f_24" name="neither" sourceRef="n_REMAIN" targetRef="n_PURGE" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_ACCOUNT" targetRef="n_PURGE" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_PURGE" targetRef="n_REVIVE" />
    <bpmn:association id="f_8" sourceRef="n_ORIGINAL" targetRef="n_STAGE" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_STAGE" targetRef="n_RCMD" associationDirection="One" />
  </bpmn:process>
