<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_capture_attempt" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_capture_attempt" name="capture-attempt" isExecutable="false">
    <bpmn:task id="n_CMD" name="Save command: original + capture + attempt">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="n_Q" name="Existing save worker queue and DLQ">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="n_IDENT" name="Prepare article identity; repair a wrapper-keyed original in place">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_WORK" name="Run live and capture crawls concurrently">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_LIVE" name="Live crawl of the original; keep the actual response as evaluation body">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_VERIFY" name="Capture still proves this original?">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_FAILED" name="ArchiveCaptureCrawlFailed">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_WRAP" name="Fetch the capture; keep the body whatever the status, CAPTCHA included">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_MEDIA" name="Finalize media under attempt and author scope">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_LSTATE" name="Live outcome">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_STORE" name="Candidate manifest first, then reader and evaluation bodies, then tier pointer"></bpmn:dataStoreReference>
    <bpmn:task id="n_NOBODY" name="Live outcome no-body">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_WAIT" name="Live outcome deferred; keep wrapper candidate refs">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_UNSUP" name="SimpleCrawlUnsupportedEvent with attempt and refs">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_POLICY" name="Existing comprehensive crawl policy">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_PDF" name="ComprehensiveCrawlCommand with the same attempt and refs">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_PQ" name="Existing comprehensive queue and DLQ">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_OCR" name="Comprehensive crawl and extraction">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_SECOND" name="Wrapper refs with live outcome no-body">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_EVT" name="TierContentExtractedEvent: candidate refs + attempt + live outcome">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_SELECT" name="Existing selector queue and DLQ">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_CMD" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Q" targetRef="n_IDENT" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_IDENT" targetRef="n_WORK" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_WORK" targetRef="n_LIVE" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_WORK" targetRef="n_VERIFY" />
    <bpmn:sequenceFlow id="f_5" name="no" sourceRef="n_VERIFY" targetRef="n_FAILED" />
    <bpmn:sequenceFlow id="f_6" name="yes" sourceRef="n_VERIFY" targetRef="n_WRAP" />
    <bpmn:sequenceFlow id="f_7" name="no body" sourceRef="n_WRAP" targetRef="n_FAILED" />
    <bpmn:sequenceFlow id="f_8" name="body" sourceRef="n_WRAP" targetRef="n_MEDIA" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_LIVE" targetRef="n_LSTATE" />
    <bpmn:sequenceFlow id="f_10" name="body, even unparseable or non-2xx" sourceRef="n_LSTATE" targetRef="n_MEDIA" />
    <bpmn:sequenceFlow id="f_12" name="classified failure" sourceRef="n_LSTATE" targetRef="n_NOBODY" />
    <bpmn:sequenceFlow id="f_13" name="unsupported body" sourceRef="n_LSTATE" targetRef="n_WAIT" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_WAIT" targetRef="n_UNSUP" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_UNSUP" targetRef="n_POLICY" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_POLICY" targetRef="n_PDF" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_PDF" targetRef="n_PQ" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_PQ" targetRef="n_OCR" />
    <bpmn:sequenceFlow id="f_20" name="no body or budget spent" sourceRef="n_OCR" targetRef="n_SECOND" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_NOBODY" targetRef="n_EVT" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_WAIT" targetRef="n_EVT" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_SECOND" targetRef="n_EVT" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_EVT" targetRef="n_SELECT" />
    <bpmn:association id="f_11" sourceRef="n_MEDIA" targetRef="n_STORE" associationDirection="One" />
    <bpmn:association id="f_19" sourceRef="n_OCR" targetRef="n_STORE" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_STORE" targetRef="n_EVT" associationDirection="One" />
  </bpmn:process>
