<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_save_surfaces" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_save_surfaces" name="save-surfaces" isExecutable="false">
    <bpmn:startEvent id="n_SINGLE" name="Web save bar / Siren single save / MCP save / newsletter-issue link save">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_NETRES" name="Resolve the wrapper chain in the request: local unwrap, stored binding, bounded network lookup">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="n_CONTENT" name="Extension HTML or PDF content intake">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_ANON" name="Anonymous reader visit">
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_BULK" name="Bulk save / import commit">
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_STORED" name="Resolve from local unwrap and stored binding only">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="n_INBOX" name="Inbox link producers">
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:sendTask id="n_SUB" name="SubmitLinkCommand with save attempt">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="n_KNOWN" name="Original resolved?">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_NOTICE" name="409 Siren notice / 303 queued notice / MCP pending / bulk entry flagged queued">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_REJECT" name="422 original-unresolved; nothing staged">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_ANONERR" name="422 error page; no article row">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="n_SQ" name="Existing submit queue and DLQ">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_BG" name="Submit worker resolves over the network, accepts and crawls in process">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_ACCEPT" name="Accept under the original identity; claim wrapper alias with source binding">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_QFAIL" name="LinkQueueFailed from the existing DLQ consumer">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_DB" name="Articles, aliases and user readlists"></bpmn:dataStoreReference>
    <bpmn:task id="n_PIN" name="Pin an archive-host source; mark direct content that predates the pin">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:task>
    <bpmn:sendTask id="n_CMD" name="SaveLinkCommand or SaveAnonymousLinkCommand: original + capture + attempt">
      <bpmn:incoming>f_19</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:task id="n_STAGE" name="Stage HTML or PDF under the attempt key">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_RAWCMD" name="SaveLinkRawHtmlCommand / SaveLinkRawPdfCommand with source and attempt">
      <bpmn:incoming>f_21</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_FACT" name="LinkQueued / QueueEntryCreated">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_RESP" name="303 to the readlist, Siren 201 or upload-slot entity carrying the attempt">
      <bpmn:incoming>f_23</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SINGLE" targetRef="n_NETRES" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_CONTENT" targetRef="n_NETRES" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_ANON" targetRef="n_NETRES" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_BULK" targetRef="n_STORED" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_INBOX" targetRef="n_SUB" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_NETRES" targetRef="n_KNOWN" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_STORED" targetRef="n_KNOWN" />
    <bpmn:sequenceFlow id="f_7" name="no, URL save or inline content" sourceRef="n_KNOWN" targetRef="n_SUB" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_SUB" targetRef="n_NOTICE" />
    <bpmn:sequenceFlow id="f_9" name="no, upload slot or completion" sourceRef="n_KNOWN" targetRef="n_REJECT" />
    <bpmn:sequenceFlow id="f_10" name="no, anonymous first visit" sourceRef="n_KNOWN" targetRef="n_ANONERR" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_SUB" targetRef="n_SQ" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_SQ" targetRef="n_BG" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_BG" targetRef="n_ACCEPT" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_SQ" targetRef="n_QFAIL" />
    <bpmn:sequenceFlow id="f_15" name="yes" sourceRef="n_KNOWN" targetRef="n_ACCEPT" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_ACCEPT" targetRef="n_PIN" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_ACCEPT" targetRef="n_CMD" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_ACCEPT" targetRef="n_STAGE" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_STAGE" targetRef="n_RAWCMD" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_ACCEPT" targetRef="n_FACT" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_ACCEPT" targetRef="n_RESP" />
    <bpmn:association id="f_16" sourceRef="n_ACCEPT" targetRef="n_DB" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_PIN" targetRef="n_DB" associationDirection="One" />
  </bpmn:process>
