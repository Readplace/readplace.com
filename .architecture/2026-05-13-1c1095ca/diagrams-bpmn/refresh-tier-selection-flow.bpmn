<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_refresh_tier_selection_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_refresh_tier_selection_flow" name="refresh-tier-selection-flow" isExecutable="false">
    <bpmn:startEvent id="n_SCE" name="StaleCheckRequestedEvent url">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_Bus" name="EventBridge default-bus">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_QSCE" name="stale-check-requested vis 60s">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_SCWorker" name="stale-check-requested Lambda refreshArticleIfStale">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Origin" name="Origin HTTP/2 fetch conditional GET etag/lastModified">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_Decision" name="action">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_UFT" name="UpdateFetchTimestampCommand bookkeeping only">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SAL" name="SaveAnonymousLinkCommand re-prime crawl pipeline">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_Noop" name="no-op">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_RAC" name="RefreshArticleContentCommand url, html, metadata, etag, lastModified, contentFetchedAt">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_QRAC" name="refresh-article-content vis 60s">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="n_RACWorker" name="refresh-article-content Lambda putTierSource tier-1 + publishEvent">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:dataStoreReference id="n_S3Tier1" name="S3 articles/&lt;id&gt;/sources/tier-1.html + tier-1.metadata.json"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_RFCE" name="RefreshContentExtractedEvent url, etag, lastModified, contentFetchedAt">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:dataStoreReference id="n_QRFCE" name="refresh-content-extracted vis 90s"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_RFCEWorker" name="refresh-content-extracted Lambda list sources, Deepseek if competition, promote winner, refreshContent transition">
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3Tier0" name="S3 articles/&lt;id&gt;/sources/tier-0.html + sidecar; preserved across refreshes"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_S3Canon" name="S3 content/&lt;id&gt;/content.html canonical bytes"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Articles" name="DynamoDB articles metadata, etag, lastModified, contentFetchedAt, contentSourceTier"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_TieNote" name="Tie on refresh: keep existing canonical tier default tier-1 if no prior canonical">
      <bpmn:incoming>f_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SCE" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Bus" targetRef="n_QSCE" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_QSCE" targetRef="n_SCWorker" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SCWorker" targetRef="n_Origin" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_SCWorker" targetRef="n_Decision" />
    <bpmn:sequenceFlow id="f_5" name="304 unchanged" sourceRef="n_Decision" targetRef="n_UFT" />
    <bpmn:sequenceFlow id="f_6" name="new / reprime" sourceRef="n_Decision" targetRef="n_SAL" />
    <bpmn:sequenceFlow id="f_7" name="skip" sourceRef="n_Decision" targetRef="n_Noop" />
    <bpmn:sequenceFlow id="f_8" name="200 refreshed" sourceRef="n_Decision" targetRef="n_RAC" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_RAC" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Bus" targetRef="n_QRAC" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_QRAC" targetRef="n_RACWorker" />
    <bpmn:sequenceFlow id="f_13" name="publish" sourceRef="n_RACWorker" targetRef="n_RFCE" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_RFCE" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_21" name="tie handling" sourceRef="n_RFCEWorker" targetRef="n_TieNote" />
    <bpmn:association id="f_12" sourceRef="n_RACWorker" targetRef="n_S3Tier1" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_Bus" targetRef="n_QRFCE" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_QRFCE" targetRef="n_RFCEWorker" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_RFCEWorker" targetRef="n_S3Tier0" associationDirection="Both" />
    <bpmn:association id="f_18" sourceRef="n_RFCEWorker" targetRef="n_S3Tier1" associationDirection="Both" />
    <bpmn:association id="f_19" sourceRef="n_RFCEWorker" targetRef="n_S3Canon" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_RFCEWorker" targetRef="n_Articles" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_refresh_tier_selection_flow">
