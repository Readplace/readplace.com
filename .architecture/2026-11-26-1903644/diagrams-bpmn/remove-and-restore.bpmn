<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_remove_and_restore" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_remove_and_restore" name="remove-and-restore" isExecutable="false">
    <bpmn:sendTask id="n_PAGE" name="Inbox: Newsletter Links Removal page">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_COUNT" name="RunSavedLinksJobCommand count">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_REMOVE" name="RunSavedLinksJobCommand remove">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_RESTORE" name="RunSavedLinksJobCommand restore">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="user-data-jobs queue and Lambda">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DLQ" name="user-data-jobs-dlq">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_COUNTER" name="Count links, issues by sender and held rows">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_JOBROW" name="Saved-links job row"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_LINKS" name="Hold each chosen link with its readlist copies">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ALL" name="All and readlist partitions"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_HOLD" name="Removed-links hold partition"></bpmn:dataStoreReference>
    <bpmn:task id="n_ISSUES" name="Hold each chosen issue and mark its email">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_SCHEDULE" name="Create removed-issues schedule at run start plus 30 days and an hour">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_EMAILS" name="Inbox email rows"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_DEQ" name="LinkDequeued">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_BACK" name="Restore held links and issues to All and live readlists">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_CLEAR" name="Clear the mark on each chosen email">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="n_QUEUED" name="LinkQueued">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_DONE" name="SavedLinksJobCompleted or SavedLinksJobFailed">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_PAGE" targetRef="n_COUNT" />
    <bpmn:sequenceFlow id="f_1" name="popup confirmed" sourceRef="n_PAGE" targetRef="n_REMOVE" />
    <bpmn:sequenceFlow id="f_2" name="Restore removed links" sourceRef="n_PAGE" targetRef="n_RESTORE" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_COUNT" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_REMOVE" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_RESTORE" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_6" name="12th receive" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Q" targetRef="n_COUNTER" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_Q" targetRef="n_LINKS" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_LINKS" targetRef="n_ISSUES" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_ISSUES" targetRef="n_SCHEDULE" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_LINKS" targetRef="n_DEQ" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_Q" targetRef="n_BACK" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_BACK" targetRef="n_CLEAR" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_BACK" targetRef="n_QUEUED" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_Q" targetRef="n_DONE" />
    <bpmn:association id="f_8" sourceRef="n_COUNTER" targetRef="n_JOBROW" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_LINKS" targetRef="n_ALL" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_LINKS" targetRef="n_HOLD" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_ISSUES" targetRef="n_HOLD" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_ISSUES" targetRef="n_EMAILS" associationDirection="One" />
    <bpmn:association id="f_19" sourceRef="n_CLEAR" targetRef="n_EMAILS" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_remove_and_restore">
