<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_purge" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_purge" name="purge" isExecutable="false">
    <bpmn:serviceTask id="n_SCHED" name="EventBridge Scheduler one-off">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_PURGE" name="PurgeRemovedNewsletterIssuesCommand">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="user-data-jobs queue and Lambda">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DLQ" name="user-data-jobs-dlq">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_DUE" name="Email marked 30 days ago?">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_KEEP" name="Leave the email"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_INALL" name="Issue back in All?">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_SHOW" name="Clear the mark">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_DELETE" name="Delete raw and rendered copies, images, link and identity rows, the issue content with a tombstone, then the email row">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_EMAILS" name="Inbox email rows"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_S3" name="Raw-email and content buckets"></bpmn:dataStoreReference>
    <bpmn:task id="n_PURGED" name="RemovedNewsletterIssuesPurged">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SCHED" targetRef="n_PURGE" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_PURGE" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_2" name="12th receive" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Q" targetRef="n_DUE" />
    <bpmn:sequenceFlow id="f_5" name="Yes" sourceRef="n_DUE" targetRef="n_INALL" />
    <bpmn:sequenceFlow id="f_6" name="Yes" sourceRef="n_INALL" targetRef="n_SHOW" />
    <bpmn:sequenceFlow id="f_7" name="No" sourceRef="n_INALL" targetRef="n_DELETE" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_DELETE" targetRef="n_PURGED" />
    <bpmn:association id="f_4" sourceRef="n_DUE" targetRef="n_KEEP" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_SHOW" targetRef="n_EMAILS" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_DELETE" targetRef="n_EMAILS" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_DELETE" targetRef="n_S3" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_purge">
    <bpmndi:BPMNPlane id="Plane_purge" bpmnElement="Process_purge">
      <bpmndi:BPMNShape id="n_SCHED_di" bpmnElement="n_SCHED">
        <dc:Bounds x="233.31" y="28" width="169.25" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_PURGE_di" bpmnElement="n_PURGE">
        <dc:Bounds x="218.31" y="138" width="199.25" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Q_di" bpmnElement="n_Q">
