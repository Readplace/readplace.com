<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_failure_paths" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_failure_paths" name="failure-paths" isExecutable="false">
    <bpmn:serviceTask id="n_Worker" name="saveLinkWork or anonymous variant">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Crawl" name="crawlArticle result">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_TerminalCrawl" name="status !== fetched?">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_LogPE1" name="logParseError reason = crawl-&lt;status&gt;">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_MCF1" name="markCrawlFailed crawlStatus=failed crawlFailureReason">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Articles1" name="DynamoDB articles crawlStatus=failed"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Parse" name="parseHtml">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ParseOk" name="parseResult.ok?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Happy" name="markCrawlReady publish LinkSaved / AnonymousLinkSaved">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_LogPE2" name="logParseError reason = Readability.parse failed, Invalid URL, etc.">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_MCF2" name="markCrawlFailed immediate, sync">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Articles2" name="DynamoDB articles crawlStatus=failed"></bpmn:dataStoreReference>
    <bpmn:task id="n_Retry" name="[SQS retry maxReceiveCount">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="n_DLQ" name="save-link-command-dlq save-anonymous-link-dlq save-link-raw-html-command-dlq">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="n_DLQHandler" name="HutchDLQEventHandler SaveLink/SaveAnonymousLink DLQ consumer">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_MCF3" name="markCrawlFailed reason = exceeded SQS maxReceiveCount receiveCount=N">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Articles3" name="DynamoDB articles crawlStatus=failed"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_CAFE" name="CrawlArticleFailedEvent url, reason, receiveCount">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:dataStoreReference id="n_ParseErrorsLog" name="parse-errors log CloudWatch"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_AdminEmail" name="admin alertEmail DLQ arrival">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="n_ReaderUI" name="view/read reader UI renders verify-banner + crawl-failed state"></bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Worker" targetRef="n_Crawl" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Crawl" targetRef="n_TerminalCrawl" />
    <bpmn:sequenceFlow id="f_2" name="yes" sourceRef="n_TerminalCrawl" targetRef="n_LogPE1" />
    <bpmn:sequenceFlow id="f_3" name="throw reraises but state already written by DLQ on retries" sourceRef="n_LogPE1" targetRef="n_MCF1" />
    <bpmn:sequenceFlow id="f_5" name="no, fetched" sourceRef="n_TerminalCrawl" targetRef="n_Parse" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Parse" targetRef="n_ParseOk" />
    <bpmn:sequenceFlow id="f_7" name="yes" sourceRef="n_ParseOk" targetRef="n_Happy" />
    <bpmn:sequenceFlow id="f_8" name="no, terminal" sourceRef="n_ParseOk" targetRef="n_LogPE2" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_LogPE2" targetRef="n_MCF2" />
    <bpmn:sequenceFlow id="f_11" name="throws" sourceRef="n_Worker" targetRef="n_Retry" />
    <bpmn:sequenceFlow id="f_12" name="exhausted" sourceRef="n_Retry" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_DLQ" targetRef="n_DLQHandler" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_DLQHandler" targetRef="n_MCF3" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_DLQHandler" targetRef="n_CAFE" />
    <bpmn:sequenceFlow id="f_18" name="CloudWatch alarm" sourceRef="n_CAFE" targetRef="n_AdminEmail" />
    <bpmn:association id="f_4" sourceRef="n_MCF1" targetRef="n_Articles1" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_MCF2" targetRef="n_Articles2" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_MCF3" targetRef="n_Articles3" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_CAFE" targetRef="n_ParseErrorsLog" associationDirection="One" />
    <bpmn:association id="f_19" sourceRef="n_Articles1" targetRef="n_ReaderUI" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_Articles2" targetRef="n_ReaderUI" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_Articles3" targetRef="n_ReaderUI" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_failure_paths">
