      <bpmndi:BPMNEdge id="f_9_di" bpmnElement="f_9">
        <di:waypoint x="276.73" y="618.75" />
        <di:waypoint x="276.73" y="657.13" />
        <di:waypoint x="342.47" y="657.13" />
