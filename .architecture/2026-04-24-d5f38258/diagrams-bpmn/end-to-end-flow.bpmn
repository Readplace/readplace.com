<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:businessRuleTask id="n_WebForm" name="POST /queue authenticated form">
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_SaveHtml" name="POST /queue/save-html browser extension, rendered DOM">
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_View" name="GET /view/&lt;url&gt; anonymous share link">
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_Recrawl" name="GET /admin/recrawl/&lt;url&gt; admin, bypasses TTL">
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_Articles" name="DynamoDB articles table"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_S3Pending" name="S3 pending-html bucket"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Articles2" name="DynamoDB articles table"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Articles3" name="DynamoDB articles table"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Articles4" name="DynamoDB articles table"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_SLC" name="SaveLinkCommand url, userId">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SLRHC" name="SaveLinkRawHtmlCommand url, userId, title?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SALC1" name="SaveAnonymousLinkCommand url">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SALC2" name="SaveAnonymousLinkCommand url">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Bus" name="EventBridge bus hutch default-bus">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_QSL" name="save-link-command vis 60s">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_QSLRH" name="save-link-raw-html-command vis 60s">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_QSAL" name="save-anonymous-link-command vis 60s">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_WSL" name="save-link-command Lambda saveLinkWork">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_WSLRH" name="save-link-raw-html-command Lambda Tier-0: skips HTTP fetch">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_40</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_WSAL" name="save-anonymous-link-command Lambda saveLinkWork anonymous">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_39</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Crawl" name="crawlArticle HTTP waterfall">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_PendingRead" name="S3 pending-html GetObject"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Parse" name="parseHtml sitePreParsers → Readability">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_DL" name="downloadMedia + processContent">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3Content" name="S3 content-bucket articles/&lt;id&gt;/content.html images/&lt;hash&gt;.&lt;ext&gt;"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Meta" name="updateArticleMetadata updateContentLocation updateFetchTimestamp updateThumbnailUrl">
      <bpmn:incoming>f_26</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ArticlesReady" name="DynamoDB crawlStatus=ready"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_LSE" name="LinkSavedEvent url, userId">
      <bpmn:outgoing>f_31</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_ALSE" name="AnonymousLinkSavedEvent url">
      <bpmn:outgoing>f_33</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_CAC" name="CrawlArticleCompletedEvent url">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_LinkSavedHandler" name="link-saved Lambda">
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:outgoing>f_32</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_AnonLinkSavedHandler" name="anonymous-link-saved Lambda">
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:outgoing>f_34</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_GSC" name="GenerateSummaryCommand → summary pipeline">
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:incoming>f_34</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_FailPath" name="Failure path see failure-paths diagram">
      <bpmn:incoming>f_38</bpmn:incoming>
      <bpmn:incoming>f_39</bpmn:incoming>
      <bpmn:incoming>f_40</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_5" name="publish" sourceRef="n_WebForm" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_6" name="publish" sourceRef="n_SaveHtml" targetRef="n_SLRHC" />
    <bpmn:sequenceFlow id="f_7" name="publish" sourceRef="n_View" targetRef="n_SALC1" />
    <bpmn:sequenceFlow id="f_8" name="publish" sourceRef="n_Recrawl" targetRef="n_SALC2" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_SLC" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_SLRHC" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_SALC1" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_SALC2" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Bus" targetRef="n_QSL" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_Bus" targetRef="n_QSLRH" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_Bus" targetRef="n_QSAL" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_QSL" targetRef="n_WSL" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_QSLRH" targetRef="n_WSLRH" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_QSAL" targetRef="n_WSAL" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_WSL" targetRef="n_Crawl" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_WSAL" targetRef="n_Crawl" />
    <bpmn:sequenceFlow id="f_23" name="status=fetched" sourceRef="n_Crawl" targetRef="n_Parse" />
    <bpmn:sequenceFlow id="f_24" name="ok, article" sourceRef="n_Parse" targetRef="n_DL" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_DL" targetRef="n_Meta" />
    <bpmn:sequenceFlow id="f_31" name="" sourceRef="n_LSE" targetRef="n_LinkSavedHandler" />
    <bpmn:sequenceFlow id="f_32" name="" sourceRef="n_LinkSavedHandler" targetRef="n_GSC" />
    <bpmn:sequenceFlow id="f_33" name="" sourceRef="n_ALSE" targetRef="n_AnonLinkSavedHandler" />
    <bpmn:sequenceFlow id="f_34" name="" sourceRef="n_AnonLinkSavedHandler" targetRef="n_GSC" />
    <bpmn:sequenceFlow id="f_38" name="terminal parse error or crawl failed" sourceRef="n_WSL" targetRef="n_FailPath" />
    <bpmn:sequenceFlow id="f_39" name="terminal parse error or crawl failed" sourceRef="n_WSAL" targetRef="n_FailPath" />
    <bpmn:sequenceFlow id="f_40" name="terminal parse error" sourceRef="n_WSLRH" targetRef="n_FailPath" />
    <bpmn:association id="f_0" sourceRef="n_WebForm" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_1" sourceRef="n_SaveHtml" targetRef="n_S3Pending" associationDirection="One" />
    <bpmn:association id="f_2" sourceRef="n_SaveHtml" targetRef="n_Articles2" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_View" targetRef="n_Articles3" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_Recrawl" targetRef="n_Articles4" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_WSLRH" targetRef="n_PendingRead" associationDirection="One" />
    <bpmn:association id="f_22" sourceRef="n_PendingRead" targetRef="n_Parse" associationDirection="One" />
    <bpmn:association id="f_25" sourceRef="n_DL" targetRef="n_S3Content" associationDirection="One" />
    <bpmn:association id="f_27" sourceRef="n_Meta" targetRef="n_ArticlesReady" associationDirection="One" />
    <bpmn:association id="f_28" sourceRef="n_ArticlesReady" targetRef="n_LSE" associationDirection="One" />
    <bpmn:association id="f_29" sourceRef="n_ArticlesReady" targetRef="n_ALSE" associationDirection="One" />
    <bpmn:association id="f_30" sourceRef="n_ArticlesReady" targetRef="n_CAC" associationDirection="One" />
    <bpmn:association id="f_35" sourceRef="n_WSL" targetRef="n_ArticlesReady" associationDirection="One" />
    <bpmn:association id="f_36" sourceRef="n_WSAL" targetRef="n_ArticlesReady" associationDirection="One" />
    <bpmn:association id="f_37" sourceRef="n_WSLRH" targetRef="n_ArticlesReady" associationDirection="One" />
  </bpmn:process>
