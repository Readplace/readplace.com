<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_filing_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_filing_flow" name="filing-flow" isExecutable="false">
    <bpmn:businessRuleTask id="n_BUS" name="EventBridge bus no publisher yet">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_CMD" name="FileArticleIntoReadlistCommand userId, url, readlist, provenance, fit">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_RULE" name="file-article-into-readlist-command-rule">
      <bpmn:incoming>f_1</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Q" name="file-article-into-readlist-q 300 s visibility, 5 receives"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_DLQ" name="file-article-into-readlist-dlq 14 days, topic, email, alarm">

      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_L" name="file-article-into-readlist Lambda">
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_LOOKUP" name="Prepare the URL as a save does, follow its alias, read the All row">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_ALIAS" name="Articles table article and alias rows"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_ALL" name="User-articles table All and readlist rows"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_WAIT" name="Not in All yet: INFO wait line, record fails, SQS redelivers">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_FILE" name="File into the readlist; a read article resurfaces as unread">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_FACT" name="ArticleFiledIntoReadlistEvent userId, readlist, resolved url, source">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_NONE" name="No subscriber yet">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_BUS" targetRef="n_CMD" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_CMD" targetRef="n_RULE" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_L" targetRef="n_LOOKUP" />
    <bpmn:sequenceFlow id="f_8" name="not saved" sourceRef="n_LOOKUP" targetRef="n_WAIT" />
    <bpmn:sequenceFlow id="f_10" name="saved" sourceRef="n_LOOKUP" targetRef="n_FILE" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_FILE" targetRef="n_FACT" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_FACT" targetRef="n_NONE" />
    <bpmn:association id="f_2" sourceRef="n_RULE" targetRef="n_Q" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_Q" targetRef="n_L" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_Q" targetRef="n_DLQ" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_LOOKUP" targetRef="n_ALIAS" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_LOOKUP" targetRef="n_ALL" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_WAIT" targetRef="n_Q" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_FILE" targetRef="n_ALL" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_filing_flow">
    <bpmndi:BPMNPlane id="Plane_filing_flow" bpmnElement="Process_filing_flow">
      <bpmndi:BPMNShape id="n_BUS_di" bpmnElement="n_BUS">
