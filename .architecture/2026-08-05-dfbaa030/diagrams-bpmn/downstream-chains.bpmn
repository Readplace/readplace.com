    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_CCC" targetRef="n_CCCL" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_ALS" targetRef="n_ALSL" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_CCCL" targetRef="n_GS" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_ALSL" targetRef="n_GS" />
