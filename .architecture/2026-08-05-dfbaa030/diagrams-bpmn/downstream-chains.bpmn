    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_E2" targetRef="n_QC" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_QC" targetRef="n_LC" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_LC" targetRef="n_Def" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_LC" targetRef="n_Term1" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_LC" targetRef="n_RCE" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_Def" targetRef="n_RCE" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_RCE" targetRef="n_QRC" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_QRC" targetRef="n_LRC" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_LRC" targetRef="n_RCEout" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_RCEout" targetRef="n_CCCL" />
    <bpmn:sequenceFlow id="f_25" name="receives exhausted" sourceRef="n_QR" targetRef="n_SD" />
    <bpmn:sequenceFlow id="f_26" name="1 receive" sourceRef="n_QC" targetRef="n_SD" />
    <bpmn:sequenceFlow id="f_27" name="receives exhausted" sourceRef="n_QRC" targetRef="n_SD" />
    <bpmn:sequenceFlow id="f_28" name="" sourceRef="n_SD" targetRef="n_DR" />
    <bpmn:sequenceFlow id="f_29" name="" sourceRef="n_DR" targetRef="n_CAF" />
    <bpmn:association id="f_6" sourceRef="n_Sel" targetRef="n_Write" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_Write" targetRef="n_CCC" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_Write" targetRef="n_CACo2" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_Write" targetRef="n_ALS" associationDirection="One" />
  </bpmn:process>
