<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_downstream_chains" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_downstream_chains" name="downstream-chains" isExecutable="false">
    <bpmn:startEvent id="n_E1" name="ReselectAfterRemovalEvent">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_E2" name="RecrawlLinkInitiatedEvent">
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_QR" name="reselect-after-removal queue SELECT_CONTENT visibility shared failures DLQ">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_LR" name="reselect-after-removal Lambda 3008 MB normalise: no userId, tier-1, no extractedAt delegates to the selection core">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Sel" name="selection core list sources; 1 source wins outright, 2+ go to the Deepseek selector, ties resolved against the current canonical">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_NoSrc" name="0 sources -&gt; throw -&gt; SQS retry race between S3 write and delivery">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Keep" name="tie resolves to keep-canonical">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_CACo" name="CrawlArticleCompletedEvent no subscriber — telemetry terminal">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_Write" name="writeCanonicalContent — S3 copy tier source -&gt; canonical recordCrawlVersion when tier flipped or text changed stamps ONLY the winner's authorUserId promoteTier aggregate transition"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_CCC" name="CanonicalContentChangedEvent tier flipped OR readable text changed">
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_CACo2" name="CrawlArticleCompletedEvent every successful selection">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="n_ALS" name="AnonymousLinkSavedEvent only when canonical flipped; anonymous variant because reselect passes no userId">
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_CCCL" name="canonical-content-changed Lambda markSummaryPending, preserves pendingSince">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_ALSL" name="anonymous-link-saved Lambda waits for canonical S3 to be readable">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="n_GS" name="generate-summary queue">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_GSL" name="generate-summary Lambda existing summary pipeline — boundary of this snapshot">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_QC" name="recrawl-link-initiated queue visibility 480s, maxReceiveCount 1 shared failures DLQ">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_LC" name="recrawl-link-initiated Lambda simple crawl of the public URL writes a fresh tier-1 source">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_Def" name="non-HTML body -&gt; SimpleCrawlUnsupportedEvent -&gt; policy -&gt; ComprehensiveCrawlCommand which emits the same event when it lands">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_Term1" name="tier-1-terminal — origin no longer serves the page no event, record acked">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_RCE" name="RecrawlContentExtractedEvent">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_QRC" name="recrawl-content-extracted queue shared failures DLQ">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_LRC" name="recrawl-content-extracted Lambda selector over all surviving sources recrawlPromoteTier">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_RCEout" name="CanonicalContentChanged + RecrawlCompleted RecrawlCompleted has no subscriber — terminal">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_SD" name="save-link-failures DLQ shared by both queues">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="n_DR" name="DLQ router — dispatch by source queue name markCrawlExhausted: crawl=failed, summary=failed">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:outgoing>f_29</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_CAF" name="CrawlArticleFailedEvent no subscriber — terminal fact">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_E1" targetRef="n_QR" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_QR" targetRef="n_LR" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_LR" targetRef="n_Sel" />
