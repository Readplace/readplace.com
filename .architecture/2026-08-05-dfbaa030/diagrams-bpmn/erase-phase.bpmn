<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_erase_phase" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_erase_phase" name="erase-phase" isExecutable="false">
    <bpmn:intermediateCatchEvent id="n_Q" name="remove-my-content-command queue visibility 60s">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_L" name="remove-my-content-command Lambda 256 MB / 60 s / batchSize 1">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_Parse" name="RemoveMyContentCommand.detailSchema.parse versionMinuteId now REQUIRED">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_Fail" name="batchItemFailures + logger.error">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_D" name="remove-my-content-command DLQ alarm + SNS email, NO consumer">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_Res" name="resolveAuthoredContentKeys url, userId, versionMinuteId">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Rows" name="articles row, projection crawlVersions"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_All" name="allAuthored = entries where authorUserId = userId named = allAuthored where minuteId = versionMinuteId">
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Keys" name="objectKeys = version snapshot key per named entry pruneMinuteIds = their minute ids">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_Last" name="LAST authored snapshot? allAuthored.length = 1 AND named.length = 1">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_Sidecar" name="GET sources/tier-0.json sidecar NoSuchKey or malformed JSON -&gt; treat as unauthored, never throw"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Cred" name="sidecar authorUserId = userId?">
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_Add" name="append tier-0 source object + tier-0 metadata sidecar to objectKeys">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Del" name="deleteContentObjects S3 DeleteObjects, 1000-key batches empty list issues no request"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Prune" name="pruneCrawlVersions read + CAS UpdateItem on crawlVersions already-absent ids are a no-op"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Log" name="logger.info authored objects removed url, objectCount">
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Next" name="-&gt; repair phase, section 3">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Q" targetRef="n_L" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_L" targetRef="n_Parse" />
    <bpmn:sequenceFlow id="f_2" name="throws" sourceRef="n_Parse" targetRef="n_Fail" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Fail" targetRef="n_D" />
    <bpmn:sequenceFlow id="f_4" name="ok" sourceRef="n_Parse" targetRef="n_Res" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_All" targetRef="n_Keys" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_All" targetRef="n_Last" />
    <bpmn:sequenceFlow id="f_9" name="no" sourceRef="n_Last" targetRef="n_Keys" />
    <bpmn:sequenceFlow id="f_12" name="yes" sourceRef="n_Cred" targetRef="n_Add" />
    <bpmn:sequenceFlow id="f_13" name="no" sourceRef="n_Cred" targetRef="n_Keys" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_Add" targetRef="n_Keys" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_Log" targetRef="n_Next" />
    <bpmn:association id="f_5" sourceRef="n_Res" targetRef="n_Rows" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_Rows" targetRef="n_All" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_Last" targetRef="n_Sidecar" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_Sidecar" targetRef="n_Cred" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_Keys" targetRef="n_Del" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_Del" targetRef="n_Prune" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_Prune" targetRef="n_Log" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_erase_phase">
    <bpmndi:BPMNPlane id="Plane_erase_phase" bpmnElement="Process_erase_phase">
      <bpmndi:BPMNShape id="n_Q_di" bpmnElement="n_Q">
        <dc:Bounds x="206.5" y="28" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_L_di" bpmnElement="n_L">
        <dc:Bounds x="127.5" y="171.5" width="198" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Parse_di" bpmnElement="n_Parse">
