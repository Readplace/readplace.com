<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_export_user_data" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_export_user_data" name="export-user-data" isExecutable="false">
    <bpmn:serviceTask id="n_UI" name="GET /export — Download your data">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Route" name="POST /export/start — hutch web Lambda">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Email" name="findEmailByUserId"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_NoEmail" name="no email -&gt; logError + 303 /export nothing published"></bpmn:serviceTask>
    <bpmn:sendTask id="n_Cmd" name="ExportUserDataCommand source hutch.api detail: userId, email, requestedAt">
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_R303" name="303 /export?status=preparing">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Bus" name="EventBridge — shared platform bus">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="user-data-jobs queue visibility 900s, maxReceiveCount 12 shared with DeleteAccountCommand">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_L" name="user-data-jobs Lambda — 1024 MB / 900 s routes by detail-type; unrouted type dead-letters">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_H" name="export-user-data handler">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Page" name="findArticlesByUser — 500 per page, excludeContent loop until an empty page"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Up" name="PutObject exports/userId/timestamp.json ContentDisposition attachment presign GetObject for 7 days"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Mail" name="Resend — 'Your Readplace export is ready' download link + article count + 7-day expiry copy">
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_Ev" name="UserDataExported source hutch.export-user-data detail: userId, articleCount, s3Key, exportedAt NO SUBSCRIBER — terminal fact">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_Life" name="bucket lifecycle expires exports/ after 7 days account deletion also deletes exports/userId/"></bpmn:dataStoreReference>
    <bpmn:intermediateCatchEvent id="n_D" name="user-data-jobs DLQ alarm + SNS email, no consumer THE failure signal for this flow">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_W" name="WITHDRAWN: UserDataExportFailedEvent declared at design time, never emitted, never subscribed — deleted in this snapshot">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_UI" targetRef="n_Route" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Route" targetRef="n_R303" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Cmd" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Bus" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Q" targetRef="n_L" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_L" targetRef="n_H" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Mail" targetRef="n_Ev" />
    <bpmn:sequenceFlow id="f_14" name="throw -&gt; batchItemFailure -&gt; 12 receives" sourceRef="n_H" targetRef="n_D" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_D" targetRef="n_W" />
    <bpmn:association id="f_1" sourceRef="n_Route" targetRef="n_Email" associationDirection="One" />
    <bpmn:association id="f_2" sourceRef="n_Email" targetRef="n_NoEmail" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_Email" targetRef="n_Cmd" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_H" targetRef="n_Page" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_Page" targetRef="n_Up" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_Up" targetRef="n_Mail" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_Up" targetRef="n_Life" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_export_user_data">
    <bpmndi:BPMNPlane id="Plane_export_user_data" bpmnElement="Process_export_user_data">
      <bpmndi:BPMNShape id="n_UI_di" bpmnElement="n_UI">
