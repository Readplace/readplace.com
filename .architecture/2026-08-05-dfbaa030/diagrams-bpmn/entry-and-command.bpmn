<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_entry_and_command" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_entry_and_command" name="entry-and-command" isExecutable="false">
    <bpmn:serviceTask id="n_UI" name="Owner reader — crawl bookmark one tab per crawlVersions entry">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Auth" name="findArticleCrawlVersions url keep entries where authorUserId = owner"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Form" name="Tab renders 'me' badge + POST form hidden input versionMinuteId">
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Public" name="Public /view and iOS chromeless no crawlBookmarkRemoval passed no badge, no form">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Route" name="POST /queue/:id/remove-my-version hutch web Lambda dualAuth + resolveVerificationStatus only NO requireNotLocked / requireWriteAccess">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_P1" name="ReaderArticleHashIdSchema parses id? CrawlVersionMinuteIdSchema parses body? findArticleById id,userId returns a row?">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Pub" name="publishRemoveMyContent eventbridge-remove-my-content pass-through, no conditional spread">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_Cmd" name="RemoveMyContentCommand source hutch.api detail: url, userId, versionMinuteId ALL REQUIRED">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Noop" name="No publish">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_R303" name="303 -&gt; /queue/:id/view same redirect on both paths">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_NoRow" name="Queue row is NOT deleted no LinkDequeued fact published"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Sib" name="Sibling POST /queue/:id/delete deleteArticleFromQueue -&gt; drops the row publishes LinkDequeued -&gt; inbox read model publishes NO RemoveMyContentCommand">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Bus" name="EventBridge — shared platform bus">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="remove-my-content-command queue visibility 60s, batchSize 1 maxReceiveCount 3 default">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_UI" targetRef="n_Public" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Form" targetRef="n_Route" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Route" targetRef="n_P1" />
    <bpmn:sequenceFlow id="f_5" name="all three yes" sourceRef="n_P1" targetRef="n_Pub" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Pub" targetRef="n_Cmd" />
    <bpmn:sequenceFlow id="f_7" name="any no" sourceRef="n_P1" targetRef="n_Noop" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_Pub" targetRef="n_R303" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_Noop" targetRef="n_R303" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_Route" targetRef="n_Sib" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Cmd" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Bus" targetRef="n_Q" />
    <bpmn:association id="f_0" sourceRef="n_UI" targetRef="n_Auth" associationDirection="One" />
    <bpmn:association id="f_1" sourceRef="n_Auth" targetRef="n_Form" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_Route" targetRef="n_NoRow" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_entry_and_command">
    <bpmndi:BPMNPlane id="Plane_entry_and_command" bpmnElement="Process_entry_and_command">
      <bpmndi:BPMNShape id="n_UI_di" bpmnElement="n_UI">
        <dc:Bounds x="264" y="28" width="193.25" height="84" />
