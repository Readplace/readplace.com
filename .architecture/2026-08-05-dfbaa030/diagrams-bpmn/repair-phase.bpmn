      <bpmndi:BPMNShape id="n_G4_di" bpmnElement="n_G4">
        <dc:Bounds x="60.13" y="1146" width="104" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_E2_di" bpmnElement="n_E2">
        <dc:Bounds x="98.13" y="1349.75" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Purge_di" bpmnElement="n_Purge">
        <dc:Bounds x="227.83" y="1326" width="190" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Tomb_di" bpmnElement="n_Tomb">
        <dc:Bounds x="136.13" y="1530.5" width="190" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Term_di" bpmnElement="n_Term">
        <dc:Bounds x="148.25" y="1775.5" width="165.75" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Why_di" bpmnElement="n_Why">
        <dc:Bounds x="200.13" y="1072" width="202" height="196" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_2_di" bpmnElement="f_2">
        <di:waypoint x="231.13" y="374.5" />
        <di:waypoint x="231.13" y="429.38" />
        <di:waypoint x="118.13" y="429.38" />
        <di:waypoint x="118.13" y="484.25" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_5_di" bpmnElement="f_5">
        <di:waypoint x="231.13" y="714" />
        <di:waypoint x="231.13" y="759" />
        <di:waypoint x="131.88" y="759" />
        <di:waypoint x="131.88" y="804" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_6_di" bpmnElement="f_6">
        <di:waypoint x="231.13" y="714" />
