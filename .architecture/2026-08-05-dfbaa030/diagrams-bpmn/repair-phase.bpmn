<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_repair_phase" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_repair_phase" name="repair-phase" isExecutable="false">
    <bpmn:serviceTask id="n_In" name="erase phase complete objects deleted, log pruned"></bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_T" name="findContentSourceTier url articles row, projection contentSourceTier"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_G1" name="canonicalTier defined?">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_Stop1" name="continue — record acked, no repair">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_LS" name="listAvailableTierSources url S3 GET html + sidecar for each known tier partial or malformed pair reads as absent"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_G2" name="remaining still contains canonicalTier?">
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_Stop2" name="continue — record acked, no repair">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_G3" name="remaining.length &gt; 0?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_E1" name="ReselectAfterRemovalEvent source hutch.save-link detail: url">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_CS" name="countSaversByUrl url url-index GSI, Select COUNT, paginated counts ALL savers, remover INCLUDED">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_G4" name="savers &gt; 0?">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_E2" name="RecrawlLinkInitiatedEvent source hutch.api detail: url">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_Purge" name="purgeArticleContent url list + delete canonical body, rehosted images, every tier source + sidecar, every version snapshot CDN edge copies may outlive it ~24h, no invalidation"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Tomb" name="tombstoneArticle url, now set-once purgedAt, crawl=ready, summary=skipped content-purged, title/siteName re-stubbed to hostname REMOVE every content-bearing column row itself survives so ids resolve to 'removed'"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Term" name="TERMINAL — no event published"></bpmn:serviceTask>
    <bpmn:task id="n_Why" name="Why ALL savers, not others: a version delete leaves the remover's queue row. Excluding them would purge + tombstone an article they still own — and reader-permalink's invariant is 'a tombstone can't coexist with an owning row'.">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_2" name="no — never promoted, already tombstoned, or legacy" sourceRef="n_G1" targetRef="n_Stop1" />
    <bpmn:sequenceFlow id="f_5" name="yes — canonical body still backed" sourceRef="n_G2" targetRef="n_Stop2" />
    <bpmn:sequenceFlow id="f_6" name="no" sourceRef="n_G2" targetRef="n_G3" />
    <bpmn:sequenceFlow id="f_7" name="yes" sourceRef="n_G3" targetRef="n_E1" />
    <bpmn:sequenceFlow id="f_8" name="no" sourceRef="n_G3" targetRef="n_CS" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_CS" targetRef="n_G4" />
    <bpmn:sequenceFlow id="f_10" name="yes" sourceRef="n_G4" targetRef="n_E2" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_CS" targetRef="n_Why" />
    <bpmn:association id="f_0" sourceRef="n_In" targetRef="n_T" associationDirection="One" />
    <bpmn:association id="f_1" sourceRef="n_T" targetRef="n_G1" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_G1" targetRef="n_LS" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_LS" targetRef="n_G2" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_G4" targetRef="n_Purge" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_Purge" targetRef="n_Tomb" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_Tomb" targetRef="n_Term" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_repair_phase">
    <bpmndi:BPMNPlane id="Plane_repair_phase" bpmnElement="Process_repair_phase">
      <bpmndi:BPMNShape id="n_In_di" bpmnElement="n_In">
        <dc:Bounds x="133.25" y="28" width="195.75" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_T_di" bpmnElement="n_T">
