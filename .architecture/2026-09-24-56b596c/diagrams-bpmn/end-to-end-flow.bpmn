<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:serviceTask id="n_RCV" name="inbox receive-email Lambda Gmail gateway mail is delivered as the claimed sender's mapped alias · other mail as addressed">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_ERE" name="EmailReceivedEvent source hutch.inbox · origin receive or backfill recipientAddress = the delivery address">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_QX" name="inbox-extract-email-links-q SQS · visibility 240 s">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_DQX" name="inbox-failures-dlq shared DLQ · alarm">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_DLX" name="inbox-failures-dlq router Lambda markLinksExtractionFailed: barrier with extractionFailed, only if no barrier yet">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_EX" name="inbox extract-email-links Lambda re-derive the body from the raw .eml · extract and cap links classify + one triage call (deepseek-flash) conditional put of pending or skipped link rows">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ADDR" name="inbox-addresses table readlist"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_LINKS" name="inbox-email-links table link rows (new: droppedFor) meta barrier (new: readlistDecision)"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_GATE" name="routed to a readlist, with links to decide?">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="n_PREV" name="CrawlEmailLinkPreview one per pending link, on every branch">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_PRVL" name="inbox crawl-email-link-preview Lambda setLinkOutcome: status + preview fields (never touches droppedFor)">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_HELD" name="SendTrialFeedbackEmailCommand kind automation_saves_held · once per email">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_FIRST" name="SendFirstInboxEmailNoticeCommand once per email">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_HUTCHN" name="hutch send-trial-feedback-email and send-first-inbox-email-notice Lambdas (unchanged · end at the email send)">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_TRI" name="EmailLinksTriagedEvent source hutch.inbox · readlist, senderEmail, subject links: ordinal, url, anchorText ≤ 120 chars (min 1)">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_QF" name="filter-email-links-q SQS · visibility 360 s · maxReceiveCount 2 · batch 1">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_32</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_FL" name="save-link filter-email-links Lambda timeout 300 s · 256 MB">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_UA" name="user-articles table readlist definitions · per-user saves"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_FD" name="the routed readlist's definition?">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_MISS" name="definition missing · keep every link savedTo default (All) · decision readlist-missing">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_NOP" name="no purpose · keep every link savedTo the readlist · decision no-purpose">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_LLM" name="DeepSeek deepseek-v4-pro, thinking enabled one call labels every link keep or drop + a reason kept and dropped are derived in code">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:outgoing>f_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_PUB" name="filter-email-links Lambda publishes 1 · SubmitLinkCommand per kept link 2 · EmailLinksFilteredEvent once, last">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:outgoing>f_30</bpmn:outgoing>
      <bpmn:outgoing>f_31</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_DQF" name="save-link-failures-dlq shared DLQ · alarm">
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:incoming>f_37</bpmn:incoming>
      <bpmn:outgoing>f_33</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_DLF" name="save-link-failures-dlq router Lambda routes by source queue new route for filter-email-links-q">
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:outgoing>f_34</bpmn:outgoing>
      <bpmn:outgoing>f_38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_FFAIL" name="EmailLinksFilterFailedEvent source hutch.save-link · readlist, reason, receiveCount">
      <bpmn:incoming>f_34</bpmn:incoming>
      <bpmn:outgoing>f_45</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_FILT" name="EmailLinksFilteredEvent source hutch.save-link · savedTo, readlistLabel, decision dropped: ordinal + reason · token counts">
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:outgoing>f_44</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="n_SUB" name="SubmitLinkCommand readlist now required (default = All) also published by the email page's Save (section 3)">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:outgoing>f_35</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_QS" name="submit-link-q SQS · visibility 480 s · maxReceiveCount 3">
      <bpmn:incoming>f_35</bpmn:incoming>
      <bpmn:outgoing>f_36</bpmn:outgoing>
      <bpmn:outgoing>f_37</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_SL" name="save-link submit-link Lambda 1 · accept at All: queue row, savedAt bump, read → unread 2 · readlist ≠ default: file the accepted article into it 3 · tier-1 crawl in-process">
      <bpmn:incoming>f_36</bpmn:incoming>
      <bpmn:outgoing>f_40</bpmn:outgoing>
      <bpmn:outgoing>f_41</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_LQ" name="LinkQueuedEvent · QueueEntryCreatedEvent (unchanged)">
      <bpmn:incoming>f_40</bpmn:incoming>
      <bpmn:outgoing>f_42</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_CRAWL" name="TierContentExtractedEvent · SimpleCrawlUnsupportedEvent StaleCheckRequestedEvent · CrawlArticleFailedEvent (unchanged crawl chain)">
      <bpmn:incoming>f_41</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="n_LQF" name="LinkQueueFailedEvent (unchanged)">
      <bpmn:incoming>f_38</bpmn:incoming>
      <bpmn:outgoing>f_43</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_RLQ" name="inbox record-link-queued Lambda saved-link read model (unchanged)">
      <bpmn:incoming>f_42</bpmn:incoming>
      <bpmn:incoming>f_43</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_QR" name="inbox-record-email-links-filtered-q SQS · two rules, one queue · visibility 90 s">
      <bpmn:incoming>f_44</bpmn:incoming>
      <bpmn:incoming>f_45</bpmn:incoming>
      <bpmn:outgoing>f_46</bpmn:outgoing>
      <bpmn:outgoing>f_47</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DQR" name="inbox-record-email-links-filtered-dlq own DLQ · alarm + email">
      <bpmn:incoming>f_47</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_REC" name="inbox record-email-links-filtered Lambda store-only · publishes nothing 1 · SET droppedFor on each dropped link row 2 · settle the barrier: deciding → decided or failed">
      <bpmn:incoming>f_46</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_WEB" name="inbox web Lambda · email page links panel polls (section 3)"></bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_RCV" targetRef="n_ERE" />
    <bpmn:sequenceFlow id="f_1" name="rule inbox-extract-email-links" sourceRef="n_ERE" targetRef="n_QX" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_QX" targetRef="n_EX" />
    <bpmn:sequenceFlow id="f_3" name="3rd receive fails" sourceRef="n_QX" targetRef="n_DQX" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_DQX" targetRef="n_DLX" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_EX" targetRef="n_GATE" />
    <bpmn:sequenceFlow id="f_8" name="per pending link" sourceRef="n_EX" targetRef="n_PREV" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_PREV" targetRef="n_PRVL" />
    <bpmn:sequenceFlow id="f_11" name="no · read-only reader" sourceRef="n_GATE" targetRef="n_HELD" />
    <bpmn:sequenceFlow id="f_12" name="no · full access, per saveable link" sourceRef="n_GATE" targetRef="n_SUB" />
    <bpmn:sequenceFlow id="f_13" name="no · full access, first saveable link" sourceRef="n_GATE" targetRef="n_FIRST" />
    <bpmn:sequenceFlow id="f_14" name="yes · once" sourceRef="n_GATE" targetRef="n_TRI" />
    <bpmn:sequenceFlow id="f_15" name="yes · once, after the triage" sourceRef="n_GATE" targetRef="n_FIRST" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_HELD" targetRef="n_HUTCHN" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_FIRST" targetRef="n_HUTCHN" />
    <bpmn:sequenceFlow id="f_19" name="rule email-links-triaged" sourceRef="n_TRI" targetRef="n_QF" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_QF" targetRef="n_FL" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_FL" targetRef="n_FD" />
    <bpmn:sequenceFlow id="f_23" name="missing" sourceRef="n_FD" targetRef="n_MISS" />
    <bpmn:sequenceFlow id="f_24" name="no purpose" sourceRef="n_FD" targetRef="n_NOP" />
    <bpmn:sequenceFlow id="f_25" name="has a purpose" sourceRef="n_FD" targetRef="n_LLM" />
    <bpmn:sequenceFlow id="f_26" name="unknown, repeated or unlabelled ordinal: throw → SQS retry" sourceRef="n_LLM" targetRef="n_QF" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_MISS" targetRef="n_PUB" />
    <bpmn:sequenceFlow id="f_28" name="" sourceRef="n_NOP" targetRef="n_PUB" />
    <bpmn:sequenceFlow id="f_29" name="decision filtered" sourceRef="n_LLM" targetRef="n_PUB" />
    <bpmn:sequenceFlow id="f_30" name="1 · Event → Command readlist = savedTo" sourceRef="n_PUB" targetRef="n_SUB" />
    <bpmn:sequenceFlow id="f_31" name="2 · Event → Event" sourceRef="n_PUB" targetRef="n_FILT" />
    <bpmn:sequenceFlow id="f_32" name="2nd receive fails" sourceRef="n_QF" targetRef="n_DQF" />
    <bpmn:sequenceFlow id="f_33" name="" sourceRef="n_DQF" targetRef="n_DLF" />
    <bpmn:sequenceFlow id="f_34" name="filter route · reason decision-retries-exhausted fails closed: nothing more is saved" sourceRef="n_DLF" targetRef="n_FFAIL" />
    <bpmn:sequenceFlow id="f_35" name="rule submit-link-command" sourceRef="n_SUB" targetRef="n_QS" />
    <bpmn:sequenceFlow id="f_36" name="" sourceRef="n_QS" targetRef="n_SL" />
    <bpmn:sequenceFlow id="f_37" name="3rd receive fails" sourceRef="n_QS" targetRef="n_DQF" />
    <bpmn:sequenceFlow id="f_38" name="submit-link route" sourceRef="n_DLF" targetRef="n_LQF" />
    <bpmn:sequenceFlow id="f_40" name="" sourceRef="n_SL" targetRef="n_LQ" />
    <bpmn:sequenceFlow id="f_41" name="" sourceRef="n_SL" targetRef="n_CRAWL" />
    <bpmn:sequenceFlow id="f_42" name="" sourceRef="n_LQ" targetRef="n_RLQ" />
    <bpmn:sequenceFlow id="f_43" name="" sourceRef="n_LQF" targetRef="n_RLQ" />
    <bpmn:sequenceFlow id="f_44" name="rule inbox-record-email-links-filtered" sourceRef="n_FILT" targetRef="n_QR" />
    <bpmn:sequenceFlow id="f_45" name="rule inbox-record-email-links-filter-failed" sourceRef="n_FFAIL" targetRef="n_QR" />
    <bpmn:sequenceFlow id="f_46" name="" sourceRef="n_QR" targetRef="n_REC" />
    <bpmn:sequenceFlow id="f_47" name="3rd receive fails" sourceRef="n_QR" targetRef="n_DQR" />
    <bpmn:association id="f_5" sourceRef="n_DLX" targetRef="n_LINKS" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_EX" targetRef="n_ADDR" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_PRVL" targetRef="n_LINKS" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_EX" targetRef="n_LINKS" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_FL" targetRef="n_UA" associationDirection="One" />
    <bpmn:association id="f_39" sourceRef="n_SL" targetRef="n_UA" associationDirection="One" />
    <bpmn:association id="f_48" sourceRef="n_REC" targetRef="n_LINKS" associationDirection="One" />
    <bpmn:association id="f_49" sourceRef="n_LINKS" targetRef="n_WEB" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_end_to_end_flow">
    <bpmndi:BPMNPlane id="Plane_end_to_end_flow" bpmnElement="Process_end_to_end_flow">
