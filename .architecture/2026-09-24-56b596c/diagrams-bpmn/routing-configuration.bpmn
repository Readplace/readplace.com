<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_routing_configuration" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_routing_configuration" name="routing-configuration" isExecutable="false">
    <bpmn:startEvent id="n_U" name="Reader on a readlist's Preferences tab (shown with ?feature=pref)">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_PAGE" name="hutch web Lambda · Preferences page new Inboxes section: one row per live, named inbox (user aliases and Gmail-mapped aliases, never the Gmail gateway)">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_ROUTE" name="Command · POST /queues/:slug/preferences/inboxes address + destination = this readlist or All (Send here / Send to All)">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="n_DECIDE" name="decideInboxRouting">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_REFUSE" name="refused, nothing written unknown-inbox or invalid-destination: 303 back with That inbox isn't available · unknown-readlist: 303 to the list">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_SET" name="hutch web Lambda · setAddressReadlist UpdateItem, condition userId = the reader SET readlist (Send here) or REMOVE readlist (Send to All) then 303 back to the Preferences tab">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ADDR" name="inbox-addresses table key address · userId-index GSI new optional attribute: readlist"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_UA" name="user-articles table readlist definition rows: label, purpose"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_DEL" name="POST /queues/:slug/delete (optional migrate_to)">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_PURGE" name="hutch web Lambda · move the articles if asked, then purge the readlist's saved articles">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_UNROUTE" name="hutch web Lambda · unroute-inboxes-on-readlist-delete decorator around deleteReadlistDefinition">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CLEAR" name="clearReadlistFromAddresses Query userId-index, then per matching row UpdateItem REMOVE readlist (condition userId + readlist · a lost race is ignored)">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_DEFDEL" name="deleteReadlistDefinition deletes the definition row">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_KEEP" name="clearing throws: the definition is kept and the delete request fails">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_ACC" name="DeleteAccountCommand">
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_JOBS" name="hutch user-data-jobs Lambda tombstoneUserAddresses">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_EXTRACT" name="inbox extract-email-links Lambda reads the routing once per email (section 2)"></bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_U" targetRef="n_PAGE" />
    <bpmn:sequenceFlow id="f_3" name="Send here / Send to All" sourceRef="n_PAGE" targetRef="n_ROUTE" />
    <bpmn:sequenceFlow id="f_4" name="requireNotLocked + requireWriteAccess then list definitions and the reader's inboxes" sourceRef="n_ROUTE" targetRef="n_DECIDE" />
    <bpmn:sequenceFlow id="f_5" name="rejected" sourceRef="n_DECIDE" targetRef="n_REFUSE" />
    <bpmn:sequenceFlow id="f_6" name="accepted" sourceRef="n_DECIDE" targetRef="n_SET" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_U" targetRef="n_DEL" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_DEL" targetRef="n_PURGE" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_PURGE" targetRef="n_UNROUTE" />
    <bpmn:sequenceFlow id="f_11" name="1 · first" sourceRef="n_UNROUTE" targetRef="n_CLEAR" />
    <bpmn:sequenceFlow id="f_13" name="throws" sourceRef="n_CLEAR" targetRef="n_KEEP" />
    <bpmn:sequenceFlow id="f_14" name="2 · then" sourceRef="n_UNROUTE" targetRef="n_DEFDEL" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_ACC" targetRef="n_JOBS" />
    <bpmn:association id="f_1" sourceRef="n_PAGE" targetRef="n_ADDR" associationDirection="One" />
    <bpmn:association id="f_2" sourceRef="n_PAGE" targetRef="n_UA" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_SET" targetRef="n_ADDR" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_CLEAR" targetRef="n_ADDR" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_DEFDEL" targetRef="n_UA" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_JOBS" targetRef="n_ADDR" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_ADDR" targetRef="n_EXTRACT" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_routing_configuration">
