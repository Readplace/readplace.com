      <bpmndi:BPMNShape id="n_DONE_di" bpmnElement="n_DONE">
        <dc:Bounds x="270.45" y="708.75" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SKIPTAB_di" bpmnElement="n_SKIPTAB">
        <dc:Bounds x="200.57" y="881" width="195.75" height="116" />
