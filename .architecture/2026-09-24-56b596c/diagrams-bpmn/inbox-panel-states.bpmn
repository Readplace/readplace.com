<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_inbox_panel_states" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_inbox_panel_states" name="inbox-panel-states" isExecutable="false">
    <bpmn:startEvent id="n_OPEN" name="Reader opens an email in /inbox Extracted Articles or Skipped tab">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="n_EXT" name="extracting no meta barrier yet · Looking for links… the panel polls every 3 s, up to 300 polls">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_TERM" name="terminal, as before barrier without a readlist decision cards and counts · Save queues to All">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:endEvent>
    <bpmn:endEvent id="n_XFAIL" name="failed, as before barrier written by the extraction dead-letter consumer alert: Couldn't scan this email for links">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="n_STALE" name="stale, as before 300 polls spent and still no barrier same alert · polling stops">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_DEC" name="deciding barrier carries readlistDecision deciding notice: Choosing which links fit this inbox's readlist… no cards, tab counts withheld · both panels keep polling">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_DONE" name="decided notice: Saved to the readlist's label + Links that didn't fit are on the Skipped tab">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_SKIPTAB" name="Skipped tab · each dropped link reads Not for the label — the model's reason note: Save any you still want">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_FAIL" name="decision failed alert: Couldn't choose which links to save Nothing from this email was saved · every link keeps Save">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_SLOW" name="still choosing deciding when the 300-poll budget runs out alert: Still choosing which links to save · polling stops">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_SAVEDROP" name="SubmitLinkCommand readlist = the readlist the link was dropped for">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SAVEALL" name="SubmitLinkCommand readlist default (All)">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_OPEN" targetRef="n_EXT" />
    <bpmn:sequenceFlow id="f_1" name="barrier, no decision" sourceRef="n_EXT" targetRef="n_TERM" />
    <bpmn:sequenceFlow id="f_2" name="barrier with a deciding decision" sourceRef="n_EXT" targetRef="n_DEC" />
    <bpmn:sequenceFlow id="f_3" name="extraction dead-lettered" sourceRef="n_EXT" targetRef="n_XFAIL" />
    <bpmn:sequenceFlow id="f_4" name="budget spent, no barrier" sourceRef="n_EXT" targetRef="n_STALE" />
    <bpmn:sequenceFlow id="f_5" name="EmailLinksFilteredEvent recorded" sourceRef="n_DEC" targetRef="n_DONE" />
    <bpmn:sequenceFlow id="f_6" name="EmailLinksFilterFailedEvent recorded" sourceRef="n_DEC" targetRef="n_FAIL" />
    <bpmn:sequenceFlow id="f_7" name="budget spent while deciding" sourceRef="n_DEC" targetRef="n_SLOW" />
    <bpmn:sequenceFlow id="f_8" name="reload after it settles" sourceRef="n_SLOW" targetRef="n_DONE" />
    <bpmn:sequenceFlow id="f_9" name="reload after it settles" sourceRef="n_SLOW" targetRef="n_FAIL" />
    <bpmn:sequenceFlow id="f_10" name="reload while still deciding" sourceRef="n_SLOW" targetRef="n_DEC" />
    <bpmn:sequenceFlow id="f_11" name="dropped links" sourceRef="n_DONE" targetRef="n_SKIPTAB" />
    <bpmn:sequenceFlow id="f_12" name="Save" sourceRef="n_SKIPTAB" targetRef="n_SAVEDROP" />
    <bpmn:sequenceFlow id="f_13" name="Save again on a kept card" sourceRef="n_DONE" targetRef="n_SAVEALL" />
    <bpmn:sequenceFlow id="f_14" name="Save" sourceRef="n_FAIL" targetRef="n_SAVEALL" />
    <bpmn:sequenceFlow id="f_15" name="Save" sourceRef="n_TERM" targetRef="n_SAVEALL" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_inbox_panel_states">
    <bpmndi:BPMNPlane id="Plane_inbox_panel_states" bpmnElement="Process_inbox_panel_states">
      <bpmndi:BPMNShape id="n_OPEN_di" bpmnElement="n_OPEN">
        <dc:Bounds x="377.57" y="28" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_EXT_di" bpmnElement="n_EXT">
        <dc:Bounds x="296.07" y="185" width="203" height="100" />
