      <bpmndi:BPMNShape id="n_FAIL_di" bpmnElement="n_FAIL">
        <dc:Bounds x="399.38" y="707" width="178.25" height="116" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SLOW_di" bpmnElement="n_SLOW">
        <dc:Bounds x="296.82" y="549" width="201.5" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SAVEDROP_di" bpmnElement="n_SAVEDROP">
        <dc:Bounds x="301.07" y="1055" width="193" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SAVEALL_di" bpmnElement="n_SAVEALL">
        <dc:Bounds x="432.32" y="913" width="162.25" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="397.57" y="68" />
        <di:waypoint x="397.57" y="185" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_1_di" bpmnElement="f_1">
