    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_D" name="Dead-letter queue">

      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_X1" name="Existing step">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_X2" name="New or changed in this snapshot">
      <bpmn:incoming>f_0</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="amber edge: new or re-wired" sourceRef="n_X1" targetRef="n_X2" />
