  <bpmn:process id="Process_legend" name="legend" isExecutable="false">
    <bpmn:sendTask id="n_C" name="Command (a request that may be refused)"></bpmn:sendTask>
    <bpmn:serviceTask id="n_S" name="System / aggregate (the handler that decides)"></bpmn:serviceTask>
    <bpmn:endEvent id="n_E" name="Event (an irreversible fact)">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_P" name="Policy / reaction (what an event triggers)"></bpmn:endEvent>
    <bpmn:dataStoreReference id="n_R" name="Read model / store"></bpmn:dataStoreReference>
