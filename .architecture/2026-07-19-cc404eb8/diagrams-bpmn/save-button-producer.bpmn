      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Extract_di" bpmnElement="n_Extract">
        <dc:Bounds x="332.67" y="36" width="191.75" height="116" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SLC2_di" bpmnElement="n_SLC2">
        <dc:Bounds x="324.3" y="598" width="201" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Dormant_di" bpmnElement="n_Dormant">
        <dc:Bounds x="560.42" y="44" width="185.75" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Sub_di" bpmnElement="n_Sub">
        <dc:Bounds x="326.92" y="708" width="195.75" height="148" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Queue_di" bpmnElement="n_Queue">
        <dc:Bounds x="336.14" y="914" width="177.32" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="200.05" y="160" />
        <di:waypoint x="200.05" y="189" />
        <di:waypoint x="424.8" y="189" />
        <di:waypoint x="424.8" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_2_di" bpmnElement="f_2">
        <di:waypoint x="424.8" y="334" />
