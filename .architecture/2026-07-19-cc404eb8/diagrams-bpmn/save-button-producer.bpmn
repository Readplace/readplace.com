<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_save_button_producer" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_save_button_producer" name="save-button-producer" isExecutable="false">
    <bpmn:task id="n_Card" name="Articles-tab preview card Save to queue action rendered only when the viewmodel emits it — omitted for a URL failing validateSaveableUrl">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_Click" name="POST /inbox/:id/links/:ordinal/save requireNotLocked + requireWriteAccess (same write gates as /create)">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_LinkRow" name="inbox-email-links table getLink by userId + receivedAtMessageId + ordinal"></bpmn:dataStoreReference>
    <bpmn:task id="n_NotFound" name="404 empty body: bad ordinal, missing row, skipped row, or unsaveable URL — shapes the card never renders a button for (out-of-band request, not a user path)">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:task>
    <bpmn:sendTask id="n_SLC" name="SubmitLinkCommand userId, url from the stored link row">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_Notice" name="303 back to the Articles tab, saved=1 'Saved to your queue.' notice">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_Extract" name="inbox-extract-email-links Lambda auto-save per kept link on fresh arrivals (origin = receive; submit before preview)">
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SLC2" name="SubmitLinkCommand on the EventBridge bus">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Dormant" name="article-aggregate effect dispatcher dispatch-submit-link (no transition caller — dormant)">
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Sub" name="save-link submit-link subscriber — collapsed rule, queue, guards, accept phase, in-process crawl, selector, summary, reader-ready digest (see the two companion snapshots)">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Queue" name="reader's unread queue: stub card, savedAt bump, read-to-unread resurface — re-clicks converge idempotently"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="reader clicks Save" sourceRef="n_Card" targetRef="n_Click" />
    <bpmn:sequenceFlow id="f_2" name="guard fails" sourceRef="n_Click" targetRef="n_NotFound" />
    <bpmn:sequenceFlow id="f_3" name="guards pass: publish" sourceRef="n_Click" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_4" name="after the publish" sourceRef="n_Click" targetRef="n_Notice" />
    <bpmn:sequenceFlow id="f_5" name="1st live producer (committed at this HEAD)" sourceRef="n_Extract" targetRef="n_SLC2" />
    <bpmn:sequenceFlow id="f_6" name="still no runtime path" sourceRef="n_Dormant" targetRef="n_SLC2" />
    <bpmn:sequenceFlow id="f_7" name="2nd live producer (new)" sourceRef="n_SLC" targetRef="n_SLC2" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_SLC2" targetRef="n_Sub" />
    <bpmn:association id="f_1" sourceRef="n_Click" targetRef="n_LinkRow" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_Sub" targetRef="n_Queue" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_save_button_producer">
    <bpmndi:BPMNPlane id="Plane_save_button_producer" bpmnElement="Process_save_button_producer">
      <bpmndi:BPMNShape id="n_Card_di" bpmnElement="n_Card">
        <dc:Bounds x="103.42" y="28" width="193.25" height="132" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Click_di" bpmnElement="n_Click">
        <dc:Bounds x="317.8" y="218" width="214" height="116" />
