  <bpmn:process id="Process_settle_media_failure" name="settle-media-failure" isExecutable="false">
    <bpmn:startEvent id="n_E" name="MediaProcessingFailedEvent: uploadId, url, reason, notice">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_B" name="Shared event bus">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="settle-media-failure queue">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_L" name="settle-media-failure Lambda: parse the detail">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_D" name="settle-media-failure DLQ + alarm email">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_R1" name="1. Record the private item failure">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_A" name="Articles table: crawlStatus failed, processing-failed reason, processingNotice"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_P1" name="Row has an owner?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_NF" name="not-found, logged">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_OK1" name="recorded">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_R2" name="2. Fail the upload session">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_S" name="Media upload sessions table: committed to failed"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_P2" name="Session is committed?">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_NC" name="not-committed, logged">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_OK2" name="failed, logged">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="n_F" name="Record fails: SQS retries, then dead-letters">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:incoming>f_17</bpmn:incoming>
