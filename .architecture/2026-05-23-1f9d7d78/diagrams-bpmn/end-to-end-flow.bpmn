<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:businessRuleTask id="n_Stripe" name="Stripe customer.subscription.deleted">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_APIGW" name="API Gateway POST /webhooks/stripe">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Receiver" name="stripe-webhook-receiver Lambda HMAC-SHA256 verify + parse 128 MB / 10 s">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_R400" name="400 Bad signature"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_R200Ignore" name="200 OK silently accepted"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_SCE" name="SubscriptionCancelledEvent subscriptionId">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_R5xx" name="5xx Stripe retries exponential backoff up to 3 days">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_EB" name="EventBridge">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_HSCQueue" name="handle-subscription-cancelled SQS queue vis 30 s">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="n_HSCLambda" name="handle-subscription-cancelled Lambda markCancelled on subscription_providers 128 MB / 30 s">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:dataStoreReference id="n_SubRow" name="subscription_providers row status = cancelled"></bpmn:dataStoreReference>
    <bpmn:intermediateCatchEvent id="n_HSCDLQ" name="handle-subscription-cancelled DLQ">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_OperatorEmail" name="Operator email notification">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_SSR" name="SSR Lambda initGetEffectiveAccess">
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_Gate" name="requireWriteAccess middleware 402-gates POST /queue, /save, /import/*">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="HTTP POST" sourceRef="n_Stripe" targetRef="n_APIGW" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_APIGW" targetRef="n_Receiver" />
    <bpmn:sequenceFlow id="f_4" name="customer.subscription.deleted valid signature" sourceRef="n_Receiver" targetRef="n_SCE" />
    <bpmn:sequenceFlow id="f_5" name="EventBridge publish fails exception propagates" sourceRef="n_Receiver" targetRef="n_R5xx" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_SCE" targetRef="n_EB" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_EB" targetRef="n_HSCQueue" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_HSCQueue" targetRef="n_HSCLambda" />
    <bpmn:sequenceFlow id="f_10" name="exhausted retries" sourceRef="n_HSCQueue" targetRef="n_HSCDLQ" />
    <bpmn:sequenceFlow id="f_11" name="SNS alarm" sourceRef="n_HSCDLQ" targetRef="n_OperatorEmail" />
    <bpmn:sequenceFlow id="f_13" name="status=cancelled" sourceRef="n_SSR" targetRef="n_Gate" />
    <bpmn:association id="f_2" sourceRef="n_Receiver" targetRef="n_R400" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_Receiver" targetRef="n_R200Ignore" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_HSCLambda" targetRef="n_SubRow" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_SubRow" targetRef="n_SSR" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_end_to_end_flow">
    <bpmndi:BPMNPlane id="Plane_end_to_end_flow" bpmnElement="Process_end_to_end_flow">
      <bpmndi:BPMNShape id="n_Stripe_di" bpmnElement="n_Stripe">
        <dc:Bounds x="248.6" y="28" width="198.75" height="68" />
