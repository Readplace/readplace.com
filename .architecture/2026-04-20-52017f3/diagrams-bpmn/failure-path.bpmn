<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_failure_path" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_failure_path" name="failure-path" isExecutable="false">
    <bpmn:serviceTask id="n_generateLambda" name="generate-summary Lambda">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_throw" name="summariser throws DeepSeek timeout · parse error · network">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="n_generateQ" name="[generate-summary SQS vis: 300s">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_generateDlq" name="[generate-summary-dlq retention: 14 days">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_dlqLambda" name="generate-summary-dlq Lambda HutchDLQEventHandler batchSize: 1">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_articlesTable" name="DynamoDB: articles"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_summaryFailedEvt" name="SummaryGenerationFailedEvent source: hutch.save-link detailType: SummaryGenerationFailed detail: url, reason, receiveCount">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_summaryFailedQ" name="[summary-generation-failed SQS vis: 60s">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_summaryFailedLambda" name="summary-generation-failed Lambda terminal handler">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_parseErrorLog" name="CloudWatch Logs parse-errors stream"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_generateLambda" targetRef="n_throw" />
    <bpmn:sequenceFlow id="f_1" name="retry ≤ 3" sourceRef="n_throw" targetRef="n_generateQ" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_generateQ" targetRef="n_generateLambda" />
    <bpmn:sequenceFlow id="f_3" name="receiveCount = 3" sourceRef="n_throw" targetRef="n_generateDlq" />
    <bpmn:sequenceFlow id="f_4" name="EventSourceMapping" sourceRef="n_generateDlq" targetRef="n_dlqLambda" />
    <bpmn:sequenceFlow id="f_6" name="publishEvent" sourceRef="n_dlqLambda" targetRef="n_summaryFailedEvt" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_summaryFailedEvt" targetRef="n_summaryFailedQ" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_summaryFailedQ" targetRef="n_summaryFailedLambda" />
    <bpmn:association id="f_5" sourceRef="n_dlqLambda" targetRef="n_articlesTable" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_summaryFailedLambda" targetRef="n_parseErrorLog" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_failure_path">
