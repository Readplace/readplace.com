<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:startEvent id="n_linkSavedEvent" name="LinkSavedEvent source: hutch.save-link detailType: LinkSaved">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_anonSavedEvent" name="AnonymousLinkSavedEvent source: hutch.save-link detailType: AnonymousLinkSaved">
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="n_linkSavedQ" name="[link-saved SQS vis: 60s · maxReceive: 3">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_anonSavedQ" name="[anonymous-link-saved SQS vis: 60s · maxReceive: 3">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_linkSavedLambda" name="link-saved Lambda dispatchGenerateSummary">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_anonLinkSavedLambda" name="anonymous-link-saved Lambda dispatchGenerateSummary">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_generateCmd" name="GenerateSummaryCommand detail: url">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_generateQ" name="[generate-summary SQS vis: 300s · maxReceive: 3">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_generateLambda" name="generate-summary Lambda memory: 512 MB · timeout: 45s">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_summariser" name="[link-summariser DeepSeek API · JSON schema">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_articlesTable" name="DynamoDB: articles summary, summaryStatus, summaryFailureReason, tokens"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_s3Content" name="S3: content bucket article text"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_skipDecision" name="status is ready or skipped? OR cleaned text &lt;= 3 × MAX_SUMMARY_LENGTH?">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_markSkipped" name="markSummarySkipped status: pending → skipped">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_saveReady" name="saveGeneratedSummary sets summary + status=ready REMOVE summaryFailureReason">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_summaryGeneratedEvt" name="SummaryGeneratedEvent source: hutch.save-link detailType: GlobalSummaryGenerated detail: url, inputTokens, outputTokens">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_summaryGeneratedQ" name="[summary-generated SQS vis: 60s">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_summaryGeneratedLambda" name="summary-generated Lambda no-op logger / hook point">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_linkSavedEvent" targetRef="n_linkSavedQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_linkSavedQ" targetRef="n_linkSavedLambda" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_anonSavedEvent" targetRef="n_anonSavedQ" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_anonSavedQ" targetRef="n_anonLinkSavedLambda" />
    <bpmn:sequenceFlow id="f_4" name="SendMessage" sourceRef="n_linkSavedLambda" targetRef="n_generateCmd" />
    <bpmn:sequenceFlow id="f_5" name="SendMessage" sourceRef="n_anonLinkSavedLambda" targetRef="n_generateCmd" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_generateCmd" targetRef="n_generateQ" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_generateQ" targetRef="n_generateLambda" />
    <bpmn:sequenceFlow id="f_10" name="summarizeArticle" sourceRef="n_generateLambda" targetRef="n_summariser" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_generateLambda" targetRef="n_skipDecision" />
    <bpmn:sequenceFlow id="f_12" name="yes · skip" sourceRef="n_skipDecision" targetRef="n_markSkipped" />
    <bpmn:sequenceFlow id="f_14" name="no · proceed" sourceRef="n_skipDecision" targetRef="n_saveReady" />
    <bpmn:sequenceFlow id="f_16" name="publishEvent" sourceRef="n_saveReady" targetRef="n_summaryGeneratedEvt" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_summaryGeneratedEvt" targetRef="n_summaryGeneratedQ" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_summaryGeneratedQ" targetRef="n_summaryGeneratedLambda" />
    <bpmn:association id="f_8" sourceRef="n_generateLambda" targetRef="n_s3Content" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_generateLambda" targetRef="n_articlesTable" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_markSkipped" targetRef="n_articlesTable" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_saveReady" targetRef="n_articlesTable" associationDirection="One" />
    <bpmn:group id="grp_0" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_end_to_end_flow">
