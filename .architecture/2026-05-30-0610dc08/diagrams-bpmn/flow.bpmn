<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_flow" name="flow" isExecutable="false">
    <bpmn:startEvent id="n_TCE" name="TierContentExtractedEvent">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_SELQ" name="select-most-complete-content SQS queue">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_SEL" name="select-most-complete-content Lambda promoteTier">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_DB1" name="articles row metadata + freshness + crawl=ready"></bpmn:dataStoreReference>
    <bpmn:startEvent id="n_RCE" name="RecrawlContentExtractedEvent">
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_RCEQ" name="recrawl-content-extracted SQS queue">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_RCEH" name="recrawl-content-extracted Lambda recrawlPromoteTier">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_CCE" name="CanonicalContentChangedEvent (tier flip / text change, or unconditional on operator recrawl)">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_CCQ" name="canonical-content-changed SQS queue">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_CCDLQ" name="canonical-content-changed DLQ + email alarm">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_CCH" name="canonical-content-changed Lambda markSummaryPending">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_DB2" name="articles row summary=pending (pendingSince preserved)"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_GSC" name="GenerateSummaryCommand">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_GSQ" name="generate-summary SQS queue">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_GS" name="generate-summary Lambda markSummaryReady / markSummarySkipped">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_DB3" name="articles row summary=ready"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_CAC" name="CrawlArticleCompletedEvent">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_LS" name="LinkSaved / AnonymousLinkSaved (only on canonical change)">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_TCE" targetRef="n_SELQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_SELQ" targetRef="n_SEL" />
    <bpmn:sequenceFlow id="f_3" name="publish-canonical-content-changed" sourceRef="n_SEL" targetRef="n_CCE" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_SEL" targetRef="n_CAC" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_SEL" targetRef="n_LS" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_RCE" targetRef="n_RCEQ" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_RCEQ" targetRef="n_RCEH" />
    <bpmn:sequenceFlow id="f_8" name="publish-canonical-content-changed unconditional" sourceRef="n_RCEH" targetRef="n_CCE" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_CCE" targetRef="n_CCQ" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_CCQ" targetRef="n_CCH" />
    <bpmn:sequenceFlow id="f_11" name="retry exhaustion" sourceRef="n_CCQ" targetRef="n_CCDLQ" />
    <bpmn:sequenceFlow id="f_13" name="generate-summary effect" sourceRef="n_CCH" targetRef="n_GSC" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_GSC" targetRef="n_GSQ" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_GSQ" targetRef="n_GS" />
    <bpmn:association id="f_2" sourceRef="n_SEL" targetRef="n_DB1" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_CCH" targetRef="n_DB2" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_GS" targetRef="n_DB3" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_flow">
    <bpmndi:BPMNPlane id="Plane_flow" bpmnElement="Process_flow">
      <bpmndi:BPMNShape id="n_TCE_di" bpmnElement="n_TCE">
