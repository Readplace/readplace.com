<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_gmail_update" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_gmail_update" name="gmail-update" isExecutable="false">
    <bpmn:sendTask id="n_MARK" name="MarkGmailEmailImported">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:businessRuleTask id="n_BUS" name="EventBridge subscription">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="n_QUEUE" name="Gmail message updates queue and Lambda">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="n_MAPPED" name="Sender actively mapped to a destination?">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_SKIP" name="Discard pending update and acknowledge">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CLAIM" name="Lease pending update by origin, with job and message for explicit imports">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ACK" name="Acknowledge without polling Gmail">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_GRANT" name="Connected account and modify grant verified?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_DEFER" name="GmailEmailUpdateDeferred, retain pending">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_LOCATE" name="Locate by Gmail ID or verified forwarded Message-ID and sender">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_FAIL" name="GmailEmailUpdateFailed">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="n_STATUS" name="Read current labels from the original">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_SETTLE" name="Settle without writing to Gmail">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_WRITE" name="Find or create label, then add it and remove UNREAD in one modify call">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_EVENT" name="GmailEmailMarkedImported">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_DLQ" name="Shared Gmail import DLQ settles pending failures">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="n_CONNECT" name="Connect or reconnect Gmail from settings">
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_GOOGLE" name="Google OAuth requests gmail.modify">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_RESUME" name="GmailModifyPermissionGranted">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_LIMITED" name="Imports can continue with read access">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_PENDING" name="Publish commands for pending updates on this account">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_OLD" name="Retired historical marking worker, queue, rules and dedicated permissions">
      <bpmn:incoming>f_21</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_MARK" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_BUS" targetRef="n_QUEUE" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_QUEUE" targetRef="n_MAPPED" />
    <bpmn:sequenceFlow id="f_3" name="No" sourceRef="n_MAPPED" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_4" name="Yes" sourceRef="n_MAPPED" targetRef="n_CLAIM" />
    <bpmn:sequenceFlow id="f_5" name="Already settled" sourceRef="n_CLAIM" targetRef="n_ACK" />
    <bpmn:sequenceFlow id="f_6" name="Pending" sourceRef="n_CLAIM" targetRef="n_GRANT" />
    <bpmn:sequenceFlow id="f_7" name="No" sourceRef="n_GRANT" targetRef="n_DEFER" />
    <bpmn:sequenceFlow id="f_8" name="Yes" sourceRef="n_GRANT" targetRef="n_LOCATE" />
    <bpmn:sequenceFlow id="f_9" name="Missing or ambiguous" sourceRef="n_LOCATE" targetRef="n_FAIL" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_LOCATE" targetRef="n_STATUS" />
    <bpmn:sequenceFlow id="f_11" name="Already read" sourceRef="n_STATUS" targetRef="n_SETTLE" />
    <bpmn:sequenceFlow id="f_12" name="Unread" sourceRef="n_STATUS" targetRef="n_WRITE" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_WRITE" targetRef="n_EVENT" />
    <bpmn:sequenceFlow id="f_14" name="Repeated failures" sourceRef="n_QUEUE" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_CONNECT" targetRef="n_GOOGLE" />
    <bpmn:sequenceFlow id="f_16" name="Granted and account matches" sourceRef="n_GOOGLE" targetRef="n_RESUME" />
    <bpmn:sequenceFlow id="f_17" name="Narrower grant" sourceRef="n_GOOGLE" targetRef="n_LIMITED" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_RESUME" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_19" name="Permission grant event" sourceRef="n_QUEUE" targetRef="n_PENDING" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_PENDING" targetRef="n_MARK" />
    <bpmn:sequenceFlow id="f_21" name="Already dead-lettered historical work" sourceRef="n_DLQ" targetRef="n_OLD" />
  </bpmn:process>
