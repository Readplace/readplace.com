      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_MARK_di" bpmnElement="n_MARK">
        <dc:Bounds x="119.83" y="528" width="191.5" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_UPDATE_di" bpmnElement="n_UPDATE">
        <dc:Bounds x="195.58" y="654" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_OPT_di" bpmnElement="n_OPT">
        <dc:Bounds x="84.08" y="784" width="86" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_RECORD_di" bpmnElement="n_RECORD">
        <dc:Bounds x="120.58" y="960" width="190" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_API_di" bpmnElement="n_API">
        <dc:Bounds x="28" y="1127.25" width="193.75" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_GRANT_di" bpmnElement="n_GRANT">
        <dc:Bounds x="310.46" y="1110.5" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_DONE_di" bpmnElement="n_DONE">
        <dc:Bounds x="195.58" y="1254" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_DLQ_di" bpmnElement="n_DLQ">
        <dc:Bounds x="269.36" y="807" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="135.66" y="83.25" />
        <di:waypoint x="135.66" y="113.88" />
        <di:waypoint x="215.58" y="113.88" />
        <di:waypoint x="215.58" y="144.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_1_di" bpmnElement="f_1">
