<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_completion" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_completion" name="completion" isExecutable="false">
    <bpmn:serviceTask id="n_SAVE" name="Issue or article saver writes to All">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_ACK" name="EmailOutputSavedToAll">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="n_SELECT" name="EmailOutputsSelected">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_WORKER" name="Import completion queue and Lambda">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:dataStoreReference id="n_STATE" name="Accumulate saved outputs and check the relevant selection"></bpmn:dataStoreReference>
    <bpmn:task id="n_MARK" name="MarkGmailEmailImported carries supplemental for missing work">
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="n_UPDATE" name="Gmail message update queue and Lambda">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="n_OPT" name="Automatic marking enabled?">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_RECORD" name="Per-origin update record with a separate key for supplemental work"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_API" name="Gmail adds the imported label and removes UNREAD">
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_GRANT" name="GmailModifyPermissionGranted resumes pending updates">
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_DONE" name="GmailEmailMarkedImported">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_DLQ" name="Gmail update dead-letter handler">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SAVE" targetRef="n_ACK" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_SELECT" targetRef="n_WORKER" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_ACK" targetRef="n_WORKER" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_MARK" targetRef="n_UPDATE" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_UPDATE" targetRef="n_OPT" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_GRANT" targetRef="n_UPDATE" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_API" targetRef="n_DONE" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_UPDATE" targetRef="n_DLQ" />
    <bpmn:association id="f_3" sourceRef="n_WORKER" targetRef="n_STATE" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_STATE" targetRef="n_MARK" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_OPT" targetRef="n_RECORD" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_RECORD" targetRef="n_API" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_RECORD" targetRef="n_GRANT" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_completion">
    <bpmndi:BPMNPlane id="Plane_completion" bpmnElement="Process_completion">
      <bpmndi:BPMNShape id="n_SAVE_di" bpmnElement="n_SAVE">
        <dc:Bounds x="51.78" y="31.25" width="167.75" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_ACK_di" bpmnElement="n_ACK">
        <dc:Bounds x="195.58" y="144.5" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SELECT_di" bpmnElement="n_SELECT">
        <dc:Bounds x="297.46" y="28" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_WORKER_di" bpmnElement="n_WORKER">
