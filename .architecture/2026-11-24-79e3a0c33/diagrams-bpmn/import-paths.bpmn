<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_import_paths" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_import_paths" name="import-paths" isExecutable="false">
    <bpmn:startEvent id="n_FORWARD" name="SES receives a forwarded newsletter">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_RECEIVE" name="Inbox receive queue and Lambda">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="n_ROUTE" name="Active sender and destination?">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_HOLD" name="Hold or skip mail"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_IDENTITY" name="Resolve inbox identity and record forwarded origin">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_CLICK" name="POST Import unread messages for one sender"></bpmn:sendTask>
    <bpmn:dataStoreReference id="n_JOB" name="Create job with the selected destinations"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_READ" name="Read scope granted?">
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_WAIT" name="Awaiting permission"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_START" name="StartGmailHistoryImport">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_PAGES" name="History import queue and Lambda">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DLQ" name="Shared Gmail import DLQ">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="n_FETCH" name="GmailHistoryImportMessageFetched">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_INBOX" name="Inbox import queue and Lambda">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="n_OUTCOME" name="GmailHistoryImportMessageIngested">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:dataStoreReference id="n_COUNTS" name="Outcome queue and Lambda settle the job counts"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_NEW" name="Canonical inbox email exists?">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="n_DUP" name="Reuse one inbox email and add the job and Gmail message origin">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_ACCEPT" name="EmailReceived">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_EXTRACT" name="Extract email output selection and dispatch saves">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_SELECTED" name="EmailOutputsSelected">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_SAVE" name="Save selected links, issue, or both in All and file into chosen readlists">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_SAVED" name="EmailOutputSavedToAll after durable save">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_COMPLETION" name="Inbox completion queue and Lambda">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="n_ALL" name="Every selected output saved in All?">
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_MARK" name="MarkGmailEmailImported per recorded origin">
      <bpmn:incoming>f_28</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:dataStoreReference id="n_STOP" name="Wait for remaining save facts"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_FORWARD" targetRef="n_RECEIVE" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_RECEIVE" targetRef="n_ROUTE" />
    <bpmn:sequenceFlow id="f_3" name="Yes" sourceRef="n_ROUTE" targetRef="n_IDENTITY" />
    <bpmn:sequenceFlow id="f_7" name="Yes" sourceRef="n_READ" targetRef="n_START" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_START" targetRef="n_PAGES" />
    <bpmn:sequenceFlow id="f_11" name="Retries exhausted" sourceRef="n_PAGES" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_12" name="Unread within 30 days and sender matches" sourceRef="n_PAGES" targetRef="n_FETCH" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_FETCH" targetRef="n_INBOX" />
    <bpmn:sequenceFlow id="f_14" name="Verify current job, sender and destinations" sourceRef="n_INBOX" targetRef="n_IDENTITY" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_INBOX" targetRef="n_OUTCOME" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_IDENTITY" targetRef="n_NEW" />
    <bpmn:sequenceFlow id="f_18" name="Yes" sourceRef="n_NEW" targetRef="n_DUP" />
    <bpmn:sequenceFlow id="f_19" name="No" sourceRef="n_NEW" targetRef="n_ACCEPT" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_ACCEPT" targetRef="n_EXTRACT" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_EXTRACT" targetRef="n_SELECTED" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_EXTRACT" targetRef="n_SAVE" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_SAVE" targetRef="n_SAVED" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_SELECTED" targetRef="n_COMPLETION" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_SAVED" targetRef="n_COMPLETION" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_COMPLETION" targetRef="n_ALL" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_DUP" targetRef="n_ALL" />
    <bpmn:sequenceFlow id="f_28" name="Yes" sourceRef="n_ALL" targetRef="n_MARK" />
    <bpmn:association id="f_2" sourceRef="n_ROUTE" targetRef="n_HOLD" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_CLICK" targetRef="n_JOB" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_JOB" targetRef="n_READ" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_READ" targetRef="n_WAIT" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_WAIT" targetRef="n_START" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_OUTCOME" targetRef="n_COUNTS" associationDirection="One" />
    <bpmn:association id="f_29" sourceRef="n_ALL" targetRef="n_STOP" associationDirection="One" />
  </bpmn:process>
