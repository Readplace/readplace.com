<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_import_and_save" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_import_and_save" name="import-and-save" isExecutable="false">
    <bpmn:sendTask id="n_UI" name="Import unread messages form">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_WEB" name="Gmail newsletters route">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_START" name="Start or continue Gmail history import">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_IMPORT" name="Import queue and worker">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_GMAIL" name="Gmail API checks unread messages in the last 30 days">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_RAW" name="Raw message in S3"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_FETCHED" name="GmailHistoryImportMessageFetched">
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_INGEST" name="Ingest queue and Lambda">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:dataStoreReference id="n_ID" name="Existing email identity and canonical inbox entry"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_COVERED" name="Does the original delivery cover the request?">
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="n_ALREADY" name="Already imported">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_CLAIM" name="Conditionally store missing mode, destinations and origin"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_ACCEPT" name="Imported">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_INITIAL" name="Store initial inbox entry and routing">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_OUTCOME" name="GmailHistoryImportMessageIngested">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:dataStoreReference id="n_SUMMARY" name="Import job counters"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_RECEIVED" name="EmailReceived carries supplemental for missing work">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_EXTRACT" name="Extract queue and Lambda">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:dataStoreReference id="n_PLAN" name="Reuse completed link rows and freeze the missing output selection"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_SAVES" name="SaveEmailIssue or SubmitLink for unacknowledged outputs"></bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="n_TRIAGE" name="EmailLinksTriaged for the selected article readlists">
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_FILTER" name="Readlist matching queue and worker">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_MATCH" name="File kept links and record each readlist decision">
      <bpmn:incoming>f_24</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SELECTED" name="EmailOutputsSelected carries supplemental, including zero outputs"></bpmn:serviceTask>
    <bpmn:endEvent id="n_DLQ" name="Existing queue failure routes">
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_UI" targetRef="n_WEB" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_WEB" targetRef="n_START" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_START" targetRef="n_IMPORT" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_IMPORT" targetRef="n_GMAIL" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_FETCHED" targetRef="n_INGEST" />
    <bpmn:sequenceFlow id="f_9" name="Yes" sourceRef="n_COVERED" targetRef="n_ALREADY" />
    <bpmn:sequenceFlow id="f_13" name="New email" sourceRef="n_COVERED" targetRef="n_INITIAL" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_INITIAL" targetRef="n_ACCEPT" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_ACCEPT" targetRef="n_OUTCOME" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_ALREADY" targetRef="n_OUTCOME" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_ACCEPT" targetRef="n_RECEIVED" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_RECEIVED" targetRef="n_EXTRACT" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_TRIAGE" targetRef="n_FILTER" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_FILTER" targetRef="n_MATCH" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_INGEST" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_EXTRACT" targetRef="n_DLQ" />
    <bpmn:association id="f_4" sourceRef="n_GMAIL" targetRef="n_RAW" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_RAW" targetRef="n_FETCHED" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_INGEST" targetRef="n_ID" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_ID" targetRef="n_COVERED" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_COVERED" targetRef="n_CLAIM" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_CLAIM" targetRef="n_ACCEPT" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_CLAIM" targetRef="n_ALREADY" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_OUTCOME" targetRef="n_SUMMARY" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_EXTRACT" targetRef="n_PLAN" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_PLAN" targetRef="n_SAVES" associationDirection="One" />
    <bpmn:association id="f_22" sourceRef="n_PLAN" targetRef="n_TRIAGE" associationDirection="One" />
    <bpmn:association id="f_25" sourceRef="n_PLAN" targetRef="n_SELECTED" associationDirection="One" />
  </bpmn:process>
