<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_sender_assignment" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_sender_assignment" name="sender-assignment" isExecutable="false">
    <bpmn:task id="n_U" name="Choose one discovered sender and destination inbox">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_V" name="Validate owned sender and active owned inbox">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_N" name="Mint named inbox within shared 25-address cap">
      <bpmn:incoming>f_1</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_S" name="Sender assignment and forwarding membership"></bpmn:dataStoreReference>
    <bpmn:task id="n_X" name="Exclude sender or delete destination group"></bpmn:task>
    <bpmn:sendTask id="n_C" name="RewriteGmailFilterCommand">
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="Existing filter SQS and DLQ">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_W" name="Read current sender set and forwarding confirmations">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_G" name="Google filters: create and verify replacement before deleting old rule">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_E" name="GmailFilterRewrittenEvent">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_F" name="GmailFilterRewriteFailedEvent">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_T" name="No subscribed follow-up">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="n_R" name="Redirect with validation error and preserve selection">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_U" targetRef="n_V" />
    <bpmn:sequenceFlow id="f_1" name="new inbox" sourceRef="n_V" targetRef="n_N" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_C" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Q" targetRef="n_W" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_W" targetRef="n_G" />
    <bpmn:sequenceFlow id="f_9" name="success" sourceRef="n_G" targetRef="n_E" />
    <bpmn:sequenceFlow id="f_10" name="terminal error" sourceRef="n_G" targetRef="n_F" />
    <bpmn:sequenceFlow id="f_11" name="unavailable" sourceRef="n_G" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_E" targetRef="n_T" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_F" targetRef="n_T" />
    <bpmn:sequenceFlow id="f_14" name="invalid input, stale sender, ownership or cap failure" sourceRef="n_V" targetRef="n_R" />
    <bpmn:association id="f_2" sourceRef="n_N" targetRef="n_S" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_V" targetRef="n_S" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_X" targetRef="n_S" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_S" targetRef="n_C" associationDirection="One" />
  </bpmn:process>
