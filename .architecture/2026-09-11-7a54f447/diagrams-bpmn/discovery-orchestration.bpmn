<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_discovery_orchestration" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_discovery_orchestration" name="discovery-orchestration" isExecutable="false">
    <bpmn:sendTask id="n_U" name="Open authenticated Gmail page">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_W" name="Web Lambda renders cached choices">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_M" name="Metadata permission granted?">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_O" name="OAuth consent and callback">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_R" name="Credentials and connection"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_X" name="Render integration error">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_C" name="StartGmailSenderDiscoveryCommand">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_B" name="EventBridge source and detail-type rules">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="gmail-discovery SQS">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_S" name="Discovery Lambda starts or claims one page">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_D" name="Discovery checkpoint and sender cache"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_E" name="GmailSenderDiscoveryProgressedEvent">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_P" name="Progress-event reaction">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_N" name="DiscoverGmailSendersPageCommand">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_T" name="No more work">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_V" name="Search and poll sender results"></bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_U" targetRef="n_W" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_W" targetRef="n_M" />
    <bpmn:sequenceFlow id="f_2" name="no" sourceRef="n_M" targetRef="n_O" />
    <bpmn:sequenceFlow id="f_4" name="invalid grant" sourceRef="n_O" targetRef="n_X" />
    <bpmn:sequenceFlow id="f_5" name="yes, page-load POST" sourceRef="n_M" targetRef="n_C" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_C" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_B" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_Q" targetRef="n_S" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_S" targetRef="n_E" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_E" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Q" targetRef="n_P" />
    <bpmn:sequenceFlow id="f_14" name="next page present" sourceRef="n_P" targetRef="n_N" />
    <bpmn:sequenceFlow id="f_15" name="direct SQS, 10 second delay" sourceRef="n_N" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_16" name="no next page" sourceRef="n_P" targetRef="n_T" />
    <bpmn:association id="f_3" sourceRef="n_O" targetRef="n_R" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_R" targetRef="n_S" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_S" targetRef="n_D" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_D" targetRef="n_V" associationDirection="One" />
  </bpmn:process>
