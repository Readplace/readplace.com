<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_mailbox_state" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_mailbox_state" name="mailbox-state" isExecutable="false">
    <bpmn:sendTask id="n_C" name="Start or page command">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_S" name="Check current connection and generation">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_A" name="Current mode">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_P" name="Read profile and history baseline">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_F" name="List a full message page and read From metadata">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_D" name="Deduplicate senders and commit page">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_E" name="GmailSenderDiscoveryProgressedEvent with next page">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_H" name="History delta from opening baseline">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_K" name="Save cursor; retain starting history ID">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_T" name="Commit new history ID and complete state">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_Z" name="GmailSenderDiscoveryProgressedEvent without next page">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_R" name="Retain cache; reset to profile mode">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_B" name="Per-user sender cache and checkpoint"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_C" targetRef="n_S" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_S" targetRef="n_A" />
    <bpmn:sequenceFlow id="f_2" name="new or history expired" sourceRef="n_A" targetRef="n_P" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_P" targetRef="n_F" />
    <bpmn:sequenceFlow id="f_4" name="full scan cursor" sourceRef="n_A" targetRef="n_F" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_F" targetRef="n_D" />
    <bpmn:sequenceFlow id="f_6" name="more full pages" sourceRef="n_D" targetRef="n_E" />
    <bpmn:sequenceFlow id="f_7" name="last full page" sourceRef="n_D" targetRef="n_H" />
    <bpmn:sequenceFlow id="f_8" name="completed cache or history cursor" sourceRef="n_A" targetRef="n_H" />
    <bpmn:sequenceFlow id="f_9" name="more history pages" sourceRef="n_H" targetRef="n_K" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_K" targetRef="n_E" />
    <bpmn:sequenceFlow id="f_11" name="last history page" sourceRef="n_H" targetRef="n_T" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_T" targetRef="n_Z" />
    <bpmn:sequenceFlow id="f_13" name="history expired" sourceRef="n_H" targetRef="n_R" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_R" targetRef="n_E" />
    <bpmn:association id="f_15" sourceRef="n_D" targetRef="n_B" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_K" targetRef="n_B" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_T" targetRef="n_B" associationDirection="One" />
  </bpmn:process>
