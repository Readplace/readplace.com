<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_failure_and_cleanup" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_failure_and_cleanup" name="failure-and-cleanup" isExecutable="false">
    <bpmn:sendTask id="n_C" name="Discovery page">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_S" name="Connection and mailbox boundary">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="SQS retry after visibility timeout">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_D" name="Discovery DLQ and alarm">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_L" name="DLQ consumer checks current generation/page">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_F" name="Mark current run failed; retain cursor and cache">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_R" name="Mark failed and require reconnect">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_E" name="GmailSenderDiscoveryProgressedEvent without next page">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_U" name="Render retry or reconnect action">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="n_X" name="Delete discovery state, then cached sender rows">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_I" name="Ignore old delivery">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_G" name="DisconnectGmailCommand">
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_W" name="Remove filters; revoke grant; delete credentials and connection">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_A" name="DeleteAccountCommand">
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_J" name="User data jobs: remove Gmail connection, credentials and assignments">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_T" name="Cleanup complete; late transactions are fenced">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_C" targetRef="n_S" />
    <bpmn:sequenceFlow id="f_1" name="Google unavailable or storage/publish error" sourceRef="n_S" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Q" targetRef="n_C" />
    <bpmn:sequenceFlow id="f_3" name="five exhausted receives" sourceRef="n_Q" targetRef="n_D" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_D" targetRef="n_L" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_L" targetRef="n_F" />
    <bpmn:sequenceFlow id="f_6" name="missing metadata scope, reauth or account mismatch" sourceRef="n_S" targetRef="n_R" />
    <bpmn:sequenceFlow id="f_7" name="terminal Google rejection" sourceRef="n_S" targetRef="n_F" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_F" targetRef="n_E" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_R" targetRef="n_E" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_E" targetRef="n_U" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_U" targetRef="n_C" />
    <bpmn:sequenceFlow id="f_12" name="deleted or disconnecting connection" sourceRef="n_S" targetRef="n_X" />
    <bpmn:sequenceFlow id="f_13" name="stale generation or changed gateway/account" sourceRef="n_S" targetRef="n_I" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_G" targetRef="n_W" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_W" targetRef="n_X" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_A" targetRef="n_J" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_J" targetRef="n_X" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_X" targetRef="n_T" />
  </bpmn:process>
