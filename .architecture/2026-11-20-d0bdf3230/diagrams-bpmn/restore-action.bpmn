<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_restore_action" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_restore_action" name="restore-action" isExecutable="false">
    <bpmn:serviceTask id="n_RES" name="restore runner requestedAt, senders">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_HOLD" name="user-articles: userId#removed partition"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_ALL" name="user-articles: reader's All partition"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_ART" name="articles table: originalUrl, purgedAt"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_PAGES" name="read every hold-row page">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_SEL" name="select: hold still live, removed at or before requestedAt, chosen sender, earliest per link">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_REST" name="restore held link">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_GET" name="hold row still there?">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_GONE" name="gone, not counted">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_PURGED" name="shared article purged?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_UNR" name="count unrestorable">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_TX" name="transaction: Put All row with restoredAt, only if absent + Delete hold row, only if present">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_AIA" name="count already-in-all">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_ORIG" name="find original URLs">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_LQ" name="LinkQueued url, userId">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_PROG" name="record progress on job row">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_STOP" name="stop, do not finish">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_RES" targetRef="n_PAGES" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_PAGES" targetRef="n_SEL" />
    <bpmn:sequenceFlow id="f_3" name="chunks of 10" sourceRef="n_SEL" targetRef="n_REST" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_REST" targetRef="n_GET" />
    <bpmn:sequenceFlow id="f_5" name="no" sourceRef="n_GET" targetRef="n_GONE" />
    <bpmn:sequenceFlow id="f_6" name="yes" sourceRef="n_GET" targetRef="n_PURGED" />
    <bpmn:sequenceFlow id="f_7" name="yes" sourceRef="n_PURGED" targetRef="n_UNR" />
    <bpmn:sequenceFlow id="f_8" name="no" sourceRef="n_PURGED" targetRef="n_TX" />
    <bpmn:sequenceFlow id="f_11" name="Put refused" sourceRef="n_TX" targetRef="n_AIA" />
    <bpmn:sequenceFlow id="f_12" name="Delete refused" sourceRef="n_TX" targetRef="n_GONE" />
    <bpmn:sequenceFlow id="f_13" name="restored" sourceRef="n_TX" targetRef="n_ORIG" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_ORIG" targetRef="n_LQ" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_REST" targetRef="n_PROG" />
    <bpmn:sequenceFlow id="f_17" name="stale: row moved on" sourceRef="n_PROG" targetRef="n_STOP" />
    <bpmn:association id="f_1" sourceRef="n_PAGES" targetRef="n_HOLD" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_TX" targetRef="n_ALL" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_TX" targetRef="n_HOLD" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_ORIG" targetRef="n_ART" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_restore_action">
    <bpmndi:BPMNPlane id="Plane_restore_action" bpmnElement="Process_restore_action">
      <bpmndi:BPMNShape id="n_RES_di" bpmnElement="n_RES">
