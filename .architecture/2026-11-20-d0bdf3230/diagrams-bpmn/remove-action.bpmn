<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_remove_action" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_remove_action" name="remove-action" isExecutable="false">
    <bpmn:task id="n_REM" name="remove runner cutoff, senders">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_ALL" name="user-articles: reader's All partition"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_HOLD" name="user-articles: userId#removed partition hold row: removedUrl, removedByJobId, removedAt, expiresAt = removedAt + 30 days"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_HL" name="highlights"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_ART" name="articles table: originalUrl, purgedAt"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_OPENED" name="list keys opened in readlists">
      <bpmn:incoming>f_0</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PAGE" name="for each removal-candidate page">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_HLS" name="list the reader's highlights">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_SEL" name="select page: email provenance, chosen sender, saved at or before cutoff, unread, not hand-picked, viewed, summary-opened, highlighted, opened in a readlist, not restored after cutoff, not an issue row">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_CNT" name="count skip reason">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_MOVE" name="move newsletter link to hold consistent read, then transaction: Put hold row + Delete All row under the same conditions">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_CHG" name="count changed">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_ORIG" name="find original URLs">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_SAVES" name="reader still saves this URL elsewhere?">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_LDQ" name="LinkDequeued url, userId">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_NOEV" name="no event">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="n_PROG" name="record progress on job row">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_STOP" name="stop, do not finish">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="n_TTL" name="DynamoDB TTL on expiresAt purges the hold row after 30 days"></bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_REM" targetRef="n_OPENED" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_REM" targetRef="n_PAGE" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_PAGE" targetRef="n_HLS" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_PAGE" targetRef="n_SEL" />
    <bpmn:sequenceFlow id="f_7" name="skip: read, opened, highlighted, unreadable" sourceRef="n_SEL" targetRef="n_CNT" />
    <bpmn:sequenceFlow id="f_8" name="selected, chunks of 10" sourceRef="n_SEL" targetRef="n_MOVE" />
    <bpmn:sequenceFlow id="f_11" name="transaction cancelled, row now holdable" sourceRef="n_MOVE" targetRef="n_CHG" />
    <bpmn:sequenceFlow id="f_12" name="held" sourceRef="n_MOVE" targetRef="n_ORIG" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_ORIG" targetRef="n_SAVES" />
    <bpmn:sequenceFlow id="f_15" name="no copy remains" sourceRef="n_SAVES" targetRef="n_LDQ" />
    <bpmn:sequenceFlow id="f_16" name="a copy remains" sourceRef="n_SAVES" targetRef="n_NOEV" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_MOVE" targetRef="n_PROG" />
    <bpmn:sequenceFlow id="f_18" name="stale: row moved on" sourceRef="n_PROG" targetRef="n_STOP" />
    <bpmn:association id="f_1" sourceRef="n_OPENED" targetRef="n_ALL" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_PAGE" targetRef="n_ALL" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_HLS" targetRef="n_HL" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_MOVE" targetRef="n_ALL" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_MOVE" targetRef="n_HOLD" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_ORIG" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_19" sourceRef="n_HOLD" targetRef="n_TTL" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_remove_action">
