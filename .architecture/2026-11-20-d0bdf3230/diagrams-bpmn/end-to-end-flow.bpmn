<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:businessRuleTask id="n_NOPROD" name="No producer yet: no web route publishes the command at this commit">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_CMD" name="RunSavedLinksJobCommand source hutch.api userId, jobId, requestedAt, job remove or restore">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_RULE" name="EventBridge rule user-data-jobs DeleteAccountCommand, ExportUserDataCommand, RunSavedLinksJobCommand">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_Q" name="[&quot;user-data-jobs queue visibility 900 s, batch 1">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_DLQ" name="[&quot;user-data-jobs-dlq maxReceiveCount 12, email alarm">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_L" name="user-data-jobs Lambda handle by detail type">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_H" name="saved-links-job handler">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_JOB" name="job row in user-articles readplace:saved-links-job/userId state, counts, finishedAt"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_FIND" name="job row names this job and is not completed?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_ACK" name="acknowledge, log stale job">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_START" name="record progress: state running seed held or restored count resumed when state was not requested">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_ACT" name="job.action">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="n_REM" name="remove runner">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_RES" name="restore runner">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_LDQ" name="LinkDequeued">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_LQ" name="LinkQueued">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_FIN" name="finish row completed with counts">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_DONE" name="SavedLinksJobCompleted source hutch.saved-links-job no subscriber yet">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_FAIL" name="finish row failed">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_FAILED" name="SavedLinksJobFailed no subscriber yet">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_IDQ" name="inbox record-link-dequeued">
      <bpmn:incoming>f_26</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_MR" name="media-release">
      <bpmn:incoming>f_27</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_IQ" name="inbox record-link-queued">
      <bpmn:incoming>f_28</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_NOPROD" targetRef="n_CMD" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_CMD" targetRef="n_RULE" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_RULE" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Q" targetRef="n_L" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_L" targetRef="n_H" />
    <bpmn:sequenceFlow id="f_5" name="12th receive fails" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_H" targetRef="n_FIND" />
    <bpmn:sequenceFlow id="f_7" name="no" sourceRef="n_FIND" targetRef="n_ACK" />
    <bpmn:sequenceFlow id="f_8" name="yes" sourceRef="n_FIND" targetRef="n_START" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_START" targetRef="n_ACT" />
    <bpmn:sequenceFlow id="f_12" name="remove" sourceRef="n_ACT" targetRef="n_REM" />
    <bpmn:sequenceFlow id="f_13" name="restore" sourceRef="n_ACT" targetRef="n_RES" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_REM" targetRef="n_LDQ" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_RES" targetRef="n_LQ" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_REM" targetRef="n_FIN" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_RES" targetRef="n_FIN" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_FIN" targetRef="n_DONE" />
    <bpmn:sequenceFlow id="f_22" name="error: rethrow, SQS redelivers" sourceRef="n_H" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_23" name="error on receive 12" sourceRef="n_H" targetRef="n_FAIL" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_FAIL" targetRef="n_FAILED" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_LDQ" targetRef="n_IDQ" />
    <bpmn:sequenceFlow id="f_27" name="private media item URLs only" sourceRef="n_LDQ" targetRef="n_MR" />
    <bpmn:sequenceFlow id="f_28" name="" sourceRef="n_LQ" targetRef="n_IQ" />
    <bpmn:association id="f_9" sourceRef="n_JOB" targetRef="n_FIND" associationDirection="Both" />
    <bpmn:association id="f_10" sourceRef="n_START" targetRef="n_JOB" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_REM" targetRef="n_JOB" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_RES" targetRef="n_JOB" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_FIN" targetRef="n_JOB" associationDirection="One" />
    <bpmn:association id="f_24" sourceRef="n_FAIL" targetRef="n_JOB" associationDirection="One" />
  </bpmn:process>
