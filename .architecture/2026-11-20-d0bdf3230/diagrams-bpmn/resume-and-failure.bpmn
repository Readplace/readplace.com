<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_resume_and_failure" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_resume_and_failure" name="resume-and-failure" isExecutable="false">
    <bpmn:task id="n_Q" name="[&quot;user-data-jobs queue">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_DLQ" name="[&quot;user-data-jobs-dlq">
      <bpmn:incoming>f_24</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_H" name="saved-links-job handler receive N">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_HOLD" name="userId#removed partition"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_ALL" name="reader's All partition"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_JOB" name="job row"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_ST" name="job row state">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_FRESH" name="fresh run, counts start empty">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="n_RESUME" name="resume: which action?">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_ACK" name="acknowledge">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_RH" name="scan hold rows of this jobId republish LinkDequeued where no copy remains seed held with their number">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RR" name="scan All rows restored since requestedAt republish LinkQueued seed restored with their number">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_LDQ" name="LinkDequeued">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_LQ" name="LinkQueued">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_CONT" name="carry on with the remaining links">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_OK" name="finish completed">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_DONE" name="SavedLinksJobCompleted">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_RC" name="receiveCount at least 12?">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_RETHROW" name="rethrow, redelivered after visibility">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="n_FF" name="finish failed with counts so far only if the row is not completed">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_FAILED" name="SavedLinksJobFailed">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_RETHROW2" name="rethrow">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Q" targetRef="n_H" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_H" targetRef="n_ST" />
    <bpmn:sequenceFlow id="f_2" name="requested" sourceRef="n_ST" targetRef="n_FRESH" />
    <bpmn:sequenceFlow id="f_3" name="running or failed" sourceRef="n_ST" targetRef="n_RESUME" />
    <bpmn:sequenceFlow id="f_4" name="missing, other job, completed" sourceRef="n_ST" targetRef="n_ACK" />
    <bpmn:sequenceFlow id="f_5" name="remove" sourceRef="n_RESUME" targetRef="n_RH" />
    <bpmn:sequenceFlow id="f_6" name="restore" sourceRef="n_RESUME" targetRef="n_RR" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_RH" targetRef="n_LDQ" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_RR" targetRef="n_LQ" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_RH" targetRef="n_CONT" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_RR" targetRef="n_CONT" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_FRESH" targetRef="n_CONT" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_CONT" targetRef="n_OK" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_OK" targetRef="n_DONE" />
    <bpmn:sequenceFlow id="f_17" name="error" sourceRef="n_CONT" targetRef="n_RC" />
    <bpmn:sequenceFlow id="f_18" name="no" sourceRef="n_RC" targetRef="n_RETHROW" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_RETHROW" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_20" name="yes" sourceRef="n_RC" targetRef="n_FF" />
    <bpmn:sequenceFlow id="f_22" name="recorded" sourceRef="n_FF" targetRef="n_FAILED" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_FF" targetRef="n_RETHROW2" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_RETHROW2" targetRef="n_DLQ" />
    <bpmn:association id="f_7" sourceRef="n_RH" targetRef="n_HOLD" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_RR" targetRef="n_ALL" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_OK" targetRef="n_JOB" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_FF" targetRef="n_JOB" associationDirection="One" />
  </bpmn:process>
