<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_fit_choice" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_fit_choice" name="fit-choice" isExecutable="false">
    <bpmn:sendTask id="n_U" name="Reader presses Keep, Drop or Undo">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:businessRuleTask id="n_G" name="Locked-account and write-access gates">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_W" name="inbox web Lambda: fit route">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_EM" name="inbox emails and links: stored readlist outcome"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_NF" name="404, nothing changes">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_K" name="Record the reader's choice">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_DR" name="Record the reader's choice">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_UN" name="Delete the reader's choice">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_OV" name="readlist fit overrides"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_FC" name="FileArticleIntoReadlistCommand, reader source">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_FE" name="FileArticleIntoReadlistCommand, engine keep with reason and email source">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_RM" name="Remove the article from the readlist">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_UA" name="user articles: readlist row"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_LG" name="Readlist fit overridden log line, no URL">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RS" name="htmx: card, readlist line and toast with Undo. Form post: redirect with the confirmation">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_U" targetRef="n_G" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_G" targetRef="n_W" />
    <bpmn:sequenceFlow id="f_3" name="no decided outcome, saves held, or nothing to undo" sourceRef="n_W" targetRef="n_NF" />
    <bpmn:sequenceFlow id="f_4" name="keep" sourceRef="n_W" targetRef="n_K" />
    <bpmn:sequenceFlow id="f_5" name="drop" sourceRef="n_W" targetRef="n_DR" />
    <bpmn:sequenceFlow id="f_6" name="undo" sourceRef="n_W" targetRef="n_UN" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_K" targetRef="n_FC" />
    <bpmn:sequenceFlow id="f_11" name="engine had kept the link" sourceRef="n_UN" targetRef="n_FE" />
    <bpmn:sequenceFlow id="f_12" name="engine had dropped it, or no engine fit" sourceRef="n_UN" targetRef="n_RM" />
    <bpmn:sequenceFlow id="f_13" name="reader has it saved" sourceRef="n_DR" targetRef="n_RM" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_W" targetRef="n_LG" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_W" targetRef="n_RS" />
    <bpmn:association id="f_2" sourceRef="n_EM" targetRef="n_W" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_K" targetRef="n_OV" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_DR" targetRef="n_OV" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_UN" targetRef="n_OV" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_RM" targetRef="n_UA" associationDirection="One" />
  </bpmn:process>
