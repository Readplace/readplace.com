<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_filing" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_filing" name="filing" isExecutable="false">
    <bpmn:serviceTask id="n_IW" name="inbox web Lambda">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_C" name="FileArticleIntoReadlistCommand">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_FL" name="filter-email-links Lambda">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_OT" name="Other publishers: submit-link, email-issue save, readlist page">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_B" name="Event bus rule">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="file-article-into-readlist queue">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_H" name="file-article-into-readlist Lambda">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_F" name="articles and user articles: find the saved copy"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_A" name="user articles: file into the readlist"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_E" name="ArticleFiledIntoReadlistEvent">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_R" name="Fail the record; the queue redelivers">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_D" name="file-article-into-readlist-dlq">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_AL" name="DLQ alarm email">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_IW" targetRef="n_C" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_FL" targetRef="n_C" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_OT" targetRef="n_C" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_C" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_B" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Q" targetRef="n_H" />
    <bpmn:sequenceFlow id="f_9" name="not in All yet" sourceRef="n_H" targetRef="n_R" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_R" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_11" name="after 5 receives" sourceRef="n_Q" targetRef="n_D" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_D" targetRef="n_AL" />
    <bpmn:association id="f_6" sourceRef="n_H" targetRef="n_F" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_H" targetRef="n_A" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_A" targetRef="n_E" associationDirection="One" />
  </bpmn:process>
