<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_summary_queue" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_summary_queue" name="summary-queue" isExecutable="false">
    <bpmn:sendTask id="n_C" name="GenerateSummaryCommand">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="generate-summary queue">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_H" name="generate-summary Lambda">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_A" name="Articles table"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_S" name="Mark the summary skipped">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_M" name="Persist the failed summary mark, then fail the record">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="n_D" name="generate-summary-dlq">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_C" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Q" targetRef="n_H" />
    <bpmn:sequenceFlow id="f_3" name="declined, final receive" sourceRef="n_H" targetRef="n_S" />
    <bpmn:sequenceFlow id="f_5" name="failed, final receive" sourceRef="n_H" targetRef="n_M" />
    <bpmn:sequenceFlow id="f_7" name="out of receives" sourceRef="n_Q" targetRef="n_D" />
    <bpmn:association id="f_2" sourceRef="n_H" targetRef="n_A" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_S" targetRef="n_A" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_M" targetRef="n_A" associationDirection="One" />
  </bpmn:process>
