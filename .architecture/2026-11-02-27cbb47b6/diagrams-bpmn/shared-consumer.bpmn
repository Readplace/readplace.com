      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_K" name="Crawl routes and the email-filter route stay">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_R1" name="select-most-complete-content route">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_R2" name="reselect-after-removal route">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_R3" name="recrawl-content-extracted route">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_R4" name="generate-summary route">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_O" targetRef="n_F" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_F" targetRef="n_C" />
