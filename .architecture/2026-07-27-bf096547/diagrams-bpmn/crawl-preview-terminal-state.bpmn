<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_crawl_preview_terminal_state" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_crawl_preview_terminal_state" name="crawl-preview-terminal-state" isExecutable="false">
    <bpmn:serviceTask id="n_Extract" name="inbox extract-email-links Lambda fans out one command per kept link">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_Cmd" name="CrawlEmailLinkPreview source hutch.inbox userId, receivedAtMessageId, ordinal, url">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:businessRuleTask id="n_Rule" name="EventBridge rule inbox-crawl-email-link-preview">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="SQS inbox-crawl-email-link-preview visibility 120s = worker timeout, no guard maxReceiveCount 3">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Worker" name="inbox crawl-email-link-preview Lambda crawlAndFinalize - SSRF guard - metadata only">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Rows" name="hutch-inbox-email-links link row: crawled or failed"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_Alarm" name="CloudWatch depth alarm to SNS email pages the operator">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_D" name="DLQ inbox-crawl-email-link-preview-dlq">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_DlqFn" name="inbox-crawl-email-link-preview-dlq Lambda attachDlqConsumer - batchSize 1 - 256MB/30s">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Terminal" name="failPendingLink UpdateItem guarded on status = pending failureReason preview-retries-exhausted"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_Race" name="already-terminal a redelivered slow crawl already succeeded, or the row was deleted: log and ACK"></bpmn:endEvent>
    <bpmn:endEvent id="n_Unparsed" name="unidentifiable command end of the line: log at error and ACK">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Extract" targetRef="n_Cmd" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Cmd" targetRef="n_Rule" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Rule" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Q" targetRef="n_Worker" />
    <bpmn:sequenceFlow id="f_6" name="store fault or malformed envelope: fail the record" sourceRef="n_Worker" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_7" name="3 receives exhausted" sourceRef="n_Q" targetRef="n_D" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_D" targetRef="n_Alarm" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_D" targetRef="n_DlqFn" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_DlqFn" targetRef="n_Unparsed" />
    <bpmn:association id="f_4" sourceRef="n_Worker" targetRef="n_Rows" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_Worker" targetRef="n_Rows" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_DlqFn" targetRef="n_Terminal" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_Terminal" targetRef="n_Rows" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_Terminal" targetRef="n_Race" associationDirection="One" />
  </bpmn:process>
