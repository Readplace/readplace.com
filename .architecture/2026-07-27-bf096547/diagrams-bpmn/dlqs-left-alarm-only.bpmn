<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_dlqs_left_alarm_only" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_dlqs_left_alarm_only" name="dlqs-left-alarm-only" isExecutable="false">
    <bpmn:serviceTask id="n_SES" name="SES catch-all receipt rule raw .eml to the forever-retained bucket, then SNS">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_RQ" name="SQS inbox-receive-email visibility 120s + 60s guard">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_RW" name="inbox receive-email Lambda">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Audit" name="hutch-inbox-emails rejected / unparsed audit row written BEFORE the record fails"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Raw" name="raw .eml bucket, retained forever the audit trail when there is no key to write against"></bpmn:dataStoreReference>
    <bpmn:intermediateCatchEvent id="n_RD" name="DLQ inbox-receive-email-dlq alarm only, by design">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="n_LQE" name="LinkQueuedEvent / LinkQueueFailedEvent from the save side">
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_LQ" name="SQS inbox-record-link-queued and inbox-record-link-queue-failed">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_LW" name="inbox record-link-queued Lambda unconditional single-row upsert, no read">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Saved" name="hutch-inbox-saved-links"></bpmn:dataStoreReference>
    <bpmn:intermediateCatchEvent id="n_LD" name="DLQ per queue alarm only, by design">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_Alarm" name="CloudWatch depth alarm to SNS email the operator is the consumer">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SES" targetRef="n_RQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_RQ" targetRef="n_RW" />
    <bpmn:sequenceFlow id="f_4" name="3 receives exhausted" sourceRef="n_RW" targetRef="n_RD" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_RD" targetRef="n_Alarm" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_LQE" targetRef="n_LQ" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_LQ" targetRef="n_LW" />
    <bpmn:sequenceFlow id="f_11" name="3 receives exhausted" sourceRef="n_LW" targetRef="n_LD" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_LD" targetRef="n_Alarm" />
    <bpmn:association id="f_2" sourceRef="n_RW" targetRef="n_Audit" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_SES" targetRef="n_Raw" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_Audit" targetRef="n_RD" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_Raw" targetRef="n_RD" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_LW" targetRef="n_Saved" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_Saved" targetRef="n_LD" associationDirection="One" />
  </bpmn:process>
