<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_detail_view_read_model" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_detail_view_read_model" name="detail-view-read-model" isExecutable="false">
    <bpmn:serviceTask id="n_Req" name="GET /inbox/:emailId?tab=articles and the panel-poll fragment routes"></bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Query" name="listLinksByEmail single Query on the email partition link rows + reserved-sort-key meta item"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_Coerce" name="meta = truncated, extractionFailed Boolean-coerced, not parsed: a missing column means the run succeeded">
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_VM" name="toInboxEmailDetailViewModel">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_Extracting" name="isExtracting no meta, budget unspent poll every 3s">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_Failed" name="isExtractionFailed meta.extractionFailed === true">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_Stale" name="isStalePending no meta, budget spent">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_Done" name="terminal meta present, extractionFailed false">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:endEvent>
    <bpmn:task id="n_NoPoll" name="panelPollUrl undefined terminal on first render"></bpmn:task>
    <bpmn:task id="n_Copy" name="I could not scan this email for links... existing stale copy, reused"></bpmn:task>
    <bpmn:task id="n_NoCounts" name="headerCounts withheld no link badge, no tab counts"></bpmn:task>
    <bpmn:task id="n_NoStrip" name="extractionReported false poll route ships no out-of-band tab strip"></bpmn:task>
    <bpmn:task id="n_Status" name="panelStatusFor: extracting, failed, stale, terminal data-articles-status / data-excluded-status">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Coerce" targetRef="n_VM" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_VM" targetRef="n_Extracting" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_VM" targetRef="n_Stale" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_VM" targetRef="n_Done" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Extracting" targetRef="n_Status" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Stale" targetRef="n_Status" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_Done" targetRef="n_Status" />
    <bpmn:association id="f_0" sourceRef="n_Req" targetRef="n_Query" associationDirection="One" />
    <bpmn:association id="f_1" sourceRef="n_Query" targetRef="n_Coerce" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_detail_view_read_model">
    <bpmndi:BPMNPlane id="Plane_detail_view_read_model" bpmnElement="Process_detail_view_read_model">
      <bpmndi:BPMNShape id="n_Req_di" bpmnElement="n_Req">
        <dc:Bounds x="28" y="28.75" width="211.5" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Query_di" bpmnElement="n_Query">
        <dc:Bounds x="585.09" y="171.5" width="190" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Coerce_di" bpmnElement="n_Coerce">
        <dc:Bounds x="660.09" y="349" width="40" height="40" />
