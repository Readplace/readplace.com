        <dc:Bounds x="869.59" y="643" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_NoPoll_di" bpmnElement="n_NoPoll">
        <dc:Bounds x="458.68" y="44.75" width="182" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Copy_di" bpmnElement="n_Copy">
        <dc:Bounds x="676.68" y="36.75" width="196.25" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_NoCounts_di" bpmnElement="n_NoCounts">
        <dc:Bounds x="908.93" y="44.75" width="200" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_NoStrip_di" bpmnElement="n_NoStrip">
        <dc:Bounds x="1144.93" y="36.75" width="187.25" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Status_di" bpmnElement="n_Status">
        <dc:Bounds x="588.46" y="786.5" width="183.25" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_2_di" bpmnElement="f_2">
        <di:waypoint x="680.09" y="389" />
        <di:waypoint x="680.09" y="533" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_3_di" bpmnElement="f_3">
