<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_extraction_terminal_state" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_extraction_terminal_state" name="extraction-terminal-state" isExecutable="false">
    <bpmn:serviceTask id="n_Recv" name="inbox receive-email Lambda">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_Evt" name="EmailReceivedEvent source hutch.inbox userId, receivedAtMessageId, recipientAddress, origin">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_Rule" name="EventBridge rule inbox-extract-email-links">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="SQS inbox-extract-email-links visibility 180s + 60s guard - maxReceiveCount 3">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Worker" name="inbox extract-email-links Lambda re-derive body from raw .eml, extract, classify, triage">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_LinkRows" name="hutch-inbox-email-links one pending or skipped row per link"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_Submit" name="SubmitLinkCommand origin receive + routed + saveable only">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_Crawl" name="CrawlEmailLinkPreview one per kept link">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:dataStoreReference id="n_Counts" name="hutch-inbox-emails setEmailLinkCounts"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Meta" name="putLinksMeta unconditional truncated, extractionFailed false the extraction-finished barrier"></bpmn:dataStoreReference>
    <bpmn:intermediateCatchEvent id="n_TruncQ" name="SQS inbox-extract-email-links-truncated-alert send-rate alarm, no consumer">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_D" name="DLQ inbox-extract-email-links-dlq">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_Alarm" name="CloudWatch depth alarm to SNS email pages the operator">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_DlqFn" name="inbox-extract-email-links-dlq Lambda attachDlqConsumer - batchSize 1 - 256MB/30s dynamodb:PutItem only">
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="n_Failed" name="markLinksExtractionFailed conditional PutItem attribute_not_exists ordinal truncated false, extractionFailed true">
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="n_Superseded" name="superseded: a barrier already exists a sibling delivery succeeded, leave it">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="n_BadEnvelope" name="envelope is not an EmailReceivedEvent fail the record, keep it for redrive">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Recv" targetRef="n_Evt" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Evt" targetRef="n_Rule" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Rule" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Q" targetRef="n_Worker" />
    <bpmn:sequenceFlow id="f_5" name="1 - before the preview publish" sourceRef="n_Worker" targetRef="n_Submit" />
    <bpmn:sequenceFlow id="f_6" name="2" sourceRef="n_Worker" targetRef="n_Crawl" />
    <bpmn:sequenceFlow id="f_9" name="per-email cap of 200 hit" sourceRef="n_Worker" targetRef="n_TruncQ" />
    <bpmn:sequenceFlow id="f_10" name="record fails" sourceRef="n_Worker" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_11" name="3 receives exhausted" sourceRef="n_Q" targetRef="n_D" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_D" targetRef="n_Alarm" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Failed" targetRef="n_Superseded" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_DlqFn" targetRef="n_BadEnvelope" />
    <bpmn:association id="f_4" sourceRef="n_Worker" targetRef="n_LinkRows" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_Worker" targetRef="n_Counts" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_Worker" targetRef="n_Meta" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_extraction_terminal_state">
    <bpmndi:BPMNPlane id="Plane_extraction_terminal_state" bpmnElement="Process_extraction_terminal_state">
