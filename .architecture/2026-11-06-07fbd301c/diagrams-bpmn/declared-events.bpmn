    <bpmn:sequenceFlow id="f_7" name="declared, unwired" sourceRef="n_R" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_C" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_F" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_10" name="MediaUploadCommitted" sourceRef="n_B" targetRef="n_P" />
    <bpmn:sequenceFlow id="f_11" name="MediaProcessingFailed" sourceRef="n_B" targetRef="n_SF" />
  </bpmn:process>
