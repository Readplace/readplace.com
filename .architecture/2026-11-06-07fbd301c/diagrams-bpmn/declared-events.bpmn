  <bpmn:process id="Process_declared_events" name="declared-events" isExecutable="false">
    <bpmn:serviceTask id="n_M" name="Media contracts: upload id, kind name, failure reason, inspection facts">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_S" name="MediaUploadStagedEvent">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_I" name="MediaInspectedEvent">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_R" name="MediaRejectedEvent">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_C" name="MediaUploadCommittedEvent">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_F" name="MediaProcessingFailedEvent">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_B" name="Shared event bus, source hutch.media">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_P" name="Media-book processor">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SF" name="Settle media failure (hutch)">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_M" targetRef="n_S" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_M" targetRef="n_I" />
