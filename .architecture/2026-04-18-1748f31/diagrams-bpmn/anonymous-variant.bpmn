    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_Q2" targetRef="n_S2" />
    <bpmn:sequenceFlow id="f_10" name="dispatchGenerateSummary (direct SQS)" sourceRef="n_S2" targetRef="n_C1" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_C1" targetRef="n_Q3" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Q3" targetRef="n_S3" />
