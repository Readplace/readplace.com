  <bpmn:process id="Process_anonymous_variant" name="anonymous-variant" isExecutable="false">
    <bpmn:startEvent id="n_UI2" name="Anonymous user views shared link view.page.ts">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_S0" name="Hutch Express App (Lambda)">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_C0" name="SaveAnonymousLinkCommand">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_EB" name="EventBridge">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q1" name="SQS save-anonymous-link-command">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_S1" name="Lambda: save-anonymous-link-command save-anonymous-link-command-handler.ts">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_R1" name="S3 + DynamoDB"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_E1" name="AnonymousLinkSavedEvent">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_Q2" name="SQS anonymous-link-saved">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_S2" name="Lambda: anonymous-link-saved anonymous-link-saved-handler.ts">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_C1" name="GenerateSummaryCommand">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q3" name="SQS generate-summary (shared with authenticated flow)">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_S3" name="Lambda: generate-summary">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_E2" name="SummaryGeneratedEvent">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="f_0" name="GET /view/:id" sourceRef="n_UI2" targetRef="n_S0" />
    <bpmn:sequenceFlow id="f_1" name="saveArticleGlobally + publishSaveAnonymousLink" sourceRef="n_S0" targetRef="n_C0" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_C0" targetRef="n_EB" />
