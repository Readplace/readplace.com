<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:userTask id="n_UI" name="User clicks Save in UI (queue page or browser extension)">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="n_C0" name="SaveArticle">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_S1" name="Hutch Express App (Lambda + API Gateway) queue.page.ts">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_FRESH" name="Freshness Check check-content-freshness.ts">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_R0" name="DynamoDB articles table GetItem etag/lastModified"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_ORIG" name="Origin website"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_S1P" name="parseArticle inline metadata">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_EVF1" name="ArticleContentRefreshed">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_EVF2" name="ArticleContentUnchanged">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_SKIP" name="noop">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_C_REFRESH" name="RefreshArticleContentCommand">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_C_TS1" name="UpdateFetchTimestampCommand">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_S1WRITE" name="saveArticle()">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_R1" name="DynamoDB articles table UpdateItem (metadata)"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_EV0" name="ArticleMetadataSaved in-process">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="n_C_TS2" name="UpdateFetchTimestampCommand">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_C1" name="SaveLinkCommand">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_EB" name="EventBridge hutch event bus">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:incoming>f_46</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:outgoing>f_34</bpmn:outgoing>
      <bpmn:outgoing>f_47</bpmn:outgoing>
      <bpmn:outgoing>f_51</bpmn:outgoing>
      <bpmn:outgoing>f_56</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q1" name="SQS save-link-command visibility 60s">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DLQ1" name="DLQ → SNS → email">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_S2" name="Lambda: save-link-command save-link-command-handler.ts">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:outgoing>f_28</bpmn:outgoing>
      <bpmn:outgoing>f_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ORIG2" name="Origin website full HTML + thumbnail"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_S2P" name="parseHtml">
      <bpmn:incoming>f_25</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_MED" name="Image origins"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_R2I" name="S3 content bucket images/&lt;hash&gt;.ext"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_S2C" name="processContent">
      <bpmn:incoming>f_28</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_R2H" name="S3 content bucket articles/&lt;id&gt;/content.html"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_R2D" name="DynamoDB UpdateItem (contentLocation)"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_R2T" name="DynamoDB UpdateItem (thumbnailUrl)"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_E1" name="LinkSavedEvent source=hutch.save-link">
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:outgoing>f_33</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_Q2" name="SQS link-saved visibility 60s">
      <bpmn:incoming>f_34</bpmn:incoming>
      <bpmn:outgoing>f_35</bpmn:outgoing>
      <bpmn:outgoing>f_36</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DLQ2" name="DLQ → SNS → email">
      <bpmn:incoming>f_35</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_S3" name="Lambda: link-saved link-saved-handler.ts">
      <bpmn:incoming>f_36</bpmn:incoming>
      <bpmn:outgoing>f_38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_R3" name="DynamoDB GetItem + S3 GetObject"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_C2" name="GenerateSummaryCommand">
      <bpmn:incoming>f_38</bpmn:incoming>
      <bpmn:outgoing>f_39</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q3" name="SQS generate-summary visibility 300s">
      <bpmn:incoming>f_39</bpmn:incoming>
      <bpmn:outgoing>f_40</bpmn:outgoing>
      <bpmn:outgoing>f_41</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DLQ3" name="DLQ → SNS → email">
      <bpmn:incoming>f_40</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_S4" name="Lambda: generate-summary generate-summary-handler.ts">
      <bpmn:incoming>f_41</bpmn:incoming>
      <bpmn:outgoing>f_45</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_R4" name="DynamoDB + S3"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_DS" name="Deepseek API"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_R4C" name="DynamoDB UpdateItem (summary)"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_E2" name="SummaryGeneratedEvent detail-type=GlobalSummaryGenerated">
      <bpmn:incoming>f_45</bpmn:incoming>
      <bpmn:outgoing>f_46</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_Q4" name="SQS summary-generated visibility 60s">
      <bpmn:incoming>f_47</bpmn:incoming>
      <bpmn:outgoing>f_48</bpmn:outgoing>
      <bpmn:outgoing>f_49</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DLQ4" name="DLQ → SNS → email">
      <bpmn:incoming>f_48</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_S5" name="Lambda: summary-generated summary-generated-handler.ts">
      <bpmn:incoming>f_49</bpmn:incoming>
      <bpmn:outgoing>f_50</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_END" name="done">
      <bpmn:incoming>f_50</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_Q5" name="SQS refresh-article-content visibility 60s">
      <bpmn:incoming>f_51</bpmn:incoming>
      <bpmn:outgoing>f_52</bpmn:outgoing>
      <bpmn:outgoing>f_53</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DLQ5" name="DLQ → SNS → email">
      <bpmn:incoming>f_52</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_S6" name="Lambda: refresh-article-content refresh-article-content-handler.ts">
      <bpmn:incoming>f_53</bpmn:incoming>
      <bpmn:outgoing>f_55</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_R6" name="DynamoDB UpdateItem metadata + etag + lastModified + contentFetchedAt"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_END2" name="done">
      <bpmn:incoming>f_55</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_Q6" name="SQS update-fetch-timestamp visibility 60s">
      <bpmn:incoming>f_56</bpmn:incoming>
      <bpmn:outgoing>f_57</bpmn:outgoing>
      <bpmn:outgoing>f_58</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DLQ6" name="DLQ → SNS → email">
      <bpmn:incoming>f_57</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_S7" name="Lambda: update-fetch-timestamp update-fetch-timestamp-handler.ts">
      <bpmn:incoming>f_58</bpmn:incoming>
      <bpmn:outgoing>f_60</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_R7" name="DynamoDB UpdateItem contentFetchedAt"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_END3" name="done">
      <bpmn:incoming>f_60</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="POST /queue (Siren) POST /queue/save (form)" sourceRef="n_UI" targetRef="n_C0" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_C0" targetRef="n_S1" />
    <bpmn:sequenceFlow id="f_2" name="refreshArticleIfStale()" sourceRef="n_S1" targetRef="n_FRESH" />
    <bpmn:sequenceFlow id="f_5" name="action: new" sourceRef="n_FRESH" targetRef="n_S1P" />
    <bpmn:sequenceFlow id="f_6" name="action: refreshed (HTTP 200, parsed)" sourceRef="n_FRESH" targetRef="n_EVF1" />
    <bpmn:sequenceFlow id="f_7" name="action: unchanged (HTTP 304)" sourceRef="n_FRESH" targetRef="n_EVF2" />
    <bpmn:sequenceFlow id="f_8" name="action: skip" sourceRef="n_FRESH" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_9" name="publishRefreshArticleContent" sourceRef="n_EVF1" targetRef="n_C_REFRESH" />
    <bpmn:sequenceFlow id="f_10" name="publishUpdateFetchTimestamp" sourceRef="n_EVF2" targetRef="n_C_TS1" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_S1P" targetRef="n_S1WRITE" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_S1WRITE" targetRef="n_EV0" />
    <bpmn:sequenceFlow id="f_14" name="publishUpdateFetchTimestamp" sourceRef="n_EV0" targetRef="n_C_TS2" />
    <bpmn:sequenceFlow id="f_15" name="publishLinkSaved (see eventbridge-link-saved.ts)" sourceRef="n_EV0" targetRef="n_C1" />
    <bpmn:sequenceFlow id="f_16" name="HTTP 201 Siren / 303 redirect" sourceRef="n_S1WRITE" targetRef="n_UI" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_C1" targetRef="n_EB" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_C_REFRESH" targetRef="n_EB" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_C_TS1" targetRef="n_EB" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_C_TS2" targetRef="n_EB" />
    <bpmn:sequenceFlow id="f_21" name="rule: source=hutch.api detail-type=SaveLinkCommand" sourceRef="n_EB" targetRef="n_Q1" />
    <bpmn:sequenceFlow id="f_22" name="on failure" sourceRef="n_Q1" targetRef="n_DLQ1" />
    <bpmn:sequenceFlow id="f_23" name="EventSourceMapping batchSize=1" sourceRef="n_Q1" targetRef="n_S2" />
    <bpmn:sequenceFlow id="f_25" name="parseHtml (Readability)" sourceRef="n_S2" targetRef="n_S2P" />
    <bpmn:sequenceFlow id="f_28" name="processContent (rewrite img URLs to CDN)" sourceRef="n_S2" targetRef="n_S2C" />
    <bpmn:sequenceFlow id="f_32" name="" sourceRef="n_S2" targetRef="n_E1" />
    <bpmn:sequenceFlow id="f_33" name="publishEvent" sourceRef="n_E1" targetRef="n_EB" />
    <bpmn:sequenceFlow id="f_34" name="rule: detail-type=LinkSaved" sourceRef="n_EB" targetRef="n_Q2" />
    <bpmn:sequenceFlow id="f_35" name="on failure" sourceRef="n_Q2" targetRef="n_DLQ2" />
    <bpmn:sequenceFlow id="f_36" name="" sourceRef="n_Q2" targetRef="n_S3" />
    <bpmn:sequenceFlow id="f_38" name="dispatchGenerateSummary (direct SQS, NOT EventBridge)" sourceRef="n_S3" targetRef="n_C2" />
    <bpmn:sequenceFlow id="f_39" name="" sourceRef="n_C2" targetRef="n_Q3" />
    <bpmn:sequenceFlow id="f_40" name="on failure" sourceRef="n_Q3" targetRef="n_DLQ3" />
    <bpmn:sequenceFlow id="f_41" name="" sourceRef="n_Q3" targetRef="n_S4" />
    <bpmn:sequenceFlow id="f_45" name="" sourceRef="n_S4" targetRef="n_E2" />
    <bpmn:sequenceFlow id="f_46" name="publishEvent" sourceRef="n_E2" targetRef="n_EB" />
    <bpmn:sequenceFlow id="f_47" name="rule: detail-type=GlobalSummaryGenerated" sourceRef="n_EB" targetRef="n_Q4" />
    <bpmn:sequenceFlow id="f_48" name="on failure" sourceRef="n_Q4" targetRef="n_DLQ4" />
    <bpmn:sequenceFlow id="f_49" name="" sourceRef="n_Q4" targetRef="n_S5" />
    <bpmn:sequenceFlow id="f_50" name="logger.info (terminal)" sourceRef="n_S5" targetRef="n_END" />
    <bpmn:sequenceFlow id="f_51" name="rule: detail-type=RefreshArticleContentCommand" sourceRef="n_EB" targetRef="n_Q5" />
    <bpmn:sequenceFlow id="f_52" name="on failure" sourceRef="n_Q5" targetRef="n_DLQ5" />
    <bpmn:sequenceFlow id="f_53" name="" sourceRef="n_Q5" targetRef="n_S6" />
    <bpmn:sequenceFlow id="f_55" name="" sourceRef="n_S6" targetRef="n_END2" />
    <bpmn:sequenceFlow id="f_56" name="rule: detail-type=UpdateFetchTimestampCommand" sourceRef="n_EB" targetRef="n_Q6" />
    <bpmn:sequenceFlow id="f_57" name="on failure" sourceRef="n_Q6" targetRef="n_DLQ6" />
    <bpmn:sequenceFlow id="f_58" name="" sourceRef="n_Q6" targetRef="n_S7" />
    <bpmn:sequenceFlow id="f_60" name="" sourceRef="n_S7" targetRef="n_END3" />
    <bpmn:association id="f_3" sourceRef="n_FRESH" targetRef="n_R0" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_FRESH" targetRef="n_ORIG" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_S1WRITE" targetRef="n_R1" associationDirection="One" />
