    <bpmn:association id="f_31" sourceRef="n_S2" targetRef="n_R2T" associationDirection="One" />
    <bpmn:association id="f_37" sourceRef="n_S3" targetRef="n_R3" associationDirection="One" />
    <bpmn:association id="f_42" sourceRef="n_S4" targetRef="n_R4" associationDirection="One" />
    <bpmn:association id="f_43" sourceRef="n_S4" targetRef="n_DS" associationDirection="One" />
    <bpmn:association id="f_44" sourceRef="n_S4" targetRef="n_R4C" associationDirection="One" />
    <bpmn:association id="f_54" sourceRef="n_S6" targetRef="n_R6" associationDirection="One" />
    <bpmn:association id="f_59" sourceRef="n_S7" targetRef="n_R7" associationDirection="One" />
  </bpmn:process>
