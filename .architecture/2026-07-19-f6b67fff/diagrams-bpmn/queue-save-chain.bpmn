<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_queue_save_chain" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_queue_save_chain" name="queue-save-chain" isExecutable="false">
    <bpmn:sendTask id="n_SLC" name="SubmitLinkCommand userId, url first live producer: inbox extract Lambda (aggregate-effect publisher still dormant)">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Rule" name="EventRule submit-link-command-rule">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_SQ" name="SQS submit-link visibility 480s, maxReceiveCount 3, alarm-only DLQ">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Sub" name="submit-link Lambda — collapsed guards, crawl-status-aware freshness, shared accept phase, in-process tier-1 crawl (see companion snapshot submit-link-entry-point.md)">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_QueueRow" name="reader's unread queue: stub card at accept time, savedAt bump + read-to-unread resurface on a re-arrival"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_Tier" name="TierContentExtractedEvent">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_Sel" name="select-most-complete-content Lambda sole canonical promoter">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_LS" name="LinkSavedEvent">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_LSL" name="link-saved Lambda">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_GS" name="GenerateSummaryCommand">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Sum" name="generate-summary Lambda summary + AI excerpt">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_RVS" name="ReaderViewLoadingSucceeded (successful terminal reader state)">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_Fan" name="reader-ready digest chain (hutch): fan-out via user-articles url-index, 6h digest schedule, per-user gates, single digest email">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SLC" targetRef="n_Rule" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Rule" targetRef="n_SQ" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_SQ" targetRef="n_Sub" />
    <bpmn:sequenceFlow id="f_4" name="tier-1 source written (PDF links detour via the comprehensive-crawl chain)" sourceRef="n_Sub" targetRef="n_Tier" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Tier" targetRef="n_Sel" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Sel" targetRef="n_LS" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_LS" targetRef="n_LSL" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_LSL" targetRef="n_GS" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_GS" targetRef="n_Sum" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Sum" targetRef="n_RVS" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_RVS" targetRef="n_Fan" />
    <bpmn:association id="f_3" sourceRef="n_Sub" targetRef="n_QueueRow" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_queue_save_chain">
    <bpmndi:BPMNPlane id="Plane_queue_save_chain" bpmnElement="Process_queue_save_chain">
      <bpmndi:BPMNShape id="n_SLC_di" bpmnElement="n_SLC">
        <dc:Bounds x="107.99" y="28" width="186" height="116" />
      </bpmndi:BPMNShape>
