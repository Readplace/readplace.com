<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:sendTask id="n_GSC" name="GenerateSummaryCommand">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_GS" name="generate-summary worker markSummaryReady / markSummarySkipped">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_SGE" name="SummaryGeneratedEvent">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="n_RVLS" name="ReaderViewLoadingSucceeded url, succeededAt, hasSummary">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_FQ" name="reader-ready-fanout queue">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_FAN" name="reader-ready-fanout Lambda">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_UA" name="user-articles rows succeededAt / viewedAt / emailSentAt"></bpmn:dataStoreReference>
    <bpmn:task id="n_NQ" name="reader-ready-notify queue">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_NRVR" name="NotifyReaderViewReadyCommand userId, url, succeededAt">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_NOTIFY" name="reader-ready-notify Lambda">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_GATE" name="per-user gates row exists · not read · not re-saved · not already emailed · gen &gt; 60s · viewedAt &lt; succeededAt · email verified">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_DROP" name="dropped + logged">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_CLAIM" name="claimReaderReadyEmailSlot atomic 6h cooldown on reader-ready-notifications row">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_USERS" name="reader-ready-notifications row userId PK · lastReaderReadyEmailAt"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_SEND" name="send Resend email APP_ORIGIN/queue/&lt;id&gt;/view">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_RRES" name="ReaderReadyEmailSentEvent userId, url, sentAt">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_FDLQ" name="fanout DLQ → alarm">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_NDLQ" name="notify DLQ → alarm">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_GSC" targetRef="n_GS" />
    <bpmn:sequenceFlow id="f_1" name="publish-summary-generated" sourceRef="n_GS" targetRef="n_SGE" />
    <bpmn:sequenceFlow id="f_2" name="publish-reader-view-loading-succeeded succeededAt = persist moment" sourceRef="n_GS" targetRef="n_RVLS" />
    <bpmn:sequenceFlow id="f_3" name="EventBridge → SQS" sourceRef="n_RVLS" targetRef="n_FQ" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_FQ" targetRef="n_FAN" />
    <bpmn:sequenceFlow id="f_7" name="hasSummary AND viewedAt set DelaySeconds = 300" sourceRef="n_FAN" targetRef="n_NQ" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_NQ" targetRef="n_NRVR" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_NRVR" targetRef="n_NOTIFY" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_NOTIFY" targetRef="n_GATE" />
    <bpmn:sequenceFlow id="f_12" name="any miss → skip + log" sourceRef="n_GATE" targetRef="n_DROP" />
    <bpmn:sequenceFlow id="f_13" name="all pass" sourceRef="n_GATE" targetRef="n_CLAIM" />
    <bpmn:sequenceFlow id="f_15" name="rejected: within cooldown" sourceRef="n_CLAIM" targetRef="n_DROP" />
    <bpmn:sequenceFlow id="f_16" name="claimed" sourceRef="n_CLAIM" targetRef="n_SEND" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_SEND" targetRef="n_RRES" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_FQ" targetRef="n_FDLQ" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_NQ" targetRef="n_NDLQ" />
    <bpmn:association id="f_5" sourceRef="n_FAN" targetRef="n_UA" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_FAN" targetRef="n_UA" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_FAN" targetRef="n_UA" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_CLAIM" targetRef="n_USERS" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_SEND" targetRef="n_UA" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_end_to_end_flow">
