<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_save_email_issue" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_save_email_issue" name="save-email-issue" isExecutable="false">
    <bpmn:sendTask id="n_Command" name="SaveEmailIssueCommand reader, message, subject, sender, issue URL, readlists">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="save-email-issue-command queue three receives, own DLQ and alarm">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Lambda" name="Save-email-issue Lambda read the stored email body">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Body" name="Existing content S3 sanitized email body under the issue key"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_Retry" name="Fail the record for an SQS retry">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="n_Meta" name="Derive title, newsletter name, excerpt and read time">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_Save" name="Save under the email's own key email://inbox/reader/message">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Articles" name="Existing article and per-user All rows email provenance"></bpmn:dataStoreReference>
    <bpmn:task id="n_Display" name="Display URL is the email's inbox page">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_ArticleRow" name="Existing article row displayUrl"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_File" name="Existing filing into each mapped custom readlist">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Lists" name="Existing readlist memberships"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_Entry" name="QueueEntryCreatedEvent">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_RelatedQ" name="Existing related-articles queue">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="n_Ready" name="Content already ready?">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_Done" name="Membership only">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_Pending" name="Mark crawl and summary pending">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_Source" name="Write the body as the tier-0 source no author, so no remove-my-version control">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Tier0" name="Existing tier-source S3 objects"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_Tier" name="TierContentExtractedEvent">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_SelectQ" name="Existing content-selector queue">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Select" name="Existing selector only available tier becomes canonical">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_Changed" name="CanonicalContentChangedEvent">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_Summary" name="Existing summary generation">
      <bpmn:incoming>f_23</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Onboarding" name="Stamp the inbox onboarding signal best effort">
      <bpmn:incoming>f_24</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_DLQ" name="save-email-issue-command DLQ">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Command" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Q" targetRef="n_Lambda" />
    <bpmn:sequenceFlow id="f_3" name="body not readable yet" sourceRef="n_Lambda" targetRef="n_Retry" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Retry" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Lambda" targetRef="n_Meta" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Meta" targetRef="n_Save" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_Save" targetRef="n_Display" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Save" targetRef="n_File" />
    <bpmn:sequenceFlow id="f_12" name="new reader membership" sourceRef="n_Save" targetRef="n_Entry" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Entry" targetRef="n_RelatedQ" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_Save" targetRef="n_Ready" />
    <bpmn:sequenceFlow id="f_15" name="yes, a repeat delivery" sourceRef="n_Ready" targetRef="n_Done" />
    <bpmn:sequenceFlow id="f_16" name="no" sourceRef="n_Ready" targetRef="n_Pending" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_Pending" targetRef="n_Source" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_Source" targetRef="n_Tier" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_Tier" targetRef="n_SelectQ" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_SelectQ" targetRef="n_Select" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_Select" targetRef="n_Changed" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_Changed" targetRef="n_Summary" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_Lambda" targetRef="n_Onboarding" />
    <bpmn:sequenceFlow id="f_25" name="retry exhaustion" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:association id="f_2" sourceRef="n_Body" targetRef="n_Lambda" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_Save" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_Display" targetRef="n_ArticleRow" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_File" targetRef="n_Lists" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_Source" targetRef="n_Tier0" associationDirection="One" />
  </bpmn:process>
