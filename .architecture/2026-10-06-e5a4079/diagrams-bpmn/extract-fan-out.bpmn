<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_extract_fan_out" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_extract_fan_out" name="extract-fan-out" isExecutable="false">
    <bpmn:startEvent id="n_Received" name="EmailReceivedEvent">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_Q" name="Existing extraction queue">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Extract" name="Extract Lambda re-derive links from raw mail and triage them">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_Mode" name="Routing and delivery mode">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_Links" name="Existing link fan-out">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_IssueOnly" name="Issue only no link saves and no custom filtering">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_Both" name="Issue and link fan-out">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_Access" name="Submitting origin and write access?">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_Quiet" name="Previews only">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_HeldNotice" name="Existing saves-held notice once per email">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SaveIssue" name="SaveEmailIssueCommand published before the first preview">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_IssueQ" name="save-email-issue-command queue">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="n_First" name="Existing first-inbox-email notice link fan-out only">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_Submit" name="SubmitLinkCommand to All">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_Triaged" name="EmailLinksTriagedEvent one per custom readlist">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sendTask id="n_Preview" name="CrawlEmailLinkPreview every pending link in every mode">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_PreviewQ" name="Existing preview queue">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Crawl" name="Existing preview Lambda">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Rows" name="Existing email-links rows read later by the reader's issue panel"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Meta" name="Counts and metadata no readlist selection snapshot in issue mode">
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_MetaStore" name="Existing email-links metadata"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_DLQ" name="Existing inbox failure DLQ">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Received" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Q" targetRef="n_Extract" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Extract" targetRef="n_Mode" />
    <bpmn:sequenceFlow id="f_3" name="inbox address or links" sourceRef="n_Mode" targetRef="n_Links" />
    <bpmn:sequenceFlow id="f_4" name="issue" sourceRef="n_Mode" targetRef="n_IssueOnly" />
    <bpmn:sequenceFlow id="f_5" name="both" sourceRef="n_Mode" targetRef="n_Both" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Both" targetRef="n_Links" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_IssueOnly" targetRef="n_Access" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_Both" targetRef="n_Access" />
    <bpmn:sequenceFlow id="f_9" name="backfill or unrouted audit" sourceRef="n_Access" targetRef="n_Quiet" />
    <bpmn:sequenceFlow id="f_10" name="read only" sourceRef="n_Access" targetRef="n_HeldNotice" />
    <bpmn:sequenceFlow id="f_11" name="full" sourceRef="n_Access" targetRef="n_SaveIssue" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_SaveIssue" targetRef="n_IssueQ" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Links" targetRef="n_First" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_Links" targetRef="n_Submit" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_Links" targetRef="n_Triaged" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_Extract" targetRef="n_Preview" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_Preview" targetRef="n_PreviewQ" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_PreviewQ" targetRef="n_Crawl" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_Extract" targetRef="n_Meta" />
    <bpmn:sequenceFlow id="f_22" name="retry exhaustion" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:association id="f_19" sourceRef="n_Crawl" targetRef="n_Rows" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_Meta" targetRef="n_MetaStore" associationDirection="One" />
  </bpmn:process>
