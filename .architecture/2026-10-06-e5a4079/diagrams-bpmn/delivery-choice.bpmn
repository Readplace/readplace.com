<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_delivery_choice" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_delivery_choice" name="delivery-choice" isExecutable="false">
    <bpmn:startEvent id="n_Entry" name="Reader opens the Gmail newsletter picker for a new sender or with Edit on a mapping row">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="n_Picker" name="Picker state carries delivery issue, links or both">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_Mapped" name="Sender already mapped?">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_Issue" name="Preselect the issue itself">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Current" name="Preselect the sender's delivery mode">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Legacy" name="Preselect links what that mapping has been delivering">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_Save" name="POST /gmail/senders/add destinations plus delivery mode">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_Resolve" name="Resolve destinations compare saved destinations and mode">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Senders" name="Existing Gmail sender table deliveryMode beside mappedAddresses"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_Changed" name="Destinations or mode changed?">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_Cancel" name="Cancel unfinished sender imports destination-changed">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_Filter" name="RewriteGmailFilterCommand">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_FilterQ" name="Existing rewrite-gmail-filter queue">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="n_Row" name="Mapping row names what the sender saves Edit reopens the picker on it">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:task>
    <bpmn:sendTask id="n_Delete" name="Delete a selected readlist">
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_Move" name="Existing deletion decorator keeps the sender's delivery mode">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Entry" targetRef="n_Picker" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Picker" targetRef="n_Mapped" />
    <bpmn:sequenceFlow id="f_2" name="no" sourceRef="n_Mapped" targetRef="n_Issue" />
    <bpmn:sequenceFlow id="f_3" name="yes, with a chosen mode" sourceRef="n_Mapped" targetRef="n_Current" />
    <bpmn:sequenceFlow id="f_4" name="yes, mapped before modes existed" sourceRef="n_Mapped" targetRef="n_Legacy" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Issue" targetRef="n_Save" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Current" targetRef="n_Save" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Legacy" targetRef="n_Save" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_Save" targetRef="n_Resolve" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Resolve" targetRef="n_Changed" />
    <bpmn:sequenceFlow id="f_11" name="yes" sourceRef="n_Changed" targetRef="n_Cancel" />
    <bpmn:sequenceFlow id="f_12" name="no or first mapping" sourceRef="n_Changed" targetRef="n_Filter" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Cancel" targetRef="n_Filter" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_Filter" targetRef="n_FilterQ" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_Resolve" targetRef="n_Row" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_Delete" targetRef="n_Move" />
    <bpmn:association id="f_9" sourceRef="n_Resolve" targetRef="n_Senders" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_Move" targetRef="n_Senders" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_delivery_choice">
    <bpmndi:BPMNPlane id="Plane_delivery_choice" bpmnElement="Process_delivery_choice">
      <bpmndi:BPMNShape id="n_Entry_di" bpmnElement="n_Entry">
        <dc:Bounds x="212.88" y="28" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Picker_di" bpmnElement="n_Picker">
