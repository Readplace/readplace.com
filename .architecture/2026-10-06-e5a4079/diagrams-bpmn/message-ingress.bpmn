<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_message_ingress" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_message_ingress" name="message-ingress" isExecutable="false">
    <bpmn:startEvent id="n_Mail" name="Gmail forwarded mail">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_ReceiveQ" name="Existing inbox-receive-email queue">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Receive" name="Receive Lambda resolve recipients and parse">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_Accepted" name="Same raw object already accepted?">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_Resume" name="Republish the accepted row's routing destinations and delivery mode">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_Route" name="Resolve sender destinations and delivery mode">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Senders" name="Existing Gmail sender table"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Held" name="Existing held-mail table"></bpmn:dataStoreReference>
    <bpmn:task id="n_Addressed" name="Delivered as addressed delivery mode links">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_Snapshot" name="Routing kind gmail destinationAddresses and deliveryMode">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_Ingest" name="Existing identity claim and ingestion email row stores gmailDeliveryMode">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Emails" name="Existing inbox email table and content S3"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_Received" name="EmailReceivedEvent gmail routing carries deliveryMode">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_Worker" name="Existing Gmail history import page worker reads the sender's current mode">
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_Fetched" name="GmailHistoryImportMessageFetchedEvent carries deliveryMode">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_ImportQ" name="Existing inbox-ingest-gmail-import queue">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="n_ImportIngest" name="Existing import ingestion routing takes the event's mode">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="n_ExtractQ" name="Existing inbox-extract-email-links queue">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Mail" targetRef="n_ReceiveQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_ReceiveQ" targetRef="n_Receive" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Receive" targetRef="n_Accepted" />
    <bpmn:sequenceFlow id="f_3" name="yes" sourceRef="n_Accepted" targetRef="n_Resume" />
    <bpmn:sequenceFlow id="f_4" name="no" sourceRef="n_Accepted" targetRef="n_Route" />
    <bpmn:sequenceFlow id="f_7" name="unreadable sender or unknown alias sender" sourceRef="n_Route" targetRef="n_Addressed" />
    <bpmn:sequenceFlow id="f_8" name="mapped sender" sourceRef="n_Route" targetRef="n_Snapshot" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_Addressed" targetRef="n_Snapshot" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Snapshot" targetRef="n_Ingest" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Ingest" targetRef="n_Received" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Resume" targetRef="n_Received" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_Worker" targetRef="n_Fetched" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_Fetched" targetRef="n_ImportQ" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_ImportQ" targetRef="n_ImportIngest" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_ImportIngest" targetRef="n_Ingest" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_Received" targetRef="n_ExtractQ" />
    <bpmn:association id="f_5" sourceRef="n_Route" targetRef="n_Senders" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_Route" targetRef="n_Held" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_Ingest" targetRef="n_Emails" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_message_ingress">
    <bpmndi:BPMNPlane id="Plane_message_ingress" bpmnElement="Process_message_ingress">
      <bpmndi:BPMNShape id="n_Mail_di" bpmnElement="n_Mail">
