<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_reader_issue_links" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_reader_issue_links" name="reader-issue-links" isExecutable="false">
    <bpmn:startEvent id="n_Open" name="Reader opens a saved issue GET /queue/:id/view">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_Reader" name="Web Lambda owner reader">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_IsIssue" name="Article key is an email issue?">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_Hidden" name="Panel rendered hidden share prompt and EPUB as before">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="n_Panel" name="Links in this issue panel share prompt and EPUB withheld">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_LinkRows" name="Existing email-links rows and metadata new read grant for the web Lambda"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_SaveStates" name="Existing inbox saved-link read model new read grant for the web Lambda"></bpmn:dataStoreReference>
    <bpmn:startEvent id="n_Click" name="Reader presses Save on a link">
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="n_Post" name="POST /queue/:id/issue-links ordinal and returnTo">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_Check" name="Owned issue, known link, saveable URL?">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_NotFound" name="404">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_Inline" name="Existing inline save to the top of All provenance is the newsletter">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Articles" name="Existing article and All membership rows"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_Queued" name="LinkQueuedEvent">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_RecorderQ" name="Existing inbox saved-link recorder queue">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Recorder" name="Existing saved-link recorder">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_Saved" name="LinkSavedEvent">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_Crawl" name="Existing crawl and enrichment">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_Back" name="303 to the reader issue_link_saved marks the row saved at once">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="n_Stranger" name="Someone else opens the issue's reader link">
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="n_Permalink" name="Not found instead of the public view">
      <bpmn:incoming>f_19</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Open" targetRef="n_Reader" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Reader" targetRef="n_IsIssue" />
    <bpmn:sequenceFlow id="f_2" name="no" sourceRef="n_IsIssue" targetRef="n_Hidden" />
    <bpmn:sequenceFlow id="f_3" name="yes" sourceRef="n_IsIssue" targetRef="n_Panel" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Click" targetRef="n_Post" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Post" targetRef="n_Check" />
    <bpmn:sequenceFlow id="f_8" name="no" sourceRef="n_Check" targetRef="n_NotFound" />
    <bpmn:sequenceFlow id="f_9" name="yes" sourceRef="n_Check" targetRef="n_Inline" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_Inline" targetRef="n_Queued" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Queued" targetRef="n_RecorderQ" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_RecorderQ" targetRef="n_Recorder" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_Inline" targetRef="n_Saved" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_Saved" targetRef="n_Crawl" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_Inline" targetRef="n_Back" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_Back" targetRef="n_Panel" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_Stranger" targetRef="n_Permalink" />
    <bpmn:association id="f_4" sourceRef="n_Panel" targetRef="n_LinkRows" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_Panel" targetRef="n_SaveStates" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_Inline" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_Recorder" targetRef="n_SaveStates" associationDirection="One" />
  </bpmn:process>
