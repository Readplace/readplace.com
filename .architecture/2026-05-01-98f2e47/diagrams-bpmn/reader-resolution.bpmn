<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_reader_resolution" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_reader_resolution" name="reader-resolution" isExecutable="false">
    <bpmn:businessRuleTask id="n_Caller" name="resolveReaderState / handleReaderPoll / handleSummaryPoll called by /view, /queue, /admin/recrawl">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_Read1" name="findArticleCrawlStatus">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Read2" name="findGeneratedSummary">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Read3" name="readArticleContent S3 GetObject content/&lt;id&gt;/content.html">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Articles" name="DynamoDB articles crawlStatus, summaryStatus, summary, excerpt"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_S3" name="S3 content bucket canonical bytes"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_Both" name="crawl undefined AND summary undefined?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_HealC" name="markCrawlPending">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_HealS" name="markSummaryPending">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ReReadCS" name="re-read crawl + summary">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_KeepPoll" name="shouldKeepPollingReader">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_Poll1" name="case 1: in-flight">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_Poll2" name="case 2: read-after-write race markCrawlPending hasn't propagated">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_Poll3" name="case 3: promotion race selector flipped row before S3 CopyObject">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_Stop" name="stop polling">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:incoming>f_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_Bound" name="pollCount &lt; 40?">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_NextPoll" name="set readerPollUrl ?poll=N+1 HTMX swap continues">
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_SumPoll" name="summary status === pending AND not crawl-failed AND pollCount &lt; 40?">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_SumPollUrl" name="set summaryPollUrl">
      <bpmn:incoming>f_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="n_SumStop" name="summary slot terminal collapse if failed/skipped">
      <bpmn:incoming>f_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_Progress" name="buildUnifiedProgress pick further-along pipeline">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_BarOut" name="progress source">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
      <bpmn:outgoing>f_29</bpmn:outgoing>
      <bpmn:outgoing>f_30</bpmn:outgoing>
      <bpmn:outgoing>f_31</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_NoBar" name="undefined - hide bar">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:outgoing>f_34</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_CrawlPct" name="CRAWL_STAGE_TO_PCT - lower half">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:outgoing>f_32</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_SumPct" name="SUMMARY_STAGE_TO_PCT - upper half">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:outgoing>f_33</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_Oob" name="renderProgressBarOob HTMX hx-swap-oob to id=progress-bar">
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:incoming>f_34</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Excerpt" name="GeneratedSummary.excerpt 1 or 2 short sentences, max 280 chars"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_ListUI" name="Article-list views render AI excerpt when present fallback to Readability excerpt"></bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Caller" targetRef="n_Read1" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Caller" targetRef="n_Read2" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Caller" targetRef="n_Read3" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Read1" targetRef="n_Both" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Read2" targetRef="n_Both" />
    <bpmn:sequenceFlow id="f_8" name="yes, legacy stub" sourceRef="n_Both" targetRef="n_HealC" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_HealC" targetRef="n_HealS" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_HealS" targetRef="n_ReReadCS" />
    <bpmn:sequenceFlow id="f_12" name="no" sourceRef="n_Both" targetRef="n_KeepPoll" />
    <bpmn:sequenceFlow id="f_13" name="crawl=pending" sourceRef="n_KeepPoll" targetRef="n_Poll1" />
    <bpmn:sequenceFlow id="f_14" name="crawl=undefined AND content=undefined" sourceRef="n_KeepPoll" targetRef="n_Poll2" />
    <bpmn:sequenceFlow id="f_15" name="crawl=ready AND content=undefined" sourceRef="n_KeepPoll" targetRef="n_Poll3" />
    <bpmn:sequenceFlow id="f_16" name="ready+content OR failed" sourceRef="n_KeepPoll" targetRef="n_Stop" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_Poll1" targetRef="n_Bound" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_Poll2" targetRef="n_Bound" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_Poll3" targetRef="n_Bound" />
    <bpmn:sequenceFlow id="f_20" name="yes" sourceRef="n_Bound" targetRef="n_NextPoll" />
    <bpmn:sequenceFlow id="f_21" name="no, exhausted" sourceRef="n_Bound" targetRef="n_Stop" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_Read2" targetRef="n_SumPoll" />
    <bpmn:sequenceFlow id="f_23" name="yes" sourceRef="n_SumPoll" targetRef="n_SumPollUrl" />
    <bpmn:sequenceFlow id="f_24" name="no" sourceRef="n_SumPoll" targetRef="n_SumStop" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_Read1" targetRef="n_Progress" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_Read2" targetRef="n_Progress" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_Progress" targetRef="n_BarOut" />
    <bpmn:sequenceFlow id="f_28" name="crawl=failed" sourceRef="n_BarOut" targetRef="n_NoBar" />
    <bpmn:sequenceFlow id="f_29" name="crawl=pending" sourceRef="n_BarOut" targetRef="n_CrawlPct" />
    <bpmn:sequenceFlow id="f_30" name="summary pipeline" sourceRef="n_BarOut" targetRef="n_SumPct" />
    <bpmn:sequenceFlow id="f_31" name="both terminal" sourceRef="n_BarOut" targetRef="n_NoBar" />
    <bpmn:sequenceFlow id="f_32" name="" sourceRef="n_CrawlPct" targetRef="n_Oob" />
    <bpmn:sequenceFlow id="f_33" name="" sourceRef="n_SumPct" targetRef="n_Oob" />
    <bpmn:sequenceFlow id="f_34" name="" sourceRef="n_NoBar" targetRef="n_Oob" />
    <bpmn:association id="f_1" sourceRef="n_Read1" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_Read2" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_Read3" targetRef="n_S3" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_ReReadCS" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_35" sourceRef="n_Read2" targetRef="n_Excerpt" associationDirection="One" />
    <bpmn:association id="f_36" sourceRef="n_Excerpt" targetRef="n_ListUI" associationDirection="One" />
  </bpmn:process>
