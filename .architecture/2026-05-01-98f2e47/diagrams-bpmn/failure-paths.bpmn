<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_failure_paths" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_failure_paths" name="failure-paths" isExecutable="false">
    <bpmn:intermediateCatchEvent id="n_QRLI" name="recrawl-link-initiated vis 60s">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_QRCE" name="recrawl-content-extracted vis 90s">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DLQ_RLI" name="recrawl-link-initiated-dlq">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_DLQ_RCE" name="recrawl-content-extracted-dlq">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_NoSources" name="listAvailableTierSources returned 0?">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_Throw" name="throw — let SQS redeliver after vis timeout">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_DH_RLI" name="recrawl-link-initiated-dlq Lambda parses RecrawlLinkInitiatedEvent.detail">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_DH_RCE" name="recrawl-content-extracted-dlq Lambda parses RecrawlContentExtractedEvent.detail">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Mark" name="markCrawlFailed crawlStatus=failed, reason=exceeded SQS maxReceiveCount, receiveCount=N">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Articles" name="DynamoDB articles crawlStatus=failed"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_CAFE" name="CrawlArticleFailedEvent url, reason, receiveCount source=hutch.save-link">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_Bus" name="EventBridge default-bus">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_Alarm" name="CloudWatch alarm DLQ depth ≥ 1">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_SNS" name="SNS to alertEmail"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_Reader" name="Reader UI buildUnifiedProgress returns undefined reader-slot renders failed-banner summary-slot collapses"></bpmn:endEvent>
    <bpmn:serviceTask id="n_SumMark" name="markSummaryFailed by HutchDLQEventHandler so summary slot doesn't sit on pending forever fixed in PR 207">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Sum" name="DynamoDB summary attrs status=failed"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_SGFE" name="SummaryGenerationFailedEvent parse-error log feed">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="f_0" name="exceed maxReceiveCount=3" sourceRef="n_QRLI" targetRef="n_DLQ_RLI" />
    <bpmn:sequenceFlow id="f_1" name="exceed" sourceRef="n_QRCE" targetRef="n_DLQ_RCE" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_QRCE" targetRef="n_NoSources" />
    <bpmn:sequenceFlow id="f_3" name="yes" sourceRef="n_NoSources" targetRef="n_Throw" />
    <bpmn:sequenceFlow id="f_4" name="up to 3x" sourceRef="n_Throw" targetRef="n_QRCE" />
    <bpmn:sequenceFlow id="f_5" name="eventually" sourceRef="n_Throw" targetRef="n_DLQ_RCE" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_DLQ_RLI" targetRef="n_DH_RLI" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_DLQ_RCE" targetRef="n_DH_RCE" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_DH_RLI" targetRef="n_Mark" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_DH_RCE" targetRef="n_Mark" />
    <bpmn:sequenceFlow id="f_11" name="publish" sourceRef="n_DH_RLI" targetRef="n_CAFE" />
    <bpmn:sequenceFlow id="f_12" name="publish" sourceRef="n_DH_RCE" targetRef="n_CAFE" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_CAFE" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_14" name="metric" sourceRef="n_DLQ_RLI" targetRef="n_Alarm" />
    <bpmn:sequenceFlow id="f_15" name="metric" sourceRef="n_DLQ_RCE" targetRef="n_Alarm" />
    <bpmn:sequenceFlow id="f_18" name="also" sourceRef="n_DH_RLI" targetRef="n_SumMark" />
    <bpmn:sequenceFlow id="f_19" name="also" sourceRef="n_DH_RCE" targetRef="n_SumMark" />
    <bpmn:sequenceFlow id="f_21" name="publish" sourceRef="n_SumMark" targetRef="n_SGFE" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_SGFE" targetRef="n_Bus" />
    <bpmn:association id="f_10" sourceRef="n_Mark" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_Alarm" targetRef="n_SNS" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_Articles" targetRef="n_Reader" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_SumMark" targetRef="n_Sum" associationDirection="One" />
  </bpmn:process>
