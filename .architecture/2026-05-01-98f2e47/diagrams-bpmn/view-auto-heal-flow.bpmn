<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_view_auto_heal_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_view_auto_heal_flow" name="view-auto-heal-flow" isExecutable="false">
    <bpmn:businessRuleTask id="n_View" name="GET /view/&lt;url&gt; anonymous, no auth">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_Validate" name="ViewUrlSchema.safeParse + scheme normalisation https:/ → https://">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_Bad" name="render SaveErrorPage">
      <bpmn:incoming>f_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_Fresh" name="refreshArticleIfStale findArticleFreshness + findArticleCrawlStatus">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Articles" name="DynamoDB articles contentFetchedAt, etag, lastModified, crawlStatus"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_Decision" name="action">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_New" name="action=new row missing entirely">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_Reprime" name="action=reprime crawl missing or status=failed auto-heal trigger">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_Skip" name="action=skip fresh, parse failed, or fetch failed">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_Unchanged" name="action=unchanged 304 not-modified publish UpdateFetchTimestamp">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_Refreshed" name="action=refreshed fetched + parsed publish RefreshArticleContent">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_Stub" name="saveArticleGlobally stub title=hostname, excerpt='', wordCount=0">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_MarkC1" name="markCrawlPending">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_MarkS1" name="markSummaryPending">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PubSAL1" name="publishSaveAnonymousLink">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_MarkC2" name="markCrawlPending">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_MarkS2" name="markSummaryPending">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PubSAL2" name="publishSaveAnonymousLink NB: NOT publishRecrawlLinkInitiated recrawl is admin-only">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SAL" name="SaveAnonymousLinkCommand url">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Bus" name="EventBridge default-bus">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_QSAL" name="save-anonymous-link-command see tier-content-selector snapshot">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="n_RAC" name="RefreshArticleContentCommand updates metadata in place">
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_UFT" name="UpdateFetchTimestampCommand etag/lastModified bookkeeping">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_29</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_ReRead" name="findArticleByUrl re-read after any primer write">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:outgoing>f_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Reader" name="initArticleReader.resolveReaderState">
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:outgoing>f_33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_Renders" name="render ViewPage reader-slot + summary-slot + progress bar">
      <bpmn:incoming>f_33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_View" targetRef="n_Validate" />
    <bpmn:sequenceFlow id="f_1" name="invalid" sourceRef="n_Validate" targetRef="n_Bad" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Validate" targetRef="n_Fresh" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Fresh" targetRef="n_Decision" />
    <bpmn:sequenceFlow id="f_5" name="no row" sourceRef="n_Decision" targetRef="n_New" />
    <bpmn:sequenceFlow id="f_6" name="crawl failed/missing" sourceRef="n_Decision" targetRef="n_Reprime" />
    <bpmn:sequenceFlow id="f_7" name="&lt; staleTtlMs" sourceRef="n_Decision" targetRef="n_Skip" />
    <bpmn:sequenceFlow id="f_8" name="304" sourceRef="n_Decision" targetRef="n_Unchanged" />
    <bpmn:sequenceFlow id="f_9" name="200 + parse ok" sourceRef="n_Decision" targetRef="n_Refreshed" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_New" targetRef="n_Stub" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_Stub" targetRef="n_MarkC1" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_MarkC1" targetRef="n_MarkS1" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_MarkS1" targetRef="n_PubSAL1" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_Reprime" targetRef="n_MarkC2" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_MarkC2" targetRef="n_MarkS2" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_MarkS2" targetRef="n_PubSAL2" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_PubSAL1" targetRef="n_SAL" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_PubSAL2" targetRef="n_SAL" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_SAL" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_Bus" targetRef="n_QSAL" />
    <bpmn:sequenceFlow id="f_26" name="publishRefreshArticleContent" sourceRef="n_Refreshed" targetRef="n_RAC" />
    <bpmn:sequenceFlow id="f_27" name="publishUpdateFetchTimestamp" sourceRef="n_Unchanged" targetRef="n_UFT" />
    <bpmn:sequenceFlow id="f_28" name="" sourceRef="n_RAC" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_29" name="" sourceRef="n_UFT" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_30" name="" sourceRef="n_Decision" targetRef="n_ReRead" />
    <bpmn:sequenceFlow id="f_32" name="" sourceRef="n_ReRead" targetRef="n_Reader" />
    <bpmn:sequenceFlow id="f_33" name="" sourceRef="n_Reader" targetRef="n_Renders" />
    <bpmn:association id="f_3" sourceRef="n_Fresh" targetRef="n_Articles" associationDirection="Both" />
    <bpmn:association id="f_14" sourceRef="n_Stub" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_MarkC1" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_MarkS1" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_MarkC2" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_MarkS2" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_31" sourceRef="n_ReRead" targetRef="n_Articles" associationDirection="One" />
  </bpmn:process>
