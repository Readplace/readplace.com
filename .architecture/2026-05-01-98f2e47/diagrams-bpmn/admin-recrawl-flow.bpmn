<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_admin_recrawl_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_admin_recrawl_flow" name="admin-recrawl-flow" isExecutable="false">
    <bpmn:businessRuleTask id="n_Admin" name="GET /admin/recrawl/&lt;url&gt; requireAdmin middleware">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_Find" name="findArticleByUrl 404 if missing — explicit human intervention only">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Articles" name="DynamoDB articles"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_ForceCrawl" name="forceMarkCrawlPending flips even ready/failed rows back to pending">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ForceSum" name="forceMarkSummaryPending flips even ready/skipped rows back to pending">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_RLI" name="RecrawlLinkInitiatedEvent url source=hutch.api">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_Bus" name="EventBridge default-bus">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_QRLI" name="recrawl-link-initiated vis 60s, maxReceive 3">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_RLIWorker" name="recrawl-link-initiated Lambda shares saveLinkWork with Tier-1 path logPrefix RecrawlLinkInitiated">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Origin" name="Origin HTTP/2 fetch readability-parser + site pre-parsers">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3Tier1" name="S3 articles/&lt;id&gt;/sources/tier-1.html + tier-1.metadata.json"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_RCE" name="RecrawlContentExtractedEvent url source=hutch.save-link">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_QRCE" name="recrawl-content-extracted vis 90s, maxReceive 3">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_RCEWorker" name="recrawl-content-extracted Lambda list sources, run Deepseek if competition, promote, ALWAYS dispatch summary">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_QRCEWorker_in" name="see selector internals diagram">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_S3Tier0" name="S3 articles/&lt;id&gt;/sources/tier-0.html + sidecar; preserved across recrawls"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_S3Canon" name="S3 content/&lt;id&gt;/content.html canonical bytes"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_GSC" name="GenerateSummaryCommand direct SQS dispatch via initSqsCommandDispatcher">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_QGS" name="generate-summary shared with user-save chain">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="n_RComplete" name="RecrawlCompletedEvent url">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_GSWorker" name="generate-summary Lambda see 52017f3 snapshot for state machine">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:incoming>f_30</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Sum" name="DynamoDB summary attrs summary, excerpt, tokens"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_Note" name="summariser short-circuits on cache hit when status is ready/skipped forceMarkSummaryPending flips it back to pending so it regenerates">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Admin" targetRef="n_Find" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Find" targetRef="n_ForceCrawl" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Find" targetRef="n_ForceSum" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Find" targetRef="n_RLI" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_RLI" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_Bus" targetRef="n_QRLI" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_QRLI" targetRef="n_RLIWorker" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_RLIWorker" targetRef="n_Origin" />
    <bpmn:sequenceFlow id="f_14" name="publish" sourceRef="n_RLIWorker" targetRef="n_RCE" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_RCE" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_Bus" targetRef="n_QRCE" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_QRCE" targetRef="n_RCEWorker" />
    <bpmn:sequenceFlow id="f_18" name="same listing/contest logic" sourceRef="n_RCEWorker" targetRef="n_QRCEWorker_in" />
    <bpmn:sequenceFlow id="f_23" name="inline dispatch every time" sourceRef="n_RCEWorker" targetRef="n_GSC" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_GSC" targetRef="n_QGS" />
    <bpmn:sequenceFlow id="f_25" name="publish" sourceRef="n_RCEWorker" targetRef="n_RComplete" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_RComplete" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_QGS" targetRef="n_GSWorker" />
    <bpmn:sequenceFlow id="f_29" name="enables" sourceRef="n_ForceSum" targetRef="n_Note" />
    <bpmn:sequenceFlow id="f_30" name="unblocks" sourceRef="n_Note" targetRef="n_GSWorker" />
    <bpmn:association id="f_1" sourceRef="n_Find" targetRef="n_Articles" associationDirection="Both" />
    <bpmn:association id="f_4" sourceRef="n_ForceCrawl" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_ForceSum" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_RLIWorker" targetRef="n_S3Tier1" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_RLIWorker" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_RLIWorker" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_19" sourceRef="n_RCEWorker" targetRef="n_S3Tier0" associationDirection="Both" />
    <bpmn:association id="f_20" sourceRef="n_RCEWorker" targetRef="n_S3Tier1" associationDirection="Both" />
    <bpmn:association id="f_21" sourceRef="n_RCEWorker" targetRef="n_S3Canon" associationDirection="One" />
    <bpmn:association id="f_22" sourceRef="n_RCEWorker" targetRef="n_Articles" associationDirection="One" />
    <bpmn:association id="f_28" sourceRef="n_GSWorker" targetRef="n_Sum" associationDirection="One" />
  </bpmn:process>
