<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_reader_recovery" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_reader_recovery" name="reader-recovery" isExecutable="false">
    <bpmn:dataStoreReference id="n_R3" name="gmail-connections lastConfirmError set, forwardingConfirmedAt unset"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_ST" name="gmailConnectionState">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_RTF" name="ready-to-filter / filtering">
      <bpmn:incoming>f_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="n_CF" name="confirm-failed badge: Needs attention">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:businessRuleTask id="n_PG" name="/integrations/gmail Step 2 kept · alert for the reason address · Copy · Open Gmail">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="n_POLL" name="GET /integrations/gmail/status?state=confirm-failed watching for a new confirmation · every 3s, ≤100 ticks">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_U" name="Reader removes + re-adds the forwarding address in Gmail">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_G2" name="Google emails a fresh confirmation link">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_S3" name="inbox · receive → confirm worker">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_E1" name="GmailForwardingConfirmedEvent">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_S5" name="hutch · mark confirmed REMOVE lastConfirmError">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_DONE" name="state = ready-to-filter page: Forwarding confirmed.">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_1" name="confirmed later" sourceRef="n_ST" targetRef="n_RTF" />
    <bpmn:sequenceFlow id="f_2" name="unconfirmed + lastConfirmError" sourceRef="n_ST" targetRef="n_CF" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_CF" targetRef="n_PG" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_PG" targetRef="n_POLL" />
    <bpmn:sequenceFlow id="f_6" name="state missing or mismatched" sourceRef="n_POLL" targetRef="n_PG" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_PG" targetRef="n_U" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_U" targetRef="n_G2" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_G2" targetRef="n_S3" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_S3" targetRef="n_E1" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_E1" targetRef="n_S5" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_S5" targetRef="n_DONE" />
    <bpmn:association id="f_0" sourceRef="n_R3" targetRef="n_ST" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_reader_recovery">
    <bpmndi:BPMNPlane id="Plane_reader_recovery" bpmnElement="Process_reader_recovery">
      <bpmndi:BPMNShape id="n_R3_di" bpmnElement="n_R3">
