<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_accept_archive_save" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_accept_archive_save" name="accept-archive-save" isExecutable="false">
    <bpmn:sendTask id="n_WEB" name="POST /queue/save, extension or iOS action, bulk save, import commit, MCP save">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_ACC" name="Shared accept phase: save article from URL">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SUB" name="SubmitLinkCommand via submit-link Lambda">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_ID" name="Resolve save identity: archive snapshot URL keys on the original, capture becomes contentSourceUrl">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_FR" name="Freshness branch">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_NEWW" name="Write stub rows under the original">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_OLDW" name="Upsert per-user row under the original">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PIN1" name="Pin content source on the article row">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_PIN2" name="Pin content source on the article row on every branch">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_ART" name="Articles table: contentSourceUrl"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_PEND" name="Mark crawl and summary pending">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SLC" name="SaveLinkCommand url">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SLCC" name="Second SaveLinkCommand url plus captureUrl">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_LQ" name="LinkQueuedEvent and QueueEntryCreatedEvent, unchanged">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_COL" name="In-memory collector replaces the publish: tier-1 entry and capture entry">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_VIEW" name="GET /view/url first visit, anonymous">
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_VID" name="Resolve save identity">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_VST" name="Global stub, pin content source, mark crawl and summary pending">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SAL" name="SaveAnonymousLinkCommand url">
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SALC" name="Second SaveAnonymousLinkCommand url plus captureUrl">
      <bpmn:incoming>f_21</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_SCR" name="StaleCheckRequestedEvent">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_WEB" targetRef="n_ACC" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_SUB" targetRef="n_ACC" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_ACC" targetRef="n_ID" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_ID" targetRef="n_FR" />
    <bpmn:sequenceFlow id="f_4" name="new" sourceRef="n_FR" targetRef="n_NEWW" />
    <bpmn:sequenceFlow id="f_5" name="refreshed or skip" sourceRef="n_FR" targetRef="n_OLDW" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_NEWW" targetRef="n_PIN1" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_OLDW" targetRef="n_PIN2" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_NEWW" targetRef="n_PEND" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_PEND" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_PEND" targetRef="n_SLCC" />
    <bpmn:sequenceFlow id="f_13" name="refreshed with content" sourceRef="n_OLDW" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_PIN2" targetRef="n_SLCC" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_ACC" targetRef="n_LQ" />
    <bpmn:sequenceFlow id="f_16" name="in process" sourceRef="n_SUB" targetRef="n_COL" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_VIEW" targetRef="n_VID" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_VID" targetRef="n_VST" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_VST" targetRef="n_SAL" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_VST" targetRef="n_SALC" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_VIEW" targetRef="n_SCR" />
    <bpmn:association id="f_8" sourceRef="n_PIN1" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_PIN2" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_19" sourceRef="n_VST" targetRef="n_ART" associationDirection="One" />
  </bpmn:process>
