<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_three_tier_selection" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_three_tier_selection" name="three-tier-selection" isExecutable="false">
    <bpmn:startEvent id="n_TCE" name="TierContentExtractedEvent tier-0, tier-1 or tier-2">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_R" name="EventBridge rule TierContentExtracted">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="select-most-complete-content SQS">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_SEL" name="select-most-complete-content Lambda">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_LIST" name="List tier sources: tier-0, tier-1, tier-2">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3" name="Content bucket: per-tier sources"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_RETRY" name="Throw, SQS redelivers">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_WIN" name="Winner">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_DS" name="DeepSeek selector">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_TIE" name="Resolve tie">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_KEEP" name="Keep canonical, CrawlArticleCompletedEvent">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_ORD" name="Fallback order tier-1, tier-0, tier-2">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_PROM" name="Write canonical, promote tier; contentSourceTier may be tier-2">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ART" name="Articles table: contentSourceTier"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_CCC" name="CanonicalContentChangedEvent">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_CAC" name="CrawlArticleCompletedEvent">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_LS" name="LinkSavedEvent or AnonymousLinkSavedEvent when canonical changed">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_SUM" name="Summary regeneration chain, then ReaderViewLoadingSucceeded with contentSourceTier widened to tier-2">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_DLQ" name="save-link-failures shared DLQ">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_TCE" targetRef="n_R" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_R" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Q" targetRef="n_SEL" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SEL" targetRef="n_LIST" />
    <bpmn:sequenceFlow id="f_5" name="none" sourceRef="n_LIST" targetRef="n_RETRY" />
    <bpmn:sequenceFlow id="f_6" name="one" sourceRef="n_LIST" targetRef="n_WIN" />
    <bpmn:sequenceFlow id="f_7" name="two or more" sourceRef="n_LIST" targetRef="n_DS" />
    <bpmn:sequenceFlow id="f_8" name="winner" sourceRef="n_DS" targetRef="n_WIN" />
    <bpmn:sequenceFlow id="f_9" name="tie" sourceRef="n_DS" targetRef="n_TIE" />
    <bpmn:sequenceFlow id="f_10" name="fresh tier is not tier-2 and tier-0 vs tier-1 differ in media" sourceRef="n_TIE" targetRef="n_WIN" />
    <bpmn:sequenceFlow id="f_11" name="healthy canonical" sourceRef="n_TIE" targetRef="n_KEEP" />
    <bpmn:sequenceFlow id="f_12" name="no healthy canonical" sourceRef="n_TIE" targetRef="n_ORD" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_ORD" targetRef="n_WIN" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_WIN" targetRef="n_PROM" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_PROM" targetRef="n_CCC" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_PROM" targetRef="n_CAC" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_PROM" targetRef="n_LS" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_CCC" targetRef="n_SUM" />
    <bpmn:sequenceFlow id="f_20" name="receives exhausted" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:association id="f_4" sourceRef="n_LIST" targetRef="n_S3" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_PROM" targetRef="n_ART" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_three_tier_selection">
