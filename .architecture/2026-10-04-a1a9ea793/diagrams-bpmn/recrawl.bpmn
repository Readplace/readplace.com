<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_recrawl" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_recrawl" name="recrawl" isExecutable="false">
    <bpmn:sendTask id="n_ADM" name="Admin recrawl POST: force crawl pending">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="n_RLI" name="RecrawlLinkInitiatedEvent">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="n_RMC" name="RemoveMyContentCommand: no sources left, savers remain">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_R" name="EventBridge rule RecrawlLinkInitiated">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="recrawl-link-initiated SQS, maxReceiveCount 1">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_H" name="recrawl-link-initiated Lambda">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_FIND" name="Find recorded content source">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ART" name="Articles table: contentSourceUrl"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_CAP" name="Crawl archive capture into tier-2">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_ACF" name="ArchiveCaptureCrawlFailedEvent">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_S3" name="Content bucket: tier-2 source"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_T1" name="Tier-1 recrawl of the live original, with dead-origin fallback">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_COMP" name="Comprehensive Lambda publishes its own RecrawlContentExtractedEvent">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_GATE" name="Tier-1 written or tier-2 written">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="n_RCE" name="RecrawlContentExtractedEvent">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_ACK" name="Ack, no event">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_RS" name="recrawl-content-extracted Lambda: three tiers, same tie resolution">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_CCC" name="CanonicalContentChangedEvent">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_RC" name="RecrawlCompletedEvent">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_DLQ" name="save-link-failures shared DLQ">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_EXH" name="Recrawl route: mark crawl exhausted, unchanged">
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_ADM" targetRef="n_RLI" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_RMC" targetRef="n_RLI" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_RLI" targetRef="n_R" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_R" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Q" targetRef="n_H" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_H" targetRef="n_FIND" />
    <bpmn:sequenceFlow id="f_7" name="capture recorded" sourceRef="n_FIND" targetRef="n_CAP" />
    <bpmn:sequenceFlow id="f_8" name="not fetched" sourceRef="n_CAP" targetRef="n_ACF" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_FIND" targetRef="n_T1" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_CAP" targetRef="n_T1" />
    <bpmn:sequenceFlow id="f_12" name="deferred" sourceRef="n_T1" targetRef="n_COMP" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_T1" targetRef="n_GATE" />
    <bpmn:sequenceFlow id="f_14" name="either" sourceRef="n_GATE" targetRef="n_RCE" />
    <bpmn:sequenceFlow id="f_15" name="neither" sourceRef="n_GATE" targetRef="n_ACK" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_RCE" targetRef="n_RS" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_RS" targetRef="n_CCC" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_RS" targetRef="n_RC" />
    <bpmn:sequenceFlow id="f_19" name="throws" sourceRef="n_H" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_DLQ" targetRef="n_EXH" />
    <bpmn:association id="f_6" sourceRef="n_FIND" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_CAP" targetRef="n_S3" associationDirection="One" />
  </bpmn:process>
