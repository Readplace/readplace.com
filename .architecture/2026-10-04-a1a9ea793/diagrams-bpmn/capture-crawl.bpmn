<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_capture_crawl" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_capture_crawl" name="capture-crawl" isExecutable="false">
    <bpmn:sendTask id="n_SLCC" name="SaveLinkCommand with captureUrl">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_R1" name="EventBridge rule SaveLinkCommand">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q1" name="save-link-command SQS, maxReceiveCount 1">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_H1" name="save-link-command Lambda: captureUrl present, skip tier-1 work">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SALC" name="SaveAnonymousLinkCommand with captureUrl">
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_R2" name="EventBridge rule SaveAnonymousLinkCommand">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q2" name="save-anonymous-link-command SQS, maxReceiveCount 1">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_H2" name="save-anonymous-link-command Lambda: captureUrl present, skip tier-1 work">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_COL" name="submit-link Lambda: collected capture entry, in process">
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CAP" name="Crawl archive capture: fetch the capture, finalize under the original">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ARCH" name="Wayback Machine or archive.today">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SNAP" name="Read tier snapshot, log crawl outcome thisTier tier-2">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ART" name="Articles table: crawl status, canonical tier"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_PUT" name="Put tier-2 source">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3" name="Content bucket: articles/id/sources/tier-2.html plus metadata sidecar with sourceUrl"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_TCE" name="TierContentExtractedEvent tier tier-2">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_ACF" name="ArchiveCaptureCrawlFailedEvent url, captureUrl, reason">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_NOSUB" name="No subscriber; crawl state untouched">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_DLQ" name="save-link-failures shared DLQ">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_RT" name="save-link-failures-dlq router">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_SKIP" name="SaveLink and SaveAnonymousLink routes: captureUrl present, log and skip, never mark exhausted">
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_EXH" name="Plain command: mark crawl exhausted, unchanged">
      <bpmn:incoming>f_21</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_RETRY" name="Whole submit record fails, SQS redelivers up to 3 receives">
      <bpmn:incoming>f_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_SEL" name="select-most-complete-content, section 4">
      <bpmn:incoming>f_23</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SLCC" targetRef="n_R1" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_R1" targetRef="n_Q1" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Q1" targetRef="n_H1" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SALC" targetRef="n_R2" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_R2" targetRef="n_Q2" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Q2" targetRef="n_H2" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_COL" targetRef="n_CAP" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_H1" targetRef="n_CAP" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_H2" targetRef="n_CAP" />
    <bpmn:sequenceFlow id="f_9" name="fetch" sourceRef="n_CAP" targetRef="n_ARCH" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_CAP" targetRef="n_SNAP" />
    <bpmn:sequenceFlow id="f_12" name="fetched" sourceRef="n_CAP" targetRef="n_PUT" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_PUT" targetRef="n_TCE" />
    <bpmn:sequenceFlow id="f_15" name="not fetched" sourceRef="n_CAP" targetRef="n_ACF" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_ACF" targetRef="n_NOSUB" />
    <bpmn:sequenceFlow id="f_17" name="throws" sourceRef="n_H1" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_18" name="throws" sourceRef="n_H2" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_DLQ" targetRef="n_RT" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_RT" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_RT" targetRef="n_EXH" />
    <bpmn:sequenceFlow id="f_22" name="capture crawl throws" sourceRef="n_COL" targetRef="n_RETRY" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_TCE" targetRef="n_SEL" />
    <bpmn:association id="f_11" sourceRef="n_SNAP" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_PUT" targetRef="n_S3" associationDirection="One" />
  </bpmn:process>
