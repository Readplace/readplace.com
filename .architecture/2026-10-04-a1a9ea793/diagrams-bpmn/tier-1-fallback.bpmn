<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_tier_1_fallback" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_tier_1_fallback" name="tier-1-fallback" isExecutable="false">
    <bpmn:sendTask id="n_SLC" name="SaveLinkCommand, SaveAnonymousLinkCommand, collected tier-1 entry, or recrawl">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_W" name="Save-link work: crawl and finalize under the original">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_FB" name="Capture-fallback decorator, in the four save and recrawl Lambdas">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PC" name="Pinned-crawl decorator: adopted redirect terminal only, no longer the capture">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CR" name="Crawl the live original">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_RES" name="Live result">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_PASS" name="Return live result">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_LOOK" name="Find recorded content source">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ART" name="Articles table: contentSourceUrl"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_CC" name="Crawl the capture instead">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_OUT" name="Save-link work outcome">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_T1" name="Put tier-1 source">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3" name="Content bucket: articles/id/sources/tier-1.html"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_TCE1" name="TierContentExtractedEvent tier tier-1">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_SCU" name="SimpleCrawlUnsupportedEvent, comprehensive chain">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_TERM" name="Crawl exhausted, CrawlArticleFailed">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SLC" targetRef="n_W" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_W" targetRef="n_FB" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_FB" targetRef="n_PC" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_PC" targetRef="n_CR" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_CR" targetRef="n_RES" />
    <bpmn:sequenceFlow id="f_5" name="fetched, not-modified, unsupported" sourceRef="n_RES" targetRef="n_PASS" />
    <bpmn:sequenceFlow id="f_6" name="failed, not-found, blocked" sourceRef="n_RES" targetRef="n_LOOK" />
    <bpmn:sequenceFlow id="f_8" name="none" sourceRef="n_LOOK" targetRef="n_PASS" />
    <bpmn:sequenceFlow id="f_9" name="capture recorded" sourceRef="n_LOOK" targetRef="n_CC" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_CC" targetRef="n_PASS" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_PASS" targetRef="n_OUT" />
    <bpmn:sequenceFlow id="f_12" name="written" sourceRef="n_OUT" targetRef="n_T1" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_T1" targetRef="n_TCE1" />
    <bpmn:sequenceFlow id="f_15" name="non-HTML" sourceRef="n_OUT" targetRef="n_SCU" />
    <bpmn:sequenceFlow id="f_16" name="terminal" sourceRef="n_OUT" targetRef="n_TERM" />
    <bpmn:association id="f_7" sourceRef="n_LOOK" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_T1" targetRef="n_S3" associationDirection="One" />
  </bpmn:process>
