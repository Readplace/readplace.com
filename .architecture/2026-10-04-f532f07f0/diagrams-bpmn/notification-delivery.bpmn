<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_notification_delivery" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_notification_delivery" name="notification-delivery" isExecutable="false">
    <bpmn:sendTask id="n_C" name="Send Gmail newsletter notice Command">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="Gmail newsletter notice SQS">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_RULE" name="EventBridge notice rule and queue policy">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_W" name="Notice Lambda: recheck account, mailbox, unmapped sender and approval">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CON" name="Connections, sender mappings, account email"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_CAT" name="Newsletter catalog"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_MON" name="User/sender pending notice and permanent receipt"></bpmn:dataStoreReference>
    <bpmn:task id="n_SUP" name="Finish with suppressed or existing sent outcome">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_CLAIM" name="Atomic claim; persist stable payload and first attempt time">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:businessRuleTask id="n_RETRY" name="Retry queue record">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="n_SEND" name="Resend adapter: same payload and idempotency key">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_RECEIPT" name="Persist permanent sent receipt">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_EVT" name="Gmail newsletter notice processed Event: sent or suppressed">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_STOP" name="Fail without another provider send">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_DLQ" name="Notice DLQ and operator alarm; delivery evidence requires review">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_BUS" name="EventBridge: no downstream subscriber">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="direct SQS from monitoring" sourceRef="n_C" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="also subscribed" sourceRef="n_C" targetRef="n_RULE" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_RULE" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Q" targetRef="n_W" />
    <bpmn:sequenceFlow id="f_7" name="ineligible or sent receipt" sourceRef="n_W" targetRef="n_SUP" />
    <bpmn:sequenceFlow id="f_8" name="eligible" sourceRef="n_W" targetRef="n_CLAIM" />
    <bpmn:sequenceFlow id="f_10" name="claim held elsewhere" sourceRef="n_CLAIM" targetRef="n_RETRY" />
    <bpmn:sequenceFlow id="f_11" name="within 23h55m cutoff" sourceRef="n_CLAIM" targetRef="n_SEND" />
    <bpmn:sequenceFlow id="f_12" name="successful response" sourceRef="n_SEND" targetRef="n_RECEIPT" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_RECEIPT" targetRef="n_EVT" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_SUP" targetRef="n_EVT" />
    <bpmn:sequenceFlow id="f_16" name="ambiguous response" sourceRef="n_SEND" targetRef="n_RETRY" />
    <bpmn:sequenceFlow id="f_17" name="catalog or provider unavailable" sourceRef="n_W" targetRef="n_RETRY" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_RETRY" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_19" name="ambiguous attempt past cutoff" sourceRef="n_CLAIM" targetRef="n_STOP" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_STOP" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_21" name="receives exhausted" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_EVT" targetRef="n_BUS" />
    <bpmn:association id="f_4" sourceRef="n_CON" targetRef="n_W" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_CAT" targetRef="n_W" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_MON" targetRef="n_W" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_CLAIM" targetRef="n_MON" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_RECEIPT" targetRef="n_MON" associationDirection="One" />
  </bpmn:process>
