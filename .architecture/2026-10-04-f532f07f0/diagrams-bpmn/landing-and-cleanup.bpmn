<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_landing_and_cleanup" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_landing_and_cleanup" name="landing-and-cleanup" isExecutable="false">
    <bpmn:serviceTask id="n_EMAIL" name="Choose a readlist email CTA: sender selected and arrival hint">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_AUTH" name="requireAuth: login return destination preserved">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_PAGE" name="Gmail page: merge current-mailbox observed and discovered candidates">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_MON" name="Monitoring observations for current mailbox"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_DISC" name="Gmail discovery and saved sender mappings"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_PICK" name="Existing mapping: current readlist; only All: preselected; otherwise choose">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_HINT" name="Brand border on selector and Save; dismiss on first click, retain through htmx">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_POST" name="Existing mapping POST: authenticate, enforce mailbox ownership, validate readlist">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_MAP" name="Get or create owned readlist address and save sender mapping">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_FC" name="Rewrite Gmail filter Command">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_FQ" name="rewrite-gmail-filter SQS">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_FW" name="Existing filter Lambda: reconcile Gmail rules">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_FE" name="Gmail filter rewritten or rewrite failed Event">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_FD" name="Existing filter DLQ and alarm">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sendTask id="n_IC" name="Start Gmail history import Command">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_IMP" name="Existing paginated import, ingest and outcomes chain">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_IE" name="Gmail history import completed or failed Event">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_RESP" name="303 mapping saved, filter and optional import status">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_DEL" name="Delete account Command">
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_UQ" name="Existing user-data-jobs SQS">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_U" name="Existing account erasure worker">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_ERASE" name="Query and delete all monitoring rows for user">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_DE" name="Continue existing erasure; close account; log completion">
      <bpmn:incoming>f_22</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_UD" name="Existing user-data-jobs DLQ and alarm">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_EMAIL" targetRef="n_AUTH" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_AUTH" targetRef="n_PAGE" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_PAGE" targetRef="n_PICK" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_PICK" targetRef="n_HINT" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_PICK" targetRef="n_POST" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_POST" targetRef="n_MAP" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_MAP" targetRef="n_FC" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_FC" targetRef="n_FQ" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_FQ" targetRef="n_FW" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_FW" targetRef="n_FE" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_FQ" targetRef="n_FD" />
    <bpmn:sequenceFlow id="f_14" name="explicit import option" sourceRef="n_POST" targetRef="n_IC" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_IC" targetRef="n_IMP" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_IMP" targetRef="n_IE" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_POST" targetRef="n_RESP" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_DEL" targetRef="n_UQ" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_UQ" targetRef="n_U" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_U" targetRef="n_ERASE" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_ERASE" targetRef="n_DE" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_UQ" targetRef="n_UD" />
    <bpmn:association id="f_2" sourceRef="n_MON" targetRef="n_PAGE" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_DISC" targetRef="n_PAGE" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_MAP" targetRef="n_DISC" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_ERASE" targetRef="n_MON" associationDirection="One" />
  </bpmn:process>
