<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_prepare_transcription" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_prepare_transcription" name="prepare-transcription" isExecutable="false">
    <bpmn:startEvent id="n_C" name="MediaUploadCommittedEvent, kind audio">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_K" name="Media-audio keep-audio">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_Q" name="[&quot;media-audio-prepare-transcription-q">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_P" name="Prepare transcription (ffprobe, ffmpeg)">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_A" name="Acknowledge and log">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_T" name="Amazon Transcribe job rp-uploadId-attempt">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_R" name="Refund the unstarted charge">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_B" name="TierContentExtracted, short audio body">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_D" name="[&quot;media-audio-failures DLQ">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_DR" name="Prepare-transcription dead-letter route">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_C" targetRef="n_K" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_C" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Q" targetRef="n_P" />
    <bpmn:sequenceFlow id="f_3" name="not charged" sourceRef="n_P" targetRef="n_A" />
    <bpmn:sequenceFlow id="f_4" name="charged" sourceRef="n_P" targetRef="n_T" />
    <bpmn:sequenceFlow id="f_5" name="bytes gone or item released" sourceRef="n_P" targetRef="n_R" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_R" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_7" name="uncharged" sourceRef="n_K" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_8" name="after 3 receives" sourceRef="n_Q" targetRef="n_D" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_D" targetRef="n_DR" />
    <bpmn:sequenceFlow id="f_10" name="no job" sourceRef="n_DR" targetRef="n_R" />
  </bpmn:process>
