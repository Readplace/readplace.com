<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_mark_backfill" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_mark_backfill" name="mark-backfill" isExecutable="false">
    <bpmn:task id="n_APPLY" name="Apply to earlier emails or Try again option on, gmail.modify granted">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_ROUTE" name="POST mark-read/backfill">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="n_JOB" name="startBackfill MARK_BACKFILL#account#sender new generation, queued">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="n_SCMD" name="StartGmailMarkBackfillCommand">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_BQ" name="[gmail-mark-backfill queue">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_PROG" name="GmailMarkBackfillPageProcessedEvent nextPage">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_BL" name="gmail-mark-backfill Lambda">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_PCMD" name="ProcessGmailMarkBackfillPageCommand SQS, 10 s delay">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_SDLQ" name="[gmail-history-import-failures shared DLQ">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_GUARD" name="Generation and page current, connection, mapping and on-period unchanged?">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_ACK" name="Acknowledge and log">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CANCEL" name="cancel job: disconnected, mapping-removed or option-off"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_CLAIM" name="claimPage: 60 s lease"></bpmn:dataStoreReference>
    <bpmn:task id="n_OPEN" name="Open mailbox, resolve imported-to-readplace label"></bpmn:task>
    <bpmn:dataStoreReference id="n_FAILJ" name="fail job: permission-revoked or gmail-rejected"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_ROWS" name="listCompletionsBefore cursor inbox emails, newest first"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_CLASS" name="Classify row">
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_LEAVE" name="Left alone, not counted">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_COUNTS" name="Counts: notSaved, unlocatable, marked, alreadyMarked, notFound, failed">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_MARKO" name="recordPending, locate, label and mark read">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_BUDGET" name="Rows run out?">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_NEXT" name="Publish the next page first, then savePage: cursor + counts">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_DONE" name="complete job with counts"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_APPLY" targetRef="n_ROUTE" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_ROUTE" targetRef="n_JOB" />
    <bpmn:sequenceFlow id="f_2" name="started" sourceRef="n_JOB" targetRef="n_SCMD" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SCMD" targetRef="n_BQ" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_PROG" targetRef="n_BQ" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_BQ" targetRef="n_BL" />
    <bpmn:sequenceFlow id="f_6" name="start or progress" sourceRef="n_BL" targetRef="n_PCMD" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_PCMD" targetRef="n_BQ" />
    <bpmn:sequenceFlow id="f_8" name="exhausted" sourceRef="n_BQ" targetRef="n_SDLQ" />
    <bpmn:sequenceFlow id="f_9" name="page" sourceRef="n_BL" targetRef="n_GUARD" />
    <bpmn:sequenceFlow id="f_10" name="stale" sourceRef="n_GUARD" targetRef="n_ACK" />
    <bpmn:sequenceFlow id="f_17" name="other sender, or no save evidence" sourceRef="n_CLASS" targetRef="n_LEAVE" />
    <bpmn:sequenceFlow id="f_18" name="not saved or unlocatable" sourceRef="n_CLASS" targetRef="n_COUNTS" />
    <bpmn:sequenceFlow id="f_19" name="eligible, option unchanged" sourceRef="n_CLASS" targetRef="n_MARKO" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_MARKO" targetRef="n_COUNTS" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_COUNTS" targetRef="n_BUDGET" />
    <bpmn:sequenceFlow id="f_22" name="no, budget reached" sourceRef="n_BUDGET" targetRef="n_NEXT" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_NEXT" targetRef="n_PROG" />
    <bpmn:association id="f_11" sourceRef="n_GUARD" targetRef="n_CANCEL" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_GUARD" targetRef="n_CLAIM" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_CLAIM" targetRef="n_OPEN" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_OPEN" targetRef="n_FAILJ" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_OPEN" targetRef="n_ROWS" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_ROWS" targetRef="n_CLASS" associationDirection="One" />
    <bpmn:association id="f_24" sourceRef="n_BUDGET" targetRef="n_DONE" associationDirection="One" />
  </bpmn:process>
