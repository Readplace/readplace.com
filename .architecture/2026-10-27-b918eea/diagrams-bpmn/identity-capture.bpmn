<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_identity_capture" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_identity_capture" name="identity-capture" isExecutable="false">
    <bpmn:startEvent id="n_SES" name="SES receipt notification">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="n_RQ" name="[inbox-receive-email queue">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_RX" name="receive-email Lambda">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="n_FETCHED" name="GmailHistoryImportMessageFetched">
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="n_IQ" name="[inbox-ingest-gmail-import queue">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_IG" name="ingest-gmail-import Lambda">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CONN" name="Gmail connections account captured at receipt"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_ID" name="Email identity claim">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_ROW" name="Inbox email row + gmailOrigins set"></bpmn:dataStoreReference>
    <bpmn:task id="n_DUP" name="Record duplicate Gmail origin ADD to canonical row">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_EVAL" name="Evaluate completion inline">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_MARK" name="MarkGmailEmailImported">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="n_RECEIVED" name="EmailReceived">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SES" targetRef="n_RQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_RQ" targetRef="n_RX" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_FETCHED" targetRef="n_IQ" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_IQ" targetRef="n_IG" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_RX" targetRef="n_ID" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_IG" targetRef="n_ID" />
    <bpmn:sequenceFlow id="f_8" name="already ingested, canonical row id" sourceRef="n_ID" targetRef="n_DUP" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_DUP" targetRef="n_EVAL" />
    <bpmn:sequenceFlow id="f_10" name="canonical already in All" sourceRef="n_EVAL" targetRef="n_MARK" />
    <bpmn:association id="f_4" sourceRef="n_RX" targetRef="n_CONN" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_ID" targetRef="n_ROW" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_ROW" targetRef="n_RECEIVED" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_RX" targetRef="n_ROW" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_IG" targetRef="n_ROW" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_identity_capture">
