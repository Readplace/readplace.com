  <bpmn:process id="Process_gmail_worker" name="gmail-worker" isExecutable="false">
    <bpmn:task id="n_MARK" name="MarkGmailEmailImported">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_GQ" name="[gmail-message-updates queue">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_GRANT" name="GmailModifyPermissionGranted">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_GW" name="gmail-message-updates Lambda">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:outgoing>f_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_SDLQ" name="[gmail-history-import-failures shared DLQ">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_DLQH" name="gmail-history-import-dlq router">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_FAILREC" name="record failed: dead-lettered">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_FAILED" name="GmailEmailUpdateFailed">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="n_GATE" name="Mapping for account and sender has markImportedAt?">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_DISCARD" name="delete the update record only while pending"></bpmn:dataStoreReference>
    <bpmn:task id="n_SKIPPED" name="skipped: info log, no event, no metric"></bpmn:task>
    <bpmn:dataStoreReference id="n_PEND" name="GMAIL_UPDATE#account#origin record pending"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_STATUS" name="Record status">
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="n_MARKED" name="GmailEmailMarkedImported already-marked">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_ALREADYFAILED" name="already-failed: info log, no event, no metric">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:task>
    <bpmn:businessRuleTask id="n_ACCT" name="Connected account is the captured one, not revoked or disconnecting?">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_DEFER" name="GmailEmailUpdateDeferred account-unavailable">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_OPEN" name="Open mailbox: one credential snapshot, gmail.modify scope, verified profile">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_DEFERP" name="GmailEmailUpdateDeferred permission-required">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_RETRY" name="Throw: SQS retry">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_FIND" name="Locate original">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_LABEL" name="Find or create label imported-to-readplace">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_FAILREC2" name="record failed"></bpmn:dataStoreReference>
    <bpmn:task id="n_MOD" name="messages.modify +label, -UNREAD">
      <bpmn:incoming>f_24</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_COMPLETE" name="record completed"></bpmn:dataStoreReference>
    <bpmn:task id="n_MARKED2" name="GmailEmailMarkedImported marked"></bpmn:task>
    <bpmn:endEvent id="n_METRIC" name="GmailEmailUpdateFailed metric alarm emails operator">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_WARN" name="Warning log, no metric">
      <bpmn:incoming>f_28</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_RESUME" name="List pending records of the account consistent, paginated key query">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:serviceTask>
