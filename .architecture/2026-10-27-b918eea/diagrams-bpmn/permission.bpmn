<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_permission" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_permission" name="permission" isExecutable="false">
    <bpmn:serviceTask id="n_CONNECT" name="Connect Gmail settings + metadata scopes">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_GOOGLE" name="Google consent include_granted_scopes on import and mark">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_IMPORT" name="Import permission gmail.readonly">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_TICK" name="Card or dialog box ticked without gmail.modify">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_BEGIN" name="POST mark-read/start or senders/add mark intent carries the senders">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_ROW" name="permission-lost card option on, no gmail.modify">
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_ALLOW" name="Allow in Gmail POST connect, intent=mark, sender">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_CB" name="OAuth callback">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_REFUSED" name="notice: mark_permission_refused nothing stored, option unchanged: a box ticked without it stays unticked">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CRED" name="Store credentials refresh token + granted scope"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_HAS" name="gmail.modify granted?">
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="n_GRANT" name="GmailModifyPermissionGranted">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_RESUME" name="Gmail worker resumes pending updates for the account">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_TURNON" name="setMarkImported on the intent's mapped senders"></bpmn:dataStoreReference>
    <bpmn:task id="n_AWAIT" name="Resume imports awaiting permission">
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_GRANTED" name="notice: mark_permission_granted">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_CONNECT" targetRef="n_GOOGLE" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_IMPORT" targetRef="n_GOOGLE" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_TICK" targetRef="n_BEGIN" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_ROW" targetRef="n_ALLOW" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_BEGIN" targetRef="n_GOOGLE" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_ALLOW" targetRef="n_GOOGLE" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_GOOGLE" targetRef="n_CB" />
    <bpmn:sequenceFlow id="f_7" name="provider error, mark intent" sourceRef="n_GOOGLE" targetRef="n_REFUSED" />
    <bpmn:sequenceFlow id="f_10" name="yes, any intent" sourceRef="n_HAS" targetRef="n_GRANT" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_GRANT" targetRef="n_RESUME" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_AWAIT" targetRef="n_GRANTED" />
    <bpmn:sequenceFlow id="f_15" name="no, mark intent" sourceRef="n_HAS" targetRef="n_REFUSED" />
    <bpmn:association id="f_8" sourceRef="n_CB" targetRef="n_CRED" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_CRED" targetRef="n_HAS" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_HAS" targetRef="n_TURNON" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_TURNON" targetRef="n_AWAIT" associationDirection="One" />
  </bpmn:process>
