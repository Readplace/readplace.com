<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_permission" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_permission" name="permission" isExecutable="false">
    <bpmn:task id="n_PAGE" name="Gmail newsletters page connected, no gmail.modify">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_PROMPT" name="Allow labelling POST connect, intent=label">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_GOOGLE" name="Google consent scope gmail.modify, include_granted_scopes">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CONNECT" name="Connect / import permission">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CB" name="OAuth callback">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CRED" name="Store credentials refresh token + granted scope"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_HAS" name="gmail.modify granted?">
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="n_GRANT" name="GmailModifyPermissionGranted">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_REFUSED" name="notice: label_permission_refused">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_RESUME" name="Gmail worker resumes pending updates for the account">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_NOTICE" name="notice: label_permission_granted">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_PAGE" targetRef="n_PROMPT" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_PROMPT" targetRef="n_GOOGLE" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_CONNECT" targetRef="n_GOOGLE" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_GOOGLE" targetRef="n_CB" />
    <bpmn:sequenceFlow id="f_6" name="yes" sourceRef="n_HAS" targetRef="n_GRANT" />
    <bpmn:sequenceFlow id="f_7" name="no, label intent" sourceRef="n_HAS" targetRef="n_REFUSED" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_GRANT" targetRef="n_RESUME" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_CB" targetRef="n_NOTICE" />
    <bpmn:association id="f_4" sourceRef="n_CB" targetRef="n_CRED" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_CRED" targetRef="n_HAS" associationDirection="One" />
  </bpmn:process>
