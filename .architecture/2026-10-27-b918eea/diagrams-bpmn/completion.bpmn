<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_completion" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_completion" name="completion" isExecutable="false">
    <bpmn:sendTask id="n_SLC" name="SubmitLinkCommand">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_SL" name="submit-link Lambda">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ALL" name="All readlist row"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_SEI" name="SaveEmailIssueCommand">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_SE" name="save-email-issue Lambda">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ACK" name="EmailOutputSavedToAll">
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_FILE" name="File into custom readlist, crawl / enrich">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_CQ" name="[inbox-gmail-import-completion queue">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_SELECTED" name="EmailOutputsSelected">
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CL" name="gmail-import-completion Lambda">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_CDLQ" name="[own DLQ + alarm">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_ADD" name="ADD savedOutputs"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_READ" name="Consistent read: selection, savedOutputs, gmailOrigins"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_DONE" name="Selection present, not truncated, every output acknowledged, at least one Gmail origin?">
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_WAIT" name="Wait for the next fact">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_MARK" name="MarkGmailEmailImported">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SLC" targetRef="n_SL" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_SEI" targetRef="n_SE" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_SL" targetRef="n_FILE" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_SE" targetRef="n_FILE" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_ACK" targetRef="n_CQ" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_SELECTED" targetRef="n_CQ" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_CQ" targetRef="n_CL" />
    <bpmn:sequenceFlow id="f_10" name="exhausted" sourceRef="n_CQ" targetRef="n_CDLQ" />
    <bpmn:sequenceFlow id="f_14" name="no" sourceRef="n_DONE" targetRef="n_WAIT" />
    <bpmn:sequenceFlow id="f_15" name="yes, one per origin" sourceRef="n_DONE" targetRef="n_MARK" />
    <bpmn:association id="f_1" sourceRef="n_SL" targetRef="n_ALL" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_SE" targetRef="n_ALL" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_ALL" targetRef="n_ACK" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_CL" targetRef="n_ADD" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_CL" targetRef="n_READ" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_READ" targetRef="n_DONE" associationDirection="One" />
  </bpmn:process>
