<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_mark_option" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_mark_option" name="mark-option" isExecutable="false">
    <bpmn:task id="n_DIALOG" name="New-mapping dialog checkbox ticked by default once gmail.modify is granted">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_ADD" name="POST senders/add, mark=1 new mappings only">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_CARD" name="Mapping card checkbox ticked readlist destination">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_START" name="POST mark-read/start option=on">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:businessRuleTask id="n_HAS" name="gmail.modify granted?">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_SET" name="setMarkImported markImportedAt if_not_exists now"></bpmn:dataStoreReference>
    <bpmn:task id="n_ON" name="notice: mark_on box ticked, backfill offered"></bpmn:task>
    <bpmn:serviceTask id="n_REVOKED" name="error: mark_revoked nothing stored">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_CONSENT" name="Google consent for gmail.modify signed state carries the senders">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_CB" name="OAuth callback, mark intent">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_SETCB" name="setMarkImported on the intent's mapped senders"></bpmn:dataStoreReference>
    <bpmn:task id="n_GRANTED" name="notice: mark_permission_granted box ticked"></bpmn:task>
    <bpmn:serviceTask id="n_REFUSED" name="notice: mark_permission_refused nothing stored, box unticked">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_STOPB" name="Mapping card checkbox unticked">
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_STOP" name="POST mark-read/stop">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_CLEAR" name="clearMarkImported REMOVE markImportedAt"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_REMOVE" name="POST senders/remove">
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_TEAR" name="Delete the sender's pending GMAIL_UPDATE records">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CANCEL" name="cancelBackfill option-off or mapping-removed"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_DIALOG" targetRef="n_ADD" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_CARD" targetRef="n_START" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_ADD" targetRef="n_HAS" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_START" targetRef="n_HAS" />
    <bpmn:sequenceFlow id="f_6" name="no, connection revoked" sourceRef="n_HAS" targetRef="n_REVOKED" />
    <bpmn:sequenceFlow id="f_7" name="no" sourceRef="n_HAS" targetRef="n_CONSENT" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_CONSENT" targetRef="n_CB" />
    <bpmn:sequenceFlow id="f_11" name="refused" sourceRef="n_CB" targetRef="n_REFUSED" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_STOPB" targetRef="n_STOP" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_REMOVE" targetRef="n_TEAR" />
    <bpmn:association id="f_4" sourceRef="n_HAS" targetRef="n_SET" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_SET" targetRef="n_ON" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_CB" targetRef="n_SETCB" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_SETCB" targetRef="n_GRANTED" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_STOP" targetRef="n_CLEAR" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_CLEAR" targetRef="n_TEAR" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_TEAR" targetRef="n_CANCEL" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_mark_option">
