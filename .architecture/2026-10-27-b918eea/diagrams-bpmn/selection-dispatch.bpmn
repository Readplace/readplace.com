      <bpmndi:BPMNShape id="n_SELECT_di" bpmnElement="n_SELECT">
        <dc:Bounds x="233.77" y="775.09" width="174.46" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_DISPATCH_di" bpmnElement="n_DISPATCH">
        <dc:Bounds x="235.75" y="912.09" width="170.5" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SEI_di" bpmnElement="n_SEI">
        <dc:Bounds x="28" y="1022.09" width="187" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SLC_di" bpmnElement="n_SLC">
        <dc:Bounds x="251" y="1022.09" width="157.5" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SELECTED_di" bpmnElement="n_SELECTED">
        <dc:Bounds x="444.5" y="1022.09" width="169.5" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_PREVIEW_di" bpmnElement="n_PREVIEW">
        <dc:Bounds x="241.73" y="376.5" width="178.75" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_TRIAGED_di" bpmnElement="n_TRIAGED">
        <dc:Bounds x="497.75" y="364.5" width="40" height="40" />
      </bpmndi:BPMNShape>
