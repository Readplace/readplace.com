<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_selection_dispatch" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_selection_dispatch" name="selection-dispatch" isExecutable="false">
    <bpmn:startEvent id="n_RECEIVED" name="EmailReceived">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="n_XQ" name="[inbox-extract-email-links queue">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_X" name="extract-email-links Lambda">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_TRACK" name="Gmail routing and write access full?">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_OLD" name="Dispatch as before, no tracking">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_FROZEN" name="Selection already on the row?">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_REPLAY" name="Replay frozen selection no triage call">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_TRIAGE" name="Triage links, write link rows">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_SELECT" name="outputSelection conditional SET, first wins"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_DISPATCH" name="Dispatch each selected output">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SEI" name="SaveEmailIssueCommand + emailOutput">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SLC" name="SubmitLinkCommand + emailOutput">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_SELECTED" name="EmailOutputsSelected outputCount, may be 0">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_PREVIEW" name="CrawlEmailLinkPreview">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_TRIAGED" name="EmailLinksTriaged custom readlist filing">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_RECEIVED" targetRef="n_XQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_XQ" targetRef="n_X" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_X" targetRef="n_TRACK" />
    <bpmn:sequenceFlow id="f_3" name="no: inbox address, held, backfill" sourceRef="n_TRACK" targetRef="n_OLD" />
    <bpmn:sequenceFlow id="f_4" name="yes" sourceRef="n_TRACK" targetRef="n_FROZEN" />
    <bpmn:sequenceFlow id="f_5" name="yes" sourceRef="n_FROZEN" targetRef="n_REPLAY" />
    <bpmn:sequenceFlow id="f_6" name="no" sourceRef="n_FROZEN" targetRef="n_TRIAGE" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_REPLAY" targetRef="n_DISPATCH" />
    <bpmn:sequenceFlow id="f_10" name="issue" sourceRef="n_DISPATCH" targetRef="n_SEI" />
    <bpmn:sequenceFlow id="f_11" name="link ordinal, URL from link row" sourceRef="n_DISPATCH" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_DISPATCH" targetRef="n_SELECTED" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_X" targetRef="n_PREVIEW" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_X" targetRef="n_TRIAGED" />
    <bpmn:association id="f_7" sourceRef="n_TRIAGE" targetRef="n_SELECT" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_SELECT" targetRef="n_DISPATCH" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_selection_dispatch">
    <bpmndi:BPMNPlane id="Plane_selection_dispatch" bpmnElement="Process_selection_dispatch">
      <bpmndi:BPMNShape id="n_RECEIVED_di" bpmnElement="n_RECEIVED">
        <dc:Bounds x="301" y="28" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_XQ_di" bpmnElement="n_XQ">
