    <bpmn:sequenceFlow id="f_6" name="2. publishEvent sub-1 KB detail" sourceRef="n_PutRefresh" targetRef="n_RAC" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_RAC" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_8" name="throws if Entries over 240 KB" sourceRef="n_PutRefresh" targetRef="n_Guard" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_Bus" targetRef="n_QRAC" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_QRAC" targetRef="n_RACWorker" />
