    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_RFCE" targetRef="n_SelectorChain" />
    <bpmn:association id="f_5" sourceRef="n_PutRefresh" targetRef="n_S3Staging" associationDirection="One" />
