<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_past_reads_on_open" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_past_reads_on_open" name="past-reads-on-open" isExecutable="false">
    <bpmn:startEvent id="n_OPEN" name="Reader opens the article">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_TR" name="POST /:id/topic-reads">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_CMD" name="ComputeRelatedPastReadsCommand">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_CRL" name="compute-related-articles Lambda">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PAST" name="past_reads pass">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_POLL" name="GET /:id/related polls Next read slot stays hidden">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_STOP" name="Stops at MAX_POLLS">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CAND" name="Automatic saves stay candidates for other saves' passes"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_OPEN" targetRef="n_TR" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_TR" targetRef="n_CMD" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_CMD" targetRef="n_CRL" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_CRL" targetRef="n_PAST" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_OPEN" targetRef="n_POLL" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_POLL" targetRef="n_STOP" />
    <bpmn:association id="f_6" sourceRef="n_PAST" targetRef="n_CAND" associationDirection="One" />
  </bpmn:process>
