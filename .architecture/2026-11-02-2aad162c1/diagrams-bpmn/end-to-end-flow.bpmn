<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:startEvent id="n_WEB" name="Web save bar, extension, save-all-tabs, MCP save_link">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_CAP" name="save-content upload captureTrigger on the request">
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_TAP" name="Inbox page per-link Save, reader issue-links Save">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_IMP" name="Import tab commit">
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_EXT" name="extract-email-links Lambda inbox address, Gmail live, Gmail history">
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_TMAN" name="saveTrigger manual">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_TCAP" name="saveTrigger equals captureTrigger">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_TAUTO" name="saveTrigger automatic">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_SLC" name="SubmitLinkCommand saveTrigger required when a user owns it">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_SLQ" name="submit-link queue 480 s visibility, 3 receives">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_SLL" name="submit-link Lambda">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SAVE" name="saveArticleFromUrl hutch inline or the submit-link Lambda">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ROW" name="user-articles row"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_GATE" name="createdUserArticle and saveTrigger is manual?">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="n_QEC" name="QueueEntryCreatedEvent">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_MEAS" name="markCrawlPending measured same gate, first save of a URL">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_CRQ" name="compute-related-articles queue batch size 1">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_CRL" name="compute-related-articles Lambda">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_NEXT" name="next_read pass DeepSeek">
      <bpmn:incoming>f_21</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PAST" name="past_reads pass DeepSeek">
      <bpmn:incoming>f_22</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_NONE" name="No queue entry event the save still queues and crawls">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_WEB" targetRef="n_TMAN" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_TAP" targetRef="n_TMAN" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_CAP" targetRef="n_TCAP" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_IMP" targetRef="n_TAUTO" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_EXT" targetRef="n_TAUTO" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_TMAN" targetRef="n_SAVE" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_TCAP" targetRef="n_SAVE" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_TAUTO" targetRef="n_SAVE" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_TMAN" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_TAUTO" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_10" name="unresolved link" sourceRef="n_TCAP" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_SLC" targetRef="n_SLQ" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_SLQ" targetRef="n_SLL" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_SLL" targetRef="n_SAVE" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_SAVE" targetRef="n_GATE" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_SAVE" targetRef="n_MEAS" />
    <bpmn:sequenceFlow id="f_17" name="yes" sourceRef="n_GATE" targetRef="n_QEC" />
    <bpmn:sequenceFlow id="f_18" name="no" sourceRef="n_GATE" targetRef="n_NONE" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_QEC" targetRef="n_CRQ" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_CRQ" targetRef="n_CRL" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_CRL" targetRef="n_NEXT" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_CRL" targetRef="n_PAST" />
    <bpmn:association id="f_14" sourceRef="n_SAVE" targetRef="n_ROW" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_end_to_end_flow">
