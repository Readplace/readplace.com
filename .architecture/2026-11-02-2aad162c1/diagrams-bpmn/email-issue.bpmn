<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_email_issue" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_email_issue" name="email-issue" isExecutable="false">
    <bpmn:serviceTask id="n_EXT" name="extract-email-links Lambda">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SEI" name="SaveEmailIssueCommand">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_SEL" name="save-email-issue-command Lambda">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ROW" name="user-articles row, issue metadata"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_CP" name="markCrawlPending measured false when content is pending">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SP" name="markSummaryPending">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_OSA" name="EmailOutputSavedToAllEvent">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_GONE" name="QueueEntryCreatedEvent from the issue save removed">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="n_TCE" name="TierContentExtractedEvent when content is pending">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_SEL2" name="Content selection of the issue body">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_EXT" targetRef="n_SEI" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_SEI" targetRef="n_SEL" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SEL" targetRef="n_CP" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_SEL" targetRef="n_SP" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_SEL" targetRef="n_OSA" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_SEL" targetRef="n_TCE" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_TCE" targetRef="n_SEL2" />
    <bpmn:sequenceFlow id="f_8" name="no longer published" sourceRef="n_SEL" targetRef="n_GONE" />
    <bpmn:association id="f_2" sourceRef="n_SEL" targetRef="n_ROW" associationDirection="One" />
  </bpmn:process>
