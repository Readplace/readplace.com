<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_stage_for_review" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_stage_for_review" name="stage-for-review" isExecutable="false">
    <bpmn:serviceTask id="n_W" name="Web app, logged-out upload received">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S" name="media upload session table"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_ST" name="MediaUploadStagedEvent">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_Q" name="[&quot;media-book-inspect-book queue">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_L" name="inspect-book Lambda">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_V" name="MediaInspectedEvent or MediaRejectedEvent">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_R" name="record-media-inspection">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_P" name="Web app, review page poll">
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_C" name="Web app, commit after signup">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_CM" name="MediaUploadCommittedEvent">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_W" targetRef="n_ST" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_ST" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Q" targetRef="n_L" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_L" targetRef="n_V" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_V" targetRef="n_R" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_P" targetRef="n_C" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_C" targetRef="n_CM" />
    <bpmn:association id="f_0" sourceRef="n_W" targetRef="n_S" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_R" targetRef="n_S" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_S" targetRef="n_P" associationDirection="One" />
  </bpmn:process>
