<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:sendTask id="n_created" name="QueueEntryCreated url canonical, userId">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_rule" name="EventBridge rule compute-related-articles pattern updated in place">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_q" name="compute-related-articles-q visibility 300s">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_dlq" name="compute-related-articles-dlq maxReceiveCount 3 alarm + email only">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_worker" name="compute-related-articles Lambda">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_articles" name="articles table crawl status + metadata"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_userArticles" name="user-articles table userId-savedAt-index userId-readAt-index"></bpmn:dataStoreReference>
    <bpmn:task id="n_deepseek" name="[DeepSeek one call, numbered positions">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_row" name="per-user save row relatedStatus, relatedArticles, relatedComputedAt, token counts"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_computed" name="RelatedArticlesComputed ready or skipped">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="n_pool" name="pool under the floor?">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_created" targetRef="n_rule" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_rule" targetRef="n_q" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_q" targetRef="n_worker" />
    <bpmn:sequenceFlow id="f_3" name="3 exhausted receives" sourceRef="n_q" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_6" name="target crawl pending or row absent: throw, retry" sourceRef="n_worker" targetRef="n_q" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_worker" targetRef="n_pool" />
    <bpmn:sequenceFlow id="f_10" name="yes, while some are still crawling: throw, retry" sourceRef="n_pool" targetRef="n_q" />
    <bpmn:sequenceFlow id="f_12" name="no" sourceRef="n_pool" targetRef="n_deepseek" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_deepseek" targetRef="n_worker" />
    <bpmn:sequenceFlow id="f_14" name="no readable answer: throw, retry" sourceRef="n_worker" targetRef="n_q" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_worker" targetRef="n_computed" />
    <bpmn:association id="f_4" sourceRef="n_worker" targetRef="n_row" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_worker" targetRef="n_articles" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_worker" targetRef="n_row" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_worker" targetRef="n_userArticles" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_pool" targetRef="n_row" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_worker" targetRef="n_row" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_end_to_end_flow">
    <bpmndi:BPMNPlane id="Plane_end_to_end_flow" bpmnElement="Process_end_to_end_flow">
      <bpmndi:BPMNShape id="n_created_di" bpmnElement="n_created">
        <dc:Bounds x="257.51" y="28" width="158" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_rule_di" bpmnElement="n_rule">
        <dc:Bounds x="241.38" y="138" width="190.25" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_q_di" bpmnElement="n_q">
        <dc:Bounds x="316.51" y="264" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_dlq_di" bpmnElement="n_dlq">
        <dc:Bounds x="203.38" y="407.5" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_worker_di" bpmnElement="n_worker">
        <dc:Bounds x="331.65" y="431" width="190.25" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_articles_di" bpmnElement="n_articles">
        <dc:Bounds x="123.34" y="571.25" width="161.92" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_userArticles_di" bpmnElement="n_userArticles">
        <dc:Bounds x="321.26" y="564.5" width="145.42" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_deepseek_di" bpmnElement="n_deepseek">
        <dc:Bounds x="162.54" y="740.75" width="142.75" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_row_di" bpmnElement="n_row">
        <dc:Bounds x="341.29" y="715" width="169.18" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_computed_di" bpmnElement="n_computed">
        <dc:Bounds x="553.85" y="574.75" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_pool_di" bpmnElement="n_pool">
        <dc:Bounds x="29.67" y="566.75" width="56" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="336.51" y="80" />
        <di:waypoint x="336.51" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_1_di" bpmnElement="f_1">
        <di:waypoint x="336.51" y="206" />
        <di:waypoint x="336.51" y="264" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_2_di" bpmnElement="f_2">
        <di:waypoint x="336.51" y="304" />
        <di:waypoint x="336.51" y="367.5" />
        <di:waypoint x="426.78" y="367.5" />
        <di:waypoint x="426.78" y="431" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_3_di" bpmnElement="f_3">
        <di:waypoint x="336.51" y="304" />
        <di:waypoint x="336.51" y="355.75" />
        <di:waypoint x="223.38" y="355.75" />
        <di:waypoint x="223.38" y="407.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_6_di" bpmnElement="f_6">
        <di:waypoint x="413.21" y="431" />
        <di:waypoint x="345.76" y="301.73" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_9_di" bpmnElement="f_9">
        <di:waypoint x="426.78" y="483" />
        <di:waypoint x="426.78" y="524.88" />
        <di:waypoint x="57.67" y="524.88" />
        <di:waypoint x="57.67" y="566.75" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_10_di" bpmnElement="f_10">
        <di:waypoint x="82.79" y="566.75" />
        <di:waypoint x="323.15" y="298.89" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_12_di" bpmnElement="f_12">
        <di:waypoint x="57.67" y="622.75" />
        <di:waypoint x="57.67" y="681.75" />
        <di:waypoint x="233.92" y="681.75" />
        <di:waypoint x="233.92" y="740.75" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_13_di" bpmnElement="f_13">
        <di:waypoint x="254.56" y="740.75" />
