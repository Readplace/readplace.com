<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_save_surfaces" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_save_surfaces" name="save-surfaces" isExecutable="false">
    <bpmn:sendTask id="n_saveBar" name="POST /queue/save web save bar">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_siren" name="POST /queue/ extension and iOS">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_bulk" name="POST /queue/save-articles Save All Tabs">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_capture" name="POST /queue/save-content tier-0 capture">
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_mcp" name="MCP save_link tool">
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_importCommit" name="POST import commit provenance import">
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_submitLink" name="SubmitLinkCommand handler inbox newsletter links">
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_recrawl" name="POST /admin/recrawl">
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_accept" name="shared accept phase">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_createdGate" name="row created by this save?">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_provenanceGate" name="provenance asks for resurfacing?">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_stub" name="global stub row + per-user save row"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_queued" name="LinkQueued url as submitted">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_nothing" name="no fact">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:task>
    <bpmn:sendTask id="n_created" name="QueueEntryCreated url canonical">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_recrawlChain" name="recrawl chain never writes a per-user row">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_saveBar" targetRef="n_accept" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_siren" targetRef="n_accept" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_bulk" targetRef="n_accept" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_capture" targetRef="n_accept" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_mcp" targetRef="n_accept" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_importCommit" targetRef="n_accept" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_submitLink" targetRef="n_accept" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_accept" targetRef="n_queued" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_accept" targetRef="n_createdGate" />
    <bpmn:sequenceFlow id="f_10" name="no" sourceRef="n_createdGate" targetRef="n_nothing" />
    <bpmn:sequenceFlow id="f_11" name="yes" sourceRef="n_createdGate" targetRef="n_provenanceGate" />
    <bpmn:sequenceFlow id="f_12" name="import: no" sourceRef="n_provenanceGate" targetRef="n_nothing" />
    <bpmn:sequenceFlow id="f_13" name="web, client, email, mcp" sourceRef="n_provenanceGate" targetRef="n_created" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_recrawl" targetRef="n_recrawlChain" />
    <bpmn:association id="f_7" sourceRef="n_accept" targetRef="n_stub" associationDirection="One" />
  </bpmn:process>
