      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_tier_di" bpmnElement="n_tier">
        <dc:Bounds x="353.69" y="456" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_resurfacing_di" bpmnElement="n_resurfacing">
        <dc:Bounds x="73.03" y="572.5" width="136.75" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_selector_di" bpmnElement="n_selector">
        <dc:Bounds x="245.78" y="572.5" width="145.25" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="116.15" y="76" />
        <di:waypoint x="116.15" y="105" />
