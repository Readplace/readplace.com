<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_newsletter_path" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_newsletter_path" name="newsletter-path" isExecutable="false">
    <bpmn:serviceTask id="n_extract" name="inbox link extractor">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_inboxBtn" name="inbox Save to queue button">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_submit" name="SubmitLinkCommand">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_worker" name="submit-link Lambda">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_accept" name="shared accept phase in-process">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_crawl" name="tier-1 crawl in-process">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_queued" name="LinkQueued">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sendTask id="n_created" name="QueueEntryCreated">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="n_tier" name="TierContentExtracted">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_resurfacing" name="resurfacing chain">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_selector" name="tier selector chain">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_extract" targetRef="n_submit" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_inboxBtn" targetRef="n_submit" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_submit" targetRef="n_worker" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_worker" targetRef="n_accept" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_accept" targetRef="n_queued" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_accept" targetRef="n_created" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_worker" targetRef="n_crawl" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_crawl" targetRef="n_tier" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_created" targetRef="n_resurfacing" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_tier" targetRef="n_selector" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_newsletter_path">
    <bpmndi:BPMNPlane id="Plane_newsletter_path" bpmnElement="Process_newsletter_path">
      <bpmndi:BPMNShape id="n_extract_di" bpmnElement="n_extract">
        <dc:Bounds x="40.03" y="28" width="152.25" height="48" />
