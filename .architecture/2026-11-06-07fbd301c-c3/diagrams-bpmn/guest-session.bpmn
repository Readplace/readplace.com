<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_guest_session" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_guest_session" name="guest-session" isExecutable="false">
    <bpmn:task id="n_S" name="staged, no owner">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_IN" name="inspecting, ETag stored">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_R" name="ready, facts">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_X" name="rejected, reason and notice">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_C" name="staged, owned">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_COMMIT" name="existing commit">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_S" targetRef="n_IN" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_IN" targetRef="n_R" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_IN" targetRef="n_X" />
    <bpmn:sequenceFlow id="f_3" name="reader claims" sourceRef="n_R" targetRef="n_C" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_C" targetRef="n_COMMIT" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_guest_session">
    <bpmndi:BPMNPlane id="Plane_guest_session" bpmnElement="Process_guest_session">
