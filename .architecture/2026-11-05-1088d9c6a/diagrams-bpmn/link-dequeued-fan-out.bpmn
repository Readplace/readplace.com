<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_link_dequeued_fan_out" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_link_dequeued_fan_out" name="link-dequeued-fan-out" isExecutable="false">
    <bpmn:sendTask id="n_U" name="Reader deletes an item from a readlist">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_W" name="Readlist delete: drop the reader's row">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_P" name="Any other save of this URL by the reader?">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_X" name="No event">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_E" name="LinkDequeuedEvent: url, userId">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_B" name="Shared event bus">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_IQ" name="inbox-record-link-dequeued queue">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_IL" name="Inbox record-link Lambda: retract the saved mark">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_IS" name="Inbox email links"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_IDLQ" name="inbox-record-link-dequeued DLQ">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_MQ" name="media-release queue">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_ML" name="media-release Lambda">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_MDLQ" name="media-release DLQ + alarm email">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_U" targetRef="n_W" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_W" targetRef="n_P" />
    <bpmn:sequenceFlow id="f_2" name="yes" sourceRef="n_P" targetRef="n_X" />
    <bpmn:sequenceFlow id="f_3" name="no" sourceRef="n_P" targetRef="n_E" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_E" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_5" name="every URL" sourceRef="n_B" targetRef="n_IQ" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_IQ" targetRef="n_IL" />
    <bpmn:sequenceFlow id="f_8" name="exhausted" sourceRef="n_IQ" targetRef="n_IDLQ" />
    <bpmn:sequenceFlow id="f_9" name="private item host only" sourceRef="n_B" targetRef="n_MQ" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_MQ" targetRef="n_ML" />
    <bpmn:sequenceFlow id="f_11" name="exhausted" sourceRef="n_MQ" targetRef="n_MDLQ" />
    <bpmn:association id="f_7" sourceRef="n_IL" targetRef="n_IS" associationDirection="One" />
  </bpmn:process>
