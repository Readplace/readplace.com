<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_media_release_handler" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_media_release_handler" name="media-release-handler" isExecutable="false">
    <bpmn:startEvent id="n_E" name="LinkDequeuedEvent for a private item URL">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_L" name="media-release Lambda: parse the detail">
      <bpmn:incoming>f_0</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_O" name="Articles table: read the row's owner"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_P" name="Owner is another reader?">
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_N" name="not-owner: nothing deleted, logged">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_S1" name="1. Purge the item's stored content">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_C" name="Content bucket: content/ objects"></bpmn:dataStoreReference>
    <bpmn:task id="n_S2" name="2. Delete the staged original">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_M" name="Media bucket: pending/uploadId/original"></bpmn:dataStoreReference>
    <bpmn:task id="n_S3" name="3. Delete the article row">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_A" name="Articles table"></bpmn:dataStoreReference>
    <bpmn:task id="n_S4" name="4. Delete every user-article link for the URL">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_UA" name="User-articles table, url index, default and readlist rows"></bpmn:dataStoreReference>
    <bpmn:task id="n_R" name="released, logged">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_E" targetRef="n_L" />
    <bpmn:sequenceFlow id="f_3" name="yes" sourceRef="n_P" targetRef="n_N" />
    <bpmn:sequenceFlow id="f_4" name="no, or the row is gone" sourceRef="n_P" targetRef="n_S1" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_S1" targetRef="n_S2" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_S2" targetRef="n_S3" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_S3" targetRef="n_S4" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_S4" targetRef="n_R" />
    <bpmn:association id="f_1" sourceRef="n_L" targetRef="n_O" associationDirection="One" />
    <bpmn:association id="f_2" sourceRef="n_O" targetRef="n_P" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_S1" targetRef="n_C" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_S2" targetRef="n_M" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_S3" targetRef="n_A" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_S4" targetRef="n_UA" associationDirection="One" />
  </bpmn:process>
