<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_disconnect" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_disconnect" name="disconnect" isExecutable="false">
    <bpmn:sendTask id="n_A" name="POST /integrations/gmail/disconnect">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_C" name="DisconnectGmailCommand">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="hutch-rewrite-gmail-filter-q">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_D" name="hutch-rewrite-gmail-filter-dlq → SNS → operator email">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_S" name="hutch · disconnect-gmail">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_S1" name="delete every sender row">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_S2" name="rewrite the filter (no senders left ⇒ Gmail filter removed)">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_S3" name="revoke the grant at Google">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_S4" name="delete credentials, mark revoked">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_R1" name="gmail-credentials · row gone"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_R2" name="gmail-connections · revokedAt set index marker removed"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_E" name="GmailDisconnectedEvent filterRemoved · grantRevoked">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_A" targetRef="n_C" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_C" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_2" name="retries exhausted" sourceRef="n_Q" targetRef="n_D" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Q" targetRef="n_S" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_S" targetRef="n_S1" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_S1" targetRef="n_S2" />
    <bpmn:sequenceFlow id="f_6" name="Gmail unavailable" sourceRef="n_S2" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_S2" targetRef="n_S3" />
    <bpmn:sequenceFlow id="f_8" name="Google unavailable" sourceRef="n_S3" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_S3" targetRef="n_S4" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_S4" targetRef="n_E" />
    <bpmn:association id="f_10" sourceRef="n_S4" targetRef="n_R1" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_S4" targetRef="n_R2" associationDirection="One" />
  </bpmn:process>
