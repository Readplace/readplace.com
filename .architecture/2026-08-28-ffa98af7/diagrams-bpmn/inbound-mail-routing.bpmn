<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_inbound_mail_routing" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_inbound_mail_routing" name="inbound-mail-routing" isExecutable="false">
    <bpmn:sendTask id="n_IN" name="Inbound message">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_SES" name="SES → S3 raw .eml → SNS → SQS">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_S" name="inbox · receive-email">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_D" name="inbox shared failures DLQ">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="n_G1" name="oversize / unparseable?">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_AUD" name="inbox-emails audit row"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_G2" name="Google forwarding confirmation to a single live gateway address?">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="n_C1" name="ConfirmGmailForwardingCommand">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:businessRuleTask id="n_IMG" name="download inline images once">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="n_G3" name="recipient purpose">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="n_DEL" name="store body + row">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="n_G4" name="sender mapped?">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="n_MAP" name="deliver as the mapped alias">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_HOLD" name="record sender + hold the message publish nothing">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_R1" name="gmail-senders"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_R2" name="gmail-held-mail"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_R3" name="inbox-emails"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_E1" name="EmailReceivedEvent">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_EX" name="inbox · extract-email-links → previews">
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_IN" targetRef="n_SES" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_SES" targetRef="n_S" />
    <bpmn:sequenceFlow id="f_2" name="retries exhausted" sourceRef="n_SES" targetRef="n_D" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_S" targetRef="n_G1" />
    <bpmn:sequenceFlow id="f_5" name="no" sourceRef="n_G1" targetRef="n_G2" />
    <bpmn:sequenceFlow id="f_6" name="yes" sourceRef="n_G2" targetRef="n_C1" />
    <bpmn:sequenceFlow id="f_7" name="no" sourceRef="n_G2" targetRef="n_IMG" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_IMG" targetRef="n_G3" />
    <bpmn:sequenceFlow id="f_10" name="user-alias" sourceRef="n_G3" targetRef="n_DEL" />
    <bpmn:sequenceFlow id="f_11" name="gmail-forwarding" sourceRef="n_G3" targetRef="n_G4" />
    <bpmn:sequenceFlow id="f_12" name="mapped" sourceRef="n_G4" targetRef="n_MAP" />
    <bpmn:sequenceFlow id="f_13" name="unmapped" sourceRef="n_G4" targetRef="n_HOLD" />
    <bpmn:sequenceFlow id="f_14" name="sender unreadable" sourceRef="n_G4" targetRef="n_DEL" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_MAP" targetRef="n_DEL" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_DEL" targetRef="n_E1" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_E1" targetRef="n_EX" />
    <bpmn:association id="f_4" sourceRef="n_G1" targetRef="n_AUD" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_G3" targetRef="n_AUD" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_HOLD" targetRef="n_R1" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_HOLD" targetRef="n_R2" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_DEL" targetRef="n_R3" associationDirection="One" />
  </bpmn:process>
