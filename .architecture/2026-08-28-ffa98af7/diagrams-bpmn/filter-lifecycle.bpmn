<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_filter_lifecycle" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_filter_lifecycle" name="filter-lifecycle" isExecutable="false">
    <bpmn:sendTask id="n_A1" name="POST /integrations/gmail/verify">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_C1" name="RewriteGmailFilterCommand">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_A2" name="POST /integrations/gmail/senders/add">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_A3" name="POST /integrations/gmail/senders/remove">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_A4" name="POST /integrations/gmail/senders/map">
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:startEvent id="n_E0" name="GmailForwardingConfirmedEvent">
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_Q" name="hutch-rewrite-gmail-filter-q">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_D" name="hutch-rewrite-gmail-filter-dlq → SNS → operator email">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_S" name="hutch · rewrite-gmail-filter">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_RD1" name="gmail-connections read state"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_RD2" name="gmail-senders read sender set"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_RD3" name="gmail-credentials refresh → access token"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_B" name="connection state">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="n_F1" name="GmailFilterRewriteFailedEvent">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_X1" name="delete our filters clear filterId">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_X2" name="list → create → read back → delete old">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateThrowEvent id="n_OK" name="GmailFilterRewrittenEvent">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_Y" name="delete the new filter record lastFilterError">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_A1" targetRef="n_C1" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_A2" targetRef="n_C1" />
