    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_C1" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_6" name="retries exhausted" sourceRef="n_Q" targetRef="n_D" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Q" targetRef="n_S" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_S" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_12" name="absent · unconfirmed · revoked" sourceRef="n_B" targetRef="n_F1" />
    <bpmn:sequenceFlow id="f_13" name="query over the length cap" sourceRef="n_B" targetRef="n_F1" />
    <bpmn:sequenceFlow id="f_14" name="no senders left" sourceRef="n_B" targetRef="n_X1" />
    <bpmn:sequenceFlow id="f_15" name="senders present" sourceRef="n_B" targetRef="n_X2" />
    <bpmn:sequenceFlow id="f_16" name="query round-tripped" sourceRef="n_X2" targetRef="n_OK" />
    <bpmn:sequenceFlow id="f_17" name="Gmail stored a different query" sourceRef="n_X2" targetRef="n_Y" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_Y" targetRef="n_F1" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_X1" targetRef="n_OK" />
    <bpmn:sequenceFlow id="f_20" name="429 / 5xx" sourceRef="n_X2" targetRef="n_Q" />
    <bpmn:association id="f_8" sourceRef="n_S" targetRef="n_RD1" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_S" targetRef="n_RD2" associationDirection="One" />
