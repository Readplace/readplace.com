<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_connect_and_confirm" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_connect_and_confirm" name="connect-and-confirm" isExecutable="false">
    <bpmn:sendTask id="n_U" name="Reader on /integrations">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_C1" name="POST /integrations/gmail/connect">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_S1" name="hutch web · sign state, redirect">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_G1" name="Google consent gmail.settings.basic access_type=offline · prompt=consent">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_C2" name="GET /integrations/gmail/callback">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_S2" name="hutch web · verify state, exchange code">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_R1" name="gmail-credentials"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_R2" name="inbox-addresses purpose=gmail-forwarding"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_R3" name="gmail-connections"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_U2" name="Reader pastes the gateway address into Gmail settings">
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_G2" name="Google sends a confirmation email to the gateway address">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_SES" name="SES → S3 → SNS → SQS">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_S3" name="inbox · receive-email">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_C3" name="ConfirmGmailForwardingCommand">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q1" name="inbox-confirm-gmail-forwarding-q">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_S4" name="inbox · confirm-gmail-forwarding empty-body POST to mail.google.com/mail/vf-…">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_D1" name="inbox shared failures DLQ">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="n_E1" name="GmailForwardingConfirmedEvent">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_E2" name="GmailForwardingConfirmFailedEvent">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_Q2" name="hutch-rewrite-gmail-filter-q">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_S5" name="hutch · mark confirmed">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_C4" name="RewriteGmailFilterCommand reason=forwarding-confirmed">
      <bpmn:incoming>f_22</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_U" targetRef="n_C1" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_C1" targetRef="n_S1" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_S1" targetRef="n_G1" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_G1" targetRef="n_C2" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_C2" targetRef="n_S2" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_U2" targetRef="n_G2" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_G2" targetRef="n_SES" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_SES" targetRef="n_S3" />
    <bpmn:sequenceFlow id="f_12" name="From forwarding-noreply@google.com + X-Google-Address-Confirmation + sole live gateway recipient" sourceRef="n_S3" targetRef="n_C3" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_C3" targetRef="n_Q1" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_Q1" targetRef="n_S4" />
    <bpmn:sequenceFlow id="f_15" name="retries exhausted" sourceRef="n_Q1" targetRef="n_D1" />
    <bpmn:sequenceFlow id="f_16" name="200, no submit form left" sourceRef="n_S4" targetRef="n_E1" />
    <bpmn:sequenceFlow id="f_17" name="400 · interstitial · bad URL" sourceRef="n_S4" targetRef="n_E2" />
    <bpmn:sequenceFlow id="f_18" name="5xx / network" sourceRef="n_S4" targetRef="n_Q1" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_E1" targetRef="n_Q2" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_Q2" targetRef="n_S5" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_S5" targetRef="n_C4" />
    <bpmn:association id="f_5" sourceRef="n_S2" targetRef="n_R1" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_S2" targetRef="n_R2" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_S2" targetRef="n_R3" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_R3" targetRef="n_U2" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_S5" targetRef="n_R3" associationDirection="One" />
  </bpmn:process>
