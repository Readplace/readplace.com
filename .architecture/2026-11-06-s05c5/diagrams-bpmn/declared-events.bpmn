  <bpmn:process id="Process_declared_events" name="declared-events" isExecutable="false">
    <bpmn:serviceTask id="n_T" name="Amazon Transcribe">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_J" name="TranscribeJobStateChangedEvent">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_DB" name="Default event bus, source aws.transcribe">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_Q" name="A media-audio queue">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_M" name="Media contracts">
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_C" name="MediaUploadCommittedEvent">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_F" name="MediaProcessingFailedEvent">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_B" name="Shared event bus, source hutch.media">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_P" name="Media-book processor">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_K" name="Media-audio keep-audio">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SF" name="Settle media failure (hutch)">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_T" targetRef="n_J" />
    <bpmn:sequenceFlow id="f_1" name="declared, unwired" sourceRef="n_J" targetRef="n_DB" />
    <bpmn:sequenceFlow id="f_2" name="no AWS service event rule yet" sourceRef="n_DB" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_M" targetRef="n_C" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_M" targetRef="n_F" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_C" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_F" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_7" name="MediaUploadCommitted, kind book" sourceRef="n_B" targetRef="n_P" />
    <bpmn:sequenceFlow id="f_8" name="MediaUploadCommitted, kind audio" sourceRef="n_B" targetRef="n_K" />
    <bpmn:sequenceFlow id="f_9" name="MediaProcessingFailed" sourceRef="n_B" targetRef="n_SF" />
  </bpmn:process>
