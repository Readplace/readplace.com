<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_inspect_book" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_inspect_book" name="inspect-book" isExecutable="false">
    <bpmn:serviceTask id="n_W" name="Web app (later change)">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_ST" name="MediaUploadStagedEvent">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_Q" name="[&quot;media-book-inspect-book queue">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_L" name="inspect-book Lambda">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_B" name="media bucket, pending original"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_OK" name="MediaInspectedEvent">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_NO" name="MediaRejectedEvent">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_R" name="record-media-inspection">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_DLQ" name="[&quot;media-book-failures DLQ">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_DR" name="media-book-failures router">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_NO2" name="MediaRejectedEvent">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_W" targetRef="n_ST" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_ST" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Q" targetRef="n_L" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_L" targetRef="n_OK" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_L" targetRef="n_NO" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_OK" targetRef="n_R" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_NO" targetRef="n_R" />
    <bpmn:sequenceFlow id="f_8" name="after two receives" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_DLQ" targetRef="n_DR" />
    <bpmn:sequenceFlow id="f_10" name="processing exhausted" sourceRef="n_DR" targetRef="n_NO2" />
    <bpmn:association id="f_3" sourceRef="n_B" targetRef="n_L" associationDirection="One" />
  </bpmn:process>
