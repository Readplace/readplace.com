<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_disconnect_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_disconnect_flow" name="disconnect-flow" isExecutable="false">
    <bpmn:serviceTask id="n_Route" name="POST /gmail/disconnect"></bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Mark" name="connection row: SET disconnectRequestedAt"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_Cmd" name="DisconnectGmailCommand {userId}">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_Q" name="[&quot;rewrite-gmail-filter-q">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_DLQ" name="[&quot;rewrite-gmail-filter-dlq">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_Handler" name="rewrite-gmail-filter Lambda: disconnect handler">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Read" name="connection row: consistent GetItem"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_Fence" name="Disconnect fence: row?">
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_Clean" name="delete monitor rows and discovery row"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Teardown" name="Teardown: cancel imports, delete senders and monitor rows, remove filter, revoke grant, delete credentials, disable gateway, delete connection and discovery">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_Google" name="Google answered?">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_Disconnected" name="GmailDisconnected">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_SkipNC" name="GmailDisconnectSkipped not-connected">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_SkipNR" name="GmailDisconnectSkipped not-requested">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_Retry" name="fail the record">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_AccountDelete" name="DeleteAccountCommand: delete-account handler">
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Cmd" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Q" targetRef="n_Handler" />
    <bpmn:sequenceFlow id="f_8" name="present, unmarked" sourceRef="n_Fence" targetRef="n_SkipNR" />
    <bpmn:sequenceFlow id="f_9" name="marked" sourceRef="n_Fence" targetRef="n_Teardown" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Teardown" targetRef="n_Google" />
    <bpmn:sequenceFlow id="f_11" name="yes" sourceRef="n_Google" targetRef="n_Disconnected" />
    <bpmn:sequenceFlow id="f_12" name="unavailable" sourceRef="n_Google" targetRef="n_Retry" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Retry" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_14" name="after 3 receives" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_15" name="start-message-move-task" sourceRef="n_DLQ" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_16" name="unfenced" sourceRef="n_AccountDelete" targetRef="n_Teardown" />
    <bpmn:association id="f_0" sourceRef="n_Route" targetRef="n_Mark" associationDirection="One" />
    <bpmn:association id="f_1" sourceRef="n_Mark" targetRef="n_Cmd" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_Handler" targetRef="n_Read" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_Read" targetRef="n_Fence" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_Fence" targetRef="n_Clean" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_Clean" targetRef="n_SkipNC" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_disconnect_flow">
    <bpmndi:BPMNPlane id="Plane_disconnect_flow" bpmnElement="Process_disconnect_flow">
      <bpmndi:BPMNShape id="n_Route_di" bpmnElement="n_Route">
