<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_rewrite_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_rewrite_flow" name="rewrite-flow" isExecutable="false">
    <bpmn:sendTask id="n_Rewrite" name="RewriteGmailFilterCommand {userId}">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:startEvent id="n_Confirmed" name="GmailForwardingConfirmed">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_ConfirmFailed" name="GmailForwardingConfirmFailed">
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="n_Q" name="[&quot;rewrite-gmail-filter-q">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_DLQ" name="[&quot;rewrite-gmail-filter-dlq">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_RewriteHandler" name="rewrite-gmail-filter Lambda: rewrite handler">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_Gate" name="Rewrite gate: row marked disconnecting?">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_Reconcile" name="Reconcile the gateway filter with Gmail">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_Rewritten" name="GmailFilterRewritten">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_RewriteFailed" name="GmailFilterRewriteFailed">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_ConfirmedHandler" name="forwarding-confirmed handler: gateway fence">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ConfirmFailedHandler" name="forwarding-confirm-failed handler: gateway fence">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Conn" name="connection row: UpdateItem IF attribute_exists(userId)"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Callback" name="OAuth callback: account email, clear revoked"></bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Rewrite" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Confirmed" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_ConfirmFailed" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Q" targetRef="n_RewriteHandler" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_RewriteHandler" targetRef="n_Gate" />
    <bpmn:sequenceFlow id="f_5" name="yes: not-connected" sourceRef="n_Gate" targetRef="n_RewriteFailed" />
    <bpmn:sequenceFlow id="f_6" name="no" sourceRef="n_Gate" targetRef="n_Reconcile" />
    <bpmn:sequenceFlow id="f_7" name="ok" sourceRef="n_Reconcile" targetRef="n_Rewritten" />
    <bpmn:sequenceFlow id="f_8" name="failed" sourceRef="n_Reconcile" targetRef="n_RewriteFailed" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Q" targetRef="n_ConfirmedHandler" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_ConfirmedHandler" targetRef="n_Rewrite" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Q" targetRef="n_ConfirmFailedHandler" />
    <bpmn:sequenceFlow id="f_16" name="after 3 receives" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_17" name="start-message-move-task" sourceRef="n_DLQ" targetRef="n_Q" />
    <bpmn:association id="f_9" sourceRef="n_Reconcile" targetRef="n_Conn" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_ConfirmedHandler" targetRef="n_Conn" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_ConfirmFailedHandler" targetRef="n_Conn" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_Callback" targetRef="n_Conn" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_rewrite_flow">
    <bpmndi:BPMNPlane id="Plane_rewrite_flow" bpmnElement="Process_rewrite_flow">
      <bpmndi:BPMNShape id="n_Rewrite_di" bpmnElement="n_Rewrite">
        <dc:Bounds x="438.75" y="38" width="197.25" height="52" />
      </bpmndi:BPMNShape>
