<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_trial_end_conversion_chain" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_trial_end_conversion_chain" name="trial-end-conversion-chain" isExecutable="false">
    <bpmn:sendTask id="n_U" name="Trial signup — email, Google or Apple">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_S0" name="hutch web · start trial">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ROW" name="subscription_providers status=trialing, plan-less"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_SCHED" name="EventBridge Scheduler group hutch-trial-end-stage trial-end-userId">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_BUS" name="hutch event bus">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:outgoing>f_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_CMD" name="SubscriptionStartRequestCommand userId">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="subscription-events queue visibility 30s · batch 1 shared by all six detail-types">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_L" name="subscription-events Lambda 128 MB / 30 s routes on detail-type">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_DLQ" name="subscription-events DLQ">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="n_OP" name="operator">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_H1" name="start-request handler findByUserId">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_NOOP" name="idempotent noop — already converted or cancelled">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_FP1" name="publish charge-failed reason no_card_on_file">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_PLAN" name="resolve plan = row.plan ?? yearly default">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_STRIPE" name="Stripe POST /v1/subscriptions price = stripePriceIds of plan">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_SP" name="publish charge-succeeded carrying the resolved plan">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_FP2" name="publish charge-failed reason stripe_error">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateThrowEvent id="n_ESUC" name="SubscriptionChargeSucceededEvent userId, subscriptionId, customerId, plan optional — monthly, yearly, triennial">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_H2" name="charge-succeeded handler upsertActive with detail.plan">
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ROWA" name="subscription_providers status=active plan records the charged tier, absent = grandfathered legacy price"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_EFAIL" name="SubscriptionChargeFailedEvent userId, reason">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_H3" name="charge-failed handler">
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_CCMD" name="CancelSubscriptionCommand">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_H4" name="cancel chain — cancel-subscription, then cancelled handlers via the same queue, markCancelledByUserId">
      <bpmn:incoming>f_30</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_U" targetRef="n_S0" />
    <bpmn:sequenceFlow id="f_2" name="createTrialEndSchedule one-shot, fires at trialEndsAt" sourceRef="n_S0" targetRef="n_SCHED" />
    <bpmn:sequenceFlow id="f_3" name="events PutEvents via scheduler execution role" sourceRef="n_SCHED" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_BUS" targetRef="n_CMD" />
    <bpmn:sequenceFlow id="f_5" name="subscription-start-request-command-rule" sourceRef="n_CMD" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Q" targetRef="n_L" />
    <bpmn:sequenceFlow id="f_7" name="retries exhausted" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_8" name="CloudWatch alarm + SNS email" sourceRef="n_DLQ" targetRef="n_OP" />
    <bpmn:sequenceFlow id="f_9" name="SubscriptionStartRequestCommand" sourceRef="n_L" targetRef="n_H1" />
    <bpmn:sequenceFlow id="f_11" name="row missing or not trialing" sourceRef="n_H1" targetRef="n_NOOP" />
    <bpmn:sequenceFlow id="f_12" name="trialing, no customerId typical no-card path" sourceRef="n_H1" targetRef="n_FP1" />
    <bpmn:sequenceFlow id="f_13" name="trialing with customerId" sourceRef="n_H1" targetRef="n_PLAN" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_PLAN" targetRef="n_STRIPE" />
    <bpmn:sequenceFlow id="f_15" name="2xx + subscriptionId" sourceRef="n_STRIPE" targetRef="n_SP" />
    <bpmn:sequenceFlow id="f_16" name="non-2xx / throw" sourceRef="n_STRIPE" targetRef="n_FP2" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_SP" targetRef="n_ESUC" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_ESUC" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_19" name="subscription-charge-succeeded-rule same shared queue" sourceRef="n_BUS" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_20" name="SubscriptionChargeSucceeded" sourceRef="n_L" targetRef="n_H2" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_FP1" targetRef="n_EFAIL" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_FP2" targetRef="n_EFAIL" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_EFAIL" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_25" name="subscription-charge-failed-rule same shared queue" sourceRef="n_BUS" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_26" name="SubscriptionChargeFailed" sourceRef="n_L" targetRef="n_H3" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_H3" targetRef="n_CCMD" />
    <bpmn:sequenceFlow id="f_28" name="" sourceRef="n_CCMD" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_29" name="cancel-subscription-command-rule same shared queue" sourceRef="n_BUS" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_30" name="CancelSubscriptionCommand" sourceRef="n_L" targetRef="n_H4" />
    <bpmn:association id="f_1" sourceRef="n_S0" targetRef="n_ROW" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_ROW" targetRef="n_H1" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_H2" targetRef="n_ROWA" associationDirection="One" />
    <bpmn:association id="f_31" sourceRef="n_H4" targetRef="n_ROW" associationDirection="One" />
  </bpmn:process>
