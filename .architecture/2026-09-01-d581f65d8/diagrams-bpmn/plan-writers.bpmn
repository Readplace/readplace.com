<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_plan_writers" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_plan_writers" name="plan-writers" isExecutable="false">
    <bpmn:sendTask id="n_U" name="Reader picks a tier — subscribe-plans popover on /account or the queue banner">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_C1" name="POST /account/subscribe body plan optional, unknown value = 400">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_S1" name="hutch web · pickSubscribeBranch on row.status">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ROW0" name="subscription_providers row"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_B1" name="startCheckout plan = chosen ?? yearly default trial preserved when time remains">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_B2" name="one-click resubscribe plan = chosen ?? row.plan ?? yearly default">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_NOOP" name="303 back to /account">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_CK" name="Stripe Checkout session price = stripePriceIds of plan">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_PS" name="pending_signups row plan attribute"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_C2" name="GET /auth/checkout/success">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_S2" name="hutch web · consumePendingSignup, then delete trial schedules, create charge reminder">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ROWA" name="subscription_providers status=active, plan recorded"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_SC" name="Stripe POST /v1/subscriptions price = stripePriceIds of plan">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_W2" name="upsertActive with plan — synchronous, no event">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_B1F" name="checkout fallback, same resolved plan">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_U" targetRef="n_C1" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_C1" targetRef="n_S1" />
    <bpmn:sequenceFlow id="f_3" name="trialing" sourceRef="n_S1" targetRef="n_B1" />
    <bpmn:sequenceFlow id="f_4" name="cancelled with customerId" sourceRef="n_S1" targetRef="n_B2" />
    <bpmn:sequenceFlow id="f_5" name="cancelled without customerId" sourceRef="n_S1" targetRef="n_B1" />
    <bpmn:sequenceFlow id="f_6" name="active or pending — noop" sourceRef="n_S1" targetRef="n_NOOP" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_B1" targetRef="n_CK" />
    <bpmn:sequenceFlow id="f_9" name="payment completes" sourceRef="n_CK" targetRef="n_C2" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_C2" targetRef="n_S2" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_B2" targetRef="n_SC" />
    <bpmn:sequenceFlow id="f_14" name="2xx" sourceRef="n_SC" targetRef="n_W2" />
    <bpmn:sequenceFlow id="f_16" name="declined / throw" sourceRef="n_SC" targetRef="n_B1F" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_B1F" targetRef="n_CK" />
    <bpmn:association id="f_2" sourceRef="n_ROW0" targetRef="n_S1" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_B1" targetRef="n_PS" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_PS" targetRef="n_S2" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_S2" targetRef="n_ROWA" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_W2" targetRef="n_ROWA" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_plan_writers">
    <bpmndi:BPMNPlane id="Plane_plan_writers" bpmnElement="Process_plan_writers">
      <bpmndi:BPMNShape id="n_U_di" bpmnElement="n_U">
