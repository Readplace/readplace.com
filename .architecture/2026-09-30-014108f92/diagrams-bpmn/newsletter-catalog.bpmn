<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_newsletter_catalog" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_newsletter_catalog" name="newsletter-catalog" isExecutable="false">
    <bpmn:sendTask id="n_SUB" name="SubmitNewsletterSenderCommand">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_BUS" name="EventBridge rule hutch-submit-newsletter-sender">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="newsletter-catalog-suggestions SQS">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_W" name="Suggestions Lambda: merge submitted sender as pending only when absent">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_UPD" name="Update catalog: read, apply rule, conditional write, rebase on conflict up to 3 attempts">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_EV" name="NewsletterSenderSubmittedEvent: created-pending or already-present">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_DLQ" name="Suggestions DLQ and backlog alarm">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_ADM" name="Admin form: create, edit, approve, reject, withdraw, reconsider, correct FROM, import seed">
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_GATE" name="Admin gate">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_UPD2" name="Update catalog with the moderation rule">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PRG" name="303 back to the list with notice">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_R409" name="409 with attempted values and current record">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="n_R503" name="503 storage alert">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_SEED" name="Committed seed file"></bpmn:dataStoreReference>
    <bpmn:task id="n_CAT" name="">
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_DET" name="Picker detector reads approved records">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SUB" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_BUS" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Q" targetRef="n_W" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_W" targetRef="n_UPD" />
    <bpmn:sequenceFlow id="f_4" name="ok" sourceRef="n_UPD" targetRef="n_EV" />
    <bpmn:sequenceFlow id="f_5" name="unavailable" sourceRef="n_UPD" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_6" name="receives exhausted" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_ADM" targetRef="n_GATE" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_GATE" targetRef="n_UPD2" />
    <bpmn:sequenceFlow id="f_9" name="ok" sourceRef="n_UPD2" targetRef="n_PRG" />
    <bpmn:sequenceFlow id="f_10" name="stale, invalid transition or conflict" sourceRef="n_UPD2" targetRef="n_R409" />
    <bpmn:sequenceFlow id="f_11" name="unavailable" sourceRef="n_UPD2" targetRef="n_R503" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_CAT" targetRef="n_DET" />
    <bpmn:association id="f_12" sourceRef="n_SEED" targetRef="n_UPD2" associationDirection="One" />
  </bpmn:process>
