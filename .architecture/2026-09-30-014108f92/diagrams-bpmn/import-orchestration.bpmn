<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_import_orchestration" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_import_orchestration" name="import-orchestration" isExecutable="false">
    <bpmn:task id="n_ST" name="Start import from save, import button or retry">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_CJ" name="Create job awaiting-permission">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_IMP" name="Gmail history imports: JOB and MSG rows"></bpmn:dataStoreReference>
    <bpmn:task id="n_SJ" name="startJob: queued, new generation, window fixed once">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_CONS" name="Consent row: POST gmail/connect with signed import intent">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_G" name="Google consent with include_granted_scopes">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_CB" name="OAuth callback resumes awaiting jobs and restarts the intent sender's failed job">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_REF" name="Redirect with import_permission_refused">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_SC" name="StartGmailHistoryImportCommand with generation">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_BUS" name="EventBridge rules hutch-start-gmail-history-import and page-processed">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_34</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="gmail-history-import SQS">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_36</bpmn:incoming>
      <bpmn:incoming>f_37</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_35</bpmn:outgoing>
      <bpmn:outgoing>f_38</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_L" name="Import Lambda: start runs page 0, page command runs page N">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_F1" name="Job running or queued in this generation">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateThrowEvent id="n_PP" name="GmailHistoryImportPageProcessedEvent with optional next page">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:outgoing>f_34</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_RP" name="Republish progress or complete if settled">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_F2" name="Fence connection gateway and account, then sender mapping">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_CAN" name="Cancel job: disconnected, account-changed, mapping-removed or destination-changed">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_CL" name="Claim page, 60 second lease">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_LS" name="List unread from sender in window, fetch RAW with read-only token">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_28</bpmn:outgoing>
      <bpmn:outgoing>f_37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_GM" name="Gmail API"></bpmn:serviceTask>
    <bpmn:serviceTask id="n_PUT" name="Put raw under gmail-import prefix">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_RAW" name="Inbox raw-email bucket"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_RF" name="Record message row, count new messages in listed">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_MF" name="GmailHistoryImportMessageFetchedEvent">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_SAVE" name="Save page: advance page and token, stamp listingCompletedAt at the end">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:outgoing>f_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_CE" name="GmailHistoryImportCompletedEvent">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_FJ" name="Fail job; mark connection revoked on reauth">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:outgoing>f_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_FE" name="GmailHistoryImportFailedEvent">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:incoming>f_40</bpmn:incoming>
      <bpmn:outgoing>f_33</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="n_NP" name="ProcessGmailHistoryImportPageCommand, direct SQS, 10 s delay">
      <bpmn:incoming>f_35</bpmn:incoming>
      <bpmn:outgoing>f_36</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_SDLQ" name="Shared DLQ gmail-history-import-failures">
      <bpmn:incoming>f_38</bpmn:incoming>
      <bpmn:outgoing>f_39</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="n_DR" name="gmail-history-import-dlq router, pages route: fail job dead-lettered">
      <bpmn:incoming>f_39</bpmn:incoming>
      <bpmn:outgoing>f_40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_ST" targetRef="n_CJ" />
    <bpmn:sequenceFlow id="f_2" name="read-only scope granted" sourceRef="n_CJ" targetRef="n_SJ" />
    <bpmn:sequenceFlow id="f_3" name="scope missing" sourceRef="n_CJ" targetRef="n_CONS" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_CONS" targetRef="n_G" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_G" targetRef="n_CB" />
    <bpmn:sequenceFlow id="f_6" name="refused or read access still missing" sourceRef="n_G" targetRef="n_REF" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_CB" targetRef="n_SJ" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_SJ" targetRef="n_SC" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_SC" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_BUS" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Q" targetRef="n_L" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_L" targetRef="n_F1" />
    <bpmn:sequenceFlow id="f_14" name="no" sourceRef="n_F1" targetRef="n_PP" />
    <bpmn:sequenceFlow id="f_15" name="page already saved" sourceRef="n_F1" targetRef="n_RP" />
    <bpmn:sequenceFlow id="f_16" name="yes" sourceRef="n_F1" targetRef="n_F2" />
    <bpmn:sequenceFlow id="f_17" name="mismatch" sourceRef="n_F2" targetRef="n_CAN" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_F2" targetRef="n_CL" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_CL" targetRef="n_LS" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_LS" targetRef="n_PUT" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_PUT" targetRef="n_RF" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_RF" targetRef="n_MF" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_MF" targetRef="n_SAVE" />
    <bpmn:sequenceFlow id="f_27" name="listing complete and all settled" sourceRef="n_SAVE" targetRef="n_CE" />
    <bpmn:sequenceFlow id="f_28" name="reauth-required, readonly missing or rejected" sourceRef="n_LS" targetRef="n_FJ" />
    <bpmn:sequenceFlow id="f_29" name="" sourceRef="n_FJ" targetRef="n_FE" />
    <bpmn:sequenceFlow id="f_30" name="" sourceRef="n_CAN" targetRef="n_PP" />
    <bpmn:sequenceFlow id="f_31" name="" sourceRef="n_RP" targetRef="n_PP" />
    <bpmn:sequenceFlow id="f_32" name="" sourceRef="n_SAVE" targetRef="n_PP" />
    <bpmn:sequenceFlow id="f_33" name="" sourceRef="n_FE" targetRef="n_PP" />
    <bpmn:sequenceFlow id="f_34" name="" sourceRef="n_PP" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_35" name="progress with next page" sourceRef="n_Q" targetRef="n_NP" />
    <bpmn:sequenceFlow id="f_36" name="" sourceRef="n_NP" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_37" name="Gmail unavailable" sourceRef="n_LS" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_38" name="5 receives exhausted" sourceRef="n_Q" targetRef="n_SDLQ" />
    <bpmn:sequenceFlow id="f_39" name="" sourceRef="n_SDLQ" targetRef="n_DR" />
    <bpmn:sequenceFlow id="f_40" name="" sourceRef="n_DR" targetRef="n_FE" />
    <bpmn:association id="f_1" sourceRef="n_CJ" targetRef="n_IMP" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_SJ" targetRef="n_IMP" associationDirection="One" />
    <bpmn:association id="f_21" sourceRef="n_PUT" targetRef="n_RAW" associationDirection="One" />
    <bpmn:association id="f_23" sourceRef="n_RF" targetRef="n_IMP" associationDirection="One" />
    <bpmn:association id="f_26" sourceRef="n_SAVE" targetRef="n_IMP" associationDirection="One" />
  </bpmn:process>
