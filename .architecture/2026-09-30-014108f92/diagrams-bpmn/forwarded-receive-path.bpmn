<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_forwarded_receive_path" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_forwarded_receive_path" name="forwarded-receive-path" isExecutable="false">
    <bpmn:serviceTask id="n_SES" name="SES receipt at gmail gateway address">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_RQ" name="inbox receive SQS">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_RL" name="Receive Lambda: parse, intercept confirmation, route by sender, hold unmapped">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_SND" name="Gmail senders: mappedAddress"></bpmn:dataStoreReference>
    <bpmn:task id="n_ID" name="Resolve identity with SES message attempt">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_IDS" name="Email identities"></bpmn:dataStoreReference>
    <bpmn:task id="n_SKIP" name="Skip: no row, no event">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_ING" name="Ingest parsed email, images downloaded once per message">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_EM" name="Inbox emails"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_ER" name="EmailReceivedEvent origin receive">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_EX" name="Existing extract-email-links to readlist">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SES" targetRef="n_RQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_RQ" targetRef="n_RL" />
    <bpmn:sequenceFlow id="f_3" name="routed to readlist address" sourceRef="n_RL" targetRef="n_ID" />
    <bpmn:sequenceFlow id="f_4" name="already imported or stored" sourceRef="n_ID" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_5" name="proceed" sourceRef="n_ID" targetRef="n_ING" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_ING" targetRef="n_ER" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_ER" targetRef="n_EX" />
    <bpmn:sequenceFlow id="f_9" name="no sender or no real Message-ID" sourceRef="n_RL" targetRef="n_ING" />
    <bpmn:association id="f_2" sourceRef="n_SND" targetRef="n_RL" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_ING" targetRef="n_EM" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_forwarded_receive_path">
    <bpmndi:BPMNPlane id="Plane_forwarded_receive_path" bpmnElement="Process_forwarded_receive_path">
      <bpmndi:BPMNShape id="n_SES_di" bpmnElement="n_SES">
        <dc:Bounds x="28" y="34.75" width="158.5" height="52" />
