      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_ER_di" bpmnElement="n_ER">
        <dc:Bounds x="338.88" y="646" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_EX_di" bpmnElement="n_EX">
        <dc:Bounds x="208.53" y="776" width="170.75" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="107.25" y="86.75" />
        <di:waypoint x="107.25" y="119.13" />
        <di:waypoint x="293.91" y="119.13" />
        <di:waypoint x="293.91" y="151.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_1_di" bpmnElement="f_1">
