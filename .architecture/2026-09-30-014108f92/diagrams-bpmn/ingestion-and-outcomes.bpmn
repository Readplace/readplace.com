    <bpmn:sequenceFlow id="f_31" name="" sourceRef="n_CS" targetRef="n_CE" />
    <bpmn:sequenceFlow id="f_32" name="receives exhausted" sourceRef="n_OQ" targetRef="n_SDLQ" />
    <bpmn:sequenceFlow id="f_33" name="" sourceRef="n_SDLQ" targetRef="n_OR" />
    <bpmn:sequenceFlow id="f_34" name="" sourceRef="n_OR" targetRef="n_CE" />
    <bpmn:association id="f_3" sourceRef="n_IMP" targetRef="n_L" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_RAW" targetRef="n_L" associationDirection="One" />
