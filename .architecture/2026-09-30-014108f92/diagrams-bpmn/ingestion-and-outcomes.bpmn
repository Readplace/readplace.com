<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ingestion_and_outcomes" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_ingestion_and_outcomes" name="ingestion-and-outcomes" isExecutable="false">
    <bpmn:startEvent id="n_MF" name="GmailHistoryImportMessageFetchedEvent">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_R1" name="EventBridge rule inbox-ingest-gmail-import">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="inbox-ingest-gmail-import SQS">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_L" name="Ingest Lambda">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_IMP" name="Hutch Gmail history imports, read only"></bpmn:dataStoreReference>
    <bpmn:task id="n_OC" name="Outcome cancelled">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_RAW" name="Inbox raw-email bucket"></bpmn:dataStoreReference>
    <bpmn:task id="n_OS" name="Outcome skipped-sender-mismatch">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_ON" name="Outcome skipped-no-message-id">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_ID" name="Resolve identity: adopt pre-claim row by Message-ID index, claim, same attempt, or take over">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_IDS" name="Email identities: claim per user, sender, Message-ID"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_EM" name="Inbox emails with messageId-index"></bpmn:dataStoreReference>
    <bpmn:task id="n_OA" name="Outcome already-imported">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_ING" name="Ingest parsed email: store body and images, write received row">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_ER" name="EmailReceivedEvent origin gmail-import to the readlist address">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_EX" name="Existing extract-email-links: triage links, resolve readlist from address">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SL" name="SubmitLinkCommand to the chosen readlist, All as default">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:task id="n_OI" name="Outcome imported with row key">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_MI" name="GmailHistoryImportMessageIngestedEvent">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_IDLQ" name="Shared inbox-failures DLQ">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="n_IR" name="inbox-failures-dlq router, new ingestGmailImport route">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_R2" name="EventBridge rule hutch-gmail-history-import-outcomes">
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_OQ" name="gmail-history-import-outcomes SQS">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
      <bpmn:outgoing>f_32</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_OL" name="Outcomes Lambda: record outcome fenced on both generations">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_IMP2" name="Gmail history imports"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_CS" name="Complete if listing finished and all settled">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:outgoing>f_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_CE" name="GmailHistoryImportCompletedEvent">
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:incoming>f_34</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_SDLQ" name="Shared DLQ gmail-history-import-failures">
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:outgoing>f_33</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="n_OR" name="gmail-history-import-dlq router, outcomes route: record failed, complete if settled">
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:outgoing>f_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_MF" targetRef="n_R1" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_R1" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Q" targetRef="n_L" />
    <bpmn:sequenceFlow id="f_4" name="job not running in generation, or destination gone" sourceRef="n_L" targetRef="n_OC" />
    <bpmn:sequenceFlow id="f_6" name="From is not the job sender" sourceRef="n_L" targetRef="n_OS" />
    <bpmn:sequenceFlow id="f_7" name="no real Message-ID" sourceRef="n_L" targetRef="n_ON" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_L" targetRef="n_ID" />
    <bpmn:sequenceFlow id="f_10" name="another attempt stored the email" sourceRef="n_ID" targetRef="n_OA" />
    <bpmn:sequenceFlow id="f_11" name="proceed" sourceRef="n_ID" targetRef="n_ING" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_ING" targetRef="n_ER" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_ER" targetRef="n_EX" />
