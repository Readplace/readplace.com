    <bpmn:sequenceFlow id="f_23" name="receives exhausted" sourceRef="n_Q" targetRef="n_IDLQ" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_IDLQ" targetRef="n_IR" />
