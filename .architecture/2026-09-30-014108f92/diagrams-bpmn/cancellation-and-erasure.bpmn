<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_cancellation_and_erasure" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_cancellation_and_erasure" name="cancellation-and-erasure" isExecutable="false">
    <bpmn:serviceTask id="n_WEB" name="Web: remove, remap, cancel button, readlist delete, disconnect">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_CX" name="Cancel unfinished imports with reason">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:task>
    <bpmn:sendTask id="n_DG" name="DisconnectGmailCommand">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_DW" name="Existing disconnect worker">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_GD" name="GmailDisconnectedEvent">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_IMP" name="Gmail history imports"></bpmn:dataStoreReference>
    <bpmn:task id="n_FEN" name="In-flight pages end with no next page; in-flight messages ingest as cancelled"></bpmn:task>
    <bpmn:sendTask id="n_DA" name="DeleteAccountCommand">
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_UDJ" name="user-data-jobs Lambda">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_S1" name="Existing inbox row deletes">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_S2" name="Sweep raw mail under gmail-import user prefix">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_S3" name="Delete all import jobs and message rows">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_S4" name="Delete all identity claims via userId-index">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_S5" name="Disconnect Gmail, cancelling imports">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_S6" name="Delete readlist-address claims derived from address rows">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_S7" name="Existing tombstone of inbox addresses">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_RAW" name="Inbox raw-email bucket"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_IDS" name="Email identities"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_ADDR" name="Inbox addresses"></bpmn:dataStoreReference>
