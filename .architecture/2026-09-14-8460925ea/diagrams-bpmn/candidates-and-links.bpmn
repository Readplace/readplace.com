<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_candidates_and_links" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_candidates_and_links" name="candidates-and-links" isExecutable="false">
    <bpmn:dataStoreReference id="n_definitions" name="readlist definition rows default partition, consistent read"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_listOrder" name="default list first then owned lists by creation"></bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_readIndex" name="userId-readAt-index per list partition, newest first"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_perList" name="each list capped at 1000 open article excluded">
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_merge" name="dedupe by canonical url newest readAt wins and tags its list">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_overall" name="sort newest first slice to 1000">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_hydrate" name="articles table batch read"></bpmn:dataStoreReference>
    <bpmn:task id="n_filter" name="drop invalid, purged and placeholder rows">
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_pool" name="candidate pool url, title, site, description, list hint">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_row" name="open article save row default partition"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_render" name="owner reader or poll fragment"></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_computed" name="pastReadsComputedAt set?">
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_pending" name="pending">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_anyStored" name="stored matches?">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_emptyReady" name="ready, no rows">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_recheck" name="every stored match times every owned list"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_readSomewhere" name="marked read in any list?">
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_linkable" name="article row linkable and not purged?">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_dropped" name="match dropped">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_destination" name="destination list: viewing list, then default, then owned by creation stored list hint not consulted">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_rowLink" name="row link to /queue/:id/view queue param when not default utm_content topic-read">
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_perList" targetRef="n_merge" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_merge" targetRef="n_overall" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_filter" targetRef="n_pool" />
    <bpmn:sequenceFlow id="f_11" name="no" sourceRef="n_computed" targetRef="n_pending" />
    <bpmn:sequenceFlow id="f_12" name="yes" sourceRef="n_computed" targetRef="n_anyStored" />
    <bpmn:sequenceFlow id="f_13" name="no" sourceRef="n_anyStored" targetRef="n_emptyReady" />
    <bpmn:sequenceFlow id="f_16" name="no" sourceRef="n_readSomewhere" targetRef="n_dropped" />
    <bpmn:sequenceFlow id="f_17" name="yes" sourceRef="n_readSomewhere" targetRef="n_linkable" />
    <bpmn:sequenceFlow id="f_18" name="no" sourceRef="n_linkable" targetRef="n_dropped" />
    <bpmn:sequenceFlow id="f_19" name="yes" sourceRef="n_linkable" targetRef="n_destination" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_destination" targetRef="n_rowLink" />
    <bpmn:association id="f_0" sourceRef="n_definitions" targetRef="n_listOrder" associationDirection="One" />
    <bpmn:association id="f_1" sourceRef="n_listOrder" targetRef="n_readIndex" associationDirection="One" />
    <bpmn:association id="f_2" sourceRef="n_readIndex" targetRef="n_perList" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_overall" targetRef="n_hydrate" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_hydrate" targetRef="n_filter" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_pool" targetRef="n_row" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_render" targetRef="n_row" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_row" targetRef="n_computed" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_anyStored" targetRef="n_recheck" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_recheck" targetRef="n_readSomewhere" associationDirection="One" />
  </bpmn:process>
