<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_read_side" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_read_side" name="read-side" isExecutable="false">
    <bpmn:sendTask id="n_reader" name="GET /queue/:id/view owner reader, web or app shell">
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_nonOwner" name="GET /queue/:id/view non-owner or anonymous">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_publicView" name="GET /view/* public reader">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_recrawlPreview" name="GET admin recrawl preview">
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_mcpTool" name="MCP get_related_articles"></bpmn:sendTask>
    <bpmn:sendTask id="n_dismiss" name="POST /queue/:id/related-dismiss">
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_poll" name="GET /queue/:id/topic-reads 3s poll, capped at 300">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_redirect" name="redirect to the public reader">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_notice" name="reader failure notice?">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_pastReadsRead" name="stored past reads re-checked against current reading history"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_nextReadRead" name="Next-read relations"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_discarded" name="result discarded ready, empty, no poll compute form still rendered">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_topicSlot" name="past-reads section between summary and body">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_hiddenSlot" name="hidden, reserves no space pending or no rows">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_visibleSlot" name="Previously read on this topic up to 3 rows with a reason">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_nextCard" name="Next-read card">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_nothing" name="no section, no poll no compute request">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_foundDefault" name="article found in the default list?">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_notFound" name="404, empty body">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_fragment" name="section fragment re-rendered, no notice check">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_nonOwner" targetRef="n_redirect" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_redirect" targetRef="n_publicView" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_reader" targetRef="n_notice" />
    <bpmn:sequenceFlow id="f_4" name="yes: notice wins" sourceRef="n_notice" targetRef="n_discarded" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_discarded" targetRef="n_topicSlot" />
    <bpmn:sequenceFlow id="f_6" name="no: stored result used" sourceRef="n_notice" targetRef="n_topicSlot" />
    <bpmn:sequenceFlow id="f_9" name="pending or empty" sourceRef="n_topicSlot" targetRef="n_hiddenSlot" />
    <bpmn:sequenceFlow id="f_10" name="has rows" sourceRef="n_topicSlot" targetRef="n_visibleSlot" />
    <bpmn:sequenceFlow id="f_11" name="pending: every 3s" sourceRef="n_hiddenSlot" targetRef="n_poll" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_poll" targetRef="n_foundDefault" />
    <bpmn:sequenceFlow id="f_13" name="no" sourceRef="n_foundDefault" targetRef="n_notFound" />
    <bpmn:sequenceFlow id="f_14" name="yes" sourceRef="n_foundDefault" targetRef="n_fragment" />
    <bpmn:sequenceFlow id="f_16" name="swapped in place" sourceRef="n_fragment" targetRef="n_topicSlot" />
    <bpmn:sequenceFlow id="f_17" name="Next read only" sourceRef="n_dismiss" targetRef="n_nextCard" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_publicView" targetRef="n_nothing" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_recrawlPreview" targetRef="n_nothing" />
    <bpmn:association id="f_2" sourceRef="n_reader" targetRef="n_pastReadsRead" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_reader" targetRef="n_nextReadRead" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_nextReadRead" targetRef="n_nextCard" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_fragment" targetRef="n_pastReadsRead" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_mcpTool" targetRef="n_nextReadRead" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_read_side">
    <bpmndi:BPMNPlane id="Plane_read_side" bpmnElement="Process_read_side">
