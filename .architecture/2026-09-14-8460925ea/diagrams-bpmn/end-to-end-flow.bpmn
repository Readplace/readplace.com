<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:intermediateCatchEvent id="n_record" name="SQS record QueueEntryCreated or ComputeRelatedPastReads">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_worker" name="past-reads pass compute-related-articles Lambda">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_articles" name="articles table crawl status + metadata"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_purged" name="target purged?">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_crawled" name="row present with title, site and excerpt, crawl settled?">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_gather" name="read candidates across every owned list"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_fingerprint" name="fingerprint equals the stored one?">
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_placeholder" name="target still a placeholder?">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_boilerplate" name="target text matches a read candidate on another site?">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_deepseek" name="[DeepSeek past-reads prompt, at most 3 picks">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_condition" name="savedAt exists and pastReadsComputedAt absent or older?">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_row" name="open article save row pastReadsArticles, pastReadsFingerprint, pastReadsComputedAt, token counts"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_readyEvt" name="RelatedPastReadsComputed ready"></bpmn:sendTask>
    <bpmn:sendTask id="n_unchangedEvt" name="RelatedPastReadsComputed unchanged, zero counts">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_acked" name="acked nothing written, nothing published">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_q" name="compute-related-articles-q visibility 300s">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_dlq" name="compute-related-articles-dlq maxReceiveCount 3 alarm + email only">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_record" targetRef="n_worker" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_worker" targetRef="n_purged" />
    <bpmn:sequenceFlow id="f_3" name="any throw: parse, store, model, publish" sourceRef="n_worker" targetRef="n_q" />
    <bpmn:sequenceFlow id="f_4" name="yes" sourceRef="n_purged" targetRef="n_acked" />
    <bpmn:sequenceFlow id="f_5" name="no" sourceRef="n_purged" targetRef="n_crawled" />
    <bpmn:sequenceFlow id="f_6" name="no: throw, retry" sourceRef="n_crawled" targetRef="n_q" />
    <bpmn:sequenceFlow id="f_7" name="3 exhausted receives" sourceRef="n_q" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_10" name="yes" sourceRef="n_fingerprint" targetRef="n_unchangedEvt" />
    <bpmn:sequenceFlow id="f_11" name="no" sourceRef="n_fingerprint" targetRef="n_placeholder" />
    <bpmn:sequenceFlow id="f_12" name="yes: empty result" sourceRef="n_placeholder" targetRef="n_condition" />
    <bpmn:sequenceFlow id="f_13" name="no" sourceRef="n_placeholder" targetRef="n_boilerplate" />
    <bpmn:sequenceFlow id="f_14" name="yes: empty result" sourceRef="n_boilerplate" targetRef="n_condition" />
    <bpmn:sequenceFlow id="f_15" name="no" sourceRef="n_boilerplate" targetRef="n_deepseek" />
    <bpmn:sequenceFlow id="f_16" name="no readable answer: throw, retry" sourceRef="n_deepseek" targetRef="n_q" />
    <bpmn:sequenceFlow id="f_17" name="picks mapped to urls and list hints" sourceRef="n_deepseek" targetRef="n_condition" />
    <bpmn:sequenceFlow id="f_20" name="no: superseded" sourceRef="n_condition" targetRef="n_acked" />
    <bpmn:association id="f_1" sourceRef="n_worker" targetRef="n_articles" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_crawled" targetRef="n_gather" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_gather" targetRef="n_fingerprint" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_condition" targetRef="n_row" associationDirection="One" />
    <bpmn:association id="f_19" sourceRef="n_row" targetRef="n_readyEvt" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_end_to_end_flow">
    <bpmndi:BPMNPlane id="Plane_end_to_end_flow" bpmnElement="Process_end_to_end_flow">
