<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_shared_queue" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_shared_queue" name="shared-queue" isExecutable="false">
    <bpmn:serviceTask id="n_webLambda" name="hutch web Lambda save routes + POST /queue/:id/topic-reads">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_submitLink" name="submit-link Lambda newsletter links">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_bus" name="platform event bus">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_entryRule" name="compute-related-articles-rule hutch.save-article / QueueEntryCreated name pinned to the consumer">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_pastRule" name="compute-related-past-reads-rule hutch.save-link / ComputeRelatedPastReads">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_queuePolicy" name="compute-related-articles-queue-policy SourceArn equals either rule">
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_dlqPolicy" name="compute-related-articles-dlq-policy SourceArn equals either rule">
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_q" name="compute-related-articles-q visibility 300s">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_dlq" name="compute-related-articles-dlq maxReceiveCount 3, 14-day retention">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_alarm" name="DLQ alarm + SNS email no DLQ consumer">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_lambda" name="compute-related-articles Lambda 256 MB, 300s, batch size 1">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_dispatch" name="detail-type?">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_nextRead" name="Next-read pass write-once relatedStatus">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_pastReads" name="past-reads pass fingerprinted pastReads attributes">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_merged" name="failures merged record retried whole">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_ignored" name="any other detail-type acked with no work">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_nextComputed" name="RelatedArticlesComputed ready or skipped">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="n_pastComputed" name="RelatedPastReadsComputed ready or unchanged">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_noSubscriber" name="no subscriber">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:incoming>f_24</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="QueueEntryCreated, ComputeRelatedPastReads" sourceRef="n_webLambda" targetRef="n_bus" />
    <bpmn:sequenceFlow id="f_1" name="QueueEntryCreated" sourceRef="n_submitLink" targetRef="n_bus" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_bus" targetRef="n_entryRule" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_bus" targetRef="n_pastRule" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_entryRule" targetRef="n_q" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_pastRule" targetRef="n_q" />
    <bpmn:sequenceFlow id="f_6" name="admits both rules" sourceRef="n_queuePolicy" targetRef="n_q" />
    <bpmn:sequenceFlow id="f_7" name="failed delivery" sourceRef="n_entryRule" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_8" name="failed delivery" sourceRef="n_pastRule" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_9" name="admits both rules" sourceRef="n_dlqPolicy" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_10" name="3 exhausted receives" sourceRef="n_q" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_dlq" targetRef="n_alarm" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_q" targetRef="n_lambda" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_lambda" targetRef="n_dispatch" />
    <bpmn:sequenceFlow id="f_14" name="QueueEntryCreated" sourceRef="n_dispatch" targetRef="n_nextRead" />
    <bpmn:sequenceFlow id="f_15" name="QueueEntryCreated" sourceRef="n_dispatch" targetRef="n_pastReads" />
    <bpmn:sequenceFlow id="f_16" name="ComputeRelatedPastReads" sourceRef="n_dispatch" targetRef="n_pastReads" />
    <bpmn:sequenceFlow id="f_17" name="other" sourceRef="n_dispatch" targetRef="n_ignored" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_nextRead" targetRef="n_merged" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_pastReads" targetRef="n_merged" />
    <bpmn:sequenceFlow id="f_20" name="any failure: redeliver" sourceRef="n_merged" targetRef="n_q" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_nextRead" targetRef="n_nextComputed" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_nextComputed" targetRef="n_noSubscriber" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_pastReads" targetRef="n_pastComputed" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_pastComputed" targetRef="n_noSubscriber" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_shared_queue">
    <bpmndi:BPMNPlane id="Plane_shared_queue" bpmnElement="Process_shared_queue">
