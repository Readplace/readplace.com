<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_triggers" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_triggers" name="triggers" isExecutable="false">
    <bpmn:sendTask id="n_open" name="GET /queue/:id/view owner reader, web or app shell">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_topicSlot" name="past-reads section hidden load-fired form">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_noscriptForm" name="noscript button emitted only with no rows hidden with the section">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_pollFragment" name="GET /queue/:id/topic-reads poll fragment re-renders the form">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_post" name="POST /queue/:id/topic-reads">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_signedIn" name="session for HTML bearer token for Siren?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_login" name="303 to /login HTML without a session">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_unauthorized" name="401 Siren error missing or invalid bearer">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_owned" name="article found in the default list?">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_reply" name="204 for htmx 303 to the reader otherwise queue param dropped">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:task>
    <bpmn:sendTask id="n_cmdEvt" name="ComputeRelatedPastReads url canonical, userId readlist only when queue names another list">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_saves" name="save surfaces except import shared accept phase">
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="n_created" name="QueueEntryCreated url canonical, userId">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_queue" name="compute-related-articles-q">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_lambda" name="compute-related-articles Lambda">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_dispatch" name="detail-type?">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_nextRead" name="Next-read pass">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_pastReads" name="past-reads pass">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_open" targetRef="n_topicSlot" />
    <bpmn:sequenceFlow id="f_1" name="htmx load" sourceRef="n_topicSlot" targetRef="n_post" />
    <bpmn:sequenceFlow id="f_2" name="no rows" sourceRef="n_topicSlot" targetRef="n_noscriptForm" />
    <bpmn:sequenceFlow id="f_3" name="unreachable" sourceRef="n_noscriptForm" targetRef="n_post" />
    <bpmn:sequenceFlow id="f_4" name="every 3s while pending" sourceRef="n_topicSlot" targetRef="n_pollFragment" />
    <bpmn:sequenceFlow id="f_5" name="swapped-in form fires again" sourceRef="n_pollFragment" targetRef="n_post" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_post" targetRef="n_signedIn" />
    <bpmn:sequenceFlow id="f_7" name="no session" sourceRef="n_signedIn" targetRef="n_login" />
    <bpmn:sequenceFlow id="f_8" name="no token" sourceRef="n_signedIn" targetRef="n_unauthorized" />
    <bpmn:sequenceFlow id="f_9" name="yes" sourceRef="n_signedIn" targetRef="n_owned" />
    <bpmn:sequenceFlow id="f_10" name="no" sourceRef="n_owned" targetRef="n_reply" />
    <bpmn:sequenceFlow id="f_11" name="yes" sourceRef="n_owned" targetRef="n_cmdEvt" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_cmdEvt" targetRef="n_reply" />
    <bpmn:sequenceFlow id="f_13" name="row created by this save" sourceRef="n_saves" targetRef="n_created" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_cmdEvt" targetRef="n_queue" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_created" targetRef="n_queue" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_queue" targetRef="n_lambda" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_lambda" targetRef="n_dispatch" />
    <bpmn:sequenceFlow id="f_18" name="QueueEntryCreated" sourceRef="n_dispatch" targetRef="n_nextRead" />
    <bpmn:sequenceFlow id="f_19" name="QueueEntryCreated" sourceRef="n_dispatch" targetRef="n_pastReads" />
    <bpmn:sequenceFlow id="f_20" name="ComputeRelatedPastReads" sourceRef="n_dispatch" targetRef="n_pastReads" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_triggers">
    <bpmndi:BPMNPlane id="Plane_triggers" bpmnElement="Process_triggers">
      <bpmndi:BPMNShape id="n_open_di" bpmnElement="n_open">
