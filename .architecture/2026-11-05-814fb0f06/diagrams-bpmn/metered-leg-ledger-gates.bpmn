<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_metered_leg_ledger_gates" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_metered_leg_ledger_gates" name="metered-leg-ledger-gates" isExecutable="false">
    <bpmn:serviceTask id="n_SUB" name="Submit handler: markCrawlPending">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_TRIG" name="saveTrigger">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_DEF" name="Set meteredLegsDeferredSince">
      <bpmn:incoming>f_1</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_CLR" name="Remove meteredLegsDeferredSince">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_ROW" name="Article row per-leg ledger and claim attributes"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_RENDER" name="render-crawl handler residential-per-gb, web-unlocker fetch and render">
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_COMP" name="comprehensive-crawl handler">
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_JUDGE" name="select-most-complete-content content judge">
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SUMM" name="generate-summary handler">
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CLAIM" name="claimMeteredLeg refused while deferred; one live claim; same input hash is settled">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_G" name="Claim result">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RUNLEG" name="Run the paid leg">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_SETTLE" name="settleMeteredLeg: record outcome, drop claim">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_REL" name="releaseMeteredLeg: nothing committed, drop claim">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_PARKC" name="Crawl parked markCrawlAwaitingReader, or failed blocked edge-block with block evidence">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PARKS" name="Summary parked markSummarySkipped awaiting-reader">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_RETRY" name="In flight elsewhere: record fails, SQS retries">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_REPLAY" name="Settled: replay the recorded outcome, ack">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_VIEW" name="View claim in section 2 removes the deferral">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SUB" targetRef="n_TRIG" />
    <bpmn:sequenceFlow id="f_1" name="automatic" sourceRef="n_TRIG" targetRef="n_DEF" />
    <bpmn:sequenceFlow id="f_2" name="manual" sourceRef="n_TRIG" targetRef="n_CLR" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_RENDER" targetRef="n_CLAIM" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_COMP" targetRef="n_CLAIM" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_JUDGE" targetRef="n_CLAIM" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_SUMM" targetRef="n_CLAIM" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_CLAIM" targetRef="n_G" />
    <bpmn:sequenceFlow id="f_11" name="granted" sourceRef="n_G" targetRef="n_RUNLEG" />
    <bpmn:sequenceFlow id="f_12" name="committed" sourceRef="n_RUNLEG" targetRef="n_SETTLE" />
    <bpmn:sequenceFlow id="f_13" name="not committed or threw" sourceRef="n_RUNLEG" targetRef="n_REL" />
    <bpmn:sequenceFlow id="f_14" name="deferred: render, comprehensive, judge" sourceRef="n_G" targetRef="n_PARKC" />
    <bpmn:sequenceFlow id="f_15" name="deferred: summary" sourceRef="n_G" targetRef="n_PARKS" />
    <bpmn:sequenceFlow id="f_16" name="in-flight" sourceRef="n_G" targetRef="n_RETRY" />
    <bpmn:sequenceFlow id="f_17" name="settled" sourceRef="n_G" targetRef="n_REPLAY" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_PARKC" targetRef="n_VIEW" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_PARKS" targetRef="n_VIEW" />
    <bpmn:association id="f_3" sourceRef="n_DEF" targetRef="n_ROW" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_CLR" targetRef="n_ROW" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_CLAIM" targetRef="n_ROW" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_VIEW" targetRef="n_ROW" associationDirection="One" />
  </bpmn:process>
