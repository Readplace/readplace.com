<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_view_claims_and_publishes" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_view_claims_and_publishes" name="view-claims-and-publishes" isExecutable="false">
    <bpmn:serviceTask id="n_HTML" name="GET /queue surface readlist-html">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SIREN" name="Siren GET /queue surface readlist-siren">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_READER" name="Reader open /queue/:id/view surface reader">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_GAVEUP" name="Reader poll after device capture gave up surface reader-capture-gave-up">
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_DIGEST" name="Queue digest Lambda surface queue-digest, up to 10 per run">
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_BOT" name="Bot user agent or prefetch?">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="n_SKIP" name="Render rows as loaded publish nothing">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:serviceTask id="n_NEED" name="needsResolutionOnView webmail, not-found, robots, content-too-large: none blocked and viewer can capture: device-first failed or unsupported crawl: crawl-and-summary ready crawl, summary failed or skipped awaiting-reader or ai-unavailable: summary">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CLAIM" name="claimResolutionOnView conditional UpdateItem">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ROW" name="Article row crawl and summary status, meteredLegsDeferredSince"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_WON" name="Claimed?">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_PUB" name="Publish ResolveArticleOnViewCommand a publish error is logged">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_RAV" name="ResolveArticleOnViewCommand">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_LOST" name="Lost the race: read the current crawl and summary">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_OVERLAY" name="overlayResolution card or reader renders pending and polls">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_HTML" targetRef="n_BOT" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_SIREN" targetRef="n_BOT" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_READER" targetRef="n_BOT" />
    <bpmn:sequenceFlow id="f_3" name="yes" sourceRef="n_BOT" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_4" name="no" sourceRef="n_BOT" targetRef="n_NEED" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_GAVEUP" targetRef="n_NEED" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_DIGEST" targetRef="n_NEED" />
    <bpmn:sequenceFlow id="f_7" name="none or device-first" sourceRef="n_NEED" targetRef="n_SKIP" />
    <bpmn:sequenceFlow id="f_8" name="crawl-and-summary or summary" sourceRef="n_NEED" targetRef="n_CLAIM" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_CLAIM" targetRef="n_WON" />
    <bpmn:sequenceFlow id="f_11" name="yes" sourceRef="n_WON" targetRef="n_PUB" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_PUB" targetRef="n_RAV" />
    <bpmn:sequenceFlow id="f_13" name="no" sourceRef="n_WON" targetRef="n_LOST" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_PUB" targetRef="n_OVERLAY" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_LOST" targetRef="n_OVERLAY" />
    <bpmn:association id="f_9" sourceRef="n_CLAIM" targetRef="n_ROW" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_view_claims_and_publishes">
