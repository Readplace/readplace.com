<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_resolve_article_on_view_handler" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_resolve_article_on_view_handler" name="resolve-article-on-view-handler" isExecutable="false">
    <bpmn:sendTask id="n_RAV" name="ResolveArticleOnViewCommand">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_H" name="Resolve-article-on-view handler">
      <bpmn:incoming>f_0</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_LOAD" name="Article aggregate loadArticle"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_PEND" name="Requested axis still pending?">
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_ACK" name="Ack: row moved on or missing">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_AX" name="axes">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_MSP" name="markSummaryPending">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_GS" name="generate-summary effect generate-summary queue">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_RUN" name="runCrawlFromTier1 same free tier-1 crawl as a submit, recrawl false">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_TCE" name="TierContentExtractedEvent">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_SCU" name="SimpleCrawlUnsupportedEvent deferred to render or comprehensive">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_CLS" name="ClassifiedCrawlError: markCrawlExhausted in-process, ack">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_ERR" name="Any other error: record fails, SQS retries, then DLQ">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_SEL" name="select-most-complete-content">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PAID" name="render-crawl / comprehensive-crawl">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_RAV" targetRef="n_H" />
    <bpmn:sequenceFlow id="f_3" name="no" sourceRef="n_PEND" targetRef="n_ACK" />
    <bpmn:sequenceFlow id="f_4" name="yes" sourceRef="n_PEND" targetRef="n_AX" />
    <bpmn:sequenceFlow id="f_5" name="summary" sourceRef="n_AX" targetRef="n_MSP" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_MSP" targetRef="n_GS" />
    <bpmn:sequenceFlow id="f_7" name="crawl-and-summary" sourceRef="n_AX" targetRef="n_RUN" />
    <bpmn:sequenceFlow id="f_8" name="tier-1 source written" sourceRef="n_RUN" targetRef="n_TCE" />
    <bpmn:sequenceFlow id="f_9" name="deferred" sourceRef="n_RUN" targetRef="n_SCU" />
    <bpmn:sequenceFlow id="f_10" name="terminal or crawl failure" sourceRef="n_RUN" targetRef="n_CLS" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_RUN" targetRef="n_ERR" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_TCE" targetRef="n_SEL" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_SCU" targetRef="n_PAID" />
    <bpmn:association id="f_1" sourceRef="n_H" targetRef="n_LOAD" associationDirection="One" />
    <bpmn:association id="f_2" sourceRef="n_LOAD" targetRef="n_PEND" associationDirection="One" />
  </bpmn:process>
