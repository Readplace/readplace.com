        <di:waypoint x="555.01" y="229.13" />
        <di:waypoint x="555.01" y="268.25" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_6_di" bpmnElement="f_6">
        <di:waypoint x="339.31" y="602.5" />
        <di:waypoint x="339.31" y="654.25" />
        <di:waypoint x="226.19" y="654.25" />
        <di:waypoint x="226.19" y="706" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_7_di" bpmnElement="f_7">
