<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:task id="n_click_button" name="User clicks 'Email Me My Data' on /export">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_post_start" name="POST /export/start (web Lambda)">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_find_email" name="findEmailByUserId (users table, userId-index GSI)"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_cmd" name="ExportUserDataCommand {userId, email, requestedAt}">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_redirect" name="303 -&gt; /export?status=preparing">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_rule" name="EventBridge rule: source=hutch.api, detailType=ExportUserDataCommand"></bpmn:dataStoreReference>
    <bpmn:intermediateCatchEvent id="n_queue" name="export-user-data SQS queue (visibilityTimeout=900s)">
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_dlq" name="export-user-data DLQ + CloudWatch alarm + SNS email">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_worker" name="export-user-data Lambda (900s, 1024MB)">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_query" name="DynamoDB Query userArticles + articles (paginated, pageSize=500)"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_s3_put" name="S3 PutObject hutch-user-exports-{stage} key=exports/{userId}/{timestamp}.json"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_presign" name="getSignedUrl(GetObject) expiresIn = 7 days"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_resend" name="Resend email 'Your Readplace export is ready' (button -&gt; presigned URL)"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_exported" name="UserDataExportedEvent {userId, articleCount, s3Key, exportedAt}">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_lifecycle" name="S3 lifecycle rule prefix=exports/ expire after 7 days"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_click_button" targetRef="n_post_start" />
    <bpmn:sequenceFlow id="f_2" name="publishEvent" sourceRef="n_post_start" targetRef="n_cmd" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_post_start" targetRef="n_redirect" />
    <bpmn:sequenceFlow id="f_6" name="maxReceiveCount exhausted" sourceRef="n_queue" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_queue" targetRef="n_worker" />
    <bpmn:sequenceFlow id="f_13" name="publishEvent" sourceRef="n_worker" targetRef="n_exported" />
    <bpmn:association id="f_1" sourceRef="n_post_start" targetRef="n_find_email" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_cmd" targetRef="n_rule" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_rule" targetRef="n_queue" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_worker" targetRef="n_query" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_query" targetRef="n_worker" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_worker" targetRef="n_s3_put" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_s3_put" targetRef="n_presign" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_presign" targetRef="n_resend" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_s3_put" targetRef="n_lifecycle" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_end_to_end_flow">
    <bpmndi:BPMNPlane id="Plane_end_to_end_flow" bpmnElement="Process_end_to_end_flow">
      <bpmndi:BPMNShape id="n_click_button_di" bpmnElement="n_click_button">
        <dc:Bounds x="246.44" y="28" width="185.75" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_post_start_di" bpmnElement="n_post_start">
        <dc:Bounds x="243.32" y="138" width="192" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_find_email_di" bpmnElement="n_find_email">
        <dc:Bounds x="28" y="248" width="171.38" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_cmd_di" bpmnElement="n_cmd">
