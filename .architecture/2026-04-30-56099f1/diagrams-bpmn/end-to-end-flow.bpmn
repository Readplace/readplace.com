      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_redirect_di" bpmnElement="n_redirect">
        <dc:Bounds x="459.38" y="268.25" width="191.25" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_rule_di" bpmnElement="n_rule">
        <dc:Bounds x="244.32" y="398.5" width="190" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_queue_di" bpmnElement="n_queue">
        <dc:Bounds x="319.31" y="562.5" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_dlq_di" bpmnElement="n_dlq">
        <dc:Bounds x="206.19" y="706" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_worker_di" bpmnElement="n_worker">
        <dc:Bounds x="335.45" y="722.75" width="190.25" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_query_di" bpmnElement="n_query">
        <dc:Bounds x="55.2" y="856.25" width="171.6" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_s3_put_di" bpmnElement="n_s3_put">
        <dc:Bounds x="262.79" y="849.5" width="190" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_presign_di" bpmnElement="n_presign">
        <dc:Bounds x="175.13" y="1020.25" width="161.7" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_resend_di" bpmnElement="n_resend">
        <dc:Bounds x="254.18" y="1164" width="170.28" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_exported_di" bpmnElement="n_exported">
        <dc:Bounds x="536.11" y="859.75" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_lifecycle_di" bpmnElement="n_lifecycle">
        <dc:Bounds x="372.83" y="1013.5" width="130.68" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="339.32" y="80" />
        <di:waypoint x="339.32" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_2_di" bpmnElement="f_2">
        <di:waypoint x="339.32" y="190" />
        <di:waypoint x="339.32" y="225.13" />
        <di:waypoint x="329.38" y="225.13" />
        <di:waypoint x="329.38" y="260.25" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_3_di" bpmnElement="f_3">
