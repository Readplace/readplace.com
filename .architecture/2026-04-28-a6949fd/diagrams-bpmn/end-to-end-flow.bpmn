<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:businessRuleTask id="n_PostQ" name="POST /queue auth, refreshArticleIfStale">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_PostHtml" name="POST /queue/save-html extension Tier 0 ingest + parallel Tier 1 fan-out">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_GetView" name="GET /view/&lt;url&gt; anonymous, first-visit / legacy-stub heal">
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_GetRecrawl" name="GET /admin/recrawl/&lt;url&gt; forceMarkCrawlPending">
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_SLC" name="SaveLinkCommand url, userId">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SLRH" name="SaveLinkRawHtmlCommand url, userId, title?">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SAL" name="SaveAnonymousLinkCommand url">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Bus" name="EventBridge default-bus">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:incoming>f_34</bpmn:incoming>
      <bpmn:incoming>f_35</bpmn:incoming>
      <bpmn:incoming>f_36</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:outgoing>f_37</bpmn:outgoing>
      <bpmn:outgoing>f_38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_QSL" name="save-link-command vis 60s">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_QSLR" name="save-link-raw-html-command vis 60s">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_QSAL" name="save-anonymous-link-command vis 60s">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_W1" name="save-link-command Lambda HTTP crawl + Readability">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_W0" name="save-link-raw-html-command Lambda read pending HTML + Readability">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_WA" name="save-anonymous-link-command Lambda HTTP crawl + Readability">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3Tier0" name="S3 articles/&lt;id&gt;/sources/tier-0.html + tier-0.metadata.json"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_S3Tier1" name="S3 articles/&lt;id&gt;/sources/tier-1.html + tier-1.metadata.json"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Articles" name="DynamoDB articles crawlStatus=ready, contentSourceTier?"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_TCE" name="TierContentExtractedEvent url, tier, userId?">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_QSel" name="select-most-complete-content vis 90s">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Sel" name="select-most-complete-content Lambda event handler list sources, run Deepseek, promote">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
      <bpmn:outgoing>f_31</bpmn:outgoing>
      <bpmn:outgoing>f_32</bpmn:outgoing>
      <bpmn:outgoing>f_33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_DS" name="Deepseek chat JSON-mode selector variadic candidates">
      <bpmn:incoming>f_28</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3Canon" name="S3 content/&lt;id&gt;/content.html canonical"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_LS" name="LinkSavedEvent url, userId">
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:outgoing>f_34</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_ALS" name="AnonymousLinkSavedEvent url">
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:outgoing>f_35</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_CAC" name="CrawlArticleCompletedEvent url">
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:outgoing>f_36</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_QLS" name="link-saved queue">
      <bpmn:incoming>f_37</bpmn:incoming>
      <bpmn:outgoing>f_39</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_QALS" name="anonymous-link-saved queue">
      <bpmn:incoming>f_38</bpmn:incoming>
      <bpmn:outgoing>f_40</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_HLS" name="link-saved Lambda">
      <bpmn:incoming>f_39</bpmn:incoming>
      <bpmn:outgoing>f_41</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_HALS" name="anonymous-link-saved Lambda">
      <bpmn:incoming>f_40</bpmn:incoming>
      <bpmn:outgoing>f_42</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_GSC" name="GenerateSummaryCommand direct SQS dispatch">
      <bpmn:incoming>f_41</bpmn:incoming>
      <bpmn:incoming>f_42</bpmn:incoming>
      <bpmn:outgoing>f_43</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_QGS" name="generate-summary queue see 52017f3 snapshot">
      <bpmn:incoming>f_43</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f_0" name="publishLinkSaved" sourceRef="n_PostQ" targetRef="n_SLC" />
