<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_selector_internals" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_selector_internals" name="selector-internals" isExecutable="false">
    <bpmn:intermediateThrowEvent id="n_Msg" name="SQS message TierContentExtractedEvent detail url, tier, userId?">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_Q" name="select-most-complete-content vis 90s, maxReceive 3">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_List" name="listAvailableTierSources read S3 sources/&lt;tier&gt;.html + sidecar for each known tier">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3Sources" name="S3 articles/&lt;id&gt;/sources/ tier-0.html, tier-0.metadata.json, tier-1.html, tier-1.metadata.json"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_Count" name="how many sources?">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_NoOp" name="log + skip race window: sidecar not yet readable">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_Single" name="winner = the one tier present reason = only available tier">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_Selector" name="selectMostCompleteContent variadic candidates">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_DS" name="Deepseek chat JSON-mode">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_Decision" name="winner">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_TieEvent" name="publish CrawlArticleCompletedEvent only canonical untouched, no LinkSaved">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_Resolve" name="winnerSource = sources find by tier">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Find" name="findContentSourceTier read Dynamo column">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Articles" name="DynamoDB articles contentSourceTier?"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Promote" name="promoteTierToCanonical S3 CopyObject sources/&lt;winner&gt;.html → content.html Dynamo SET title, siteName, excerpt, wordCount, estimatedReadTime, imageUrl?, contentLocation, contentSourceTier=&lt;winner&gt;, contentFetchedAt">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3Canon" name="S3 content/&lt;id&gt;/content.html canonical bytes"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_Changed" name="currentTier !== winner?">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_CAC" name="publish CrawlArticleCompletedEvent always after successful promote">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_Branch" name="detail.userId present?">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_LS" name="publish LinkSavedEvent url, userId">
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="n_ALS" name="publish AnonymousLinkSavedEvent url">
      <bpmn:incoming>f_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Q" targetRef="n_Msg" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Msg" targetRef="n_List" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_List" targetRef="n_Count" />
    <bpmn:sequenceFlow id="f_4" name="0" sourceRef="n_Count" targetRef="n_NoOp" />
    <bpmn:sequenceFlow id="f_5" name="1" sourceRef="n_Count" targetRef="n_Single" />
    <bpmn:sequenceFlow id="f_6" name="&gt;=2" sourceRef="n_Count" targetRef="n_Selector" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Selector" targetRef="n_DS" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_Selector" targetRef="n_Decision" />
    <bpmn:sequenceFlow id="f_9" name="tie" sourceRef="n_Decision" targetRef="n_TieEvent" />
    <bpmn:sequenceFlow id="f_10" name="tier-0 / tier-1" sourceRef="n_Decision" targetRef="n_Resolve" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_Single" targetRef="n_Resolve" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Resolve" targetRef="n_Find" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_Find" targetRef="n_Promote" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_Promote" targetRef="n_Changed" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_Changed" targetRef="n_CAC" />
    <bpmn:sequenceFlow id="f_19" name="yes, also publish" sourceRef="n_Changed" targetRef="n_Branch" />
    <bpmn:sequenceFlow id="f_20" name="yes" sourceRef="n_Branch" targetRef="n_LS" />
    <bpmn:sequenceFlow id="f_21" name="no" sourceRef="n_Branch" targetRef="n_ALS" />
    <bpmn:association id="f_2" sourceRef="n_List" targetRef="n_S3Sources" associationDirection="Both" />
    <bpmn:association id="f_13" sourceRef="n_Find" targetRef="n_Articles" associationDirection="Both" />
    <bpmn:association id="f_15" sourceRef="n_Promote" targetRef="n_S3Canon" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_Promote" targetRef="n_Articles" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_selector_internals">
