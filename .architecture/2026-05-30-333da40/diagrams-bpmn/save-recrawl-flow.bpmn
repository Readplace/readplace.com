<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_save_recrawl_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_save_recrawl_flow" name="save-recrawl-flow" isExecutable="false">
    <bpmn:sendTask id="n_SaveCmd" name="SaveAnonymousLinkCommand">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_SaveQueue" name="save-anonymous-link SQS">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_SaveLambda" name="save-anonymous-link Lambda (initSaveLinkWork)">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CrawlLib" name="crawl-article library + computes bodyHash :::new">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SaveLambdaWrite" name="putTierSource (tier-1 HTML) + updateFetchTimestamp + bodyHash :::new">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_SCUE_Save" name="SimpleCrawlUnsupportedEvent (no previousBodyHash on save)">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:dataStoreReference id="n_ArticleTable" name="articles table + bodyHash :::new"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_TierEvent" name="TierContentExtractedEvent">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_Policy" name="simple-crawl-unsupported-policy">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_CompCmd" name="ComprehensiveCrawlCommand (no previousBodyHash on save)">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_CompLambda" name="comprehensive-crawl Lambda (initCrawlArticle re-fetches PDF + computes bodyHash :::new)">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Selector" name="select-most-complete-content Lambda (promoteTier transition; spread preserves bodyHash from row)">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SaveCmd" targetRef="n_SaveQueue" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_SaveQueue" targetRef="n_SaveLambda" />
    <bpmn:sequenceFlow id="f_2" name="crawlAndFinalizeArticle (no previousBodyHash)" sourceRef="n_SaveLambda" targetRef="n_CrawlLib" />
    <bpmn:sequenceFlow id="f_3" name="fetched (HTML)" sourceRef="n_CrawlLib" targetRef="n_SaveLambdaWrite" />
    <bpmn:sequenceFlow id="f_4" name="unsupported (PDF)" sourceRef="n_CrawlLib" targetRef="n_SCUE_Save" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_SaveLambdaWrite" targetRef="n_TierEvent" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_SCUE_Save" targetRef="n_Policy" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_Policy" targetRef="n_CompCmd" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_CompCmd" targetRef="n_CompLambda" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_CompLambda" targetRef="n_TierEvent" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_TierEvent" targetRef="n_Selector" />
    <bpmn:association id="f_5" sourceRef="n_SaveLambdaWrite" targetRef="n_ArticleTable" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_CompLambda" targetRef="n_ArticleTable" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_Selector" targetRef="n_ArticleTable" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_save_recrawl_flow">
    <bpmndi:BPMNPlane id="Plane_save_recrawl_flow" bpmnElement="Process_save_recrawl_flow">
      <bpmndi:BPMNShape id="n_SaveCmd_di" bpmnElement="n_SaveCmd">
        <dc:Bounds x="111.19" y="28" width="203.75" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SaveQueue_di" bpmnElement="n_SaveQueue">
        <dc:Bounds x="193.06" y="138" width="40" height="40" />
