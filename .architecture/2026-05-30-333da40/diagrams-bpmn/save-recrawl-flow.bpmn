      <bpmndi:BPMNShape id="n_ArticleTable_di" bpmnElement="n_ArticleTable">
        <dc:Bounds x="153.11" y="1361.5" width="119.9" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_TierEvent_di" bpmnElement="n_TierEvent">
        <dc:Bounds x="193.06" y="1073.5" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Policy_di" bpmnElement="n_Policy">
        <dc:Bounds x="112.19" y="647.5" width="201.75" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_CompCmd_di" bpmnElement="n_CompCmd">
        <dc:Bounds x="111.06" y="757.5" width="204" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_CompLambda_di" bpmnElement="n_CompLambda">
        <dc:Bounds x="131.81" y="899.5" width="162.5" height="116" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Selector_di" bpmnElement="n_Selector">
        <dc:Bounds x="114.31" y="1203.5" width="197.5" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="213.06" y="80" />
        <di:waypoint x="213.06" y="138" />
      </bpmndi:BPMNEdge>
