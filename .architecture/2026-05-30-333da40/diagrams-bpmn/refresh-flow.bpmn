<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_refresh_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_refresh_flow" name="refresh-flow" isExecutable="false">
    <bpmn:sendTask id="n_WebSlash" name="/queue/&lt;id&gt;/freshness or scheduler">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="n_StaleEvent" name="StaleCheckRequestedEvent">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_StaleQueue" name="stale-check SQS">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_StaleCheck" name="stale-check Lambda (initStaleCheckHandler)">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ArticleTable" name="articles table etag, lastModified, contentFetchedAt, bodyHash :::new"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_CrawlLib" name="crawl-article library conditional GET + SHA-256 of body :::new + gate vs previousBodyHash :::new">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_UFTCmd" name="UpdateFetchTimestampCommand + bodyHash :::new">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:businessRuleTask id="n_RefreshHtmlPath" name="publishRefreshArticleContent (stages HTML in S3)">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateThrowEvent id="n_UnsupportedEvent" name="SimpleCrawlUnsupportedEvent { refresh: true, previousBodyHash :::new }">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="n_SkipDone" name="skip">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_UFTQueue" name="update-fetch-timestamp SQS">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_UFTLambda" name="update-fetch-timestamp Lambda">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_RACmd" name="RefreshArticleContentCommand + bodyHash :::new">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_RAQueue" name="refresh-article-content SQS">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_RALambda" name="refresh-article-content Lambda">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_RCEvent" name="RefreshContentExtractedEvent + bodyHash :::new">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_SCUQueue" name="simple-crawl-unsupported-policy SQS">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="n_Policy" name="simple-crawl-unsupported-policy Lambda">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_CompCmd" name="ComprehensiveCrawlCommand + previousBodyHash :::new">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_CompQueue" name="comprehensive-crawl SQS">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_CompLambda" name="comprehensive-crawl Lambda re-fetches via crawl-article + byte-gate :::new">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_UFTLambdaCall" name="updateFetchTimestamp (in-process call + bodyHash :::new)">
      <bpmn:incoming>f_21</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_RCEventPdf" name="RefreshContentExtractedEvent + bodyHash :::new">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_RCEQueue" name="refresh-content-extracted SQS">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_RCELambda" name="refresh-content-extracted Lambda runs selector + refreshContent transition">
      <bpmn:incoming>f_26</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_WebSlash" targetRef="n_StaleEvent" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_StaleEvent" targetRef="n_StaleQueue" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_StaleQueue" targetRef="n_StaleCheck" />
    <bpmn:sequenceFlow id="f_4" name="crawlAndFinalizeArticle { etag, lastModified, previousBodyHash :::new }" sourceRef="n_StaleCheck" targetRef="n_CrawlLib" />
    <bpmn:sequenceFlow id="f_5" name="not-modified (304 OR byte-gate hit) :::new" sourceRef="n_CrawlLib" targetRef="n_UFTCmd" />
    <bpmn:sequenceFlow id="f_6" name="fetched (HTML)" sourceRef="n_CrawlLib" targetRef="n_RefreshHtmlPath" />
    <bpmn:sequenceFlow id="f_7" name="unsupported (PDF body)" sourceRef="n_CrawlLib" targetRef="n_UnsupportedEvent" />
    <bpmn:sequenceFlow id="f_8" name="failed" sourceRef="n_CrawlLib" targetRef="n_SkipDone" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_UFTCmd" targetRef="n_UFTQueue" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_UFTQueue" targetRef="n_UFTLambda" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_RefreshHtmlPath" targetRef="n_RACmd" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_RACmd" targetRef="n_RAQueue" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_RAQueue" targetRef="n_RALambda" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_RALambda" targetRef="n_RCEvent" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_UnsupportedEvent" targetRef="n_SCUQueue" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_SCUQueue" targetRef="n_Policy" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_Policy" targetRef="n_CompCmd" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_CompCmd" targetRef="n_CompQueue" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_CompQueue" targetRef="n_CompLambda" />
    <bpmn:sequenceFlow id="f_21" name="not-modified (byte-gate hit) :::new" sourceRef="n_CompLambda" targetRef="n_UFTLambdaCall" />
    <bpmn:sequenceFlow id="f_23" name="fetched (PDF parsed)" sourceRef="n_CompLambda" targetRef="n_RCEventPdf" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_RCEvent" targetRef="n_RCEQueue" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_RCEventPdf" targetRef="n_RCEQueue" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_RCEQueue" targetRef="n_RCELambda" />
    <bpmn:association id="f_3" sourceRef="n_StaleCheck" targetRef="n_ArticleTable" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_UFTLambda" targetRef="n_ArticleTable" associationDirection="One" />
    <bpmn:association id="f_22" sourceRef="n_UFTLambdaCall" targetRef="n_ArticleTable" associationDirection="One" />
    <bpmn:association id="f_27" sourceRef="n_RCELambda" targetRef="n_ArticleTable" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_refresh_flow">
