<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_selection" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_selection" name="selection" isExecutable="false">
    <bpmn:startEvent id="n_EV" name="Tier, Recrawl or RefreshContentExtractedEvent">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_SQ" name="selection queues shared DLQ">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_SEL" name="select-most-complete-content and its recrawl and refresh siblings, rules unchanged">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_MAN" name="tier-1 manifest kind live, renderedThrough"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_JUDGE" name="content judge and the existing rules">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PROMO" name="promoteTier canonical written, crawl ready">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_NR" name="nothing readable: which reason?">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_CAP" name="capture-unreadable a tapped capture of this save">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="n_STAT" name="not-found or blocked from the live candidate's status">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="n_LIVEF" name="the live attempt's failure reason">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_AFTER" name="parse-error no readable article candidate after render (leg)">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_PE" name="parse-error no readable article candidate">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_ART" name="articles table"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_CAC" name="CrawlArticleCompletedEvent">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_EV" targetRef="n_SQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_SQ" targetRef="n_SEL" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SEL" targetRef="n_JUDGE" />
    <bpmn:sequenceFlow id="f_4" name="winner" sourceRef="n_JUDGE" targetRef="n_PROMO" />
    <bpmn:sequenceFlow id="f_5" name="none" sourceRef="n_JUDGE" targetRef="n_NR" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_NR" targetRef="n_CAP" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_NR" targetRef="n_STAT" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_NR" targetRef="n_LIVEF" />
    <bpmn:sequenceFlow id="f_9" name="live candidate rendered" sourceRef="n_NR" targetRef="n_AFTER" />
    <bpmn:sequenceFlow id="f_10" name="otherwise" sourceRef="n_NR" targetRef="n_PE" />
    <bpmn:association id="f_2" sourceRef="n_SEL" targetRef="n_MAN" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_PROMO" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_AFTER" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_PE" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_ART" targetRef="n_CAC" associationDirection="One" />
  </bpmn:process>
