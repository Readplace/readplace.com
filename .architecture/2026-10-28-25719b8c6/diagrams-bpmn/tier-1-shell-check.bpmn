<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_tier_1_shell_check" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_tier_1_shell_check" name="tier-1-shell-check" isExecutable="false">
    <bpmn:sendTask id="n_SLC" name="SaveLinkCommand">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SAC" name="SaveAnonymousLinkCommand">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_RLI" name="RecrawlLinkInitiatedEvent">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SUB" name="SubmitLinkCommand">
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SCR" name="StaleCheckRequestedEvent">
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_WORK" name="tier-1 crawl workers save-link, save-anonymous-link, recrawl-link-initiated, submit-link, stale-check">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_DEC" name="deferJavascriptShells decorator save-link crawl-and-finalize bundle only">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_BYPASS" name="archive or wrapper fetch?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_LADDER" name="crawler ladder, unchanged direct: 2 personas x primary, h2, curl-impersonate, one 429 retry proxied pass: only on block class, 429, WAF, Fastly, timeout">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_FIN" name="finalize: readability parse, media, word count evaluation HTML forced on">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_RES" name="crawl result">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_SITE" name="final URL present? none: a site rule produced the body">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_SHELL" name="2xx HTML, under 25 words, no img, video, audio or iframe, an executable script?">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_JSR" name="unsupported kind javascript-required">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_PASS" name="fetched, as before unrequested HTML and status stripped">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_OTHER" name="blocked, not-found, failed, terminal unsupported unchanged terminals">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_DEFER" name="unsupported, deferrable: non-html-content, paywall, javascript-required">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_STAGE" name="markCrawlStage comprehensive-fetching">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ART" name="articles table"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_CAND" name="tier-1 live candidate to selection">
      <bpmn:incoming>f_19</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_RESULT" name="work result deferred with its reason was the string tier-1-deferred">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_SCU" name="SimpleCrawlUnsupportedEvent url, saveAttemptId, userId, recrawl or refresh, previousBodyHash, candidates, unsupportedReason">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SLC" targetRef="n_WORK" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_SAC" targetRef="n_WORK" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_RLI" targetRef="n_WORK" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SUB" targetRef="n_WORK" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_SCR" targetRef="n_WORK" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_WORK" targetRef="n_DEC" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_DEC" targetRef="n_BYPASS" />
    <bpmn:sequenceFlow id="f_7" name="yes: pass straight through" sourceRef="n_BYPASS" targetRef="n_LADDER" />
    <bpmn:sequenceFlow id="f_8" name="no" sourceRef="n_BYPASS" targetRef="n_LADDER" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_LADDER" targetRef="n_FIN" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_FIN" targetRef="n_RES" />
    <bpmn:sequenceFlow id="f_11" name="fetched, not archive or wrapper" sourceRef="n_RES" targetRef="n_SITE" />
    <bpmn:sequenceFlow id="f_12" name="fetched, archive or wrapper" sourceRef="n_RES" targetRef="n_PASS" />
    <bpmn:sequenceFlow id="f_13" name="yes, a direct or redirected fetch" sourceRef="n_SITE" targetRef="n_SHELL" />
    <bpmn:sequenceFlow id="f_14" name="no" sourceRef="n_SITE" targetRef="n_PASS" />
    <bpmn:sequenceFlow id="f_15" name="other" sourceRef="n_RES" targetRef="n_OTHER" />
    <bpmn:sequenceFlow id="f_16" name="unsupported, deferrable" sourceRef="n_RES" targetRef="n_DEFER" />
    <bpmn:sequenceFlow id="f_17" name="yes" sourceRef="n_SHELL" targetRef="n_JSR" />
    <bpmn:sequenceFlow id="f_18" name="no" sourceRef="n_SHELL" targetRef="n_PASS" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_PASS" targetRef="n_CAND" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_JSR" targetRef="n_DEFER" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_DEFER" targetRef="n_STAGE" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_STAGE" targetRef="n_RESULT" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_RESULT" targetRef="n_SCU" />
    <bpmn:association id="f_22" sourceRef="n_STAGE" targetRef="n_ART" associationDirection="One" />
  </bpmn:process>
