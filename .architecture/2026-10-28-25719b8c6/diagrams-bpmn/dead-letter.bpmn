<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_dead_letter" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_dead_letter" name="dead-letter" isExecutable="false">
    <bpmn:intermediateCatchEvent id="n_RQ" name="render-crawl-command queue">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_CQ" name="comprehensive-crawl-command queue">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_FDLQ" name="save-link-failures shared DLQ arrival alarm emails the operator">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_ROUTER" name="save-link-failures-dlq Lambda routes by source queue">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_RDH" name="render dead-letter handler parses RenderCrawlCommand">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_CDH" name="comprehensive dead-letter handler">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_MCE" name="markCrawlExhausted reason exhausted-retries">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_BAD" name="batch item failure detail does not parse">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_ART" name="articles table"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_CAF" name="CrawlArticleFailedEvent">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="first failed receive" sourceRef="n_RQ" targetRef="n_FDLQ" />
    <bpmn:sequenceFlow id="f_1" name="first failed receive" sourceRef="n_CQ" targetRef="n_FDLQ" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_FDLQ" targetRef="n_ROUTER" />
    <bpmn:sequenceFlow id="f_3" name="render-crawl-command-q" sourceRef="n_ROUTER" targetRef="n_RDH" />
    <bpmn:sequenceFlow id="f_4" name="comprehensive-crawl-command-q" sourceRef="n_ROUTER" targetRef="n_CDH" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_RDH" targetRef="n_MCE" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_CDH" targetRef="n_MCE" />
    <bpmn:sequenceFlow id="f_7" name="no parse" sourceRef="n_RDH" targetRef="n_BAD" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_MCE" targetRef="n_CAF" />
    <bpmn:association id="f_8" sourceRef="n_MCE" targetRef="n_ART" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_dead_letter">
