<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_deferral_policy" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_deferral_policy" name="deferral-policy" isExecutable="false">
    <bpmn:startEvent id="n_SCU" name="SimpleCrawlUnsupportedEvent with unsupportedReason">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_BUS" name="hutch event bus">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_PQ" name="simple-crawl-unsupported-policy queue shared DLQ">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_POL" name="simple-crawl-unsupported-policy Lambda">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_ROUTE" name="unsupportedReason">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="n_CCC" name="ComprehensiveCrawlCommand deferred-crawl detail schema">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_RCC" name="RenderCrawlCommand same deferred-crawl detail schema">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_LOG" name="log line: dispatched detail type, unsupportedReason">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_CQ" name="comprehensive-crawl-command queue 1800 s visibility, 1 receive">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_RQ" name="render-crawl-command queue 600 s visibility, 1 receive">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_FDLQ" name="save-link-failures shared DLQ">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SCU" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_BUS" targetRef="n_PQ" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_PQ" targetRef="n_POL" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_POL" targetRef="n_ROUTE" />
    <bpmn:sequenceFlow id="f_4" name="non-html-content, paywall, or absent" sourceRef="n_ROUTE" targetRef="n_CCC" />
    <bpmn:sequenceFlow id="f_5" name="javascript-required" sourceRef="n_ROUTE" targetRef="n_RCC" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_CCC" targetRef="n_LOG" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_RCC" targetRef="n_LOG" />
    <bpmn:sequenceFlow id="f_8" name="rule on detail type" sourceRef="n_CCC" targetRef="n_CQ" />
    <bpmn:sequenceFlow id="f_9" name="new rule on detail type" sourceRef="n_RCC" targetRef="n_RQ" />
    <bpmn:sequenceFlow id="f_10" name="after its receives" sourceRef="n_PQ" targetRef="n_FDLQ" />
    <bpmn:sequenceFlow id="f_11" name="first failed receive" sourceRef="n_CQ" targetRef="n_FDLQ" />
    <bpmn:sequenceFlow id="f_12" name="first failed receive" sourceRef="n_RQ" targetRef="n_FDLQ" />
  </bpmn:process>
