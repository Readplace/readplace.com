<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_comprehensive_crawl" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_comprehensive_crawl" name="comprehensive-crawl" isExecutable="false">
    <bpmn:intermediateCatchEvent id="n_CQ" name="comprehensive-crawl-command queue">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_CL" name="comprehensive-crawl-command Lambda container image, 3008 MB, 900 s">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_BUD" name="paid-crawl budget scope paid-crawl, keys unchanged">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_RL" name="rate-limits table"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_CRAWL" name="crawler with PDF extraction, per-page OCR fan-out">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_RES" name="crawl result">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_COMMIT" name="shared deferred-crawl commit moved out of this handler">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_TERM" name="unsupported, not-found, blocked: terminal transitions">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_THROW" name="failed, or unreadable body: throw, then the shared DLQ">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_ART" name="articles table"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_EV" name="Tier, Recrawl or RefreshContentExtractedEvent">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_CQ" targetRef="n_CL" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_CL" targetRef="n_BUD" />
    <bpmn:sequenceFlow id="f_3" name="allowed" sourceRef="n_BUD" targetRef="n_CRAWL" />
    <bpmn:sequenceFlow id="f_4" name="denied" sourceRef="n_BUD" targetRef="n_COMMIT" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_CRAWL" targetRef="n_RES" />
    <bpmn:sequenceFlow id="f_6" name="fetched" sourceRef="n_RES" targetRef="n_COMMIT" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_RES" targetRef="n_TERM" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_RES" targetRef="n_THROW" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_COMMIT" targetRef="n_EV" />
    <bpmn:association id="f_2" sourceRef="n_BUD" targetRef="n_RL" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_COMMIT" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_TERM" targetRef="n_ART" associationDirection="One" />
  </bpmn:process>
