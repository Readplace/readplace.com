<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_render_crawl_worker" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_render_crawl_worker" name="render-crawl-worker" isExecutable="false">
    <bpmn:sendTask id="n_RCC" name="RenderCrawlCommand">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_RQ" name="render-crawl-command queue 600 s visibility, 1 receive, shared DLQ">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_RL" name="render-crawl-command Lambda container image with sparticuz Chromium, 3008 MB, 1 GiB tmp, 300 s, batch 1">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_40</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ID" name="prepare article identity archive capture first when the URL has one">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_BUD" name="render-crawl budget scope render-crawl, 50 per hour prod">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_RLT" name="rate-limits table"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_DENY" name="budget denied: candidates to selection, or refresh keeps the canonical, or markCrawlBlocked spend-capped">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_33</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_L1" name="leg 1: headless Chromium Lambda egress, networkidle2, 30 s navigation">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_FILT" name="request filter, both legs abort image, media, font, non-http(s), blocked literal host, blocked resolved address">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_GUARD" name="browser bounds, both legs protocol timeout navigation + 10 s, serialise 10 s, close 5 s then kill, dialogs dismissed, popups and service or shared workers closed, block-new-web-contents, web security on">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_C1" name="main document">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_L2" name="leg 2: headless Chromium through the Bright Data residential proxy, 90 s navigation, certificate errors ignored, proxy auth">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="n_BD" name="Bright Data unlocker existing crawl egress proxy secret">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="n_C2" name="main document">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="n_ORIGIN" name="origin site">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="n_SIZE" name="rendered DOM over the crawler's HTML byte cap?">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_BIG" name="markCrawlUnsupported content-too-large leg and bytes logged">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_COMMIT" name="shared deferred-crawl commit tier-1 live candidate, renderedThrough">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_UNREAD" name="no candidates and nothing readable: markCrawlFailed parse-error, after render and the leg, no throw">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_38</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_CANDS" name="capture candidates forwarded: to selection with liveAttempt no-body">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_34</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_BLK" name="markCrawlBlocked cause from the blocked leg's status">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_35</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateThrowEvent id="n_FAIL" name="markCrawlFailed fetch-failed detail render-failed: direct-egress …; residential-proxy … proxied, else direct, HTTP status">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_36</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_BACK" name="refresh only: freshness clock advanced with the previous body hash">
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:incoming>f_34</bpmn:incoming>
      <bpmn:incoming>f_35</bpmn:incoming>
      <bpmn:incoming>f_36</bpmn:incoming>
      <bpmn:incoming>f_37</bpmn:incoming>
      <bpmn:incoming>f_38</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CB" name="content bucket tier-1 source and manifest"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_ART" name="articles table"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_EV" name="Tier, Recrawl or RefreshContentExtractedEvent">
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_THROWN" name="unexpected throw: batch item failure, then the shared DLQ">
      <bpmn:incoming>f_40</bpmn:incoming>
    </bpmn:endEvent>
