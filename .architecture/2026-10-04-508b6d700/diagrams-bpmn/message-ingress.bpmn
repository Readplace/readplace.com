<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_message_ingress" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_message_ingress" name="message-ingress" isExecutable="false">
    <bpmn:startEvent id="n_Mail" name="Gmail forwarded mail or ordinary inbox mail">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_SES" name="SES catch-all receipt">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Raw" name="Existing immutable raw-email S3 bucket"></bpmn:dataStoreReference>
    <bpmn:intermediateCatchEvent id="n_SNS" name="SNS notification topic">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_ReceiveQ" name="Existing inbox-receive-email SQS queue">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Receive" name="Receive Lambda resolve live recipients, byte cap, MIME parse">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_Invalid" name="Deliverable and parseable?">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_Audit" name="Audit row where applicable; acknowledge">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_AuditError" name="Audit row then retry and alarm">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_ReceiveDLQ" name="Existing receive DLQ">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="n_Confirmation" name="Gmail confirmation mail?">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_Confirm" name="Existing confirmation worker confirm forwarding and reconcile rule">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_Kind" name="Address purpose?">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_Ordinary" name="Required routing kind inbox">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_Accepted" name="Look up accepted Gmail row same email key and raw object">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_Resume" name="Republish original accepted snapshot before current routing gates">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_Route" name="Record sighting; resolve nonempty sender destinations">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Mapping" name="Existing Gmail sender table"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Held" name="Existing held-mail table no image fetch or event"></bpmn:dataStoreReference>
    <bpmn:task id="n_Snapshot" name="Required routing kind gmail complete destinationAddresses snapshot">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_Identity" name="Conditional message identity claim adopt old received row or retry incomplete attempt">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:incoming>f_34</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_Duplicate" name="Acknowledge without reprocessing">
      <bpmn:incoming>f_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="n_Ingest" name="Download images once, sanitize body conditional email write with destinations">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:outgoing>f_36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Body" name="Existing content S3 and inbox email table"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_Unparsed" name="Store unparsed email; no EmailReceivedEvent">
      <bpmn:incoming>f_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="n_Received" name="EmailReceivedEvent accepted row supplies original snapshot">
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_ExtractQ" name="Existing inbox-extract-email-links queue">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="n_Fetched" name="GmailHistoryImportMessageFetchedEvent">
      <bpmn:outgoing>f_29</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_ImportQ" name="Existing inbox-ingest-gmail-import queue">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:outgoing>f_30</bpmn:outgoing>
      <bpmn:outgoing>f_37</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_ImportRead" name="Load known job, cap and parse raw mail verify sender and message id">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:outgoing>f_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_ImportAccepted" name="Same raw accepted Gmail row?">
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:outgoing>f_32</bpmn:outgoing>
      <bpmn:outgoing>f_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_ImportIngest" name="Validate running generation and destination set every live owned destination">
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:outgoing>f_34</bpmn:outgoing>
      <bpmn:outgoing>f_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_Outcome" name="GmailHistoryImportMessageIngestedEvent">
      <bpmn:incoming>f_35</bpmn:incoming>
      <bpmn:incoming>f_36</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_ImportDLQ" name="Existing inbox failure DLQ publish failed ingestion outcome">
      <bpmn:incoming>f_37</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Mail" targetRef="n_SES" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_SES" targetRef="n_SNS" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SNS" targetRef="n_ReceiveQ" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_ReceiveQ" targetRef="n_Receive" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Receive" targetRef="n_Invalid" />
    <bpmn:sequenceFlow id="f_6" name="unknown, disabled, no recipient" sourceRef="n_Invalid" targetRef="n_Audit" />
    <bpmn:sequenceFlow id="f_7" name="oversize or malformed deliverable" sourceRef="n_Invalid" targetRef="n_AuditError" />
    <bpmn:sequenceFlow id="f_8" name="exhausted" sourceRef="n_AuditError" targetRef="n_ReceiveDLQ" />
    <bpmn:sequenceFlow id="f_9" name="yes" sourceRef="n_Invalid" targetRef="n_Confirmation" />
    <bpmn:sequenceFlow id="f_10" name="yes" sourceRef="n_Confirmation" targetRef="n_Confirm" />
    <bpmn:sequenceFlow id="f_11" name="no" sourceRef="n_Confirmation" targetRef="n_Kind" />
    <bpmn:sequenceFlow id="f_12" name="ordinary" sourceRef="n_Kind" targetRef="n_Ordinary" />
    <bpmn:sequenceFlow id="f_13" name="gateway or legacy Gmail-mapped" sourceRef="n_Kind" targetRef="n_Accepted" />
    <bpmn:sequenceFlow id="f_14" name="matching received row" sourceRef="n_Accepted" targetRef="n_Resume" />
    <bpmn:sequenceFlow id="f_15" name="none" sourceRef="n_Accepted" targetRef="n_Route" />
    <bpmn:sequenceFlow id="f_18" name="mapped or legacy addressed fallback" sourceRef="n_Route" targetRef="n_Snapshot" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_Snapshot" targetRef="n_Identity" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_Ordinary" targetRef="n_Identity" />
    <bpmn:sequenceFlow id="f_21" name="already accepted elsewhere" sourceRef="n_Identity" targetRef="n_Duplicate" />
    <bpmn:sequenceFlow id="f_22" name="proceed, or unclaimable forwarded identity" sourceRef="n_Identity" targetRef="n_Ingest" />
    <bpmn:sequenceFlow id="f_25" name="empty sanitized body" sourceRef="n_Ingest" targetRef="n_Unparsed" />
    <bpmn:sequenceFlow id="f_26" name="stored or same-attempt retry" sourceRef="n_Ingest" targetRef="n_Received" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_Resume" targetRef="n_Received" />
    <bpmn:sequenceFlow id="f_28" name="" sourceRef="n_Received" targetRef="n_ExtractQ" />
    <bpmn:sequenceFlow id="f_29" name="" sourceRef="n_Fetched" targetRef="n_ImportQ" />
    <bpmn:sequenceFlow id="f_30" name="" sourceRef="n_ImportQ" targetRef="n_ImportRead" />
    <bpmn:sequenceFlow id="f_31" name="" sourceRef="n_ImportRead" targetRef="n_ImportAccepted" />
    <bpmn:sequenceFlow id="f_32" name="yes" sourceRef="n_ImportAccepted" targetRef="n_Resume" />
    <bpmn:sequenceFlow id="f_33" name="no" sourceRef="n_ImportAccepted" targetRef="n_ImportIngest" />
    <bpmn:sequenceFlow id="f_34" name="valid" sourceRef="n_ImportIngest" targetRef="n_Identity" />
    <bpmn:sequenceFlow id="f_35" name="cancelled, mismatch, missing id" sourceRef="n_ImportIngest" targetRef="n_Outcome" />
    <bpmn:sequenceFlow id="f_36" name="import attempt" sourceRef="n_Ingest" targetRef="n_Outcome" />
    <bpmn:sequenceFlow id="f_37" name="exhausted" sourceRef="n_ImportQ" targetRef="n_ImportDLQ" />
    <bpmn:association id="f_1" sourceRef="n_SES" targetRef="n_Raw" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_Route" targetRef="n_Mapping" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_Route" targetRef="n_Held" associationDirection="One" />
    <bpmn:association id="f_23" sourceRef="n_Raw" targetRef="n_Ingest" associationDirection="One" />
    <bpmn:association id="f_24" sourceRef="n_Ingest" targetRef="n_Body" associationDirection="One" />
  </bpmn:process>
