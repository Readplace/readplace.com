      <bpmn:outgoing>f_40</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Failed" name="Conditional extraction-failed barrier only if no completed metadata exists">
      <bpmn:incoming>f_40</bpmn:incoming>
    </bpmn:serviceTask>
