  <bpmn:process id="Process_extract_and_save_all" name="extract-and-save-all" isExecutable="false">
    <bpmn:startEvent id="n_Received" name="EmailReceivedEvent">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_Q" name="Existing extraction queue">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_39</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Extract" name="Extract Lambda read received row and raw mail; parse and sanitize">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:outgoing>f_37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Links" name="Extract and cap URLs skip action links; batch normal article triage">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_LinkRows" name="Existing email-links partition conditional ordinal rows"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_Eligible" name="Article candidate and saveable URL?">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_Skip" name="Terminal normal skipped row no save or preview for excluded links">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="n_Access" name="Origin, owner and write access?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="n_Preview" name="CrawlEmailLinkPreviewCommand">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_Hold" name="Existing SendSavesHeldNoticeCommand once per email">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_All" name="SubmitLinkCommand readlist All publish before preview">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_First" name="Existing SendFirstInboxEmailNoticeCommand">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="n_InboxRoute" name="Named inbox has custom route?">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="n_Pending" name="Stored link is pending?">
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_NoPublish" name="Keep existing terminal result">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_PreviewQ" name="Existing preview queue">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Crawl" name="Preview Lambda crawl metadata; update preview outcome only">
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_PreviewDLQ" name="Existing inbox failure DLQ conditional pending-to-failed outcome">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_Custom" name="Snapshot full custom selection with labels including zero eligible and held deliveries">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_Kind" name="Gmail routing snapshot?">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:outgoing>f_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_GmailBarrier" name="Write counts and metadata after preview rows preserve selected labels, eligible count and saves held">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Meta" name="Existing email-links extraction metadata"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_CustomAccess" name="Full write access and custom selections?">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
      <bpmn:outgoing>f_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="n_Fanout" name="EmailLinksTriagedEvent one per Gmail custom list; empty input allowed">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:outgoing>f_30</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_Done" name="Extraction complete or saves held">
      <bpmn:incoming>f_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_FilterQ" name="Existing filter-email-links queue">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="n_OrdinaryAccess" name="Full write access and routed custom links?">
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:outgoing>f_32</bpmn:outgoing>
      <bpmn:outgoing>f_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="n_OrdinaryFanout" name="EmailLinksTriagedEvent ordinary scalar route">
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:outgoing>f_33</bpmn:outgoing>
      <bpmn:outgoing>f_34</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_OrdinaryBarrier" name="Existing counts and scalar metadata write after ordinary filtering publication">
      <bpmn:incoming>f_34</bpmn:incoming>
      <bpmn:incoming>f_35</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_Truncated" name="Link cap exceeded?">
      <bpmn:incoming>f_37</bpmn:incoming>
      <bpmn:outgoing>f_38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_Alert" name="Existing truncation alert queue and alarm">
      <bpmn:incoming>f_38</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_DLQ" name="Existing inbox failure DLQ">
