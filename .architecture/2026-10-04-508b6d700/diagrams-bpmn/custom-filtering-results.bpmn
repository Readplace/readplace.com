<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_custom_filtering_results" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_custom_filtering_results" name="custom-filtering-results" isExecutable="false">
    <bpmn:startEvent id="n_Triaged" name="EmailLinksTriagedEvent one email and one custom readlist">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_Q" name="Existing filter-email-links queue two receives before shared failure DLQ">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Filter" name="Filter Lambda load owned list definition">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_Purpose" name="Current list and purpose?">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="n_Missing" name="Keep all; destination All">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_Keep" name="Keep all; destination custom list">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="n_HasLinks" name="Eligible input links?">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_Model" name="DeepSeek thinking request validate complete ordinal decisions">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_Zero" name="Terminal zero result no model call or save command">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_Verdict" name="Independent kept ordinals and dropped reasons">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_Save" name="SubmitLinkCommand one per kept link, before success fact">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="n_Filtered" name="EmailLinksFilteredEvent">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_DLQ" name="Existing save-link shared failures DLQ">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_FailWorker" name="Existing filter DLQ handler">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_Failed" name="EmailLinksFilterFailedEvent">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_RecordQ" name="Existing inbox-record-email-links-filtered queue two EventBridge rules, union queue policy">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_29</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Recorder" name="Outcome recorder Lambda consistent primary partition Query for extraction barrier">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_Ready" name="Extraction metadata exists?">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="n_Retry" name="Retry out-of-order fact until extraction metadata exists">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="n_Format" name="Gmail selectedReadlists snapshot?">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_Membership" name="Verify result belongs to snapshot conditional first-terminal outcome insertion">
      <bpmn:incoming>f_24</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Outcomes" name="Existing email-links partition reserved row per list; base previews unchanged"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_UI" name="Retained All articles stay visible named per-list results; zero and held states use metadata"></bpmn:serviceTask>
    <bpmn:serviceTask id="n_Scalar" name="Mark rejected link rows; settle scalar decision recount kept and skipped">
      <bpmn:incoming>f_27</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_BaseRows" name="Existing preview rows and email counts"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_RecordDLQ" name="Existing alarmed recorder DLQ">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Triaged" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Q" targetRef="n_Filter" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Filter" targetRef="n_Purpose" />
    <bpmn:sequenceFlow id="f_3" name="missing" sourceRef="n_Purpose" targetRef="n_Missing" />
    <bpmn:sequenceFlow id="f_4" name="no purpose" sourceRef="n_Purpose" targetRef="n_Keep" />
    <bpmn:sequenceFlow id="f_5" name="purpose" sourceRef="n_Purpose" targetRef="n_HasLinks" />
    <bpmn:sequenceFlow id="f_6" name="yes" sourceRef="n_HasLinks" targetRef="n_Model" />
    <bpmn:sequenceFlow id="f_7" name="none" sourceRef="n_HasLinks" targetRef="n_Zero" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_Model" targetRef="n_Verdict" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_Missing" targetRef="n_Verdict" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Keep" targetRef="n_Verdict" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_Verdict" targetRef="n_Save" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Verdict" targetRef="n_Filtered" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Zero" targetRef="n_Filtered" />
    <bpmn:sequenceFlow id="f_14" name="exhausted" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_DLQ" targetRef="n_FailWorker" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_FailWorker" targetRef="n_Failed" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_Filtered" targetRef="n_RecordQ" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_Failed" targetRef="n_RecordQ" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_RecordQ" targetRef="n_Recorder" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_Recorder" targetRef="n_Ready" />
    <bpmn:sequenceFlow id="f_21" name="no" sourceRef="n_Ready" targetRef="n_Retry" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_Retry" targetRef="n_RecordQ" />
    <bpmn:sequenceFlow id="f_23" name="yes" sourceRef="n_Ready" targetRef="n_Format" />
    <bpmn:sequenceFlow id="f_24" name="yes" sourceRef="n_Format" targetRef="n_Membership" />
    <bpmn:sequenceFlow id="f_27" name="historical scalar or ordinary inbox" sourceRef="n_Format" targetRef="n_Scalar" />
    <bpmn:sequenceFlow id="f_29" name="exhausted" sourceRef="n_RecordQ" targetRef="n_RecordDLQ" />
    <bpmn:association id="f_25" sourceRef="n_Membership" targetRef="n_Outcomes" associationDirection="One" />
    <bpmn:association id="f_26" sourceRef="n_Outcomes" targetRef="n_UI" associationDirection="One" />
    <bpmn:association id="f_28" sourceRef="n_Scalar" targetRef="n_BaseRows" associationDirection="One" />
  </bpmn:process>
