<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_deletion_and_cleanup" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_deletion_and_cleanup" name="deletion-and-cleanup" isExecutable="false">
    <bpmn:sendTask id="n_Delete" name="Delete owned readlist definition">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Decorate" name="Existing deletion decorator find retiring address and reader's sender partition">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_Affected" name="Sender selection includes retiring address?">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_Remaining" name="Remove only deleted destination retain remaining customs or use All">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Senders" name="Existing Gmail sender rows filter timestamp and monitoring evidence preserved"></bpmn:dataStoreReference>
    <bpmn:task id="n_Cancel" name="Cancel affected unfinished imports destination-changed">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Jobs" name="Existing Gmail history-import table"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_Rewrite" name="RewriteGmailFilterCommand readlist-deleted">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Reconcile" name="Existing filter queue/Lambda Gmail gateway rule reconciliation">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Retire" name="Retire hidden address then delete definition">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_Disconnect" name="POST /gmail/disconnect">
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Requested" name="Mark disconnect requested; cancel all unfinished imports">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_DisconnectCommand" name="DisconnectGmailCommand">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_DisconnectQ" name="Existing rewrite/disconnect handler queue">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Teardown" name="Delete sender mappings; remove rule before revoke disable gateway; remove credentials, connection and discovery">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Monitor" name="Existing monitoring receipts retained reconnect does not resend claimed newsletter notices"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_Account" name="DeleteAccountCommand">
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_AccountQ" name="Existing user-data-jobs queue alarmed DLQ">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Scrub" name="Capture email object references before deleting rows delete raw/body/images and every email-links partition">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_AllRows" name="Existing reader-owned emails, previews and reserved list outcomes saved-link state, import jobs/messages, identities, monitoring"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_ImportRaw" name="Delete gmail-import reader prefix from existing raw bucket"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Addresses" name="Delete readlist-address claims; tombstone addresses">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Tail" name="Existing account scrub purge only last-saver shared content, saved rows, billing and schedules revoke tokens, destroy sessions, close identity; terminal log">
      <bpmn:incoming>f_21</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_AccountDLQ" name="Existing alarmed user-data-jobs DLQ">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Delete" targetRef="n_Decorate" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Decorate" targetRef="n_Affected" />
    <bpmn:sequenceFlow id="f_2" name="yes" sourceRef="n_Affected" targetRef="n_Remaining" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Remaining" targetRef="n_Cancel" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Cancel" targetRef="n_Rewrite" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Rewrite" targetRef="n_Reconcile" />
    <bpmn:sequenceFlow id="f_8" name="none or no Gmail address" sourceRef="n_Affected" targetRef="n_Retire" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_Cancel" targetRef="n_Retire" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Disconnect" targetRef="n_Requested" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_Requested" targetRef="n_DisconnectCommand" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_DisconnectCommand" targetRef="n_DisconnectQ" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_DisconnectQ" targetRef="n_Teardown" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_Account" targetRef="n_AccountQ" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_AccountQ" targetRef="n_Scrub" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_Scrub" targetRef="n_Teardown" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_Teardown" targetRef="n_Addresses" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_Addresses" targetRef="n_Tail" />
    <bpmn:sequenceFlow id="f_22" name="exhausted" sourceRef="n_AccountQ" targetRef="n_AccountDLQ" />
    <bpmn:association id="f_3" sourceRef="n_Remaining" targetRef="n_Senders" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_Cancel" targetRef="n_Jobs" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_Teardown" targetRef="n_Monitor" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_Scrub" targetRef="n_AllRows" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_Scrub" targetRef="n_ImportRaw" associationDirection="One" />
  </bpmn:process>
