<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_history_import_lifecycle" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_history_import_lifecycle" name="history-import-lifecycle" isExecutable="false">
    <bpmn:sendTask id="n_Start" name="POST mapping with import consent or POST /gmail/imports/start">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_37</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_Snapshot" name="Validate owned live destinations snapshot sender, mailbox and destinationAddresses">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Jobs" name="Existing Gmail history-import table scalar primary plus optional additional destinations"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_Consent" name="Read-only scope already granted?">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="n_OAuth" name="Explicit incremental OAuth permission return to import state">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="n_Waiting" name="Await permission or show retryable error">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_Resume" name="Start/retry job with fresh generation preserve window and settled counts">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_Command" name="StartGmailHistoryImportCommand">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_PageQ" name="Existing gmail-history-import queue five receives; recursiveLoop Allow">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:outgoing>f_32</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Worker" name="Import page Lambda check state, generation, page and connection">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:outgoing>f_29</bpmn:outgoing>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_Current" name="Compare full unordered mapping snapshot claim page lease">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_Cancel" name="Cancel unfinished sender jobs">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_38</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_List" name="Read-only Gmail API unread sender mail within 30-day window">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Fetch" name="Fetch raw; omit gone, spam and trash write S3 before fetched record/event">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Raw" name="Existing raw-email bucket gmail-import reader/job/message prefix"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_Fetched" name="GmailHistoryImportMessageFetchedEvent complete accepted destination snapshot">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_IngestQ" name="Existing inbox import-ingestion queue">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Ingest" name="Shared one-message identity and ingestion path">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_Ingested" name="GmailHistoryImportMessageIngestedEvent">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_OutcomeQ" name="Existing gmail-history-import-outcomes queue">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:outgoing>f_33</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Record" name="Transaction: fetched-to-terminal message increment one generation count; check settled job">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:incoming>f_36</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_Complete" name="GmailHistoryImportCompletedEvent reader registry reads stored counts">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="n_Progress" name="GmailHistoryImportPageProcessedEvent">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_Continue" name="Progress reaction sends ProcessGmailHistoryImportPageCommand directly to its own queue">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_Failed" name="GmailHistoryImportFailedEvent">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:incoming>f_35</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_Retry" name="Retry page with generation and lease fences">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:outgoing>f_31</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="n_DLQ" name="Existing shared Gmail history failure DLQ">
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:outgoing>f_34</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_DLQHandler" name="Existing router fail page job or settle outcome as failed">
      <bpmn:incoming>f_34</bpmn:incoming>
      <bpmn:outgoing>f_35</bpmn:outgoing>
      <bpmn:outgoing>f_36</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_CancelUI" name="POST /gmail/imports/cancel">
      <bpmn:incoming>f_37</bpmn:incoming>
      <bpmn:outgoing>f_38</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Start" targetRef="n_Snapshot" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Snapshot" targetRef="n_Consent" />
    <bpmn:sequenceFlow id="f_3" name="no" sourceRef="n_Consent" targetRef="n_OAuth" />
    <bpmn:sequenceFlow id="f_4" name="declined or revoked" sourceRef="n_OAuth" targetRef="n_Waiting" />
    <bpmn:sequenceFlow id="f_5" name="granted" sourceRef="n_OAuth" targetRef="n_Resume" />
    <bpmn:sequenceFlow id="f_6" name="yes" sourceRef="n_Consent" targetRef="n_Resume" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Resume" targetRef="n_Command" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_Command" targetRef="n_PageQ" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_PageQ" targetRef="n_Worker" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Worker" targetRef="n_Current" />
    <bpmn:sequenceFlow id="f_11" name="mismatch, removed, disconnected" sourceRef="n_Current" targetRef="n_Cancel" />
    <bpmn:sequenceFlow id="f_13" name="current" sourceRef="n_Current" targetRef="n_List" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_List" targetRef="n_Fetch" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_Fetch" targetRef="n_Fetched" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_Fetched" targetRef="n_IngestQ" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_IngestQ" targetRef="n_Ingest" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_Ingest" targetRef="n_Ingested" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_Ingested" targetRef="n_OutcomeQ" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_OutcomeQ" targetRef="n_Record" />
    <bpmn:sequenceFlow id="f_24" name="listing done and all settled" sourceRef="n_Record" targetRef="n_Complete" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_Worker" targetRef="n_Progress" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_Progress" targetRef="n_PageQ" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_PageQ" targetRef="n_Continue" />
    <bpmn:sequenceFlow id="f_28" name="" sourceRef="n_Continue" targetRef="n_PageQ" />
    <bpmn:sequenceFlow id="f_29" name="permission or Gmail rejection" sourceRef="n_Worker" targetRef="n_Failed" />
    <bpmn:sequenceFlow id="f_30" name="transient unavailable" sourceRef="n_Worker" targetRef="n_Retry" />
    <bpmn:sequenceFlow id="f_31" name="" sourceRef="n_Retry" targetRef="n_PageQ" />
    <bpmn:sequenceFlow id="f_32" name="exhausted" sourceRef="n_PageQ" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_33" name="exhausted" sourceRef="n_OutcomeQ" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_34" name="" sourceRef="n_DLQ" targetRef="n_DLQHandler" />
    <bpmn:sequenceFlow id="f_35" name="" sourceRef="n_DLQHandler" targetRef="n_Failed" />
    <bpmn:sequenceFlow id="f_36" name="" sourceRef="n_DLQHandler" targetRef="n_Record" />
    <bpmn:sequenceFlow id="f_37" name="" sourceRef="n_Start" targetRef="n_CancelUI" />
    <bpmn:sequenceFlow id="f_38" name="" sourceRef="n_CancelUI" targetRef="n_Cancel" />
    <bpmn:association id="f_1" sourceRef="n_Snapshot" targetRef="n_Jobs" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_Cancel" targetRef="n_Jobs" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_Fetch" targetRef="n_Raw" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_Fetch" targetRef="n_Jobs" associationDirection="One" />
    <bpmn:association id="f_23" sourceRef="n_Record" targetRef="n_Jobs" associationDirection="One" />
  </bpmn:process>
