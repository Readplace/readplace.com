<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_what_this_pr_ships_transitions_emit_disp" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_what_this_pr_ships_transitions_emit_disp" name="what-this-pr-ships-transitions-emit-disp" isExecutable="false">
    <bpmn:task id="n_Agg" name="Article aggregate initTransitionAndPersist + upsertAndPersist">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_SubLink" name="submitLink transition upsert: synthesise stub on first save, no-op writes on subsequent save">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_ReqRec" name="requestRecrawl transition contentFetchedAt = epoch, pending reset, clear summaryAutoHeal">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Eff" name="Effect: dispatch-submit-link { url, userId?, rawHtml? }">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Disp" name="lambda-effect-dispatcher case dispatch-submit-link">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_Pub" name="publishEvent source: hutch.api detailType: SubmitLinkCommand">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_Cmd" name="SubmitLinkCommand { url, userId?, rawHtml? }">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Bus" name="EventBridge default-bus EVENT_BUS_NAME — already wired">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Articles" name="DynamoDB articles crawl, summary, metadata, freshness"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_Note" name="upsertAndPersist persists first, then dispatches empty writes scope skips the save but still dispatches">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Agg" targetRef="n_SubLink" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Agg" targetRef="n_ReqRec" />
    <bpmn:sequenceFlow id="f_2" name="effect" sourceRef="n_SubLink" targetRef="n_Eff" />
    <bpmn:sequenceFlow id="f_3" name="effect" sourceRef="n_ReqRec" targetRef="n_Eff" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Eff" targetRef="n_Disp" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Disp" targetRef="n_Pub" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Pub" targetRef="n_Cmd" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Cmd" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_9" name="ordering" sourceRef="n_Agg" targetRef="n_Note" />
    <bpmn:association id="f_8" sourceRef="n_Agg" targetRef="n_Articles" associationDirection="One" />
  </bpmn:process>
