      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_SCHED_HANDLER" name="handle-subscription- cancellation-scheduled Lambda">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:serviceTask>
