<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_diagram_2_convergence_deferred_scheduler" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_diagram_2_convergence_deferred_scheduler" name="diagram-2-convergence-deferred-scheduler" isExecutable="false">
    <bpmn:sendTask id="n_STRIPE_WH" name="Stripe webhook customer.subscription.deleted">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_WH_RECV" name="stripe-webhook-receiver Lambda">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_SCHED_FIRE" name="Deferred-cancellation EventBridge Scheduler (cancellationEffectiveAt + 1h)">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_CMD2" name="CancelSubscriptionCommand">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_CANCEL_Q" name="cancel-subscription SQS queue">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_CANCEL_LAMBDA" name="cancel-subscription Lambda (pending_cancellation branch)">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_EVT_CANCELLED" name="SubscriptionCancelledEvent">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_Q_HANDLE" name="handle-subscription- cancelled SQS queue">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_DLQ_HANDLE" name="handle-subscription- cancelled DLQ + email alarm">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_HANDLE_LAMBDA" name="handle-subscription- cancelled Lambda">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_DB_CANCEL" name="subscription_providers status=cancelled"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_STRIPE_WH" targetRef="n_WH_RECV" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_WH_RECV" targetRef="n_EVT_CANCELLED" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_SCHED_FIRE" targetRef="n_CMD2" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_CMD2" targetRef="n_CANCEL_Q" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_CANCEL_Q" targetRef="n_CANCEL_LAMBDA" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_CANCEL_LAMBDA" targetRef="n_EVT_CANCELLED" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_EVT_CANCELLED" targetRef="n_Q_HANDLE" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Q_HANDLE" targetRef="n_HANDLE_LAMBDA" />
    <bpmn:sequenceFlow id="f_9" name="retry exhaustion" sourceRef="n_Q_HANDLE" targetRef="n_DLQ_HANDLE" />
    <bpmn:association id="f_8" sourceRef="n_HANDLE_LAMBDA" targetRef="n_DB_CANCEL" associationDirection="One" />
    <bpmn:group id="grp_0" />
    <bpmn:group id="grp_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_diagram_2_convergence_deferred_scheduler">
    <bpmndi:BPMNPlane id="Plane_diagram_2_convergence_deferred_scheduler" bpmnElement="Process_diagram_2_convergence_deferred_scheduler">
