<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_diagram_3_reactivation_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_diagram_3_reactivation_flow" name="diagram-3-reactivation-flow" isExecutable="false">
    <bpmn:sendTask id="n_REACT" name="POST /account/reactivate (SSR Lambda)">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_READ_ROW" name="Read row (must be pending_cancellation)">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_DEL_SCHED" name="Delete deferred-cancellation EventBridge Scheduler">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_STRIPE_REV" name="Stripe PATCH cancel_at_period_end=false">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_MARK_ACTIVE" name="markActiveSubscription"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_CREATE_TRIAL" name="Create trial-end charge schedule">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_UPSERT_TRIAL" name="upsertTrialingSubscription"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_EVT_REACT" name="SubscriptionReactivatedEvent">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_REACT" targetRef="n_READ_ROW" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_READ_ROW" targetRef="n_DEL_SCHED" />
    <bpmn:sequenceFlow id="f_2" name="subscriptionId" sourceRef="n_DEL_SCHED" targetRef="n_STRIPE_REV" />
    <bpmn:sequenceFlow id="f_5" name="no subscriptionId" sourceRef="n_DEL_SCHED" targetRef="n_CREATE_TRIAL" />
    <bpmn:association id="f_3" sourceRef="n_STRIPE_REV" targetRef="n_MARK_ACTIVE" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_MARK_ACTIVE" targetRef="n_EVT_REACT" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_CREATE_TRIAL" targetRef="n_UPSERT_TRIAL" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_UPSERT_TRIAL" targetRef="n_EVT_REACT" associationDirection="One" />
    <bpmn:group id="grp_0" />
    <bpmn:group id="grp_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_diagram_3_reactivation_flow">
    <bpmndi:BPMNPlane id="Plane_diagram_3_reactivation_flow" bpmnElement="Process_diagram_3_reactivation_flow">
      <bpmndi:BPMNShape id="n_REACT_di" bpmnElement="n_REACT">
