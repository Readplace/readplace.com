<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_save_surfaces_emit_accept_fact" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_save_surfaces_emit_accept_fact" name="save-surfaces-emit-accept-fact" isExecutable="false">
    <bpmn:serviceTask id="n_Bar" name="queue save bar (POST /queue/save)">
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Siren" name="Siren save-article action (browser extension + iOS app)">
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Bulk" name="bulk save-articles">
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Tier0" name="save-content (tier-0 capture)">
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_MCP" name="MCP save_link tool">
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Import" name="import session commit">
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_InboxAuto" name="inbox extract-email-links Lambda auto-submit per kept saveable link (origin=receive, routed, saveable)">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_InboxBtn" name="inbox Articles tab per-link Save button (POST)">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SLC" name="SubmitLinkCommand url, userId">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_SQ" name="SQS submit-link visibility 480s, maxReceiveCount 3">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Submit" name="save-link submit-link Lambda guards, crawl-status-aware freshness, in-process tier-1 crawl">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Accept" name="shared accept phase — saveArticleFromUrl resolveCanonicalIdentity, global row, per-user row, read-to-unread resurface">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_UserRow" name="hutch-user-articles: the reader's queue row (written on every branch)"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_LQ" name="LinkQueuedEvent url, userId url = the SUBMITTED url, pre-alias-resolution published on new / refreshed / skip alike">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_LS" name="LinkSavedEvent url, userId (UNCHANGED — canonical-content promotion, silent on duplicates, carries the CANONICAL url; not an acceptance signal)">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_InboxAuto" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_InboxBtn" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_SLC" targetRef="n_SQ" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SQ" targetRef="n_Submit" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Bar" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Siren" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Bulk" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Tier0" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_MCP" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_Import" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Submit" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_13" name="only via promoteTier, later in the chain" sourceRef="n_Accept" targetRef="n_LS" />
    <bpmn:association id="f_11" sourceRef="n_Accept" targetRef="n_UserRow" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_UserRow" targetRef="n_LQ" associationDirection="One" />
  </bpmn:process>
