<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_read_model_and_button" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_read_model_and_button" name="read-model-and-button" isExecutable="false">
    <bpmn:startEvent id="n_LQ" name="LinkQueuedEvent url, userId">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_RuleA" name="EventRule inbox-record-link-queued (explicit name — PutRule is an upsert)">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_QA" name="SQS inbox-record-link-queued">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_SubmitDLQ" name="submit-link DLQ depth alarm to SNS email stays wired">
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_DLQH" name="save-link submit-link-dlq Lambda re-parses the dead-lettered envelope; mutates NO article row">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Note" name="means the command GAVE UP, not that nothing was queued: the queue row is written BEFORE calls that can still throw on every receive">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_LQF" name="LinkQueueFailedEvent url, userId, reason, receiveCount (only when userId is present)">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_RuleB" name="EventRule inbox-record-link-queue-failed">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_QB" name="SQS inbox-record-link-queue-failed">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Rec" name="inbox record-link-queued Lambda one handler, two queues — dispatches on the envelope's detail-type">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_RecDLQ" name="its own DLQ + alarm: malformed envelope, unkeyable url, or a failed store write">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_Model" name="hutch-inbox-saved-links (NEW) PK userId, SK sha256(normalized url) — a sort key caps at 1024 bytes, ESP wrappers exceed it saved: unconditional upsert failed: only if not already saved"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Web" name="inbox web Lambda — Articles tab one BatchGetItem per page of cards (BatchGetItem only; no articles/user-articles)">
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_Btn" name="the card's Save button saved: check icon + 'Saved' unsaved / failed: 'Save to queue' — still POSTs the same save route">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="n_SLCX" name="SubmitLinkCommand (savedAt bump + read-to-unread resurface, identical to a website/extension re-save)">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_LQ" targetRef="n_RuleA" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_RuleA" targetRef="n_QA" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_DLQH" targetRef="n_Note" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SubmitDLQ" targetRef="n_DLQH" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_DLQH" targetRef="n_LQF" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_LQF" targetRef="n_RuleB" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_RuleB" targetRef="n_QB" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_QA" targetRef="n_Rec" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_QB" targetRef="n_Rec" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_Rec" targetRef="n_RecDLQ" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Web" targetRef="n_Btn" />
    <bpmn:sequenceFlow id="f_13" name="re-save is the same POST" sourceRef="n_Btn" targetRef="n_SLCX" />
    <bpmn:association id="f_10" sourceRef="n_Rec" targetRef="n_Model" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_Model" targetRef="n_Web" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_read_model_and_button">
    <bpmndi:BPMNPlane id="Plane_read_model_and_button" bpmnElement="Process_read_model_and_button">
      <bpmndi:BPMNShape id="n_LQ_di" bpmnElement="n_LQ">
        <dc:Bounds x="185.13" y="34.75" width="40" height="40" />
      </bpmndi:BPMNShape>
