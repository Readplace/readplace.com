<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_user_data_jobs" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_user_data_jobs" name="user-data-jobs" isExecutable="false">
    <bpmn:sendTask id="n_WebE" name="POST /export (hutch web Lambda)">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_WebD" name="POST /account/delete (typed-phrase confirmation)">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_EUD" name="ExportUserDataCommand">
      <bpmn:incoming>f_0</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_DAC" name="DeleteAccountCommand">
      <bpmn:incoming>f_1</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:dataStoreReference id="n_Q" name="user-data-jobs-q — 900s visibility, maxReceiveCount 12 (was 3 for export): the scrub's Apple-outage window is the stronger of the two properties"></bpmn:dataStoreReference>
    <bpmn:task id="n_HE" name="export-user-data paged article read → archive">
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_HD" name="delete-account converges on partial state by design">
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_S3E" name="user-export bucket read + write + TTL lifecycle"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Mail" name="Resend email with presigned URL (reserved domains skipped)">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_Exported" name="UserDataExported / UserDataExportFailed">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_Stripe" name="Stripe deleteCustomer — 404 treated as success so a redrive converges">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Scheds" name="delete 5 per-user schedules (all ResourceNotFound-idempotent)">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Stores" name="users, sessions, oauth, articles, user-articles, digest queue, reader-ready, onboarding, prefs, subscriptions, 4 inbox tables, 3 token tables"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_S3D" name="raw-email, content, user-export — DeleteObject + ListBucket"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Idp" name="revoke Apple refresh token — fails closed on an Apple outage">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_D" name="user-data-jobs-dlq → alarm → SNS email">

      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_WebE" targetRef="n_EUD" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_WebD" targetRef="n_DAC" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_HE" targetRef="n_Mail" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_HE" targetRef="n_Exported" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_HD" targetRef="n_Stripe" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_HD" targetRef="n_Scheds" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_HD" targetRef="n_Idp" />
    <bpmn:association id="f_2" sourceRef="n_EUD" targetRef="n_Q" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_DAC" targetRef="n_Q" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_Q" targetRef="n_HE" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_Q" targetRef="n_HD" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_HE" targetRef="n_S3E" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_HD" targetRef="n_Stores" associationDirection="One" />
    <bpmn:association id="f_12" sourceRef="n_HD" targetRef="n_S3D" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_Q" targetRef="n_D" associationDirection="One" />
    <bpmn:group id="grp_0" />
  </bpmn:process>
