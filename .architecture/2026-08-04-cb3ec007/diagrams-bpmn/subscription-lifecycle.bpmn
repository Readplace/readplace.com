<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_subscription_lifecycle" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_subscription_lifecycle" name="subscription-lifecycle" isExecutable="false">
    <bpmn:sendTask id="n_Web" name="POST /account/cancel (hutch web Lambda)">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:businessRuleTask id="n_Sched1" name="EventBridge Scheduler one-shot trial-end, created at signup">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_Sched2" name="EventBridge Scheduler one-shot deferred cancellation (effective-at + 1h)">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_Hook" name="Stripe webhook receiver customer.subscription.deleted">
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_CSR" name="SubscriptionStartRequestCommand">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_CSC" name="CancelSubscriptionCommand">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_HSR" name="subscription-start-request row missing / not trialing → noop">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_HCS" name="cancel-subscription branches on row status">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_HCancelled" name="handle-subscription-cancelled SET status=cancelled">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_HFeedback" name="schedule-trial-feedback-email trial reasons only">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_HSched" name="handle-subscription-cancellation-scheduled SET pending_cancellation">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_HOK" name="subscription-charge-succeeded upsertActive">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_HFail" name="subscription-charge-failed">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_ChargeOK" name="SubscriptionChargeSucceeded">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_ChargeNo" name="SubscriptionChargeFailed no_card_on_file | stripe_error">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_SchedEv" name="SubscriptionCancellationScheduled">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_Cancelled" name="SubscriptionCancelled">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_FanOut" name="ONE rule, ONE queue record → BOTH handlers in ONE invocation (2nd rule deleted)">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_Sched3" name="EventBridge Scheduler one-shot trial feedback, +3 days, deterministic name per user">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_STFE" name="SendTrialFeedbackEmailCommand">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Sep" name="send-trial-feedback-email-handler 60/256/60 — SEPARATE by design; profile does not match the seven">
      <bpmn:incoming>f_20</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Table" name="hutch-subscription-providers merged grant: GetItem + UpdateItem"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Analytics" name="subscriptions stream → forwarder → /readplace/analytics"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Sched1" targetRef="n_CSR" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Sched2" targetRef="n_CSC" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Web" targetRef="n_CSC" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_CSR" targetRef="n_HSR" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_CSC" targetRef="n_HCS" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_HSR" targetRef="n_ChargeOK" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_HSR" targetRef="n_ChargeNo" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_ChargeOK" targetRef="n_HOK" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_ChargeNo" targetRef="n_HFail" />
    <bpmn:sequenceFlow id="f_9" name="closes the loop" sourceRef="n_HFail" targetRef="n_CSC" />
    <bpmn:sequenceFlow id="f_10" name="active / trialing" sourceRef="n_HCS" targetRef="n_SchedEv" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_SchedEv" targetRef="n_HSched" />
    <bpmn:sequenceFlow id="f_12" name="active / trialing" sourceRef="n_HCS" targetRef="n_Sched2" />
    <bpmn:sequenceFlow id="f_13" name="pending_cancellation → final conversion" sourceRef="n_HCS" targetRef="n_Cancelled" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_Hook" targetRef="n_Cancelled" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_Cancelled" targetRef="n_FanOut" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_FanOut" targetRef="n_HCancelled" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_FanOut" targetRef="n_HFeedback" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_HFeedback" targetRef="n_Sched3" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_Sched3" targetRef="n_STFE" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_STFE" targetRef="n_Sep" />
    <bpmn:association id="f_21" sourceRef="n_HSR" targetRef="n_Table" associationDirection="One" />
    <bpmn:association id="f_22" sourceRef="n_HCS" targetRef="n_Table" associationDirection="One" />
    <bpmn:association id="f_23" sourceRef="n_HCancelled" targetRef="n_Table" associationDirection="One" />
    <bpmn:association id="f_24" sourceRef="n_HSched" targetRef="n_Table" associationDirection="One" />
    <bpmn:association id="f_25" sourceRef="n_HOK" targetRef="n_Table" associationDirection="One" />
    <bpmn:association id="f_26" sourceRef="n_HCancelled" targetRef="n_Analytics" associationDirection="One" />
    <bpmn:association id="f_27" sourceRef="n_HOK" targetRef="n_Analytics" associationDirection="One" />
    <bpmn:association id="f_28" sourceRef="n_HFail" targetRef="n_Analytics" associationDirection="One" />
    <bpmn:group id="grp_0" />
  </bpmn:process>
