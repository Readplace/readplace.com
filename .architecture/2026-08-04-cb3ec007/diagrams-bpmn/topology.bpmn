<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_topology" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_topology" name="topology" isExecutable="false">
    <bpmn:serviceTask id="n_Bus" name="shared platform EventBridge bus (hutch-event-bus)">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_R1" name="cancel-subscription-command-rule">
      <bpmn:incoming>f_0</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_R2" name="subscription-cancellation-scheduled-rule"></bpmn:serviceTask>
    <bpmn:serviceTask id="n_R3" name="subscription-cancelled-rule"></bpmn:serviceTask>
    <bpmn:serviceTask id="n_R4" name="subscription-charge-failed-rule"></bpmn:serviceTask>
    <bpmn:serviceTask id="n_R5" name="subscription-charge-succeeded-rule"></bpmn:serviceTask>
    <bpmn:serviceTask id="n_R6" name="subscription-start-request-command-rule"></bpmn:serviceTask>
    <bpmn:serviceTask id="n_R7" name="delete-account-command-rule"></bpmn:serviceTask>
    <bpmn:serviceTask id="n_R8" name="export-user-data-command-rule"></bpmn:serviceTask>
    <bpmn:endEvent id="n_Dup" name="schedule-trial-feedback-email-rule 2nd rule on SubscriptionCancelled — DELETED; fan-out is now in-process">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_QA" name="subscription-events-q visibility 30s"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_DA" name="subscription-events-dlq 1 alarm → SNS email">

      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_QB" name="user-data-jobs-q visibility 900s, maxReceiveCount 12"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_DB" name="user-data-jobs-dlq 1 alarm → SNS email">

      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_PolA" name="subscription-events-queue-policy ONE policy naming all 6 rule ARNs — SQS allows exactly one per queue"></bpmn:serviceTask>
    <bpmn:serviceTask id="n_PolB" name="user-data-jobs-queue-policy ONE policy naming both rule ARNs"></bpmn:serviceTask>
    <bpmn:serviceTask id="n_LA" name="subscription-events-handler 128MB / 30s / batchSize 1 / ReportBatchItemFailures">
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_LB" name="user-data-jobs-handler 1024MB / 900s / batchSize 1 / ReportBatchItemFailures">
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_Old" name="DELETED: 9 queues + 9 DLQs + 9 mappings + 9 alarms + 9 roles (log groups retained)">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Bus" targetRef="n_R1" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Bus" targetRef="n_Dup" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_LA" targetRef="n_Old" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_LB" targetRef="n_Old" />
    <bpmn:association id="f_2" sourceRef="n_QA" targetRef="n_DA" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_QB" targetRef="n_DB" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_QA" targetRef="n_LA" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_QB" targetRef="n_LB" associationDirection="One" />
    <bpmn:group id="grp_0" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_topology">
    <bpmndi:BPMNPlane id="Plane_topology" bpmnElement="Process_topology">
      <bpmndi:BPMNShape id="n_Bus_di" bpmnElement="n_Bus">
        <dc:Bounds x="265.25" y="52" width="145" height="68" />
