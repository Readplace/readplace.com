      <bpmndi:BPMNShape id="n_LA_di" bpmnElement="n_LA">
        <dc:Bounds x="1003.17" y="215" width="201" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_LB_di" bpmnElement="n_LB">
