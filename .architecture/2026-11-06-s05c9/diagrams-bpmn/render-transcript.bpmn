<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_render_transcript" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_render_transcript" name="render-transcript" isExecutable="false">
    <bpmn:startEvent id="n_J" name="Transcribe Job State Change, rp- job">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="n_Q" name="[&quot;media-audio-render-transcript-q">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_R" name="Render transcript">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_X" name="Delete the attempt's files">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_S" name="Settle the charge">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_T" name="TierContentExtracted, tier-0 transcript">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_B" name="TierContentExtracted, short audio body">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_S2" name="Settle the charge">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_D" name="[&quot;media-audio-failures DLQ">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_DR" name="Render-transcript dead-letter route">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_J" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Q" targetRef="n_R" />
    <bpmn:sequenceFlow id="f_2" name="job request gone" sourceRef="n_R" targetRef="n_X" />
    <bpmn:sequenceFlow id="f_3" name="item released" sourceRef="n_R" targetRef="n_S" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_S" targetRef="n_X" />
    <bpmn:sequenceFlow id="f_5" name="COMPLETED" sourceRef="n_R" targetRef="n_T" />
    <bpmn:sequenceFlow id="f_6" name="FAILED or no words" sourceRef="n_R" targetRef="n_B" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_T" targetRef="n_S2" />
    <bpmn:sequenceFlow id="f_8" name="after 2 receives" sourceRef="n_Q" targetRef="n_D" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_D" targetRef="n_DR" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_DR" targetRef="n_B" />
  </bpmn:process>
