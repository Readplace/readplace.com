<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_save_email_issue" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_save_email_issue" name="save-email-issue" isExecutable="false">
    <bpmn:serviceTask id="n_EXT" name="extract-email-links Lambda (inbox)">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SEI" name="SaveEmailIssueCommand">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_Q" name="[&quot;save-email-issue-command-q">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_DLQ" name="[&quot;save-email-issue-command-dlq after 3 receives, alarm emails">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_SEL" name="save-email-issue-command Lambda">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_BODY" name="Content bucket: stored email body"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_PB" name="Body present?">
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="n_SK1" name="EmailIssueSaveSkippedEvent reason body-gone">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_37</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_STAND" name="Read the issue's standing: stored display URL + user's saves for the URL">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ALIAS" name="Articles table: canonical alias row"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_UA" name="User-articles table: All and readlist rows"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_PS" name="In All, removed by reader, or neither?">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_SUB" name="Subscription-providers table"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_PW" name="Write access?">
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="n_SK2" name="EmailIssueSaveSkippedEvent reason write-access-lapsed">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_38</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:dataStoreReference id="n_CS" name="Articles table: crawl status"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_MP" name="markCrawlPending + markSummaryPending when content is pending">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_SAVE" name="saveArticleKeepingPosition + setDisplayUrl">
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_OSA" name="EmailOutputSavedToAllEvent when the email has an output">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:outgoing>f_32</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_GIC" name="inbox gmail-import-completion Lambda">
      <bpmn:incoming>f_23</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_FILE" name="For each readlist: already filed?">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_FLR" name="fileIntoLiveReadlist stamped with the command's envelope time">
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_FO" name="Filing outcome">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:outgoing>f_29</bpmn:outgoing>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_LOGF" name="Log: filing skipped readlist-gone, removed-after-request, not-in-all">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:outgoing>f_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_TIER" name="Commit tier-0 email body via putTierSource only when content is pending">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:outgoing>f_33</bpmn:outgoing>
      <bpmn:outgoing>f_35</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_TCE" name="TierContentExtractedEvent when content is pending">
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:outgoing>f_34</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_SMC" name="select-most-complete-content">
      <bpmn:incoming>f_34</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_SK3" name="EmailIssueSaveSkippedEvent reason removed-by-reader">
      <bpmn:incoming>f_35</bpmn:incoming>
      <bpmn:outgoing>f_39</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:dataStoreReference id="n_ONB" name="Onboarding table: inbox article queued stamp"></bpmn:dataStoreReference>
    <bpmn:task id="n_NOSUB" name="No subscriber yet">
      <bpmn:incoming>f_37</bpmn:incoming>
      <bpmn:incoming>f_38</bpmn:incoming>
      <bpmn:incoming>f_39</bpmn:incoming>
    </bpmn:task>
