<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_read_flow_articles_tab_per_card_poll_beh" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_read_flow_articles_tab_per_card_poll_beh" name="read-flow-articles-tab-per-card-poll-beh" isExecutable="false">
    <bpmn:sendTask id="n_detail" name="GET /inbox/:id">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_detailSys" name="inbox.page.ts GET /:id">
      <bpmn:incoming>f_0</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_links" name="inbox-email-links table listLinksByEmail — links + meta"></bpmn:dataStoreReference>
    <bpmn:task id="n_panel" name="Articles panel one card per link + N-links badge"></bpmn:task>
    <bpmn:sendTask id="n_panelpoll" name="GET /inbox/:id/articles every 3s while extracting">
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_panelpollSys" name="inbox.page.ts /:id/articles poll until meta barrier present">
      <bpmn:incoming>f_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_poll" name="GET /inbox/:id/links/:ordinal/card every 3s">
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_pollSys" name="inbox.page.ts poll route etag + 304, omit poll url when terminal">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_getLink" name="inbox-email-links table getLink"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_card" name="inbox-article-card fragment pending / crawled / failed"></bpmn:serviceTask>
    <bpmn:sendTask id="n_list" name="GET /inbox">
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_listSys" name="inbox.page.ts GET / per-email count Query, fired concurrently">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_badge" name="N-links badge per row">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_detail" targetRef="n_detailSys" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_panelpoll" targetRef="n_panelpollSys" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_poll" targetRef="n_pollSys" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_list" targetRef="n_listSys" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_listSys" targetRef="n_badge" />
    <bpmn:association id="f_1" sourceRef="n_detailSys" targetRef="n_links" associationDirection="One" />
    <bpmn:association id="f_2" sourceRef="n_links" targetRef="n_panel" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_panelpollSys" targetRef="n_links" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_pollSys" targetRef="n_getLink" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_getLink" targetRef="n_card" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_listSys" targetRef="n_links" associationDirection="One" />
  </bpmn:process>
