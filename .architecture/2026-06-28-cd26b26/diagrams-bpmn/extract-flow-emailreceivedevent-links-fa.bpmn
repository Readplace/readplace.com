<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_extract_flow_emailreceivedevent_links_fa" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_extract_flow_emailreceivedevent_links_fa" name="extract-flow-emailreceivedevent-links-fa" isExecutable="false">
    <bpmn:startEvent id="n_ERE" name="EmailReceivedEvent userId, receivedAtMessageId">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="n_rule" name="EventBridge rule source hutch.inbox / EmailReceived">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_q" name="extract-email-links SQS">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_dlq" name="extract-email-links DLQ + alarm -&gt; SNS email">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_h" name="extract-email-links Lambda extract-email-links-handler.ts">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_getEmail" name="inbox-emails table getEmail — skip if status != received"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_rawS3" name="raw .eml bucket readRawEmail"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_derive" name="parseEmail + deriveSanitizedBody re-derive body from raw">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_extract" name="extractUrls + capEmailLinks soft cap 200">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_putLink" name="inbox-email-links table putLink one pending row per url"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_meta" name="inbox-email-links table putLinksMeta — always, extraction-finished barrier"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_alert" name="alertTruncated SendMessage -&gt; dedicated alert queue">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_alertq" name="extract-email-links truncated-alert queue + send-rate alarm -&gt; SNS email">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_pub" name="publish CrawlEmailLinkPreview one per link">
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CELP" name="CrawlEmailLinkPreview">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_ERE" targetRef="n_rule" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_rule" targetRef="n_q" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_q" targetRef="n_h" />
    <bpmn:sequenceFlow id="f_3" name="maxReceiveCount" sourceRef="n_q" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_h" targetRef="n_derive" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_derive" targetRef="n_extract" />
    <bpmn:sequenceFlow id="f_11" name="if truncated" sourceRef="n_extract" targetRef="n_alert" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_alert" targetRef="n_alertq" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_pub" targetRef="n_CELP" />
    <bpmn:association id="f_4" sourceRef="n_h" targetRef="n_getEmail" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_h" targetRef="n_rawS3" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_extract" targetRef="n_putLink" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_putLink" targetRef="n_pub" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_extract" targetRef="n_meta" associationDirection="One" />
  </bpmn:process>
