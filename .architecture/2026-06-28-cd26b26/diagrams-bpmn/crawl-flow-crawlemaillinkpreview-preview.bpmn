    <bpmn:serviceTask id="n_CELP" name="CrawlEmailLinkPreview userId, receivedAtMessageId, ordinal, url">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_rule" name="EventBridge rule hutch.inbox / CrawlEmailLinkPreview">
