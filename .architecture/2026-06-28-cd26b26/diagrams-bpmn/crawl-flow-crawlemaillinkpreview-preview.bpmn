    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_q" targetRef="n_h" />
    <bpmn:sequenceFlow id="f_3" name="genuine fault" sourceRef="n_q" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_h" targetRef="n_ssrf" />
    <bpmn:sequenceFlow id="f_6" name="ok" sourceRef="n_ssrf" targetRef="n_crawl" />
    <bpmn:association id="f_5" sourceRef="n_ssrf" targetRef="n_outcome" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_crawl" targetRef="n_img" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_crawl" targetRef="n_outcome" associationDirection="One" />
