      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_q" name="crawl-email-link-preview SQS batchSize 1">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_dlq" name="crawl-email-link-preview DLQ + alarm -&gt; SNS email">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_h" name="crawl-email-link-preview Lambda crawl-email-link-preview-handler.ts">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_ssrf" name="validateSaveableUrl + isBlockedIpAddress">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_crawl" name="crawlAndFinalizeArticle metadata only — body discarded">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_img" name="content bucket lead-image upload via CDN"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_outcome" name="inbox-email-links table setLinkOutcome crawled / failed"></bpmn:dataStoreReference>
