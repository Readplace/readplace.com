<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_extract_audio" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_extract_audio" name="extract-audio" isExecutable="false">
    <bpmn:startEvent id="n_C" name="MediaUploadCommitted, kind audio or video">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="n_KQ" name="[&quot;media-audio-keep-audio-q">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_K" name="Keep audio as enclosure">
      <bpmn:incoming>f_1</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_PQ" name="[&quot;media-audio-prepare-transcription-q">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_P" name="Prepare transcription">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_X" name="Extract audio: probe, ffmpeg to AAC m4a">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_O" name="Media object store, audio/mp4 rendition"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_A" name="Article enclosure and duration"></bpmn:dataStoreReference>
    <bpmn:task id="n_RF" name="Release rendition, refund unstarted charge">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="n_F" name="MediaProcessingFailed, staged-bytes-gone">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_T" name="Start Transcribe job">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_D" name="[&quot;media-audio-failures DLQ">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="audio" sourceRef="n_C" targetRef="n_KQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_KQ" targetRef="n_K" />
    <bpmn:sequenceFlow id="f_2" name="audio or video" sourceRef="n_C" targetRef="n_PQ" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_PQ" targetRef="n_P" />
    <bpmn:sequenceFlow id="f_4" name="video" sourceRef="n_P" targetRef="n_X" />
    <bpmn:sequenceFlow id="f_7" name="row gone" sourceRef="n_X" targetRef="n_RF" />
    <bpmn:sequenceFlow id="f_8" name="staged bytes gone" sourceRef="n_X" targetRef="n_F" />
    <bpmn:sequenceFlow id="f_9" name="proceed" sourceRef="n_P" targetRef="n_T" />
    <bpmn:sequenceFlow id="f_10" name="after receives" sourceRef="n_PQ" targetRef="n_D" />
    <bpmn:association id="f_5" sourceRef="n_X" targetRef="n_O" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_X" targetRef="n_A" associationDirection="One" />
  </bpmn:process>
