<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_read_model_subscriber" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_read_model_subscriber" name="read-model-subscriber" isExecutable="false">
    <bpmn:startEvent id="n_LQ" name="LinkQueuedEvent (save accepted)">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_LQF" name="LinkQueueFailedEvent (accept retries exhausted)">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_LDQ" name="LinkDequeuedEvent (queue row deleted)">
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_Q1" name="SQS inbox-record-link-queued visibility 90 s, maxReceiveCount 3">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_Q2" name="SQS inbox-record-link-queue-failed visibility 90 s, maxReceiveCount 3">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_Q3" name="SQS inbox-record-link-dequeued visibility 90 s, maxReceiveCount 3">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="n_Handler" name="inbox record-link-queued Lambda 256 MB / 30 s, batchSize 1 dispatch on detail-type — unknown type or unparseable URL fails the record (never defaults)">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_W1" name="markLinkSaved unconditional PutItem — re-published facts and re-saves converge on the same row">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_W2" name="markLinkSaveFailed conditional PutItem (attribute_not_exists OR state &lt;&gt; saved) — an accepted save outranks a failure">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_W3" name="retractLinkSaved DeleteItem — absence IS the not-saved state; idempotent under redelivery">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:dataStoreReference id="n_Table" name="hutch-inbox-saved-links PK userId, SK sha256(normalized url) state: saved | failed — no third state; row carries the raw url for the console"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_D1" name="DLQ + alarm → SNS email (alarm-only: single-row writes — exhaustion means DynamoDB was down, or a producer broke its contract)">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_DelAcct" name="hutch delete-account Lambda deleteAllByUserId (partition drop, bypasses the fact stream)"></bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="f_0" name="rule inbox-record-link-queued" sourceRef="n_LQ" targetRef="n_Q1" />
    <bpmn:sequenceFlow id="f_1" name="rule inbox-record-link-queue-failed" sourceRef="n_LQF" targetRef="n_Q2" />
    <bpmn:sequenceFlow id="f_2" name="rule inbox-record-link-dequeued (NEW)" sourceRef="n_LDQ" targetRef="n_Q3" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Q1" targetRef="n_Handler" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Q2" targetRef="n_Handler" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Q3" targetRef="n_Handler" />
    <bpmn:sequenceFlow id="f_6" name="LinkQueued" sourceRef="n_Handler" targetRef="n_W1" />
    <bpmn:sequenceFlow id="f_7" name="LinkQueueFailed" sourceRef="n_Handler" targetRef="n_W2" />
    <bpmn:sequenceFlow id="f_8" name="LinkDequeued" sourceRef="n_Handler" targetRef="n_W3" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Q1" targetRef="n_D1" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Q2" targetRef="n_D1" />
    <bpmn:sequenceFlow id="f_14" name="NEW third DLQ" sourceRef="n_Q3" targetRef="n_D1" />
    <bpmn:association id="f_9" sourceRef="n_W1" targetRef="n_Table" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_W2" targetRef="n_Table" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_W3" targetRef="n_Table" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_DelAcct" targetRef="n_Table" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_read_model_subscriber">
    <bpmndi:BPMNPlane id="Plane_read_model_subscriber" bpmnElement="Process_read_model_subscriber">
      <bpmndi:BPMNShape id="n_LQ_di" bpmnElement="n_LQ">
        <dc:Bounds x="54.97" y="42" width="40" height="40" />
      </bpmndi:BPMNShape>
