<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_accept_fact_and_failure_twin" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_accept_fact_and_failure_twin" name="accept-fact-and-failure-twin" isExecutable="false">
    <bpmn:sendTask id="n_Bar" name="POST /queue/save (web save bar)">
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_Siren" name="POST /queue Siren save-article (extension + iOS app)">
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_Bulk" name="POST /queue/save-articles (extension bulk save)">
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_Tier0" name="POST /queue/save-content (tier-0 capture bytes)">
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_Import" name="import session commit">
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_MCP" name="MCP save_link tool">
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:businessRuleTask id="n_InboxAuto" name="inbox extract-email-links Lambda auto-submit per kept saveable link (origin=receive only)">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_InboxBtn" name="inbox save button POST /inbox/:id/links/:ordinal/save">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SLC" name="SubmitLinkCommand url, userId">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_SQ" name="SQS submit-link visibility 480 s, maxReceiveCount 3">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Submit" name="save-link submit-link Lambda 1769 MB / 240 s — guards, freshness, then in-process tier-1 crawl">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Accept" name="shared accept phase initSaveArticleFromUrl (@packages/save-article) resolveCanonicalIdentity → upsert global stub + per-user queue row + savedAt bump + read→unread resurface">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Tables" name="hutch-articles / hutch-user-articles"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_LQ" name="LinkQueuedEvent url (as submitted), userId fires on EVERY freshness branch, duplicates included">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_Enrich" name="crawl / enrichment chain (TierContentExtracted → selector → summary; unchanged, see earlier snapshots)">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_SDLQ" name="submit-link DLQ + depth alarm → SNS email">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="n_DlqHandler" name="submit-link-dlq Lambda publish-only — mutates no article row; no-userId dead letters log + alarm only">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_LQF" name="LinkQueueFailedEvent url, userId, reason=accept-retries-exhausted, receiveCount">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_InboxAuto" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_InboxBtn" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_2" name="EventBridge rule" sourceRef="n_SLC" targetRef="n_SQ" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SQ" targetRef="n_Submit" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Bar" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Siren" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Bulk" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Tier0" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_Import" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_MCP" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Submit" targetRef="n_Accept" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Accept" targetRef="n_LQ" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Accept" targetRef="n_Enrich" />
    <bpmn:sequenceFlow id="f_14" name="accept-phase throw ×3" sourceRef="n_SQ" targetRef="n_SDLQ" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_SDLQ" targetRef="n_DlqHandler" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_DlqHandler" targetRef="n_LQF" />
    <bpmn:association id="f_11" sourceRef="n_Accept" targetRef="n_Tables" associationDirection="One" />
    <bpmn:group id="grp_0" />
    <bpmn:group id="grp_1" />
  </bpmn:process>
