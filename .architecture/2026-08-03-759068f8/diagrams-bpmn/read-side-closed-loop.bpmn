<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_read_side_closed_loop" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_read_side_closed_loop" name="read-side-closed-loop" isExecutable="false">
    <bpmn:sendTask id="n_Detail" name="GET /inbox/:id (email detail — view / articles / skipped tabs)">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_More" name="GET /inbox/:id/articles/more (next page of cards)">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_Card" name="GET /inbox/:id/links/:ordinal/card (3 s pending-card poll — save state read BEFORE the ETag, so membership is inside the validator)">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Lookup" name="findSavedLinks — one BatchGetItem per page of cards; unparseable URLs skipped, never a page failure">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Table" name="hutch-inbox-saved-links (inbox web grant: BatchGetItem only)"></bpmn:dataStoreReference>
    <bpmn:task id="n_VM" name="shared save-button view model toInboxSaveButtonViewModel — both tabs render from it">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_Saved" name="state=saved → Save again (check icon, muted, still clickable)">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Unsaved" name="absent or failed → Save to queue">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_SkippedTab" name="Skipped tab excluded rows now live — same model, previously hardcoded">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_SaveBtn" name="POST /inbox/:id/links/:ordinal/save requireNotLocked + requireWriteAccess 404: bad ordinal / missing row / unsaveable URL">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Verdict" name="skipped link saved → classifier-audit feedback line (should-be-included)">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SLC" name="SubmitLinkCommand stored URL (utm-stripped only when already resolved) — the save pipeline owns redirects">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_Loop" name="→ diagram 1: submit-link accept phase → LinkQueuedEvent → diagram 3: markLinkSaved → next render says Save again">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_Redirect" name="303 back to the link's own tab with a saved confirmation notice">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Detail" targetRef="n_Lookup" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_More" targetRef="n_Lookup" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Card" targetRef="n_Lookup" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Lookup" targetRef="n_VM" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_VM" targetRef="n_Saved" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_VM" targetRef="n_Unsaved" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_VM" targetRef="n_SkippedTab" />
    <bpmn:sequenceFlow id="f_8" name="re-save: same POST" sourceRef="n_Saved" targetRef="n_SaveBtn" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_Unsaved" targetRef="n_SaveBtn" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_SkippedTab" targetRef="n_SaveBtn" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_SaveBtn" targetRef="n_Verdict" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_SaveBtn" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_SLC" targetRef="n_Loop" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_SaveBtn" targetRef="n_Redirect" />
    <bpmn:association id="f_3" sourceRef="n_Lookup" targetRef="n_Table" associationDirection="One" />
    <bpmn:group id="grp_0" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_read_side_closed_loop">
    <bpmndi:BPMNPlane id="Plane_read_side_closed_loop" bpmnElement="Process_read_side_closed_loop">
      <bpmndi:BPMNShape id="n_Detail_di" bpmnElement="n_Detail">
        <dc:Bounds x="28.38" y="60" width="177.5" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_More_di" bpmnElement="n_More">
        <dc:Bounds x="241.88" y="60" width="184.75" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Card_di" bpmnElement="n_Card">
        <dc:Bounds x="462.63" y="28" width="214" height="132" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Lookup_di" bpmnElement="n_Lookup">
        <dc:Bounds x="272.88" y="218" width="159.25" height="116" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Table_di" bpmnElement="n_Table">
        <dc:Bounds x="156.67" y="395.75" width="156.42" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_VM_di" bpmnElement="n_VM">
        <dc:Bounds x="349.09" y="392" width="199.25" height="100" />
