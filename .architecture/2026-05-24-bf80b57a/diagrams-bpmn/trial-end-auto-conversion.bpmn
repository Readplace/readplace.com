<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_trial_end_auto_conversion" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_trial_end_auto_conversion" name="trial-end-auto-conversion" isExecutable="false">
    <bpmn:businessRuleTask id="n_User" name="User completes email or Google signup founding allocation exhausted">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_SignupRoute" name="POST /signup or /auth/google/callback SSR Lambda">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_TrialRow" name="subscription_providers status = trialing"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Scheduler" name="EventBridge Scheduler group: hutch-trial-end-stage">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_EB" name="EventBridge bus hutch-event-bus">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SSRC" name="SubscriptionStartRequestCommand userId">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_SSRQueue" name="subscription-start-request SQS queue vis 30s">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_SSRLambda" name="subscription-start-request Lambda findByUserId + branch 128 MB / 30 s">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Noop1" name="Idempotent noop"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_NoCard" name="Publish SubscriptionChargeFailed reason=no_card_on_file">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:businessRuleTask id="n_StripeCreate" name="Stripe POST /v1/subscriptions customer, items 0 price">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateThrowEvent id="n_Success" name="Publish SubscriptionChargeSucceeded">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_StripeFail" name="Publish SubscriptionChargeFailed reason=stripe_error">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_SCSE" name="SubscriptionChargeSucceededEvent userId, subscriptionId, customerId">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_SCSE_Queue" name="subscription-charge-succeeded SQS queue vis 30s">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_28</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_SCSE_Lambda" name="subscription-charge-succeeded Lambda upsertActive 128 MB / 30 s">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_SCFE" name="SubscriptionChargeFailedEvent userId, reason">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_SCFE_Queue" name="subscription-charge-failed SQS queue vis 30s">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:outgoing>f_29</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="n_SCFE_Lambda" name="subscription-charge-failed Lambda dispatch CancelSubscriptionCommand 128 MB / 30 s">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_CSC" name="CancelSubscriptionCommand Phase 2 chain takes over">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Phase2" name="Phase 2: cancel-subscription Lambda then handle-subscription-cancelled markCancelledByUserId">
      <bpmn:incoming>f_25</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_SSR_DLQ" name="subscription-start-request DLQ">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_30</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_SCSE_DLQ" name="subscription-charge-succeeded DLQ">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:outgoing>f_31</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_SCFE_DLQ" name="subscription-charge-failed DLQ">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:outgoing>f_32</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_OperatorEmail" name="Operator email notification">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:incoming>f_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_User" targetRef="n_SignupRoute" />
    <bpmn:sequenceFlow id="f_2" name="createTrialEndSchedule name = trial-end-userId firesAt = trialEndsAt" sourceRef="n_SignupRoute" targetRef="n_Scheduler" />
    <bpmn:sequenceFlow id="f_3" name="at trialEndsAt: events:PutEvents via scheduler-execution role" sourceRef="n_Scheduler" targetRef="n_EB" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_EB" targetRef="n_SSRC" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_SSRC" targetRef="n_SSRQueue" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_SSRQueue" targetRef="n_SSRLambda" />
    <bpmn:sequenceFlow id="f_9" name="trialing without customerId typical no-card path" sourceRef="n_SSRLambda" targetRef="n_NoCard" />
    <bpmn:sequenceFlow id="f_10" name="trialing with customerId rare" sourceRef="n_SSRLambda" targetRef="n_StripeCreate" />
    <bpmn:sequenceFlow id="f_11" name="2xx + subscriptionId" sourceRef="n_StripeCreate" targetRef="n_Success" />
    <bpmn:sequenceFlow id="f_12" name="non-2xx / throw" sourceRef="n_StripeCreate" targetRef="n_StripeFail" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Success" targetRef="n_SCSE" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_SCSE" targetRef="n_EB" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_EB" targetRef="n_SCSE_Queue" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_SCSE_Queue" targetRef="n_SCSE_Lambda" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_NoCard" targetRef="n_SCFE" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_StripeFail" targetRef="n_SCFE" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_SCFE" targetRef="n_EB" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_EB" targetRef="n_SCFE_Queue" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_SCFE_Queue" targetRef="n_SCFE_Lambda" />
    <bpmn:sequenceFlow id="f_23" name="Event → Command publishCancelSubscriptionCommand" sourceRef="n_SCFE_Lambda" targetRef="n_CSC" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_CSC" targetRef="n_EB" />
    <bpmn:sequenceFlow id="f_25" name="Phase 2 cancel-subscription Lambda trialing branch publishes SubscriptionCancelledEvent also: deleteTrialEndSchedule defensive" sourceRef="n_CSC" targetRef="n_Phase2" />
    <bpmn:sequenceFlow id="f_27" name="exhausted retries" sourceRef="n_SSRQueue" targetRef="n_SSR_DLQ" />
    <bpmn:sequenceFlow id="f_28" name="exhausted retries" sourceRef="n_SCSE_Queue" targetRef="n_SCSE_DLQ" />
    <bpmn:sequenceFlow id="f_29" name="exhausted retries" sourceRef="n_SCFE_Queue" targetRef="n_SCFE_DLQ" />
    <bpmn:sequenceFlow id="f_30" name="SNS alarm" sourceRef="n_SSR_DLQ" targetRef="n_OperatorEmail" />
    <bpmn:sequenceFlow id="f_31" name="SNS alarm" sourceRef="n_SCSE_DLQ" targetRef="n_OperatorEmail" />
    <bpmn:sequenceFlow id="f_32" name="SNS alarm" sourceRef="n_SCFE_DLQ" targetRef="n_OperatorEmail" />
    <bpmn:association id="f_1" sourceRef="n_SignupRoute" targetRef="n_TrialRow" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_TrialRow" targetRef="n_SSRLambda" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_SSRLambda" targetRef="n_Noop1" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_SCSE_Lambda" targetRef="n_TrialRow" associationDirection="One" />
    <bpmn:association id="f_26" sourceRef="n_Phase2" targetRef="n_TrialRow" associationDirection="One" />
  </bpmn:process>
