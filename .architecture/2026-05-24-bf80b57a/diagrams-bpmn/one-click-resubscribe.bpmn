<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_one_click_resubscribe" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_one_click_resubscribe" name="one-click-resubscribe" isExecutable="false">
    <bpmn:businessRuleTask id="n_User" name="Cancelled user clicks Subscribe on /account">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_SubPost" name="POST /account/subscribe SSR Lambda requireAuth">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Row" name="subscription_providers row status = cancelled"></bpmn:dataStoreReference>
    <bpmn:task id="n_OneClick" name="Stripe POST /v1/subscriptions customer + items 0 price synchronous">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Phase2Checkout" name="Phase 2 Stripe Checkout flow createCheckoutSession + storePendingSignup"></bpmn:dataStoreReference>
    <bpmn:task id="n_UpsertActive" name="subscriptionProviders.upsertActive userId, subscriptionId, customerId">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Redirect303" name="303 to /account banner now reads Active"></bpmn:dataStoreReference>
    <bpmn:task id="n_ErrorRedirect" name="303 to /account?error=payment_method row unchanged">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_ErrorCard" name="Error card renders support email + export link"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_User" targetRef="n_SubPost" />
    <bpmn:sequenceFlow id="f_2" name="customerId present typical" sourceRef="n_SubPost" targetRef="n_OneClick" />
    <bpmn:sequenceFlow id="f_4" name="2xx + subscriptionId" sourceRef="n_OneClick" targetRef="n_UpsertActive" />
    <bpmn:sequenceFlow id="f_7" name="non-2xx / throw" sourceRef="n_OneClick" targetRef="n_ErrorRedirect" />
    <bpmn:association id="f_1" sourceRef="n_Row" targetRef="n_SubPost" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_SubPost" targetRef="n_Phase2Checkout" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_UpsertActive" targetRef="n_Row" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_UpsertActive" targetRef="n_Redirect303" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_ErrorRedirect" targetRef="n_ErrorCard" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_one_click_resubscribe">
    <bpmndi:BPMNPlane id="Plane_one_click_resubscribe" bpmnElement="Process_one_click_resubscribe">
      <bpmndi:BPMNShape id="n_User_di" bpmnElement="n_User">
        <dc:Bounds x="235.19" y="28" width="166.25" height="52" />
