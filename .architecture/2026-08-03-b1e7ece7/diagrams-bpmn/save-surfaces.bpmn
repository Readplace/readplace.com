<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_save_surfaces" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_save_surfaces" name="save-surfaces" isExecutable="false">
    <bpmn:sendTask id="n_saveBar" name="POST /queue/save web save bar">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_siren" name="POST /queue/ extension and iOS">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_bulk" name="POST /queue/save-articles Save All Tabs">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_capture" name="POST /queue/save-content tier-0 capture">
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_mcp" name="MCP save_link tool">
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_importCommit" name="POST import commit">
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_submitLink" name="SubmitLinkCommand handler inbox newsletter links">
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_interactive" name="save article interactively">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_accept" name="shared accept phase">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_stub" name="global stub row + per-user save row"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_queued" name="LinkQueued">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sendTask id="n_compute" name="ComputeRelatedArticles">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_saveBar" targetRef="n_interactive" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_siren" targetRef="n_interactive" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_bulk" targetRef="n_interactive" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_capture" targetRef="n_interactive" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_mcp" targetRef="n_interactive" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_interactive" targetRef="n_accept" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_importCommit" targetRef="n_accept" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_submitLink" targetRef="n_accept" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_accept" targetRef="n_queued" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_interactive" targetRef="n_compute" />
    <bpmn:association id="f_8" sourceRef="n_accept" targetRef="n_stub" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_save_surfaces">
