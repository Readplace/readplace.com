<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_save_asks_for_past_reads" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_save_asks_for_past_reads" name="save-asks-for-past-reads" isExecutable="false">
    <bpmn:startEvent id="n_TAP" name="Reader taps save">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_AUTO" name="Automatic save email link, bulk import">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_SAVE" name="Save the link">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ROW" name="Default-list user-article row"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_LQ" name="LinkQueuedEvent">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_GATE" name="Manual save that created the row?">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_QEC" name="QueueEntryCreatedEvent">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="n_STOP" name="No related request left to the reader open">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_TAP" targetRef="n_SAVE" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_AUTO" targetRef="n_SAVE" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SAVE" targetRef="n_LQ" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_SAVE" targetRef="n_GATE" />
    <bpmn:sequenceFlow id="f_5" name="yes" sourceRef="n_GATE" targetRef="n_QEC" />
    <bpmn:sequenceFlow id="f_6" name="no" sourceRef="n_GATE" targetRef="n_STOP" />
    <bpmn:association id="f_2" sourceRef="n_SAVE" targetRef="n_ROW" associationDirection="One" />
  </bpmn:process>
