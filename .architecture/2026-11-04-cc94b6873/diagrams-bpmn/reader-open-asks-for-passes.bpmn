<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_reader_open_asks_for_passes" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_reader_open_asks_for_passes" name="reader-open-asks-for-passes" isExecutable="false">
    <bpmn:startEvent id="n_OPEN" name="Reader opens the article">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="n_FORM" name="Hidden load form POST topic-reads">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="n_GATES" name="Lock and write-access gates">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_ROUTE" name="Topic-reads route">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_REQ" name="requestRelatedPasses">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_READ" name="Default-list user-article row related state, relatedPassesRequestedAt"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_DECIDE" name="Saved, Next read unsettled and not stamped?">
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_PASSES" name="ComputeRelatedPassesCommand">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="n_MARK" name="markRelatedPassesRequested stamps relatedPassesRequestedAt">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="n_PAST" name="ComputeRelatedPastReadsCommand with the source readlist">
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:userTask id="n_POLL" name="Related slot polls every 3 s">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="n_CARD" name="Next read card shown">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_OPEN" targetRef="n_FORM" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_OPEN" targetRef="n_POLL" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_FORM" targetRef="n_GATES" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_GATES" targetRef="n_ROUTE" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_ROUTE" targetRef="n_REQ" />
    <bpmn:sequenceFlow id="f_7" name="yes" sourceRef="n_DECIDE" targetRef="n_PASSES" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_PASSES" targetRef="n_MARK" />
    <bpmn:sequenceFlow id="f_10" name="no" sourceRef="n_DECIDE" targetRef="n_PAST" />
    <bpmn:sequenceFlow id="f_11" name="related status landed" sourceRef="n_POLL" targetRef="n_CARD" />
    <bpmn:association id="f_5" sourceRef="n_REQ" targetRef="n_READ" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_READ" targetRef="n_DECIDE" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_MARK" targetRef="n_READ" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_reader_open_asks_for_passes">
    <bpmndi:BPMNPlane id="Plane_reader_open_asks_for_passes" bpmnElement="Process_reader_open_asks_for_passes">
      <bpmndi:BPMNShape id="n_OPEN_di" bpmnElement="n_OPEN">
