<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_tier_0_worker" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_tier_0_worker" name="tier-0-worker" isExecutable="false">
    <bpmn:sendTask id="n_Msg" name="SQS message SaveLinkRawHtmlCommand detail">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q0" name="save-link-raw-html-command vis 60s, maxReceive 3">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Read" name="readPendingHtml url S3 GetObject">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3Pending" name="S3 pending-html bucket"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Parse" name="parseHtml url, html Readability + site pre-parsers">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Media" name="downloadMedia rewrite media to CDN">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_WriteSrc" name="putSourceContent tier-0 html to S3">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3Source" name="S3 content bucket sources/tier-0.html"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_ReadCanon" name="readCanonicalContent url Dynamo projection + S3 if contentLocation set">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Dynamo" name="DynamoDB articles title, wordCount, contentLocation"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_HasCanon" name="contentLocation already set?">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_PromoteA" name="promoteSourceToCanonical tier-0">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Selector" name="selectMostCompleteContent candidates = tier-0, canonical">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_DS" name="Deepseek chat model: deepseek-chat response_format: json_object max 8192 tokens">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_Winner" name="winner tier-0 vs canonical vs tie">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_PromoteB" name="promoteSourceToCanonical tier-0">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_Noop" name="Keep canonical no writes">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_CopyA" name="S3 CopyObject sources/tier-0.html to content.html">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_CopyB" name="S3 CopyObject sources/tier-0.html to content.html">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3Canonical" name="S3 content bucket content.html"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_UpdateRow" name="Dynamo UpdateItem SET title, wordCount, excerpt, siteName, estimatedReadTime, contentLocation, contentFetchedAt">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_LS" name="LinkSaved url, userId">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_End" name="Message deleted worker exits">
      <bpmn:incoming>f_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_Bus" name="EventBridge default-bus">
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_QLS" name="link-saved queue">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Q0" targetRef="n_Msg" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Msg" targetRef="n_Read" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Read" targetRef="n_Parse" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Parse" targetRef="n_Media" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Media" targetRef="n_WriteSrc" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_WriteSrc" targetRef="n_ReadCanon" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_ReadCanon" targetRef="n_HasCanon" />
    <bpmn:sequenceFlow id="f_10" name="no first write wins" sourceRef="n_HasCanon" targetRef="n_PromoteA" />
    <bpmn:sequenceFlow id="f_11" name="yes" sourceRef="n_HasCanon" targetRef="n_Selector" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Selector" targetRef="n_DS" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Selector" targetRef="n_Winner" />
    <bpmn:sequenceFlow id="f_14" name="tier-0" sourceRef="n_Winner" targetRef="n_PromoteB" />
    <bpmn:sequenceFlow id="f_15" name="canonical" sourceRef="n_Winner" targetRef="n_Noop" />
    <bpmn:sequenceFlow id="f_16" name="tie" sourceRef="n_Winner" targetRef="n_Noop" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_PromoteA" targetRef="n_CopyA" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_PromoteB" targetRef="n_CopyB" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_CopyA" targetRef="n_UpdateRow" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_CopyB" targetRef="n_UpdateRow" />
    <bpmn:sequenceFlow id="f_24" name="publish" sourceRef="n_UpdateRow" targetRef="n_LS" />
    <bpmn:sequenceFlow id="f_25" name="no event" sourceRef="n_Noop" targetRef="n_End" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_LS" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_Bus" targetRef="n_QLS" />
    <bpmn:association id="f_2" sourceRef="n_Read" targetRef="n_S3Pending" associationDirection="Both" />
    <bpmn:association id="f_6" sourceRef="n_WriteSrc" targetRef="n_S3Source" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_ReadCanon" targetRef="n_Dynamo" associationDirection="Both" />
    <bpmn:association id="f_19" sourceRef="n_CopyA" targetRef="n_S3Canonical" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_CopyB" targetRef="n_S3Canonical" associationDirection="One" />
    <bpmn:association id="f_23" sourceRef="n_UpdateRow" targetRef="n_Dynamo" associationDirection="One" />
  </bpmn:process>
