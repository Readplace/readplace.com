<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_end_to_end_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_end_to_end_flow" name="end-to-end-flow" isExecutable="false">
    <bpmn:businessRuleTask id="n_Click" name="User clicks Save toolbar button / context menu">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_BG" name="Extension background captureActiveTabHtml">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Content" name="Content script capture-html message">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_Post" name="POST /queue/save-html Bearer token required body: url, rawHtml ≤10MB, title?">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_Queue" name="queue.page.ts save-html route">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3Pending" name="S3 pending-html bucket key: hashId/pending.html"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Articles1" name="DynamoDB articles table stub row: crawlStatus=pending"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_SLRHC" name="SaveLinkRawHtmlCommand url, userId, title?">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_SLC" name="SaveLinkCommand url, userId Tier 1 HTTP path">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Bus" name="EventBridge default-bus">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q0" name="save-link-raw-html-command vis 60s, maxReceive 3">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_Q1" name="save-link-command vis 60s">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Worker0" name="Tier 0 worker save-link-raw-html-command-handler">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Worker1" name="Tier 1 worker save-link-command-handler see d5f38258 snapshot">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_S3Source" name="S3 content bucket sources/tier-0.html"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_S3Canonical" name="S3 content bucket content.html canonical slot"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Articles2" name="DynamoDB articles table title, wordCount, contentLocation"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_DS" name="Deepseek chat JSON mode selector">
      <bpmn:incoming>f_19</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_Decide" name="Canonical empty or tier-0 wins?">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_Promote" name="promoteSourceToCanonical S3 CopyObject + Dynamo SET">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_Keep" name="Keep existing canonical no writes, no event">
      <bpmn:incoming>f_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="n_LS" name="LinkSaved url, userId">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_QSum" name="link-saved queue summary pipeline see 52017f3 snapshot">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Click" targetRef="n_BG" />
    <bpmn:sequenceFlow id="f_1" name="tabs.sendMessage 5s timeout" sourceRef="n_BG" targetRef="n_Content" />
    <bpmn:sequenceFlow id="f_2" name="rawHtml string" sourceRef="n_Content" targetRef="n_BG" />
    <bpmn:sequenceFlow id="f_3" name="fetch" sourceRef="n_BG" targetRef="n_Post" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Post" targetRef="n_Queue" />
    <bpmn:sequenceFlow id="f_7" name="publish" sourceRef="n_Queue" targetRef="n_SLRHC" />
    <bpmn:sequenceFlow id="f_8" name="publish" sourceRef="n_Queue" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_SLRHC" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_SLC" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_Bus" targetRef="n_Q0" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Bus" targetRef="n_Q1" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Q0" targetRef="n_Worker0" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_Q1" targetRef="n_Worker1" />
    <bpmn:sequenceFlow id="f_19" name="selectMostCompleteContent" sourceRef="n_Worker0" targetRef="n_DS" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_Worker0" targetRef="n_Decide" />
    <bpmn:sequenceFlow id="f_21" name="yes" sourceRef="n_Decide" targetRef="n_Promote" />
    <bpmn:sequenceFlow id="f_22" name="no canonical wins or tie" sourceRef="n_Decide" targetRef="n_Keep" />
    <bpmn:sequenceFlow id="f_25" name="publish only when changed" sourceRef="n_Promote" targetRef="n_LS" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_LS" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_Bus" targetRef="n_QSum" />
    <bpmn:association id="f_5" sourceRef="n_Queue" targetRef="n_S3Pending" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_Queue" targetRef="n_Articles1" associationDirection="One" />
    <bpmn:association id="f_15" sourceRef="n_Worker0" targetRef="n_S3Pending" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_Worker0" targetRef="n_S3Source" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_Worker0" targetRef="n_Articles2" associationDirection="One" />
    <bpmn:association id="f_23" sourceRef="n_Promote" targetRef="n_S3Canonical" associationDirection="One" />
    <bpmn:association id="f_24" sourceRef="n_Promote" targetRef="n_Articles2" associationDirection="One" />
  </bpmn:process>
