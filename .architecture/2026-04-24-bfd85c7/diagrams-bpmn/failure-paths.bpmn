<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_failure_paths" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_failure_paths" name="failure-paths" isExecutable="false">
    <bpmn:intermediateCatchEvent id="n_Q0" name="save-link-raw-html-command vis 60s, maxReceive 3">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Worker" name="Tier 0 worker throws on S3 GET, parse throw, Dynamo fail, Deepseek 5xx, etc.">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_Retry" name="ApproximateReceiveCount &lt; maxReceiveCount?">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="n_DLQ" name="save-link-raw-html-dlq redrive target">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_DLQWorker" name="save-link-raw-html-dlq-handler thin reaction">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Mark" name="markCrawlFailed reason: exceeded SQS maxReceiveCount">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Dynamo" name="DynamoDB articles crawlStatus = failed"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_Evt" name="CrawlArticleFailed url, reason, receiveCount">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_Bus" name="EventBridge default-bus">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_Alarm" name="SNS email alarm DLQ depth &gt; 0">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Q0" targetRef="n_Worker" />
    <bpmn:sequenceFlow id="f_1" name="throw" sourceRef="n_Worker" targetRef="n_Retry" />
    <bpmn:sequenceFlow id="f_2" name="yes" sourceRef="n_Retry" targetRef="n_Q0" />
    <bpmn:sequenceFlow id="f_3" name="no" sourceRef="n_Retry" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_DLQ" targetRef="n_DLQWorker" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_DLQWorker" targetRef="n_Mark" />
    <bpmn:sequenceFlow id="f_7" name="publish" sourceRef="n_DLQWorker" targetRef="n_Evt" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_Evt" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_9" name="CloudWatch metric" sourceRef="n_DLQ" targetRef="n_Alarm" />
    <bpmn:association id="f_6" sourceRef="n_Mark" targetRef="n_Dynamo" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_failure_paths">
