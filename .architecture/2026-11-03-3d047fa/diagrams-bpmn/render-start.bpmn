<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_render_start" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_render_start" name="render-start" isExecutable="false">
    <bpmn:sendTask id="n_RCC" name="RenderCrawlCommand + optional finalUrl">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_RQ" name="render-crawl-command queue">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_RH" name="Render crawl handler: prepare article identity">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_PIN" name="Strongly consistent pin read, only for a new save with finalUrl">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_SEL" name="Start page: stored pin, else finalUrl, else resolved original">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ART" name="Articles table"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_DR" name="Direct render (free)">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PF" name="Proxied fetch (paid, when blocked)">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PR" name="Proxied render (paid, render budget)">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_BUD" name="Render crawl budget table"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_COMMIT" name="Commit body under the stored URL; document base falls back to the start page">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_TS" name="Tier sources + crawl state"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_TCE" name="TierContentExtracted">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sendTask id="n_CCC" name="ComprehensiveCrawlCommand">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_DLQ" name="save-link failures DLQ">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_RCC" targetRef="n_RQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_RQ" targetRef="n_RH" />
    <bpmn:sequenceFlow id="f_2" name="first failed receive" sourceRef="n_RQ" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_RH" targetRef="n_PIN" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_PIN" targetRef="n_SEL" />
    <bpmn:sequenceFlow id="f_7" name="recrawl / refresh / no finalUrl" sourceRef="n_RH" targetRef="n_SEL" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_SEL" targetRef="n_DR" />
    <bpmn:sequenceFlow id="f_9" name="blocked or unreadable" sourceRef="n_DR" targetRef="n_PF" />
    <bpmn:sequenceFlow id="f_10" name="no body" sourceRef="n_PF" targetRef="n_PR" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_DR" targetRef="n_COMMIT" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_PF" targetRef="n_COMMIT" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_PR" targetRef="n_COMMIT" />
    <bpmn:sequenceFlow id="f_15" name="unsupported body" sourceRef="n_PF" targetRef="n_CCC" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_COMMIT" targetRef="n_TCE" />
    <bpmn:association id="f_3" sourceRef="n_RH" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_PIN" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_PR" targetRef="n_BUD" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_COMMIT" targetRef="n_TS" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_render_start">
    <bpmndi:BPMNPlane id="Plane_render_start" bpmnElement="Process_render_start">
      <bpmndi:BPMNShape id="n_RCC_di" bpmnElement="n_RCC">
