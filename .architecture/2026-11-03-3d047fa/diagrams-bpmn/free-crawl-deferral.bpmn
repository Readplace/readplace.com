<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_free_crawl_deferral" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_free_crawl_deferral" name="free-crawl-deferral" isExecutable="false">
    <bpmn:sendTask id="n_SLC" name="SaveLinkCommand / anonymous save / SubmitLink">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_RCI" name="RecrawlLinkInitiated (admin)">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_STC" name="Stale-check refresh">
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_SLW" name="Save work: free direct crawl, pinned to a stored destination">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_OBS" name="Observed target: terminal differs from the requested URL, not on a recrawl">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_SHELL" name="JavaScript-shell check keeps the fetched page on its deferral">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_PAIR" name="Candidate pairing waits for the archive capture, then emits with finalUrl">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_ADOPT" name="Canonical adoption (blocked or failed terminal only)">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ART" name="Articles table"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_SCU" name="SimpleCrawlUnsupported + optional finalUrl">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_PQ" name="simple-crawl-unsupported-policy queue">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="n_POL" name="Simple-crawl-unsupported policy">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_RCC" name="RenderCrawlCommand + optional finalUrl">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_CCC" name="ComprehensiveCrawlCommand (unchanged payload)">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_DLQ" name="save-link failures DLQ">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_SLC" targetRef="n_SLW" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_RCI" targetRef="n_SLW" />
    <bpmn:sequenceFlow id="f_2" name="blocked / proxy-worthy failure" sourceRef="n_SLW" targetRef="n_ADOPT" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_SLW" targetRef="n_SHELL" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_SLW" targetRef="n_OBS" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_SHELL" targetRef="n_OBS" />
    <bpmn:sequenceFlow id="f_7" name="plain save" sourceRef="n_OBS" targetRef="n_SCU" />
    <bpmn:sequenceFlow id="f_8" name="paired save" sourceRef="n_OBS" targetRef="n_PAIR" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_PAIR" targetRef="n_SCU" />
    <bpmn:sequenceFlow id="f_10" name="no finalUrl" sourceRef="n_STC" targetRef="n_SCU" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_SCU" targetRef="n_PQ" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_PQ" targetRef="n_POL" />
    <bpmn:sequenceFlow id="f_13" name="exhausted receives" sourceRef="n_PQ" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_14" name="blocked / javascript-required" sourceRef="n_POL" targetRef="n_RCC" />
    <bpmn:sequenceFlow id="f_15" name="non-html / paywall" sourceRef="n_POL" targetRef="n_CCC" />
    <bpmn:association id="f_3" sourceRef="n_ADOPT" targetRef="n_ART" associationDirection="One" />
  </bpmn:process>
