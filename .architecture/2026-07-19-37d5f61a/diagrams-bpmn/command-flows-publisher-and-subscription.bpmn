        <dc:Bounds x="335.13" y="1014.5" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="grp_0_di" bpmnElement="grp_0">
        <dc:Bounds x="16" y="16" width="450.25" height="408" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="125.13" y="112" />
        <di:waypoint x="125.13" y="141" />
