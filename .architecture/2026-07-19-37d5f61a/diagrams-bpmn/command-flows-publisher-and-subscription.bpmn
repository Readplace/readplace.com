<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_command_flows_publisher_and_subscription" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_command_flows_publisher_and_subscription" name="command-flows-publisher-and-subscription" isExecutable="false">
    <bpmn:serviceTask id="n_SubT" name="submitLink transition upsert: synthesise pending stub on first save, row untouched on re-save">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_ReqT" name="requestRecrawl transition operator recovery: freshness to epoch, both axes back to pending">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Eff" name="Effect: dispatch-submit-link submitLink: url + userId? + rawHtml? requestRecrawl: url only">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Disp" name="lambda-effect-dispatcher case dispatch-submit-link publishEvent via EVENT_BUS_NAME">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_Cmd" name="SubmitLinkCommand source: hutch.api detail: url, userId?, rawHtml?">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Bus" name="EventBridge bus">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="n_Rule" name="EventRule submit-link-command-rule detail-type = SubmitLinkCommand">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="SQS submit-link visibility 480s, maxReceiveCount 3">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_L" name="submit-link Lambda 1769 MB / 240s / curl-impersonate layer batchSize 1, ReportBatchItemFailures">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_DLQ" name="submit-link DLQ no consumer Lambda — CloudWatch alarm + SNS email only">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="effect" sourceRef="n_SubT" targetRef="n_Eff" />
    <bpmn:sequenceFlow id="f_1" name="effect" sourceRef="n_ReqT" targetRef="n_Eff" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Eff" targetRef="n_Disp" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_Disp" targetRef="n_Cmd" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Cmd" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Bus" targetRef="n_Rule" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Rule" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_Q" targetRef="n_L" />
    <bpmn:sequenceFlow id="f_8" name="3rd failed receive dead-letters" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:group id="grp_0" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_command_flows_publisher_and_subscription">
    <bpmndi:BPMNPlane id="Plane_command_flows_publisher_and_subscription" bpmnElement="Process_command_flows_publisher_and_subscription">
