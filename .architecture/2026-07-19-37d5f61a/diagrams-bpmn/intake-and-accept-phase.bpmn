      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Resurface_di" bpmnElement="n_Resurface">
        <dc:Bounds x="639.94" y="898.5" width="166.32" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Pending_di" bpmnElement="n_Pending">
        <dc:Bounds x="842.26" y="891.75" width="187.44" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Ts_di" bpmnElement="n_Ts">
        <dc:Bounds x="1065.7" y="898.5" width="181.72" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Collect_di" bpmnElement="n_Collect">
        <dc:Bounds x="1283.42" y="902.75" width="200" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="grp_0_di" bpmnElement="grp_0">
        <dc:Bounds x="178.94" y="859.5" width="639.32" height="170.5" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="grp_1_di" bpmnElement="grp_1">
        <dc:Bounds x="830.26" y="879.75" width="665.16" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="755.71" y="68" />
