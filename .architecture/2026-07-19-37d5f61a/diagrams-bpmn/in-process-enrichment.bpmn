<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_in_process_enrichment" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_in_process_enrichment" name="in-process-enrichment" isExecutable="false">
    <bpmn:serviceTask id="n_Work" name="saveLinkWork (in-process, per collected link) markCrawlStage crawl-fetching, then crawlAndFinalizeArticle (curl-impersonate H2 waterfall, oembed, readability parse, media rewrite + upload)">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_CB" name="content bucket + media CDN"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_Unsup" name="SimpleCrawlUnsupportedEvent url + userId (no recrawl/refresh flag)">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_PolQ" name="SQS simple-crawl-unsupported-policy">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="n_Pol" name="simple-crawl-unsupported-policy Lambda">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_CompCmd" name="ComprehensiveCrawlCommand">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_Comp" name="comprehensive-crawl-command Lambda PDF pdfinfo + per-page OCR fan-out, writes tier-1 source, owns downstream emit">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_NotFound" name="markCrawlNotFound crawl = failed not-found, summary = skipped crawl-failed no effects — chain terminates"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Written" name="tier-1 source written: putTierSource (S3 HTML + metadata sidecar), markCrawlStage crawl-content-uploaded, updateFetchTimestamp (etag/lastModified/bodyHash), adoptCanonicalIdentity (best-effort alias claim)"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_Tier" name="TierContentExtractedEvent url, tier-1, userId, extractedAt">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_SelQ" name="SQS select-most-complete-content">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_Sel" name="select-most-complete-content Lambda lists per-tier sources, Deepseek contest when competing, sole canonical promoter">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_LS" name="LinkSavedEvent (only on canonical change)">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_CCC" name="CanonicalContentChangedEvent (tier flip or readable-text change)">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_CAC" name="CrawlArticleCompletedEvent (every successful selection)">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="n_LSQ" name="SQS link-saved">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="n_LSL" name="link-saved Lambda">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="n_GS" name="GenerateSummaryCommand (SQS dispatch — summary pipeline boundary)">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="f_1" name="unsupported (non-HTML body): markCrawlStage comprehensive-fetching, result tier-1-deferred, no further event" sourceRef="n_Work" targetRef="n_Unsup" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Unsup" targetRef="n_PolQ" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_PolQ" targetRef="n_Pol" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Pol" targetRef="n_CompCmd" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_CompCmd" targetRef="n_Comp" />
    <bpmn:sequenceFlow id="f_9" name="on success (save flavour)" sourceRef="n_Comp" targetRef="n_Tier" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_Tier" targetRef="n_SelQ" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_SelQ" targetRef="n_Sel" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Sel" targetRef="n_LS" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_Sel" targetRef="n_CCC" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_Sel" targetRef="n_CAC" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_LS" targetRef="n_LSQ" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_LSQ" targetRef="n_LSL" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_LSL" targetRef="n_GS" />
    <bpmn:association id="f_0" sourceRef="n_Work" targetRef="n_CB" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_Work" targetRef="n_NotFound" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_Work" targetRef="n_Written" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_Written" targetRef="n_Tier" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_in_process_enrichment">
    <bpmndi:BPMNPlane id="Plane_in_process_enrichment" bpmnElement="Process_in_process_enrichment">
