<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_worker_outcomes" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_worker_outcomes" name="worker-outcomes" isExecutable="false">
    <bpmn:dataStoreReference id="n_FIFO" name="select-article-content-q.fifo one in flight per article group"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_WORK" name="select-article-content worker parse command, pick policy by sourceKind">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_POL" name="source policy tier, reselect: mode save recrawl: mode recrawl refresh: mode refresh">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_PREP" name="prepare selection list tier sources, read row">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ART" name="articles table"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_CB" name="content bucket tier sources + canonical"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_REF" name="refresh refusal purged, unsupported, row newer">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_REFLOG" name="log [RefreshContentExtracted] refused no write">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_JUDGE" name="judge under ledger claim = FIFO message id, TTL 360 s DeepSeek when needed">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="n_ANOM" name="ownership anomaly another owner holds the claim record fails, nothing marked">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_DS" name="DeepSeek content judge">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_PT" name="promoteTier save, reselect">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RPT" name="recrawlPromoteTier">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RTK" name="recrawlTieKeptCanonical">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RC" name="refreshContent">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:outgoing>f_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_NR" name="markNoReadableArticle crawl failed, summary skipped">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_VID" name="YouTube oEmbed card video-card-fallback">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_AW" name="markCrawlAwaitingReader judge deferred">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_VER" name="record crawl version when the body changed">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:incoming>f_21</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_DISP" name="Lambda effect dispatcher">
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:outgoing>f_28</bpmn:outgoing>
      <bpmn:outgoing>f_29</bpmn:outgoing>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_CCC" name="CanonicalContentChangedEvent">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_CAC" name="CrawlArticleCompletedEvent">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_RCD" name="RecrawlCompletedEvent">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sendTask id="n_GS" name="GenerateSummaryCommand">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:outgoing>f_31</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_GSQ" name="generate-summary.fifo grouped per article">
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_WORK" targetRef="n_POL" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_POL" targetRef="n_PREP" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_PREP" targetRef="n_REF" />
    <bpmn:sequenceFlow id="f_6" name="refused" sourceRef="n_REF" targetRef="n_REFLOG" />
    <bpmn:sequenceFlow id="f_7" name="admitted" sourceRef="n_REF" targetRef="n_JUDGE" />
    <bpmn:sequenceFlow id="f_8" name="calls" sourceRef="n_JUDGE" targetRef="n_DS" />
    <bpmn:sequenceFlow id="f_9" name="claim held elsewhere" sourceRef="n_JUDGE" targetRef="n_ANOM" />
    <bpmn:sequenceFlow id="f_10" name="winner, mode save" sourceRef="n_JUDGE" targetRef="n_PT" />
    <bpmn:sequenceFlow id="f_11" name="winner, mode recrawl" sourceRef="n_JUDGE" targetRef="n_RPT" />
    <bpmn:sequenceFlow id="f_12" name="canonical retained, mode recrawl" sourceRef="n_JUDGE" targetRef="n_RTK" />
    <bpmn:sequenceFlow id="f_13" name="winner, mode refresh" sourceRef="n_JUDGE" targetRef="n_RC" />
    <bpmn:sequenceFlow id="f_14" name="nothing readable" sourceRef="n_JUDGE" targetRef="n_VID" />
    <bpmn:sequenceFlow id="f_15" name="card committed" sourceRef="n_VID" targetRef="n_PT" />
    <bpmn:sequenceFlow id="f_16" name="not a video or oEmbed refused" sourceRef="n_VID" targetRef="n_NR" />
    <bpmn:sequenceFlow id="f_17" name="deferred to reader" sourceRef="n_JUDGE" targetRef="n_AW" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_PT" targetRef="n_VER" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_RPT" targetRef="n_VER" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_RC" targetRef="n_VER" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_PT" targetRef="n_DISP" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_RPT" targetRef="n_DISP" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_RTK" targetRef="n_DISP" />
    <bpmn:sequenceFlow id="f_25" name="" sourceRef="n_RC" targetRef="n_DISP" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_NR" targetRef="n_DISP" />
    <bpmn:sequenceFlow id="f_27" name="tier or body changed" sourceRef="n_DISP" targetRef="n_CCC" />
    <bpmn:sequenceFlow id="f_28" name="every promote, no readable" sourceRef="n_DISP" targetRef="n_CAC" />
    <bpmn:sequenceFlow id="f_29" name="recrawl" sourceRef="n_DISP" targetRef="n_RCD" />
    <bpmn:sequenceFlow id="f_30" name="tie kept, or retry crawl-failed summary" sourceRef="n_DISP" targetRef="n_GS" />
    <bpmn:sequenceFlow id="f_31" name="" sourceRef="n_GS" targetRef="n_GSQ" />
    <bpmn:association id="f_0" sourceRef="n_FIFO" targetRef="n_WORK" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_PREP" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_PREP" targetRef="n_CB" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_PT" targetRef="n_CB" associationDirection="One" />
  </bpmn:process>
