<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ingress_routes" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_ingress_routes" name="ingress-routes" isExecutable="false">
    <bpmn:startEvent id="n_TCE" name="TierContentExtractedEvent">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_RCE" name="RecrawlContentExtractedEvent">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_FCE" name="RefreshContentExtractedEvent">
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_RAR" name="ReselectAfterRemovalEvent">
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_BUS" name="EventBridge bus one rule per event">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_TQ" name="select-most-complete-content queue 300 s visibility">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_RQ" name="recrawl-content-extracted queue">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_FQ" name="refresh-content-extracted queue">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_XQ" name="reselect-after-removal queue">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_IDLQ" name="each ingress queue's own -dlq 3 receives, alarm emails">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_ING" name="ingress Lambda one per queue">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_ROUTE" name="SELECTION_ROUTE">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_SEL" name="select in place prepare, judge, commit same work as the worker">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_OUT" name="outcomes and effects see worker diagram">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_ENV" name="EventBridge envelope id non-empty, detail parses for the source kind">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_FAIL" name="log [tag] forward failed record fails, nothing marked">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_CMD" name="SelectArticleContentCommand sourceKind, workId = event id, detail">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="n_GRP" name="MessageGroupId = sha256 article id DedupId = sha256 sourceKind:workId">
      <bpmn:incoming>f_19</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="n_FIFO" name="select-article-content-q.fifo 1,800 s visibility, maxReceiveCount 3"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_ESM" name="event-source mapping SELECTION_FIFO_PROCESSING_ENABLED = false">
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_WORK" name="select-article-content worker Lambda">
      <bpmn:incoming>f_23</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_TCE" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_RCE" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_FCE" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_RAR" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_BUS" targetRef="n_TQ" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_BUS" targetRef="n_RQ" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_BUS" targetRef="n_FQ" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_BUS" targetRef="n_XQ" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_TQ" targetRef="n_ING" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_RQ" targetRef="n_ING" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_FQ" targetRef="n_ING" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_XQ" targetRef="n_ING" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_ING" targetRef="n_ROUTE" />
    <bpmn:sequenceFlow id="f_13" name="select (deployed)" sourceRef="n_ROUTE" targetRef="n_SEL" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_SEL" targetRef="n_OUT" />
    <bpmn:sequenceFlow id="f_15" name="forward" sourceRef="n_ROUTE" targetRef="n_ENV" />
    <bpmn:sequenceFlow id="f_16" name="invalid or send fails" sourceRef="n_ENV" targetRef="n_FAIL" />
    <bpmn:sequenceFlow id="f_17" name="retry, then after 3 receives" sourceRef="n_FAIL" targetRef="n_IDLQ" />
    <bpmn:sequenceFlow id="f_18" name="valid" sourceRef="n_ENV" targetRef="n_CMD" />
    <bpmn:sequenceFlow id="f_19" name="" sourceRef="n_CMD" targetRef="n_GRP" />
    <bpmn:sequenceFlow id="f_23" name="when enabled" sourceRef="n_ESM" targetRef="n_WORK" />
    <bpmn:association id="f_20" sourceRef="n_GRP" targetRef="n_FIFO" associationDirection="One" />
    <bpmn:association id="f_22" sourceRef="n_FIFO" targetRef="n_ESM" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ingress_routes">
    <bpmndi:BPMNPlane id="Plane_ingress_routes" bpmnElement="Process_ingress_routes">
