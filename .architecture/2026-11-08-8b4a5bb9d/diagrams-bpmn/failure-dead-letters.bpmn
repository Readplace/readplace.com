<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_failure_dead_letters" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_failure_dead_letters" name="failure-dead-letters" isExecutable="false">
    <bpmn:dataStoreReference id="n_FIFO" name="select-article-content-q.fifo"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_WORK" name="select-article-content worker">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_ERR" name="why did the record fail?">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_PARSE" name="command does not parse no URL, nothing marked">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_ANOM" name="ownership anomaly nothing marked on any receive">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_FAILED" name="log [tag] record failed deepseek-call-failed line on a provider error">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_WAIT" name="batch item failure retry after 1,800 s later selections for the article wait">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_RC" name="receive count &gt;= 3?">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="n_EXH" name="policy onExhaustion">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_MCE" name="markCrawlExhausted tier, recrawl, reselect">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_CAF" name="CrawlArticleFailedEvent">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_KEEP" name="keep-row refresh: reader keeps current content">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ART" name="articles table"></bpmn:dataStoreReference>
    <bpmn:intermediateCatchEvent id="n_FDLQ" name="select-article-content-dlq.fifo no consumer, kept for redrive">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_ALARM" name="DLQ depth alarm emails the alert address">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_WORK" targetRef="n_ERR" />
    <bpmn:sequenceFlow id="f_2" name="bad body" sourceRef="n_ERR" targetRef="n_PARSE" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_PARSE" targetRef="n_WAIT" />
    <bpmn:sequenceFlow id="f_4" name="judge claim held" sourceRef="n_ERR" targetRef="n_ANOM" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_ANOM" targetRef="n_WAIT" />
    <bpmn:sequenceFlow id="f_6" name="other error" sourceRef="n_ERR" targetRef="n_FAILED" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_FAILED" targetRef="n_RC" />
    <bpmn:sequenceFlow id="f_8" name="no" sourceRef="n_RC" targetRef="n_WAIT" />
    <bpmn:sequenceFlow id="f_9" name="yes" sourceRef="n_RC" targetRef="n_EXH" />
    <bpmn:sequenceFlow id="f_10" name="mark-crawl-exhausted" sourceRef="n_EXH" targetRef="n_MCE" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_MCE" targetRef="n_CAF" />
    <bpmn:sequenceFlow id="f_13" name="keep-row" sourceRef="n_EXH" targetRef="n_KEEP" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_MCE" targetRef="n_WAIT" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_KEEP" targetRef="n_WAIT" />
    <bpmn:sequenceFlow id="f_16" name="after 3 receives" sourceRef="n_WAIT" targetRef="n_FDLQ" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_FDLQ" targetRef="n_ALARM" />
    <bpmn:association id="f_0" sourceRef="n_FIFO" targetRef="n_WORK" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_MCE" targetRef="n_ART" associationDirection="One" />
  </bpmn:process>
