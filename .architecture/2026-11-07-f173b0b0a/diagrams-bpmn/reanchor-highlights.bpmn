<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_reanchor_highlights" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_reanchor_highlights" name="reanchor-highlights" isExecutable="false">
    <bpmn:serviceTask id="n_PT" name="Select content: promote tier on a save">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RPT" name="Recrawl: promote tier">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_RC" name="Select content: freshness refresh changes the body">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_CCC" name="CanonicalContentChanged">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_SLQ" name="[&quot;canonical-content-changed queue">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_SL" name="Summary re-prime, related-articles recompute">
      <bpmn:incoming>f_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_RQ" name="[&quot;reanchor-highlights queue">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_RL" name="reanchor-highlights Lambda">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_RD" name="[&quot;reanchor-highlights DLQ, email alarm">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_UA" name="User-articles table, highlight rows"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_AT" name="Articles table, canonical hash and candidate"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_CB" name="Content bucket"></bpmn:dataStoreReference>
    <bpmn:task id="n_SK" name="No write">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_TH" name="Throw, SQS retry">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="n_MF" name="Metric filters, Readplace/Highlights">
      <bpmn:incoming>f_14</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_W" name="Analytics dashboard widget"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_HR" name="HighlightsReanchored">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_PT" targetRef="n_CCC" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_RPT" targetRef="n_CCC" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_RC" targetRef="n_CCC" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_CCC" targetRef="n_SLQ" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_SLQ" targetRef="n_SL" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_CCC" targetRef="n_RQ" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_RQ" targetRef="n_RL" />
    <bpmn:sequenceFlow id="f_7" name="after receives" sourceRef="n_RQ" targetRef="n_RD" />
    <bpmn:sequenceFlow id="f_12" name="no rows, no snapshot, webmail, row deleted" sourceRef="n_RL" targetRef="n_SK" />
    <bpmn:sequenceFlow id="f_13" name="snapshot changed, stale write" sourceRef="n_RL" targetRef="n_TH" />
    <bpmn:sequenceFlow id="f_14" name="highlights_reanchored line" sourceRef="n_RL" targetRef="n_MF" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_RL" targetRef="n_HR" />
    <bpmn:association id="f_8" sourceRef="n_RL" targetRef="n_UA" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_RL" targetRef="n_AT" associationDirection="One" />
