<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_cancel_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_cancel_flow" name="cancel-flow" isExecutable="false">
    <bpmn:businessRuleTask id="n_User" name="User clicks Cancel">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_AccountPost" name="POST /account/cancel SSR Lambda requireAuth">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_CSC" name="CancelSubscriptionCommand userId">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:dataStoreReference id="n_RedirectUser" name="Browser loads /account shows &quot;Cancellation in progress"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_EB" name="EventBridge">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_CSQueue" name="cancel-subscription SQS queue vis 30s">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_19</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_CSLambda" name="cancel-subscription Lambda findByUserId + branch on status 128 MB / 30 s">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_SubRow" name="subscription_providers row"></bpmn:dataStoreReference>
    <bpmn:businessRuleTask id="n_StripeCall" name="Stripe DELETE /v1/subscriptions/&lt;id&gt; immediate cancel">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateThrowEvent id="n_TrialEmit" name="Emit SubscriptionCancelled userId, reason=user_initiated_trial">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="n_PCEmit" name="Emit SubscriptionCancelled userId, reason=user_initiated_paid_confirmed">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:dataStoreReference id="n_Noop" name="Idempotent noop"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Webhook" name="stripe-webhook-receiver Lambda HMAC verify + findBySubscriptionId then publish with userId + reason=stripe_webhook">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_SCE" name="SubscriptionCancelledEvent userId, subscriptionId?, reason">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="n_HSCQueue" name="handle-subscription-cancelled SQS queue vis 30s">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_HSCLambda" name="handle-subscription-cancelled Lambda markCancelledByUserId 128 MB / 30 s">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_CSDLQ" name="cancel-subscription DLQ">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_21</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_HSCDLQ" name="handle-subscription-cancelled DLQ">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_OperatorEmail" name="Operator email notification">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_User" targetRef="n_AccountPost" />
    <bpmn:sequenceFlow id="f_1" name="publishCancelSubscriptionCommand userId" sourceRef="n_AccountPost" targetRef="n_CSC" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_CSC" targetRef="n_EB" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_EB" targetRef="n_CSQueue" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_CSQueue" targetRef="n_CSLambda" />
    <bpmn:sequenceFlow id="f_7" name="status=active" sourceRef="n_CSLambda" targetRef="n_StripeCall" />
    <bpmn:sequenceFlow id="f_8" name="status=trialing" sourceRef="n_CSLambda" targetRef="n_TrialEmit" />
    <bpmn:sequenceFlow id="f_9" name="status=pending_cancellation defensive" sourceRef="n_CSLambda" targetRef="n_PCEmit" />
    <bpmn:sequenceFlow id="f_11" name="customer.subscription.deleted" sourceRef="n_StripeCall" targetRef="n_Webhook" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Webhook" targetRef="n_SCE" />
    <bpmn:sequenceFlow id="f_13" name="" sourceRef="n_TrialEmit" targetRef="n_SCE" />
    <bpmn:sequenceFlow id="f_14" name="" sourceRef="n_PCEmit" targetRef="n_SCE" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_SCE" targetRef="n_EB" />
    <bpmn:sequenceFlow id="f_16" name="" sourceRef="n_EB" targetRef="n_HSCQueue" />
    <bpmn:sequenceFlow id="f_17" name="" sourceRef="n_HSCQueue" targetRef="n_HSCLambda" />
    <bpmn:sequenceFlow id="f_19" name="exhausted retries" sourceRef="n_CSQueue" targetRef="n_CSDLQ" />
    <bpmn:sequenceFlow id="f_20" name="exhausted retries" sourceRef="n_HSCQueue" targetRef="n_HSCDLQ" />
    <bpmn:sequenceFlow id="f_21" name="SNS alarm" sourceRef="n_CSDLQ" targetRef="n_OperatorEmail" />
    <bpmn:sequenceFlow id="f_22" name="SNS alarm" sourceRef="n_HSCDLQ" targetRef="n_OperatorEmail" />
    <bpmn:association id="f_2" sourceRef="n_AccountPost" targetRef="n_RedirectUser" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_SubRow" targetRef="n_CSLambda" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_CSLambda" targetRef="n_Noop" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_HSCLambda" targetRef="n_SubRow" associationDirection="One" />
  </bpmn:process>
