      <bpmndi:BPMNShape id="n_CancelledBranch_di" bpmnElement="n_CancelledBranch">
        <dc:Bounds x="237.25" y="273.5" width="173.25" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_ActiveNoop_di" bpmnElement="n_ActiveNoop">
        <dc:Bounds x="446.5" y="260" width="113.52" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Forbidden_di" bpmnElement="n_Forbidden">
        <dc:Bounds x="596.02" y="266.75" width="175.34" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_StoreSignup_di" bpmnElement="n_StoreSignup">
        <dc:Bounds x="310.3" y="397" width="178.75" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Stripe_di" bpmnElement="n_Stripe">
        <dc:Bounds x="335.43" y="539" width="128.5" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Success_di" bpmnElement="n_Success">
        <dc:Bounds x="309.68" y="649" width="180" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_UpsertActive_di" bpmnElement="n_UpsertActive">
        <dc:Bounds x="218.26" y="775" width="190" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SubRow_di" bpmnElement="n_SubRow">
        <dc:Bounds x="311.46" y="939" width="176.44" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Queue_di" bpmnElement="n_Queue">
        <dc:Bounds x="444.26" y="795.25" width="136.84" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_0_di" bpmnElement="f_0">
        <di:waypoint x="399.68" y="76" />
        <di:waypoint x="399.68" y="134" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_1_di" bpmnElement="f_1">
        <di:waypoint x="399.68" y="202" />
