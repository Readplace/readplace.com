<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_process_book" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_process_book" name="process-book" isExecutable="false">
    <bpmn:startEvent id="n_Committed" name="MediaUploadCommitted kind = book">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_Q" name="media-book-process-book-q">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_P" name="media-book-process-book Lambda">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Media" name="media bucket pending/&lt;uploadId&gt;/original"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Row" name="articles table media.sectionCount"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_Content" name="content bucket tier-0 source"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_Extracted" name="TierContentExtracted">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_Select" name="select-most-complete-content">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="n_Failed" name="MediaProcessingFailed">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="n_Settle" name="settle-media-failure">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:task id="n_DLQ" name="media-book-failures DLQ">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_Router" name="media-book-failures-dlq Lambda">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_Committed" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Q" targetRef="n_P" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_P" targetRef="n_Extracted" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Extracted" targetRef="n_Select" />
    <bpmn:sequenceFlow id="f_7" name="staged-bytes-gone / unreadable / too-large-for-reader" sourceRef="n_P" targetRef="n_Failed" />
    <bpmn:sequenceFlow id="f_8" name="after 2 receives" sourceRef="n_Q" targetRef="n_DLQ" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_DLQ" targetRef="n_Router" />
    <bpmn:sequenceFlow id="f_10" name="processing-exhausted" sourceRef="n_Router" targetRef="n_Failed" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_Failed" targetRef="n_Settle" />
    <bpmn:association id="f_2" sourceRef="n_P" targetRef="n_Media" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_P" targetRef="n_Row" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_P" targetRef="n_Content" associationDirection="One" />
  </bpmn:process>
