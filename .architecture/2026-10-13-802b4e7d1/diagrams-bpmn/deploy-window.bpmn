<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_deploy_window" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_deploy_window" name="deploy-window" isExecutable="false">
    <bpmn:serviceTask id="n_OLDH" name="hutch before its deploy publishes no captureTrigger">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_NEWH" name="hutch after its deploy always publishes captureTrigger">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_OLDMSG" name="SaveLinkRawHtmlCommand without captureTrigger">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_NEWMSG" name="SaveLinkRawHtmlCommand with captureTrigger">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="save-link-raw-html-command queue">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_OLDW" name="raw-html Lambda before its deploy strips the unknown key">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_NEWW" name="raw-html Lambda after its deploy requires captureTrigger">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_TAPPED" name="manifest without a trigger read as a tapped capture, nothing lost">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_REJECT" name="rejected on three receives">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="n_FDLQ" name="save-link-failures shared DLQ arrival alarm emails the operator">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_DH" name="raw-html dead-letter handler parses only url">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_TERM" name="markCrawlExhausted terminal: the capture is lost">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="n_READER" name="reader captures the page again unless another candidate made it readable">
      <bpmn:incoming>f_11</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_OLDH" targetRef="n_OLDMSG" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_NEWH" targetRef="n_NEWMSG" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_OLDMSG" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_NEWMSG" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_4" name="hutch deployed first" sourceRef="n_Q" targetRef="n_OLDW" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_OLDW" targetRef="n_TAPPED" />
    <bpmn:sequenceFlow id="f_6" name="save-link deployed first" sourceRef="n_Q" targetRef="n_NEWW" />
    <bpmn:sequenceFlow id="f_7" name="old message" sourceRef="n_NEWW" targetRef="n_REJECT" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_REJECT" targetRef="n_FDLQ" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_FDLQ" targetRef="n_DH" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_DH" targetRef="n_TERM" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_TERM" targetRef="n_READER" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_deploy_window">
    <bpmndi:BPMNPlane id="Plane_deploy_window" bpmnElement="Process_deploy_window">
      <bpmndi:BPMNShape id="n_OLDH_di" bpmnElement="n_OLDH">
        <dc:Bounds x="43.5" y="36" width="202.75" height="52" />
