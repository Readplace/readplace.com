<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_raw_html_worker" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_raw_html_worker" name="raw-html-worker" isExecutable="false">
    <bpmn:sendTask id="n_RAW" name="SaveLinkRawHtmlCommand captureTrigger required">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_BUS" name="hutch event bus save-link-raw-html-command-rule on source and detail-type, unchanged">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_Q" name="save-link-raw-html-command queue visibility 480 s, 3 receives, shared DLQ">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_W" name="save-link-raw-html-command Lambda parses the full detail">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_PARSE" name="detail parses?">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="n_RETRY" name="batch item failure SQS redelivers">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_PEND" name="pending-html bucket"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_FIN" name="finalizeArticle readability parse of the staged capture">
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_OK" name="parsed, or a wrapper source?">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="n_MCF" name="markCrawlFailed parse-error then a batch item failure">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_ART" name="articles table"></bpmn:dataStoreReference>
    <bpmn:task id="n_PROV" name="candidateProvenance kind extension, attemptId, contentHash, captureTrigger">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_MAN" name="content bucket tier-0 manifest with captureTrigger, reader and evaluation bodies"></bpmn:dataStoreReference>
    <bpmn:task id="n_LOG" name="log line: tier-0 source written url, capturedTitle, captureTrigger">
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_TCE" name="TierContentExtractedEvent saveAttemptId, candidates, url, userId, extractedAt">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_RAW" targetRef="n_BUS" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_BUS" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_Q" targetRef="n_W" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_W" targetRef="n_PARSE" />
    <bpmn:sequenceFlow id="f_4" name="no" sourceRef="n_PARSE" targetRef="n_RETRY" />
    <bpmn:sequenceFlow id="f_5" name="next receive" sourceRef="n_RETRY" targetRef="n_Q" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_FIN" targetRef="n_OK" />
    <bpmn:sequenceFlow id="f_9" name="no" sourceRef="n_OK" targetRef="n_MCF" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_MCF" targetRef="n_RETRY" />
    <bpmn:sequenceFlow id="f_12" name="yes" sourceRef="n_OK" targetRef="n_PROV" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_LOG" targetRef="n_TCE" />
    <bpmn:association id="f_6" sourceRef="n_PARSE" targetRef="n_PEND" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_PEND" targetRef="n_FIN" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_MCF" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_PROV" targetRef="n_MAN" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_MAN" targetRef="n_LOG" associationDirection="One" />
  </bpmn:process>
