<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_dead_letter" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_dead_letter" name="dead-letter" isExecutable="false">
    <bpmn:intermediateCatchEvent id="n_Q" name="save-link-raw-html-command queue">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="n_FDLQ" name="save-link-failures shared DLQ arrival alarm emails the operator">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_ROUTER" name="save-link-failures-dlq Lambda dead-letter router, routes by source queue">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_DH" name="raw-html dead-letter handler parses only url">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_BAD" name="batch item failure no url in the detail">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_MCE" name="markCrawlExhausted reason exhausted-retries">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_ROW" name="crawl state of the row">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_READY" name="ready: no change, no event">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_PENDING" name="pending: failed with exhausted-retries, a pending summary fails too">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_FAILED" name="failed: the existing reason is kept">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="n_ART" name="articles table"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_CAF" name="CrawlArticleFailedEvent every row that is not ready">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="third failed receive" sourceRef="n_Q" targetRef="n_FDLQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_FDLQ" targetRef="n_ROUTER" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_ROUTER" targetRef="n_DH" />
    <bpmn:sequenceFlow id="f_3" name="no url" sourceRef="n_DH" targetRef="n_BAD" />
    <bpmn:sequenceFlow id="f_4" name="redelivered from the shared DLQ" sourceRef="n_BAD" targetRef="n_FDLQ" />
    <bpmn:sequenceFlow id="f_5" name="url" sourceRef="n_DH" targetRef="n_MCE" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_MCE" targetRef="n_ROW" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_ROW" targetRef="n_READY" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_ROW" targetRef="n_PENDING" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_ROW" targetRef="n_FAILED" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_PENDING" targetRef="n_CAF" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_FAILED" targetRef="n_CAF" />
    <bpmn:association id="f_10" sourceRef="n_PENDING" targetRef="n_ART" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_dead_letter">
    <bpmndi:BPMNPlane id="Plane_dead_letter" bpmnElement="Process_dead_letter">
