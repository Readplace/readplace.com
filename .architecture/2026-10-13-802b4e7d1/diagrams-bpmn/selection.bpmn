<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_selection" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_selection" name="selection" isExecutable="false">
    <bpmn:startEvent id="n_TCE" name="TierContentExtractedEvent">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="n_SQ" name="select-most-complete-content queue shared DLQ">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="n_SEL" name="select-most-complete-content Lambda lists this save's candidates and the canonical">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_MAN" name="tier-0 manifest captureTrigger"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_VER" name="verify provenance a tier-0 candidate must keep kind extension">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_RULE" name="which rule applies?">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="n_FC" name="first-capture a lone tapped capture is the first content: kind extension, captureTrigger not automatic">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="n_TIE" name="unchanged-content tie resolved without the judge">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_JUDGE" name="content judge">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:outgoing>f_11</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:outgoing>f_16</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_FALLBACK" name="provider-rejected-fallback readable candidates with a 2xx or no status">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_RETRY" name="batch item failure retried, then the shared DLQ">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_OWN" name="own-capture-over-verdict a readable tapped capture of this save, no canonical yet">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_PROMO" name="promoteTier canonical written, crawl ready">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_NR" name="markNoReadableArticle crawl failed, summary skipped">
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_RET" name="canonical retained">
      <bpmn:incoming>f_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_ART" name="articles table"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_CAC" name="CrawlArticleCompletedEvent">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="n_CHG" name="CanonicalContentChangedEvent and LinkSavedEvent when the canonical changes">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="n_LOGC" name="COMPARISON_COMPLETED log line each candidate's captureTrigger, selectionRule, ownCaptureFailed">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="n_ALARM" name="select-content-own-capture-failed-alarm raised by a failed tapped capture only">
      <bpmn:incoming>f_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_TCE" targetRef="n_SQ" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_SQ" targetRef="n_SEL" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_SEL" targetRef="n_VER" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_VER" targetRef="n_RULE" />
    <bpmn:sequenceFlow id="f_5" name="a lone tapped capture, first content" sourceRef="n_RULE" targetRef="n_FC" />
    <bpmn:sequenceFlow id="f_6" name="every candidate repeats the committed prose" sourceRef="n_RULE" targetRef="n_TIE" />
    <bpmn:sequenceFlow id="f_7" name="anything else, including every automatic capture" sourceRef="n_RULE" targetRef="n_JUDGE" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_FC" targetRef="n_PROMO" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_TIE" targetRef="n_PROMO" />
    <bpmn:sequenceFlow id="f_10" name="winner" sourceRef="n_JUDGE" targetRef="n_PROMO" />
    <bpmn:sequenceFlow id="f_11" name="provider rejected" sourceRef="n_JUDGE" targetRef="n_FALLBACK" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_FALLBACK" targetRef="n_PROMO" />
    <bpmn:sequenceFlow id="f_13" name="judge error" sourceRef="n_JUDGE" targetRef="n_RETRY" />
    <bpmn:sequenceFlow id="f_14" name="none, readable tapped capture of this save" sourceRef="n_JUDGE" targetRef="n_OWN" />
    <bpmn:sequenceFlow id="f_15" name="" sourceRef="n_OWN" targetRef="n_PROMO" />
    <bpmn:sequenceFlow id="f_16" name="none, committed content" sourceRef="n_JUDGE" targetRef="n_RET" />
    <bpmn:sequenceFlow id="f_17" name="none, nothing kept, no canonical" sourceRef="n_JUDGE" targetRef="n_NR" />
    <bpmn:sequenceFlow id="f_20" name="" sourceRef="n_PROMO" targetRef="n_CAC" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_PROMO" targetRef="n_CHG" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_NR" targetRef="n_CAC" />
    <bpmn:sequenceFlow id="f_23" name="" sourceRef="n_SEL" targetRef="n_LOGC" />
    <bpmn:sequenceFlow id="f_24" name="" sourceRef="n_LOGC" targetRef="n_ALARM" />
    <bpmn:association id="f_2" sourceRef="n_SEL" targetRef="n_MAN" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_PROMO" targetRef="n_ART" associationDirection="One" />
    <bpmn:association id="f_19" sourceRef="n_NR" targetRef="n_ART" associationDirection="One" />
  </bpmn:process>
