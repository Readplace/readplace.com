<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_save_content_intake" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_save_content_intake" name="save-content-intake" isExecutable="false">
    <bpmn:startEvent id="n_EXT" name="Browser extension upload inline or through an upload slot">
      <bpmn:outgoing>f_0</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_APP" name="iOS and Android uploads share sheet, deferred drain, reader capture">
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="n_CANARY" name="Tier 1+ canary upload">
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="n_SIREN" name="Siren save-content action url, content, mediaType, title, size, captureTrigger">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_SC" name="POST /queue/save-content hutch web Lambda">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_MP" name="multipart body?">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_R422M" name="422 invalid-save-content multipart body required">
      <bpmn:incoming>f_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="n_TRIG" name="captureTrigger part">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_MANUAL" name="manual what every shipped client sends">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_SENT" name="automatic or manual as sent">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_R422T" name="422 invalid-save-content captureTrigger must be automatic or manual nothing staged">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="n_LEG" name="which leg?">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_INLINE" name="inline capture validate URL, refresh freshness">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_SUBMIT" name="SubmitLinkCommand unresolved wrapper: 409 queued notice, bytes dropped">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_SLOT" name="upload-slot request trigger checked, not used">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="n_SLOTENT" name="200 upload-slot entity upload-content PUT and save-uploaded-content POST">
      <bpmn:incoming>f_18</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="n_DONE" name="upload completion stat the staged object, size and age checks">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_PEND" name="pending-html bucket keyed by url and saveAttemptId"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_ATTACH" name="attach the save article and user-article rows">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_ROWS" name="articles and user-articles tables"></bpmn:dataStoreReference>
    <bpmn:sendTask id="n_SLC" name="SaveLinkCommand tier-1 crawl on a first save, unchanged">
      <bpmn:incoming>f_24</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_RAW" name="SaveLinkRawHtmlCommand url, saveAttemptId, sourceUrl, sourceOriginalUrl, userId, title, captureTrigger">
      <bpmn:incoming>f_25</bpmn:incoming>
      <bpmn:incoming>f_29</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="n_PDF" name="SaveLinkRawPdfCommand PDF bytes, unchanged, no trigger">
      <bpmn:incoming>f_17</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_R201" name="201 saved article entity">
      <bpmn:incoming>f_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="n_BULK" name="Browser extension Save All Tabs">
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_SA" name="POST /queue/save-articles one staged page per captured tab">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_BULKM" name="captureTrigger manual">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:outgoing>f_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_EXT" targetRef="n_SIREN" />
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_APP" targetRef="n_SIREN" />
    <bpmn:sequenceFlow id="f_2" name="" sourceRef="n_CANARY" targetRef="n_SIREN" />
    <bpmn:sequenceFlow id="f_3" name="follow the action" sourceRef="n_SIREN" targetRef="n_SC" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_SC" targetRef="n_MP" />
    <bpmn:sequenceFlow id="f_5" name="no" sourceRef="n_MP" targetRef="n_R422M" />
    <bpmn:sequenceFlow id="f_6" name="yes" sourceRef="n_MP" targetRef="n_TRIG" />
    <bpmn:sequenceFlow id="f_7" name="absent" sourceRef="n_TRIG" targetRef="n_MANUAL" />
    <bpmn:sequenceFlow id="f_8" name="automatic or manual" sourceRef="n_TRIG" targetRef="n_SENT" />
    <bpmn:sequenceFlow id="f_9" name="anything else" sourceRef="n_TRIG" targetRef="n_R422T" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_MANUAL" targetRef="n_LEG" />
    <bpmn:sequenceFlow id="f_11" name="" sourceRef="n_SENT" targetRef="n_LEG" />
    <bpmn:sequenceFlow id="f_12" name="content part" sourceRef="n_LEG" targetRef="n_INLINE" />
    <bpmn:sequenceFlow id="f_13" name="size" sourceRef="n_LEG" targetRef="n_SLOT" />
    <bpmn:sequenceFlow id="f_14" name="uploaded=true" sourceRef="n_LEG" targetRef="n_DONE" />
    <bpmn:sequenceFlow id="f_15" name="original unresolved" sourceRef="n_INLINE" targetRef="n_SUBMIT" />
    <bpmn:sequenceFlow id="f_17" name="application/pdf" sourceRef="n_INLINE" targetRef="n_PDF" />
    <bpmn:sequenceFlow id="f_18" name="" sourceRef="n_SLOT" targetRef="n_SLOTENT" />
    <bpmn:sequenceFlow id="f_21" name="" sourceRef="n_INLINE" targetRef="n_ATTACH" />
    <bpmn:sequenceFlow id="f_22" name="" sourceRef="n_DONE" targetRef="n_ATTACH" />
    <bpmn:sequenceFlow id="f_24" name="first save" sourceRef="n_ATTACH" targetRef="n_SLC" />
    <bpmn:sequenceFlow id="f_25" name="after the rows exist" sourceRef="n_ATTACH" targetRef="n_RAW" />
    <bpmn:sequenceFlow id="f_26" name="" sourceRef="n_ATTACH" targetRef="n_R201" />
    <bpmn:sequenceFlow id="f_27" name="" sourceRef="n_BULK" targetRef="n_SA" />
    <bpmn:sequenceFlow id="f_28" name="" sourceRef="n_SA" targetRef="n_BULKM" />
    <bpmn:sequenceFlow id="f_29" name="" sourceRef="n_BULKM" targetRef="n_RAW" />
    <bpmn:association id="f_16" sourceRef="n_INLINE" targetRef="n_PEND" associationDirection="One" />
    <bpmn:association id="f_19" sourceRef="n_SLOTENT" targetRef="n_PEND" associationDirection="One" />
    <bpmn:association id="f_20" sourceRef="n_PEND" targetRef="n_DONE" associationDirection="One" />
    <bpmn:association id="f_23" sourceRef="n_ATTACH" targetRef="n_ROWS" associationDirection="One" />
  </bpmn:process>
