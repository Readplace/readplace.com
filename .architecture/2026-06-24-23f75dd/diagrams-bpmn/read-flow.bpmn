<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_read_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_read_flow" name="read-flow" isExecutable="false">
    <bpmn:sendTask id="n_navList" name="GET /inbox">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_listSys" name="inbox.page.ts GET /">
      <bpmn:incoming>f_0</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_emailStore" name="inbox-emails table listEmailsByUserId, newest first"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_listView" name="Gmail-style list sender, subject, time, badge"></bpmn:serviceTask>
    <bpmn:sendTask id="n_navDetail" name="GET /inbox/:id">
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_detailSys" name="inbox.page.ts GET /:id">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_getRow" name="inbox-emails table getEmail PK=userId scoped"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_contentS3" name="content bucket sanitized body HTML"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_iframe" name="View tab: sandboxed iframe no allow-scripts/same-origin default-src none CSP"></bpmn:serviceTask>
    <bpmn:endEvent id="n_articles" name="Articles tab — M3 placeholder">
      <bpmn:incoming>f_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_navAddr" name="GET /inbox/addresses">
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_addrSys" name="inbox.page.ts GET /addresses moved M1 management">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_addrStore" name="inbox-addresses table"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_navList" targetRef="n_listSys" />
    <bpmn:sequenceFlow id="f_3" name="" sourceRef="n_navDetail" targetRef="n_detailSys" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_detailSys" targetRef="n_articles" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_navAddr" targetRef="n_addrSys" />
    <bpmn:association id="f_1" sourceRef="n_listSys" targetRef="n_emailStore" associationDirection="One" />
    <bpmn:association id="f_2" sourceRef="n_emailStore" targetRef="n_listView" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_detailSys" targetRef="n_getRow" associationDirection="One" />
    <bpmn:association id="f_5" sourceRef="n_detailSys" targetRef="n_contentS3" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_contentS3" targetRef="n_iframe" associationDirection="One" />
    <bpmn:association id="f_9" sourceRef="n_addrSys" targetRef="n_addrStore" associationDirection="One" />
  </bpmn:process>
