<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_inbound_receive_flow" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_inbound_receive_flow" name="inbound-receive-flow" isExecutable="false">
    <bpmn:sendTask id="n_sender" name="Forwarded newsletter to in-&lt;token&gt;@read.place">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="n_ses" name="SES receipt rule recipients = mail domain">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_rawS3" name="Raw .eml bucket inbound/&lt;sesMessageId&gt; — kept forever"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_sns" name="SNS receipt topic">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="n_queue" name="receive-email SQS queue">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="n_dlq" name="receive-email DLQ + CloudWatch alarm -&gt; SNS email">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="n_handler" name="receive-email Lambda receive-email-handler.ts">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_addrStore" name="inbox-addresses table findByAddress"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_parse" name="parse-email.ts postal-mime + cid preparser">
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_store" name="store-email-body.ts sanitize-html + data: inline -&gt; content bucket">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_emailStore" name="inbox-emails table conditional putEmail"></bpmn:dataStoreReference>
    <bpmn:intermediateThrowEvent id="n_evt" name="EmailReceivedEvent userId, receivedAtMessageId, recipientAddress">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="n_m3" name="M3 consumer — deferred">
      <bpmn:incoming>f_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_sender" targetRef="n_ses" />
    <bpmn:sequenceFlow id="f_2" name="topicArn" sourceRef="n_ses" targetRef="n_sns" />
    <bpmn:sequenceFlow id="f_3" name="raw delivery" sourceRef="n_sns" targetRef="n_queue" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_queue" targetRef="n_handler" />
    <bpmn:sequenceFlow id="f_5" name="maxReceiveCount" sourceRef="n_queue" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_8" name="" sourceRef="n_handler" targetRef="n_parse" />
    <bpmn:sequenceFlow id="f_9" name="" sourceRef="n_parse" targetRef="n_store" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_handler" targetRef="n_evt" />
    <bpmn:sequenceFlow id="f_13" name="OCP seam" sourceRef="n_evt" targetRef="n_m3" />
    <bpmn:association id="f_1" sourceRef="n_ses" targetRef="n_rawS3" associationDirection="One" />
    <bpmn:association id="f_6" sourceRef="n_handler" targetRef="n_rawS3" associationDirection="One" />
    <bpmn:association id="f_7" sourceRef="n_handler" targetRef="n_addrStore" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_store" targetRef="n_emailStore" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_handler" targetRef="n_emailStore" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_inbound_receive_flow">
    <bpmndi:BPMNPlane id="Plane_inbound_receive_flow" bpmnElement="Process_inbound_receive_flow">
      <bpmndi:BPMNShape id="n_sender_di" bpmnElement="n_sender">
        <dc:Bounds x="277.17" y="28" width="189.25" height="52" />
