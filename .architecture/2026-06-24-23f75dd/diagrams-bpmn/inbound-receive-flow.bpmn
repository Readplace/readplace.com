      <bpmndi:BPMNShape id="n_addrStore_di" bpmnElement="n_addrStore">
        <dc:Bounds x="571.49" y="624" width="144.1" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_parse_di" bpmnElement="n_parse">
        <dc:Bounds x="234.28" y="629.5" width="140.25" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_store_di" bpmnElement="n_store">
        <dc:Bounds x="185.54" y="771" width="199" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_emailStore_di" bpmnElement="n_emailStore">
        <dc:Bounds x="303.81" y="897" width="135.96" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_evt_di" bpmnElement="n_evt">
        <dc:Bounds x="453.01" y="614" width="40" height="40" />
