<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_degrade_with_alert" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_degrade_with_alert" name="degrade-with-alert" isExecutable="false">
    <bpmn:serviceTask id="n_rec" name="receive-email handler per record">
      <bpmn:outgoing>f_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_badNote" name="SES notification valid?">
      <bpmn:incoming>f_0</bpmn:incoming>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_raw" name="raw .eml readable?">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_fwd" name="recipient is a forwarding address?">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_size" name="size &lt;= 20 MiB?">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_known" name="recipient resolved?">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_enabled" name="address enabled?">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_parsed" name="body parses?">
      <bpmn:incoming>f_15</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_dlq" name="DLQ + alarm">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="n_rejUnrouted" name="rejected row unrouted partition"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_rejOwner" name="rejected row owner partition"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_unparsed" name="unparsed row owner partition"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="n_received" name="received row + bodyS3Key"></bpmn:dataStoreReference>
    <bpmn:endEvent id="n_evt" name="publish EmailReceivedEvent">

      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_0" name="" sourceRef="n_rec" targetRef="n_badNote" />
    <bpmn:sequenceFlow id="f_1" name="no" sourceRef="n_badNote" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_2" name="yes" sourceRef="n_badNote" targetRef="n_raw" />
    <bpmn:sequenceFlow id="f_3" name="no (retry)" sourceRef="n_raw" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_4" name="yes" sourceRef="n_raw" targetRef="n_fwd" />
    <bpmn:sequenceFlow id="f_5" name="no" sourceRef="n_fwd" targetRef="n_dlq" />
    <bpmn:sequenceFlow id="f_6" name="yes" sourceRef="n_fwd" targetRef="n_size" />
    <bpmn:sequenceFlow id="f_9" name="yes" sourceRef="n_size" targetRef="n_known" />
    <bpmn:sequenceFlow id="f_12" name="yes" sourceRef="n_known" targetRef="n_enabled" />
    <bpmn:sequenceFlow id="f_15" name="yes" sourceRef="n_enabled" targetRef="n_parsed" />
    <bpmn:association id="f_7" sourceRef="n_size" targetRef="n_rejOwner" associationDirection="One" />
    <bpmn:association id="f_8" sourceRef="n_rejOwner" targetRef="n_dlq" associationDirection="One" />
    <bpmn:association id="f_10" sourceRef="n_known" targetRef="n_rejUnrouted" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_rejUnrouted" targetRef="n_dlq" associationDirection="One" />
    <bpmn:association id="f_13" sourceRef="n_enabled" targetRef="n_rejOwner" associationDirection="One" />
    <bpmn:association id="f_14" sourceRef="n_rejOwner" targetRef="n_dlq" associationDirection="One" />
    <bpmn:association id="f_16" sourceRef="n_parsed" targetRef="n_unparsed" associationDirection="One" />
    <bpmn:association id="f_17" sourceRef="n_unparsed" targetRef="n_dlq" associationDirection="One" />
    <bpmn:association id="f_18" sourceRef="n_parsed" targetRef="n_received" associationDirection="One" />
    <bpmn:association id="f_19" sourceRef="n_received" targetRef="n_evt" associationDirection="One" />
  </bpmn:process>
