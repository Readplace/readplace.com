<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_activate_checkout" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_activate_checkout" name="activate-checkout" isExecutable="false">
    <bpmn:task id="n_Start" name="activateCheckout"></bpmn:task>
    <bpmn:dataStoreReference id="n_Claim" name="claim pending row SET consumedAt, activatedBy if exists, unclaimed, existing-user"></bpmn:dataStoreReference>
    <bpmn:exclusiveGateway id="n_Won" name="claim outcome">
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="n_Lost" name="already-activated + returnUrl, or not-found: nothing runs">
      <bpmn:incoming>f_2</bpmn:incoming>
    </bpmn:task>
    <bpmn:dataStoreReference id="n_Upsert" name="subscription-providers row status active, statusEnteredAt"></bpmn:dataStoreReference>
    <bpmn:task id="n_Log" name="checkout_completed log line paid_now from amountTotal, activated_by">
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_Clear" name="delete trial-end and trial-reminder schedules failure logged">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_Reminder" name="create charge-reminder schedule when trial end kept failure logged">
      <bpmn:incoming>f_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_2" name="lost" sourceRef="n_Won" targetRef="n_Lost" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Log" targetRef="n_Clear" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Clear" targetRef="n_Reminder" />
    <bpmn:association id="f_0" sourceRef="n_Start" targetRef="n_Claim" associationDirection="One" />
    <bpmn:association id="f_1" sourceRef="n_Claim" targetRef="n_Won" associationDirection="One" />
    <bpmn:association id="f_3" sourceRef="n_Won" targetRef="n_Upsert" associationDirection="One" />
    <bpmn:association id="f_4" sourceRef="n_Upsert" targetRef="n_Log" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_activate_checkout">
    <bpmndi:BPMNPlane id="Plane_activate_checkout" bpmnElement="Process_activate_checkout">
      <bpmndi:BPMNShape id="n_Start_di" bpmnElement="n_Start">
        <dc:Bounds x="162.97" y="28" width="136.75" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Claim_di" bpmnElement="n_Claim">
