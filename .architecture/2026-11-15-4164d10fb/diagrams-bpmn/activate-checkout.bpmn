      <bpmndi:BPMNEdge id="f_2_di" bpmnElement="f_2">
        <di:waypoint x="231.34" y="365.53" />
        <di:waypoint x="231.34" y="409.65" />
        <di:waypoint x="125.13" y="409.65" />
        <di:waypoint x="125.13" y="453.78" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_5_di" bpmnElement="f_5">
