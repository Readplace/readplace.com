<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_two_arrivals" targetNamespace="http://readplace.com/architecture/bpmn">
  <bpmn:process id="Process_two_arrivals" name="two-arrivals" isExecutable="false">
    <bpmn:serviceTask id="n_Subscribe" name="POST /account/subscribe">
      <bpmn:outgoing>f_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="n_Pending" name="pending-signups row keyed by checkout session id"></bpmn:dataStoreReference>
    <bpmn:serviceTask id="n_Stripe" name="Stripe Checkout reader pays">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_Success" name="GET /auth/checkout/success retrieve session, paid and complete">
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_Webhook" name="POST /webhooks/stripe checkout.session.completed subscription, complete, not unpaid">
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="n_Completed" name="CheckoutCompleted session, subscription, customer, amountTotal">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="n_Bus" name="[&quot;EventBridge bus">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_SubQ" name="[&quot;subscription-events-q">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
      <bpmn:outgoing>f_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_SubDlq" name="[&quot;subscription-events-dlq">
      <bpmn:incoming>f_8</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_SubLambda" name="subscription-events Lambda checkout-completed handler">
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_Activate" name="activateCheckout activatedBy redirect or webhook">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:incoming>f_10</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="n_Redirect" name="303 to the stored return URL 409 only when no pending row">
      <bpmn:incoming>f_12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_1" name="" sourceRef="n_Subscribe" targetRef="n_Stripe" />
    <bpmn:sequenceFlow id="f_2" name="browser redirect" sourceRef="n_Stripe" targetRef="n_Success" />
    <bpmn:sequenceFlow id="f_3" name="signed webhook" sourceRef="n_Stripe" targetRef="n_Webhook" />
    <bpmn:sequenceFlow id="f_4" name="" sourceRef="n_Webhook" targetRef="n_Completed" />
    <bpmn:sequenceFlow id="f_5" name="" sourceRef="n_Completed" targetRef="n_Bus" />
    <bpmn:sequenceFlow id="f_6" name="" sourceRef="n_Bus" targetRef="n_SubQ" />
    <bpmn:sequenceFlow id="f_7" name="" sourceRef="n_SubQ" targetRef="n_SubLambda" />
    <bpmn:sequenceFlow id="f_8" name="after retries" sourceRef="n_SubQ" targetRef="n_SubDlq" />
    <bpmn:sequenceFlow id="f_9" name="inline" sourceRef="n_Success" targetRef="n_Activate" />
    <bpmn:sequenceFlow id="f_10" name="" sourceRef="n_SubLambda" targetRef="n_Activate" />
    <bpmn:sequenceFlow id="f_12" name="" sourceRef="n_Success" targetRef="n_Redirect" />
    <bpmn:association id="f_0" sourceRef="n_Subscribe" targetRef="n_Pending" associationDirection="One" />
    <bpmn:association id="f_11" sourceRef="n_Activate" targetRef="n_Pending" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_two_arrivals">
    <bpmndi:BPMNPlane id="Plane_two_arrivals" bpmnElement="Process_two_arrivals">
      <bpmndi:BPMNShape id="n_Subscribe_di" bpmnElement="n_Subscribe">
        <dc:Bounds x="147.38" y="28" width="187.5" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Pending_di" bpmnElement="n_Pending">
        <dc:Bounds x="151.15" y="1009.5" width="179.96" height="48" />
