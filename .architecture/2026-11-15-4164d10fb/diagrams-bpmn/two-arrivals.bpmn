      <bpmndi:BPMNShape id="n_Completed_di" bpmnElement="n_Completed">
        <dc:Bounds x="332.88" y="386" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Bus_di" bpmnElement="n_Bus">
        <dc:Bounds x="171.25" y="529.5" width="139.75" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SubQ_di" bpmnElement="n_SubQ">
        <dc:Bounds x="151.75" y="635.5" width="178.75" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SubDlq_di" bpmnElement="n_SubDlq">
        <dc:Bounds x="51.25" y="759.5" width="190" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_SubLambda_di" bpmnElement="n_SubLambda">
        <dc:Bounds x="277.25" y="741.5" width="153.75" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Activate_di" bpmnElement="n_Activate">
        <dc:Bounds x="152.38" y="883.5" width="177.5" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_Redirect_di" bpmnElement="n_Redirect">
        <dc:Bounds x="63.71" y="386.75" width="187.5" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_1_di" bpmnElement="f_1">
        <di:waypoint x="241.13" y="76" />
